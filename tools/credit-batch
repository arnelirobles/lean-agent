credit_common.PROG = "credit-batch"
MODELS = {"sonnet": "claude-sonnet-5-5", "opus": "claude-opus-5-5", "haiku": "claude-haiku-5-5"}
PRICE_NAME = {"claude-sonnet-5-5": "sonnet", "claude-opus-5-5": "opus-5-5", "claude-haiku-5-5": "haiku-5-5"}
CREATE_NOTE = ("; the batch may exist, its id is unknown, the reservation stays, "
               "check the Console Batches page")
SAFE = re.compile(r"[^A-Za-z0-9_-]")
BASIS = "token counts at batch rates (half the list prices), not a billed figure"


def full_model(name):
    name = name.strip()
    if name in MODELS:
        return MODELS[name]
    if name in PRICE_NAME:
        return name
    die(f"model must be sonnet, opus, haiku or one of {', '.join(PRICE_NAME)}, got {name!r}")


def batch_price(model, prompt_tokens):
    """The batch rates for a model: half the list prices, the long-prompt tier when over its limit."""
    name = PRICE_NAME[model]
    limit, long_price = LONG_PROMPT.get(name, (None, None))
    price = long_price if limit is not None and prompt_tokens > limit else PRICES[name]
    return tuple(p / 2 for p in price)


def estimate(model, shared, brief, max_tokens):
    """Upper bound for one request: every input token, the shared part at the 1 hour write rate, and max_tokens."""
    prompt = math.ceil((len(shared.encode()) + len(brief.encode())) / 2)
    shared_tokens = min(math.ceil(len(shared.encode()) / 2), prompt)
    u = {"in": prompt - shared_tokens, "cw": shared_tokens, "cw1h": shared_tokens, "cr": 0, "out": max_tokens}
    return price_usage(batch_price(model, prompt), u)


def item_cost(model, usage, had_shared):
    """Real cost of one request. With no 1h/5m split, a run that sent a shared block is priced at the 1h rate."""
    hour = usage["cache_write_1h"]
    if hour is None:
        hour = usage["cache_write"] if had_shared else 0
    u = {"in": usage["input"], "cw": usage["cache_write"], "cw1h": hour,
         "cr": usage["cache_read"], "out": usage["output"]}
    return price_usage(batch_price(model, u["in"] + u["cw"] + u["cr"]), u)


def custom_id(path):
    stem = os.path.splitext(os.path.basename(path))[0]
    return SAFE.sub("_", stem)[:64] or "brief"


def build_requests(a, model):
    shared = ""
    if a.shared:
        with open(a.shared) as f:
            shared = f.read()
        if not shared.strip():
            die(f"shared file is empty: {a.shared}")
    requests, seen, briefs = [], {}, []
    for path in a.brief:
        if not os.path.isfile(path):
            die(f"brief file not found: {path}")
        with open(path) as f:
            text = f.read()
        if not text.strip():
            die(f"brief file is empty: {path}")
        cid = custom_id(path)
        if cid.casefold() in seen:
            die(f"two briefs give the custom_id {cid!r}: {seen[cid.casefold()]} and {path}")
        seen[cid.casefold()] = path
        params = {"model": model, "max_tokens": a.max_tokens_value,
                  "messages": [{"role": "user", "content": text}]}
        if shared:
            params["system"] = [{"type": "text", "text": shared,
                                 "cache_control": {"type": "ephemeral", "ttl": "1h"}}]
        requests.append({"custom_id": cid, "params": params})
        briefs.append(text)
    return requests, shared, briefs


def sdk_entry():
    return os.path.join(sdk_dir(), "node_modules", "@anthropic-ai", "sdk", "index.mjs")


def need_sdk():
    node = shutil.which("node")
    if not node:
        die("node not found; install node, then run credit-run --setup")
    if not os.path.isfile(sdk_entry()):
        die("the Anthropic SDK is not installed; run credit-run --setup")
    return node


def call(node, key, payload, note=""):
    """One worker call. Returns its JSON line; any failure exits 1 with one scrubbed line."""
    job = json.dumps(dict(payload, sdkDir=sdk_dir()))
    try:
        r = subprocess.run([node, os.path.join(HERE, "credit-batch-worker.mjs")], input=job,
                           capture_output=True, text=True, env=child_env(key), timeout=900)
    except subprocess.TimeoutExpired:
        die("the worker took more than 15 minutes" + note, 1)
    if r.returncode != 0:
        lines = scrub(r.stderr, key).strip().splitlines()
        die((lines[-1] if lines else f"the worker failed with exit {r.returncode}") + note, 1)
    try:
        return json.loads(scrub(r.stdout, key).strip().splitlines()[-1])
    except (ValueError, IndexError):
        die("the worker printed no JSON" + note, 1)


def need_on(name):
    if os.environ.get(name, "").strip().lower() != "on":
        die(f"batch runs are off; set LEAN_CREDIT_RUNS=on and LEAN_CREDIT_BATCH=on to allow them"
            if name == "LEAN_CREDIT_BATCH" else "credit runs are off; set LEAN_CREDIT_RUNS=on to allow them")


def submit(a):
    need_on("LEAN_CREDIT_RUNS")
    need_on("LEAN_CREDIT_BATCH")
    total_text = os.environ.get("LEAN_CREDIT_TOTAL_USD")
    if not total_text:
        die("LEAN_CREDIT_TOTAL_USD is not set; set the total you allow to spend")
    total = money(total_text, "LEAN_CREDIT_TOTAL_USD")
    try:
        a.max_tokens_value = int(a.max_tokens)
    except (TypeError, ValueError):
        a.max_tokens_value = 0
    if a.max_tokens_value < 1:
        die(f"--max-tokens must be a whole number of 1 or more, got {a.max_tokens!r}")
    if key_command() is None:
        die("only macOS and Linux are supported")
    model = full_model(a.model)
    requests, shared, briefs = build_requests(a, model)
    node = need_sdk()
    key = read_key()
    reserved = round(sum(estimate(model, shared, b, a.max_tokens_value) for b in briefs), 6)
    run = uuid.uuid4().hex[:12]
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    meta = {"run": run, "kind": "batch", "model": model, "role": a.role, "requests": len(requests),
            "max_tokens": a.max_tokens_value, "shared": bool(shared)}
    reserve(dict(meta, time=stamp, phase="reserve", reserved=reserved), total)
    r = call(node, key, {"op": "create", "requests": requests}, CREATE_NOTE)
    batch_id = r.get("id")
    if not isinstance(batch_id, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", batch_id):
        die("the worker returned no usable batch id" + CREATE_NOTE, 1)
    append_line({"run": run, "kind": "batch", "phase": "submit", "batch_id": batch_id,
                 "time": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    print(batch_id)
    print(f"reserved ${reserved:.4f} for {len(requests)} request(s)", file=sys.stderr)
    return 0


def status(a):
    node = need_sdk()
    r = call(node, read_key(), {"op": "retrieve", "batch_id": a.id})
    print(f"{r.get('id', a.id)} {r.get('processing_status')}")
    counts = r.get("request_counts")
    if isinstance(counts, dict):
        print(" ".join(f"{k}={v}" for k, v in counts.items()))
    return 0


def results(a):
    if not re.fullmatch(r"[A-Za-z0-9_-]+", a.id):
        die(f"not a batch id: {a.id!r}")
    node = need_sdk()
    key = read_key()
    r = call(node, key, {"op": "retrieve", "batch_id": a.id})
    if r.get("processing_status") != "ended":
        die(f"batch {a.id} has not ended (status {r.get('processing_status')}); try again later")
    os.makedirs(a.dir, exist_ok=True)
    out = call(node, key, {"op": "results", "batch_id": a.id, "dir": os.path.realpath(a.dir)})
    items = out.get("items") if isinstance(out, dict) else None
    if not isinstance(items, list):
        die("the worker returned no items", 1)
    for it in items:
        cid = it.get("custom_id")
        if not isinstance(cid, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", cid):
            die("the worker returned an unsafe custom_id", 1)
        path = os.path.join(a.dir, f"{cid}.txt")
        try:
            if stat.S_ISLNK(os.lstat(path).st_mode):
                raise OSError("symlink")
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
            with os.fdopen(fd) as f:
                text = f.read()
            if key in text:
                fd = os.open(path, os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)
                with os.fdopen(fd, "w") as f:
                    f.write(scrub(text, key))
        except FileNotFoundError:
            pass
        except OSError:
            die(f"refusing to write through a symlink at {cid}.txt", 1)

    rows = [r for r in read_ledger() if isinstance(r, dict)]
    sub = next((r for r in rows if r.get("phase") == "submit" and r.get("batch_id") == a.id), None)
    run = sub.get("run") if sub else None
    held = next((r for r in rows if r.get("run") == run and r.get("phase") == "reserve"), None) if sub else None
    cost = 0.0
    for it in items:
        if it.get("type") == "succeeded" and isinstance(it.get("usage"), dict):
            if held:
                cost += item_cost(held["model"], it["usage"], bool(held.get("shared")))
    cost = round(cost, 6)
    failed = [it for it in items if it.get("type") != "succeeded"]
    if sub is None or held is None:
        print(f"credit-batch: batch {a.id} is not in the ledger; its cost is not recorded", file=sys.stderr)
    elif held.get("requests") != len(items):
        print(f"credit-batch: batch {a.id} reserved {held.get('requests')} request(s) but the results hold "
              f"{len(items)}; no final line written, the reservation stays, run results again", file=sys.stderr)
        return 1
    elif any(r.get("run") == run and r.get("phase") == "final" for r in rows):
        print(f"credit-batch: batch {a.id} is already closed in the ledger", file=sys.stderr)
    else:
        append_line({"run": run, "kind": "batch", "phase": "final", "batch_id": a.id, "cost": cost,
                     "cost_basis": BASIS, "requests": len(items), "failed": len(failed),
                     "time": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    print(f"{len(items) - len(failed)} of {len(items)} succeeded, files in {a.dir}")
    print(f"cost ${cost:.4f} ({BASIS})")
    if failed:
        names = ", ".join(f"{it['custom_id']} ({it.get('type')})" for it in failed)
        print(f"credit-batch: did not succeed: {names}", file=sys.stderr)
        return 1
    return 0


def parser():
    p = argparse.ArgumentParser(prog="credit-batch", description="Send read-only briefs as one Message Batch.")
    p.add_argument("--self-test", action="store_true")
    sub = p.add_subparsers(dest="cmd")
    s = sub.add_parser("submit")
    s.add_argument("--brief", action="append", required=True)
    s.add_argument("--shared")
    s.add_argument("--max-tokens", required=True)
    s.add_argument("--model", default="sonnet")
    s.add_argument("--role")
    t = sub.add_parser("status")
    t.add_argument("id")
    r = sub.add_parser("results")
    r.add_argument("id")
    r.add_argument("--dir", required=True)
    return p


def main(argv):
    p = parser()
    a = p.parse_args(argv)
    if a.self_test:
        return self_test()
    if a.cmd == "submit":
        return submit(a)
    if a.cmd == "status":
        return status(a)
    if a.cmd == "results":
        return results(a)
    p.print_usage(sys.stderr)
    return 2


