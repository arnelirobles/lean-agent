def self_test():
    fails = []
    me = os.path.realpath(__file__)

    def check(ok, msg):
        if not ok:
            fails.append(msg)

    tmp = tempfile.mkdtemp(prefix="credit-batch-test-")
    try:
        bindir = os.path.join(tmp, "bin")
        realbin = os.path.join(tmp, "realbin")
        nonode = os.path.join(tmp, "nonode")
        for d in (bindir, realbin, nonode):
            os.makedirs(d)
        for name, body in (("node", FAKE_NODE), ("security", FAKE_KEY_TOOL), ("secret-tool", FAKE_KEY_TOOL)):
            p = os.path.join(bindir, name)
            with open(p, "w") as f:
                f.write(body)
            os.chmod(p, 0o755)
        for name in ("security", "secret-tool"):
            os.symlink(os.path.join(bindir, name), os.path.join(realbin, name))
            os.symlink(os.path.join(bindir, name), os.path.join(nonode, name))
        real_node = shutil.which("node")
        if real_node:
            os.symlink(real_node, os.path.join(realbin, "node"))
        fake_home = os.path.join(tmp, "home")
        sdk = os.path.join(fake_home, ".lean", "credit-sdk", "node_modules", "@anthropic-ai", "sdk")
        os.makedirs(sdk)
        open(os.path.join(sdk, "index.mjs"), "w").close()
        ledger = os.path.join(fake_home, ".lean", "credit-runs.jsonl")
        rec = os.path.join(tmp, "rec.jsonl")
        outdir = os.path.join(tmp, "out")

        def write(name, text):
            p = os.path.join(tmp, name)
            with open(p, "w") as f:
                f.write(text)
            return p

        brief_a = write("alpha.md", "b" * 300)
        brief_b = write("beta one.md", "b" * 300)
        brief_c = write("gamma.md", "b" * 300)
        shared = write("shared.md", "s" * 3000)

        base = {"PATH": bindir + os.pathsep + os.environ.get("PATH", ""), "HOME": fake_home,
                "FAKE_REC": rec, "ANTHROPIC_AUTH_TOKEN": "tok-should-go",
                "CLAUDE_CODE_OAUTH_TOKEN": "oauth-should-go", "ANTHROPIC_BASE_URL": "https://elsewhere.invalid"}
        on = {"LEAN_CREDIT_RUNS": "on", "LEAN_CREDIT_BATCH": "on", "LEAN_CREDIT_TOTAL_USD": "2.0"}

        def env(**kw):
            e = dict(base)
            e.update(kw)
            return e

        def run(args, e):
            if os.path.exists(rec):
                os.remove(rec)
            return subprocess.run([sys.executable, me] + args, capture_output=True, text=True, env=e)

        def recs():
            if not os.path.exists(rec):
                return []
            return [json.loads(line) for line in open(rec) if line.strip()]

        def lines():
            if not os.path.exists(ledger):
                return []
            return [json.loads(line) for line in open(ledger) if line.strip()]

        def reset():
            if os.path.exists(ledger):
                os.remove(ledger)

        def one_line(r):
            return r.returncode == 2 and len(r.stderr.strip().splitlines()) == 1 and "Traceback" not in r.stderr

        sub = ["submit", "--brief", brief_a, "--brief", brief_b, "--brief", brief_c, "--max-tokens", "1000"]
        # sonnet batch rates are (1.0, 1.25, 0.1, 5.0) per million; bytes divided by 2 is
        # 1500 shared tokens and 150 for a brief
        per_request = (150 * 1.0 + 1500 * 1.0 * HOUR_WRITE + 1000 * 5.0) / 1e6
        want_reserved = round(3 * per_request, 6)

        # both switches off start nothing
        for label, e in (("both off", env(LEAN_CREDIT_TOTAL_USD="2.0")),
                         ("batch off", env(LEAN_CREDIT_RUNS="on", LEAN_CREDIT_TOTAL_USD="2.0")),
                         ("runs off", env(LEAN_CREDIT_BATCH="on", LEAN_CREDIT_TOTAL_USD="2.0")),
                         ("no total", env(LEAN_CREDIT_RUNS="on", LEAN_CREDIT_BATCH="on"))):
            r = run(sub + ["--shared", shared], e)
            check(one_line(r) and not recs() and not os.path.exists(ledger),
                  f"{label} started something: {r.returncode} {r.stderr!r}")

        # bad input
        r = run(sub[:-1] + ["0"], env(**on))
        check(one_line(r) and not recs(), "max-tokens 0 was accepted")
        for bad in ("gpt-9", "claude-sonnet-4", "claude-sonnet-5-5-x", "sonnet-5"):
            r = run(sub + ["--model", bad], env(**on))
            check(one_line(r) and not recs() and not os.path.exists(ledger), f"model {bad!r} was accepted")
        low, up = os.path.join(tmp, "low"), os.path.join(tmp, "up")
        os.makedirs(low)
        os.makedirs(up)
        r = run(["submit", "--brief", write("low/alpha.md", "x"), "--brief", write("up/Alpha.md", "x"),
                 "--max-tokens", "10"], env(**on))
        check(one_line(r) and "custom_id" in r.stderr and not recs() and not os.path.exists(ledger),
              f"Alpha and alpha were not refused: {r.stderr!r}")
        r = run(["submit", "--brief", brief_a, "--brief", brief_a, "--max-tokens", "10"], env(**on))
        check(one_line(r) and "custom_id" in r.stderr and not recs(), f"duplicate custom_id: {r.stderr!r}")
        r = run(sub, env(FAKE_KEY_MODE="empty", **on))
        check(one_line(r) and not recs(), "an empty key started a worker")
        r = run(sub, dict(env(**on), PATH=nonode))
        check(one_line(r) and "credit-run --setup" in r.stderr and not recs(), f"no node: {r.stderr!r}")

        # an over-total reservation refuses and sends nothing
        reset()
        r = run(sub, env(LEAN_CREDIT_RUNS="on", LEAN_CREDIT_BATCH="on", LEAN_CREDIT_TOTAL_USD="0.01"))
        check(one_line(r) and "over LEAN_CREDIT_TOTAL_USD" in r.stderr and not recs() and not lines(),
              f"over-total batch was submitted: {r.returncode} {r.stderr!r}")

        # a good submit, with --shared
        reset()
        r = run(sub + ["--shared", shared, "--role", "analyze"], env(**on))
        check(r.returncode == 0 and r.stdout.strip() == "msgbatch_fake1", f"submit: {r.returncode} {r.stdout!r} {r.stderr!r}")
        got = recs()
        check(len(got) == 1 and got[0]["op"] == "create", f"worker calls on submit: {[g['op'] for g in got]}")
        if got:
            g = got[0]
            job = json.loads(g["stdin"])
            reqs = job.get("requests", [])
            check([q["custom_id"] for q in reqs] == ["alpha", "beta_one", "gamma"], f"custom ids: {[q['custom_id'] for q in reqs]}")
            p0 = reqs[0]["params"] if reqs else {}
            check(p0.get("model") == "claude-sonnet-5-5" and p0.get("max_tokens") == 1000, f"params: {p0}")
            check(p0.get("system") == [{"type": "text", "text": "s" * 3000,
                                        "cache_control": {"type": "ephemeral", "ttl": "1h"}}],
                  "the shared block is wrong")
            check(g["stdin"].count("cache_control") == 3, "cache_control is on more than the shared blocks")
            check(p0.get("messages") == [{"role": "user", "content": "b" * 300}], "the brief message is wrong")
            check("speed" not in g["stdin"] and "fallbacks" not in g["stdin"] and "thinking" not in g["stdin"],
                  "speed, fallbacks or thinking was sent")
            check(g["key_ok"] and KEY not in json.dumps(g["argv"]) and KEY not in g["stdin"],
                  "the key is missing from env or present in argv or stdin")
            check(not any(n in g["env_names"] for n in ("ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN",
                                                         "ANTHROPIC_BASE_URL")), "an auth or base url variable reached the worker")
        ls = lines()
        res = [x for x in ls if x.get("phase") == "reserve"]
        check(len(res) == 1 and abs(res[0]["reserved"] - want_reserved) < 1e-9 and res[0]["kind"] == "batch"
              and res[0]["role"] == "analyze", f"reserve line: {res} want {want_reserved}")
        check(any(x.get("phase") == "submit" and x.get("batch_id") == "msgbatch_fake1" and x.get("run") == res[0]["run"]
                  for x in ls if res), "no submit line with the batch id")
        check(KEY not in r.stdout + r.stderr + (open(ledger).read() if os.path.exists(ledger) else ""),
              "the key leaked to stdout, stderr or the ledger")
        # without --shared there is no system block
        r2 = run(["submit", "--brief", brief_a, "--max-tokens", "10"], env(**on))
        g2 = recs()
        check(r2.returncode == 0 and g2 and "system" not in g2[0]["stdin"] and "cache_control" not in g2[0]["stdin"],
              "a submit without --shared sent a system block")

        # one total with credit-run
        r = subprocess.run([sys.executable, os.path.join(HERE, "credit-run"), "--spent"], capture_output=True,
                           text=True, env=env(**on))
        check(f"reserved ${want_reserved + round(estimate('claude-sonnet-5-5', '', 'b' * 300, 10), 6):.4f}" in r.stdout,
              f"credit-run --spent does not show the batch reservations: {r.stdout!r}")
        reset()
        with open(ledger, "w") as f:
            f.write(json.dumps({"run": "r1", "phase": "reserve", "reserved": 1.99}) + "\n")
        r = run(sub + ["--shared", shared], env(**on))
        check(one_line(r) and "over LEAN_CREDIT_TOTAL_USD" in r.stderr and not recs(),
              "a credit-run reservation did not count against a batch")
        with open(ledger, "w") as f:
            f.write(json.dumps({"run": "r1", "phase": "reserve", "reserved": 1.9}) + "\n")
        r = run(sub + ["--shared", shared], env(**on))
        check(r.returncode == 0, f"a batch under the shared total was refused: {r.stderr!r}")
        # the other way: a batch reservation holds budget a credit-run job would need
        spent, held = totals(read_ledger_at(ledger))
        check(abs(held - (1.9 + want_reserved)) < 1e-9, f"held budget is {held}")

        # older single-line rows count against the total
        reset()
        with open(ledger, "w") as f:
            f.write(json.dumps({"time": "t", "branch": "b", "model": "m", "budget": 0.5, "cost": 1.99,
                                "cost_known": True, "turns": 1, "state": "ok", "session": "s"}) + "\n")
        r = run(sub + ["--shared", shared], env(**on))
        check(one_line(r) and "over LEAN_CREDIT_TOTAL_USD" in r.stderr and not recs(),
              "an older row with no phase did not count against the total")

        # results: not ended refuses
        reset()
        r = run(sub, env(**on))
        r = run(["results", "msgbatch_fake1", "--dir", outdir], env(FAKE_STATUS="in_progress", **on))
        check(one_line(r) and "has not ended" in r.stderr and [g["op"] for g in recs()] == ["retrieve"]
              and not any(x.get("phase") == "final" for x in lines()), f"results before the end: {r.returncode} {r.stderr!r}")

        # results: one succeeded, one errored, one expired
        usage = {"input": 1000, "cache_write": 2000, "cache_write_1h": 2000, "cache_read": 3000, "output": 500}
        items = [{"custom_id": "alpha", "type": "succeeded", "model": "claude-sonnet-5-5", "usage": usage, "text": "the answer"},
                 {"custom_id": "beta_one", "type": "errored", "error": "boom", "text": "errored: boom"},
                 {"custom_id": "gamma", "type": "expired", "text": "expired"}]
        r = run(["results", "msgbatch_fake1", "--dir", outdir], env(FAKE_ITEMS=json.dumps(items), **on))
        check(r.returncode == 1 and "beta_one" in r.stderr and "gamma" in r.stderr and "alpha" not in r.stderr,
              f"failed requests not named: {r.returncode} {r.stderr!r}")
        check(os.path.exists(os.path.join(outdir, "alpha.txt")) and open(os.path.join(outdir, "gamma.txt")).read().strip() == "expired",
              "result files are missing")
        # batch rates: 1000*1.0 + 2000*1.0*2 (1h write) + 3000*0.1 + 500*5.0 per million
        want_cost = (1000 * 1.0 + 2000 * 1.0 * HOUR_WRITE + 3000 * 0.1 + 500 * 5.0) / 1e6
        fin = [x for x in lines() if x.get("phase") == "final"]
        check(len(fin) == 1 and abs(fin[0]["cost"] - round(want_cost, 6)) < 1e-9 and fin[0]["batch_id"] == "msgbatch_fake1",
              f"final line: {fin} want cost {want_cost}")
        list_cost = price_usage(PRICES["sonnet"], {"in": 1000, "cw": 2000, "cw1h": 2000, "cr": 3000, "out": 500})
        check(bool(fin) and abs(fin[0]["cost"] * 2 - list_cost) < 1e-6, "the final cost is not half the list price")
        spent, held = totals(read_ledger_at(ledger))
        check(abs(held) < 1e-12 and abs(spent - round(want_cost, 6)) < 1e-9, f"reservation not closed: spent {spent} held {held}")
        r = run(["results", "msgbatch_fake1", "--dir", outdir], env(FAKE_ITEMS=json.dumps(items), **on))
        check(len([x for x in lines() if x.get("phase") == "final"]) == 1, "a second results call wrote a second final line")
        # a batch id that is not in the ledger
        r = run(["results", "msgbatch_other", "--dir", outdir], env(FAKE_ITEMS=json.dumps(items[:1]), **on))
        check(r.returncode == 0 and "not in the ledger" in r.stderr and len([x for x in lines() if x.get("phase") == "final"]) == 1,
              f"an unknown batch: {r.returncode} {r.stderr!r}")
        # status needs only the key, not the switches
        r = run(["status", "msgbatch_fake1"], env())
        check(r.returncode == 0 and "msgbatch_fake1 ended" in r.stdout, f"status: {r.stdout!r} {r.stderr!r}")

        # the key never reaches output from a worker failure or a result file
        r = run(["status", "msgbatch_fake1"], env(FAKE_MODE="leak"))
        check(r.returncode == 1 and KEY not in r.stdout + r.stderr, f"worker stderr leaked the key: {r.stderr!r}")
        r = run(["results", "msgbatch_fake1", "--dir", outdir], env(FAKE_MODE="leakfile", FAKE_ITEMS=json.dumps(items[:1])))
        check(KEY not in open(os.path.join(outdir, "alpha.txt")).read() and KEY not in r.stdout + r.stderr,
              "the key stayed in a result file")

        def fresh(shared_flag):
            reset()
            args = sub + (["--shared", shared] if shared_flag else [])
            r0 = run(args, env(**on))
            check(r0.returncode == 0, f"submit for a results case: {r0.stderr!r}")

        def close(its, odir, **kw):
            return run(["results", "msgbatch_fake1", "--dir", odir], env(FAKE_ITEMS=json.dumps(its), **on, **kw))

        def final_cost():
            f = [x for x in lines() if x.get("phase") == "final"]
            return f[0]["cost"] if len(f) == 1 else None

        ok3 = [{"custom_id": c, "type": "succeeded", "model": "claude-sonnet-5-5", "usage": usage, "text": "t"}
               for c in ("alpha", "beta_one", "gamma")]
        # a 5m cache write is priced at the 5m rate
        five = dict(usage, cache_write_1h=0)
        fresh(True)
        close([dict(x, usage=five) for x in ok3], os.path.join(tmp, "o5"))
        want5 = 3 * (1000 * 1.0 + 2000 * 1.25 + 3000 * 0.1 + 500 * 5.0) / 1e6
        check(final_cost() is not None and abs(final_cost() - round(want5, 6)) < 1e-9,
              f"a 5m write was not priced at the 5m rate: {final_cost()} want {want5}")
        # no split: priced at 1h when the run had a shared block, at 5m when it had none
        nosplit = dict(usage, cache_write_1h=None)
        fresh(True)
        close([dict(x, usage=nosplit) for x in ok3], os.path.join(tmp, "o6"))
        check(final_cost() is not None and abs(final_cost() - round(3 * want_cost, 6)) < 1e-9,
              f"a missing split with shared was not priced at 1h: {final_cost()}")
        fresh(False)
        close([dict(x, usage=nosplit) for x in ok3], os.path.join(tmp, "o7"))
        check(final_cost() is not None and abs(final_cost() - round(want5, 6)) < 1e-9,
              f"a missing split without shared was not priced at 5m: {final_cost()}")
        # a short result count keeps the reservation open, a rerun closes it
        fresh(True)
        r = close(ok3[:2], os.path.join(tmp, "o8"))
        check(r.returncode == 1 and "reserved 3" in r.stderr and "hold 2" in r.stderr
              and not any(x.get("phase") == "final" for x in lines()), f"short count: {r.returncode} {r.stderr!r}")
        check(totals(read_ledger_at(ledger))[1] > 0, "a short count closed the reservation")
        r = close(ok3, os.path.join(tmp, "o8"))
        check(r.returncode == 0 and len([x for x in lines() if x.get("phase") == "final"]) == 1
              and abs(totals(read_ledger_at(ledger))[1]) < 1e-12, f"the rerun did not close it: {r.returncode} {r.stderr!r}")
        # a symlink at a result path is refused and not followed
        fresh(True)
        sdir = os.path.join(tmp, "o9")
        os.makedirs(sdir)
        victim = write("victim.txt", "keep")
        os.symlink(victim, os.path.join(sdir, "alpha.txt"))
        r = close(ok3, sdir, FAKE_MODE="leakfile")
        check(r.returncode == 1 and "alpha.txt" in r.stderr and KEY in open(victim).read()
              and not any(x.get("phase") == "final" for x in lines()), f"symlink target: {r.returncode} {r.stderr!r}")

        # the real worker against a fake @anthropic-ai/sdk
        if not real_node:
            print("credit-batch self-test: node not found, the real worker test is skipped")
        else:
            with open(os.path.join(sdk, "index.mjs"), "w") as f:
                f.write(FAKE_SDK)
            sdk_rec = os.path.join(tmp, "sdk.jsonl")
            real = env(PATH=realbin, FAKE_SDK_REC=sdk_rec, **on)
            reset()
            odir = os.path.join(tmp, "out-real")
            # the worker's own scrub, before credit-batch touches any file
            wdir = os.path.join(tmp, "out-worker")
            os.makedirs(wdir)
            w = subprocess.run([real_node, os.path.join(HERE, "credit-batch-worker.mjs")], capture_output=True, text=True,
                               input=json.dumps({"sdkDir": os.path.join(fake_home, ".lean", "credit-sdk"), "op": "results",
                                                 "batch_id": "msgbatch_real1", "dir": wdir}),
                               env={"PATH": realbin, "ANTHROPIC_API_KEY": KEY, "FAKE_SDK_REC": sdk_rec})
            wt = {n: open(os.path.join(wdir, n)).read() for n in os.listdir(wdir)}
            check(w.returncode == 0 and wt.get("one.txt", "").startswith("answer [redacted]") and KEY not in "".join(wt.values()) + w.stdout,
                  f"the worker did not scrub its own output: {w.returncode} {w.stderr!r} {wt}")
            # the worker refuses a symlink at a result path
            os.remove(os.path.join(wdir, "one.txt"))
            victim2 = write("victim2.txt", "keep")
            os.symlink(victim2, os.path.join(wdir, "one.txt"))
            w = subprocess.run([real_node, os.path.join(HERE, "credit-batch-worker.mjs")], capture_output=True, text=True,
                               input=json.dumps({"sdkDir": os.path.join(fake_home, ".lean", "credit-sdk"), "op": "results",
                                                 "batch_id": "msgbatch_real1", "dir": wdir}),
                               env={"PATH": realbin, "ANTHROPIC_API_KEY": KEY, "FAKE_SDK_REC": sdk_rec})
            check(w.returncode == 1 and "one.txt" in w.stderr and open(victim2).read() == "keep",
                  f"the worker followed a symlink: {w.returncode} {w.stderr!r}")
            os.remove(sdk_rec)
            r = run(sub + ["--shared", shared], real)
            check(r.returncode == 0 and r.stdout.strip() == "msgbatch_real1", f"real worker submit: {r.returncode} {r.stderr!r}")
            calls = [json.loads(x) for x in open(sdk_rec)] if os.path.exists(sdk_rec) else []
            check(calls and calls[0]["op"] == "create" and calls[0]["key"] == KEY, "the SDK did not get the key from the environment")
            if calls:
                body = calls[0]["body"]
                check(body["requests"][0] == {"custom_id": "alpha", "params": {
                    "model": "claude-sonnet-5-5", "max_tokens": 1000,
                    "system": [{"type": "text", "text": "s" * 3000, "cache_control": {"type": "ephemeral", "ttl": "1h"}}],
                    "messages": [{"role": "user", "content": "b" * 300}]}}, "the request item sent to the SDK is wrong")
                check(KEY not in json.dumps(body), "the key is in the request body")
            r = run(["results", "msgbatch_real1", "--dir", odir], real)
            texts = {n: open(os.path.join(odir, n)).read() for n in os.listdir(odir)} if os.path.isdir(odir) else {}
            check(r.returncode == 1 and "two (errored)" in r.stderr and "three (expired)" in r.stderr,
                  f"real worker results: {r.returncode} {r.stderr!r}")
            check(sorted(texts) == ["one.txt", "three.txt", "two.txt"] and texts.get("one.txt", "").startswith("answer [redacted]")
                  and "boom [redacted]" in texts.get("two.txt", "") and texts.get("three.txt", "").strip() == "expired",
                  f"result files: {texts}")
            check(KEY not in "".join(texts.values()) + r.stdout + r.stderr + open(ledger).read(),
                  "the key leaked through the real worker")
            fin = [x for x in lines() if x.get("phase") == "final"]
            check(len(fin) == 1 and abs(fin[0]["cost"] - round(want_cost, 6)) < 1e-9, f"real worker final line: {fin}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if fails:
        for f in fails:
            print(f"FAIL {f}", file=sys.stderr)
        return 1
    print("credit-batch self-test passed")
    return 0


def read_ledger_at(path):
    rows = []
    with open(path) as f:
        for line in f:
            if line.strip():
                rows.append(json.loads(line))
    return rows


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
