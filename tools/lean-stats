    check("and the file holds each session once", conn.execute("SELECT COUNT(*) FROM agent_runs").fetchone()[0], 6)
    conn.close()
    with leanstats.temp_env(LEAN_STATS="off"):
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            code = main(["collect", "--transcript", os.path.join(root, "two.jsonl")])
        check("LEAN_STATS=off stops it", (code, "nothing read or written" in out.getvalue()), (0, True))


def test_self_tests_leave_the_real_database(check, tmp):
    home = os.path.join(tmp, "realhome")
    os.makedirs(home)
    env = {k: v for k, v in os.environ.items() if k not in ("LEAN_DB", "LEAN_STATS", "LEAN_BRAIN_DB")}
    env["HOME"] = home
    for rel in ("lib/leanstats.py", "hooks/session-env.py", "hooks/context-cost.py"):
        result = subprocess.run([sys.executable, os.path.join(ROOT, rel), "--self-test"], env=env,
                                capture_output=True, text=True, timeout=300)
        check("%s self-test passes under a fresh HOME" % rel, (result.returncode, result.stdout.strip().splitlines()[-1:]),
              (0, ["self-test: ok"]))
        check("%s self-test makes no default database" % rel, os.path.exists(os.path.join(home, ".lean", "lean.db")), False)


COMMANDS = {
    "log-review": cmd_log_review,
    "import-reviews": cmd_import_reviews,
    "collect": cmd_collect,
    "report": cmd_report,
}
TESTS = [test_reviews, test_legacy_azure, test_transcripts, test_changes, test_report, test_avoidable, test_collect_session, test_self_tests_leave_the_real_database]


def main(argv):
    if argv == ["--self-test"]:
        return self_test()
    if not argv or argv[0] not in COMMANDS:
        print(__doc__, file=sys.stderr)
        return 2
    if leanstats.off():
        print("lean-stats: LEAN_STATS=off, nothing read or written")
        return 0
    try:
        conn = leanstats.connect()
    except leanstats.NewerSchema as exc:
        print(f"lean-stats: {exc}", file=sys.stderr)
        return 1
    try:
        return COMMANDS[argv[0]](conn, argv[1:])
    except ValueError as exc:
        print(f"lean-stats: {exc}", file=sys.stderr)
        return 2
    finally:
        conn.close()


def self_test():
    import tempfile

    failures = []

    def check(name, got, want):
        if got != want:
            failures.append(f"{name}: got {got!r}, want {want!r}")

    for test in TESTS:
        with tempfile.TemporaryDirectory() as tmp:
            with leanstats.temp_env(LEAN_DB=os.path.join(tmp, "lean.db"), LEAN_STATS=None, LEAN_MODEL_CHEAP=None):
                with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                    test(check, tmp)
    if failures:
        print("self-test failed:\n  " + "\n  ".join(failures))
        return 1
    print("self-test passed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
