#!/usr/bin/env python3
"""Collect and report what the lean-agent loop did, from one SQLite file.

  lean-stats collect [--since YYYY-MM-DD] [owner/repo ...]
  lean-stats collect --transcript <session.jsonl>
  lean-stats report  [--since YYYY-MM-DD] [--markdown]
  lean-stats import-reviews <review-log.tsv>
  lean-stats log-review <repo> <pr> <confirmed> <refuted> <blockers> "<categories>" \\
                        "<caught elsewhere first>" [pre_push] [ci] [review] [escaped]
  lean-stats --self-test

The file is ~/.lean/lean.db. LEAN_DB moves it and LEAN_STATS=off stops every
write. Nothing leaves the machine. No prompt text, code or command line is
stored: tokens, model, role, repository and change only.
"""
import contextlib
import glob
import io
import json
import os
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import forge  # noqa: E402
import leanstats  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LOG_REVIEW = os.path.join(ROOT, "skills", "adversarial-review", "log-review.sh")
REVIEW_COLUMNS = ("date", "repo", "pr", "confirmed", "refuted", "blockers", "categories",
                  "caught_elsewhere_first", "pre_push", "ci", "review", "escaped")


def pr_number(text):
    """The pull request number in `12`, `#12` or a pull request URL, else None."""
    found = re.search(r"(?:^#?|/pull/)(\d+)/?$", (text or "").strip())
    return int(found.group(1)) if found else None


def count(text):
    text = str(text).strip()
    return int(text) if text.isdigit() else 0


def put_review(conn, cells):
    """Store one review row from twelve cells in REVIEW_COLUMNS order. False when it has no pull request number."""
    number = pr_number(cells[2])
    if number is None:
        return False
    values = [cells[0], cells[1], number] + [count(c) for c in cells[3:6]] + list(cells[6:8]) + [count(c) for c in cells[8:12]]
    conn.execute("INSERT OR REPLACE INTO reviews (%s) VALUES (%s)"
                 % (", ".join(REVIEW_COLUMNS), ", ".join("?" * len(REVIEW_COLUMNS))), values)
    return True


def cmd_log_review(conn, args):
    """Store one review outcome. Takes the arguments of log-review.sh."""
    if not 7 <= len(args) <= 11:
        print("usage: lean-stats log-review <repo> <pr> <confirmed> <refuted> <blockers> "
              "\"<categories>\" \"<caught elsewhere first>\" [pre_push] [ci] [review] [escaped]", file=sys.stderr)
        return 2
    first = conn.execute("SELECT date FROM reviews WHERE repo = ? AND pr = ?", (args[0], pr_number(args[1]))).fetchone()
    # a later log amends the review, so the row stays in the window it was reviewed in
    date = first[0] if first else time.strftime("%Y-%m-%d", time.gmtime())
    cells = [date] + list(args) + ["0"] * (11 - len(args))
    if put_review(conn, cells):
        print(f"stored {args[0]}#{pr_number(args[1])}")
    else:
        print(f"lean-stats: no pull request number in {args[1]!r}, not stored")
    return 0


def cmd_import_reviews(conn, args):
    """Load a review-log.tsv, eight or twelve columns. Safe to run again: a row replaces its earlier self."""
    if len(args) != 1:
        print("usage: lean-stats import-reviews <review-log.tsv>", file=sys.stderr)
        return 2
    try:
        with open(args[0], errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError as exc:
        print(f"lean-stats: cannot read {args[0]}: {exc.strerror}", file=sys.stderr)
        return 1
    imported = skipped = 0
    with leanstats.tx(conn):
        for line in lines:
            cells = line.split("\t")
            if cells[0] == "date" or not line.strip():
                continue
            if len(cells) < 8:
                skipped += 1
                continue
            cells = (cells + ["0"] * 4)[:12]
            if put_review(conn, cells):
                imported += 1
            else:
                skipped += 1
    print(f"reviews: {imported} imported, {skipped} skipped (no pull request number or too few columns)")
    return 0


ROLES = ("draft", "spec", "hunt", "refute", "escalate", "search", "gate", "retro")
LABEL = re.compile(r"^lean:([a-z]+)(?:\s+([\w.-]+/[\w.-]+(?:/[\w.-]+)?)(?:#(\d+)|@(\S+))?)?")
REMOTE = re.compile(r"[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$")


def parse_label(text):
    """(role, repo, pr, branch) from `lean:<role> <owner/repo>#<pr>` or `...@<branch>`. No prefix is role other."""
    found = LABEL.match((text or "").strip())
    if not found:
        return "other", "", None, ""
    role = found.group(1) if found.group(1) in ROLES else "other"
    return role, found.group(2) or "", int(found.group(3)) if found.group(3) else None, found.group(4) or ""


def first_prompt_line(path):
    """The first line of the prompt an agent was started with, where a workflow script puts the label."""
    try:
        fh = open(path, errors="replace")
    except OSError:
        return ""
    with fh:
        for line in fh:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if not isinstance(row, dict) or row.get("type") != "user":
                continue
            message = row.get("message")
            content = message.get("content") if isinstance(message, dict) else None
            if isinstance(content, list):
                content = next((b.get("text") for b in content
                                if isinstance(b, dict) and b.get("type") == "text"), "")
            text = content.strip() if isinstance(content, str) else ""
            return text.splitlines()[0] if text else ""
    return ""


def read_label(path):
    """The lean: label of an agent transcript: its metadata description, else its first prompt line."""
    candidates = []
    try:
        with open(path[:-len(".jsonl")] + ".meta.json") as fh:
            meta = json.load(fh)
        if isinstance(meta, dict):
            candidates = [meta.get("label"), meta.get("description")]
    except (OSError, ValueError):
        pass
    candidates.append(first_prompt_line(path))
    for text in candidates:
        if isinstance(text, str) and text.strip().startswith("lean:"):
            return text.strip()
    return ""


def repo_from_remote(url):
    """owner/name of a GitHub-style remote, ORG/PROJECT/REPO for an Azure DevOps one (so it cannot collide)."""
    if forge.kind_of((url or "").strip()) == "azure":
        return forge.azure_slug(url)
    found = REMOTE.search((url or "").strip())
    return found.group(1) if found else ""


def git_repo(cwd):
    """owner/name of the origin remote of a directory, or empty when it is gone or not a repository."""
    if not cwd or not os.path.isdir(cwd):
        return ""
    try:
        result = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                                capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    return repo_from_remote(result.stdout) if result.returncode == 0 else ""


def make_repo_of(lookup=git_repo):
    """A cached cwd-to-repo function, so each directory costs one git call."""
    cache = {}

    def repo_of(cwd):
        if cwd not in cache:
            cache[cwd] = lookup(cwd) or ""
        return cache[cwd]

    return repo_of


def options(args):
    """Split arguments into (since, markdown, the rest)."""
    since, markdown, rest = "", False, []
    i = 0
    while i < len(args):
        if args[i] == "--since":
            if i + 1 >= len(args) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args[i + 1]):
                raise ValueError("--since takes a date as YYYY-MM-DD")
            since = args[i + 1]
            i += 2
            continue
        if args[i] == "--markdown":
            markdown = True
        else:
            rest.append(args[i])
        i += 1
    return since, markdown, rest


def projects_root():
    return os.path.join(os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude"), "projects")


def transcript_files(root):
    """(path, kind) for every transcript under a Claude Code projects directory."""
    found = [(p, "main") for p in glob.glob(os.path.join(root, "*", "*.jsonl"))]
    found += [(p, "subagent") for p in glob.glob(os.path.join(root, "*", "*", "subagents", "agent-*.jsonl"))]
    found += [(p, "workflow") for p in glob.glob(
        os.path.join(root, "*", "*", "subagents", "workflows", "*", "agent-*.jsonl"))]
    return sorted(found)


RUN_COLUMNS = ("run_id", "session_id", "kind", "role", "model", "repo", "pr", "branch", "started_at", "ended_at",
               "tokens_in", "tokens_cache_write", "tokens_cache_write_1h", "tokens_cache_read", "tokens_out",
               "source_path", "usd", "peak_context", "turns_over_80k", "lookup_calls", "image_results",
               "errored_results", "wait_loop_calls", "avoidable")


def run_row(run_id, kind, role, model, repo, pr, branch, messages, path):
    stamps = sorted(m["ts"] for m in messages if m["ts"])
    return (run_id, next((m["session"] for m in messages if m["session"]), ""), kind, role, model, repo, pr, branch,
            stamps[0] if stamps else "", stamps[-1] if stamps else "",
            sum(m["in"] for m in messages), sum(m["cw"] for m in messages), sum(m["cw1h"] for m in messages),
            sum(m["cr"] for m in messages), sum(m["out"] for m in messages), path,
            sum(leanstats.message_cost(m) for m in messages)) + leanstats.signals(messages, kind)


def agent_rows(path, kind, messages, repo_of):
    """The agent_runs rows for one transcript: one per agent, or one per repo and model of a main session."""
    messages = [m for m in messages if m["model"] != "<synthetic>"]
    if not messages:
        return []
    if kind == "main":
        session = os.path.basename(path)[:-len(".jsonl")]
        groups = {}
        for m in messages:
            groups.setdefault((repo_of(m["cwd"]), m["model"]), []).append(m)
        return [run_row(f"{session}:{repo}:{model}", "main", "coordinator", model, repo, None, "", group, path)
                for (repo, model), group in sorted(groups.items())]
    role, repo, pr, branch = parse_label(read_label(path))
    output = {}
    for m in messages:
        output[m["model"]] = output.get(m["model"], 0) + m["out"]
    model = max(sorted(output), key=output.get)
    if not repo:
        repo = repo_of(next((m["cwd"] for m in messages if m["cwd"]), ""))
    agent_id = os.path.basename(path)[len("agent-"):-len(".jsonl")]
    return [run_row(agent_id, kind, role, model, repo, pr, branch, messages, path)]


def session_files(transcript):
    """(path, kind) for one session: its main transcript and the agents under it."""
    stem = transcript[:-len(".jsonl")] if transcript.endswith(".jsonl") else transcript
    found = [(transcript, "main")] if os.path.isfile(transcript) else []
    found += [(p, "subagent") for p in glob.glob(os.path.join(stem, "subagents", "agent-*.jsonl"))]
    found += [(p, "workflow") for p in glob.glob(os.path.join(stem, "subagents", "workflows", "*", "agent-*.jsonl"))]
    return sorted(found)


def collect_transcripts(conn, root, since, repo_of, files=None):
    """Import every changed transcript under root, or just the given (path, kind) files. Returns (imported, unchanged)."""
    cutoff = time.mktime(time.strptime(since, "%Y-%m-%d")) if since else 0
    imported = unchanged = 0
    for path, kind in (transcript_files(root) if files is None else files):
        try:
            stat = os.stat(path)
        except OSError:
            continue
        if stat.st_mtime < cutoff:
            continue
        known = conn.execute("SELECT size, mtime FROM imports WHERE path = ?", (path,)).fetchone()
        if known and known["size"] == stat.st_size and known["mtime"] == stat.st_mtime and not conn.execute(
                "SELECT 1 FROM agent_runs WHERE source_path = ? AND avoidable IS NULL", (path,)).fetchone():
            unchanged += 1
            continue
        rows = agent_rows(path, kind, leanstats.read_usage(path), repo_of)
        with leanstats.tx(conn):
            conn.execute("DELETE FROM agent_runs WHERE source_path = ?", (path,))
            conn.executemany("INSERT OR REPLACE INTO agent_runs (%s) VALUES (%s)" % (
                ", ".join(RUN_COLUMNS), ", ".join("?" * len(RUN_COLUMNS))), rows)
            conn.execute("INSERT OR REPLACE INTO imports (path, size, mtime) VALUES (?, ?, ?)",
                         (path, stat.st_size, stat.st_mtime))
        imported += 1
    return imported, unchanged


RETRO = os.path.join(ROOT, "tools", "retro-signals.sh")


def run_command(cmd, timeout=600):
    """stdout of a command, or None when it is missing, fails or runs too long."""
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout if result.returncode == 0 else None


def fetch_changes(repo, since, run=run_command):
    """Rows for the changes table for one repository, or None when gh (az for Azure) fails.

    Azure rows leave fix rounds, failed checks and escaped refs empty: retro-signals reads GitHub only.
    """
    merged = forge.for_repo(repo, run).merged_prs(repo, since)
    if merged is None:
        return None
    signals = {}
    azure = forge.repo_kind(repo) == "azure"
    for line in ([] if azure else (run(["bash", RETRO, "--since", since, repo]) or "").splitlines()[1:]):
        cells = line.split("\t")
        if len(cells) >= 6 and cells[1].isdigit():
            signals[int(cells[1])] = [int(c) if c.isdigit() else None for c in (cells[2], cells[3], cells[5])]
    rows = []
    for pr in merged:
        fix_rounds, failed_checks, escaped_refs = signals.get(pr["number"], [None, None, None])
        rows.append((repo, pr["number"], pr["head_ref"], pr["created_at"], pr["merged_at"],
                     fix_rounds, failed_checks, escaped_refs))
    return rows


REPO_TABLES = ("agent_runs", "reviews", "changes")


def azure_project_map(run):
    """{lowercase repo name: [(ORG/PROJECT/REPO), ...]} for the default az organization, or None when az fails."""
    text = run(["az", "devops", "configure", "-l"])
    found = re.search(r"organization\s*=\s*https://dev\.azure\.com/([^/\s]+)", text or "")
    if not found:
        return None
    org = found.group(1)
    url = f"https://dev.azure.com/{org}"
    listing = run(["az", "devops", "project", "list", "--org", url, "--query", "value[].name", "--output", "json"])
    names = {}
    try:
        projects = json.loads(listing)
        for project in projects:
            repos = json.loads(run(["az", "repos", "list", "--project", project, "--org", url,
                                    "--query", "[].name", "--output", "json"]))
            for repo in repos:
                names.setdefault(repo.lower(), []).append(f"{org}/{project}/{repo}")
    except (ValueError, TypeError):
        return None
    return names


def fix_legacy_azure(conn, run=run_command, which=shutil.which):
    """Rewrite old `_git/NAME` repo names to ORG/PROJECT/NAME, using the repositories az lists for the default org.

    Safe to repeat: it looks at `_git/` names only, and skips the az calls when the set of those names is the
    one it already looked at. A name found in more than one project is left alone and printed. Returns
    {new name: rows rewritten}.
    """
    legacy = sorted({r[0] for t in REPO_TABLES for r in conn.execute(
        f"SELECT DISTINCT repo FROM {t} WHERE substr(repo, 1, 5) = '_git/'")})
    if not legacy:
        return {}
    seen = conn.execute("SELECT value FROM meta WHERE key = 'azure_legacy_seen'").fetchone()
    if seen and json.loads(seen[0]) == legacy:
        return {}
    if not which("az"):
        print("legacy Azure names: skipped, az not found")
        return {}
    names = azure_project_map(run)
    if names is None:
        print("legacy Azure names: skipped, the az call failed")
        return {}
    done = {}
    with leanstats.tx(conn):
        for old in legacy:
            matches = names.get(old[len("_git/"):].lower(), [])
            if len(matches) > 1:
                print(f"legacy Azure names: {old} is in {len(matches)} projects, left alone")
            elif matches:
                moved = 0
                for table in REPO_TABLES:
                    moved += conn.execute(f"UPDATE OR IGNORE {table} SET repo = ? WHERE repo = ?",
                                          (matches[0], old)).rowcount
                done[matches[0]] = moved
        left = sorted({r[0] for t in REPO_TABLES for r in conn.execute(
            f"SELECT DISTINCT repo FROM {t} WHERE substr(repo, 1, 5) = '_git/'")})
        conn.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('azure_legacy_seen', ?)", (json.dumps(left),))
    return done


def azure_repos(conn):
    """The Azure repositories (ORG/PROJECT/REPO) that agent runs and changes already name."""
    found = set()
    for table in ("agent_runs", "changes"):
        found.update(r[0] for r in conn.execute(f"SELECT DISTINCT repo FROM {table} WHERE repo LIKE '%/%/%'"))
    return sorted(r for r in found if forge.repo_kind(r) == "azure" and forge.parse_azure(r))


def collect_changes(conn, repos, since, run=run_command, which=shutil.which):
    """Store the merged pull requests of each repository. Returns how many were stored.

    GitHub repositories (owner/name) need gh and jq, Azure ones (ORG/PROJECT/REPO) need az. A tool that
    is missing skips only its own repositories, with one line.
    """
    missing = {}
    for tool, kind in (("gh", "github"), ("jq", "github"), ("az", "azure")):
        if not which(tool):
            missing.setdefault(kind, []).append(tool)
    for kind, tools in missing.items():
        if not any(forge.repo_kind(r) == kind for r in repos):
            continue
        print(f"changes: skipped{' Azure' if kind == 'azure' else ''}, {' and '.join(tools)} not found")
    repos = [r for r in repos if forge.repo_kind(r) not in missing]
    if not repos:
        return 0
    stored = 0
    for repo in repos:
        try:
            rows = fetch_changes(repo, since, run)
        except forge.Unsupported as e:
            print(f"changes: skipped {repo}: {e}")
            continue
        if rows is None:
            print(f"changes: skipped {repo}, the {'az' if forge.repo_kind(repo) == 'azure' else 'gh'} call failed")
            continue
        with leanstats.tx(conn):
            conn.executemany("INSERT OR REPLACE INTO changes VALUES (?, ?, ?, ?, ?, ?, ?, ?)", rows)
        stored += len(rows)
    print(f"changes: {stored} stored from {len(repos)} repositories")
    return stored


def cmd_collect(conn, args):
    """Import transcripts, and merged pull requests for any repositories named.

    With --transcript <path> it imports only that session's transcript and its agents.
    """
    if "--transcript" in args:
        i = args.index("--transcript")
        if i + 1 >= len(args) or len(args) != 2:
            raise ValueError("--transcript takes one transcript path and nothing else")
        imported, unchanged = collect_transcripts(conn, "", "", make_repo_of(), session_files(args[i + 1]))
        print(f"transcripts: {imported} imported, {unchanged} unchanged")
        return 0
    since, _, repos = options(args)
    bad = [r for r in repos if not re.fullmatch(r"[\w.-]+/[\w.-]+|[\w.-]+/[^/]+/[^/]+", r)]
    if bad:
        raise ValueError(f"not an owner/repo or ORG/PROJECT/REPO: {bad[0]}")
    if repos and not since:
        raise ValueError("naming repositories needs --since YYYY-MM-DD, the start of the batch")
    imported, unchanged = collect_transcripts(conn, projects_root(), since, make_repo_of())
    print(f"transcripts: {imported} imported, {unchanged} unchanged")
    fixed = fix_legacy_azure(conn)
    if fixed:
        print(f"legacy Azure names: {sum(fixed.values())} rows rewritten in {len(fixed)} repositories")
    if not repos and since:
        repos = azure_repos(conn)  # nothing named: the Azure repositories the transcripts already name
    if repos:
        collect_changes(conn, repos, since)
    return 0


NO_DATA = "no data"
SILENT_HOOKS = {"record-test-run.py"}  # writes a marker file and never notes or blocks, so it has no fire to count


def registered_hooks():
    """The hook scripts named in hooks/hooks.json, without the ones that never fire by design."""
    try:
        with open(os.path.join(ROOT, "hooks", "hooks.json")) as fh:
            text = fh.read()
    except OSError:
        return []
    return sorted(set(re.findall(r"/hooks/([\w.-]+\.py)", text)) - SILENT_HOOKS)


def run_cost(run):
    if run["usd"] is not None:
        return run["usd"]
    return leanstats.cost(run["model"], {
        "in": run["tokens_in"], "cw": run["tokens_cache_write"], "cw1h": run["tokens_cache_write_1h"],
        "cr": run["tokens_cache_read"], "out": run["tokens_out"]})


def run_tokens(run):
    return run["tokens_in"] + run["tokens_cache_write"] + run["tokens_cache_read"] + run["tokens_out"]


def share(part, whole):
    return f"{100 * part / whole:.0f}%"


AVOIDABLE = (
    ("context", "Avoidable: context above 80k", "turns_over_80k", "turns over 80k"),
    ("lookup", "Avoidable: coordinator lookups", "lookup_calls", "read-only lookup calls by coordinators on opus"),
    ("image", "Avoidable: images carried in a long context", "image_results", "image results"),
    ("error", "Avoidable: errored tool calls", "errored_results", "errored tool results"),
    ("wait", "Avoidable: wait loops", "wait_loop_calls", "wait-loop calls"),
)
FAST_ROLES = ("search", "gate", "retro")


def ratio(part, whole):
    return share(part, whole) if whole else "0%"


def is_fast(model, fast):
    """Whether a run's model is the configured fast model: its family, or the setting's own text for a model outside the families."""
    return leanstats.family(model) == fast if fast in leanstats.FAMILIES else fast in model.lower()


def avoidable_rows(runs):
    """The Avoidable section: each usage signal as a share of the tokens and list price of the runs that have signals."""
    known = [run for run in runs if run["avoidable"] is not None]
    rows = []
    if known:
        tokens, usd = sum(run_tokens(run) for run in known), sum(run_cost(run) for run in known)
        spent = {name: [0, 0.0] for name, _, _, _ in AVOIDABLE}
        for run in known:
            try:
                found = json.loads(run["avoidable"])
            except ValueError:
                found = {}
            for name, pair in spent.items():
                part = found.get(name) or [0, 0]
                pair[0] += part[0]
                pair[1] += part[1]
        unknown = len(runs) - len(known)
        for name, label, column, noun in AVOIDABLE:
            calls = sum(run[column] or 0 for run in known)
            basis = f"{calls} {noun}"
            if name == "context":
                basis += f", peak {max(run['peak_context'] or 0 for run in known) // 1000}k"
            basis += f"; {spent[name][1]:.2f} of {usd:.2f} USD at list price, over {len(known)} runs"
            if unknown:
                basis += f"; {unknown} older runs have no signals"
            rows.append((label, f"{ratio(spent[name][0], tokens)} of tokens, {ratio(spent[name][1], usd)} of USD", basis))
    else:
        rows += [(label, NO_DATA, "") for _, label, _, _ in AVOIDABLE]
    fast = (os.environ.get("LEAN_MODEL_FAST") or "haiku").strip().lower() or "haiku"
    if runs:
        ran = sum(1 for run in runs if is_fast(run["model"], fast))
        meant = sum(1 for run in runs if run["role"] in FAST_ROLES)
        rows.append((f"{fast.capitalize()} share of runs", f"{ratio(ran, len(runs))} ran on {fast}, the method gives it {ratio(meant, len(runs))}",
                     f"{ran} of {len(runs)} runs; {meant} have a read-and-report role ({', '.join(FAST_ROLES)})"
                     + ("" if meant else "; none started with a lean:search, lean:gate or lean:retro description")))
    else:
        rows.append((f"{fast.capitalize()} share of runs", NO_DATA, ""))
    return rows


def measures(conn, since=""):
    """The report as (label, value, basis) rows. A row with nothing behind it says no data, not zero."""
    out = []
    changes = conn.execute("SELECT * FROM changes WHERE merged_at >= ? ORDER BY repo, pr", (since,)).fetchall()
    runs = conn.execute("SELECT * FROM agent_runs WHERE ended_at >= ?", (since,)).fetchall()
    reviews = conn.execute("SELECT * FROM reviews WHERE date >= ?", (since,)).fetchall()
    cheap = leanstats.family(os.environ.get("LEAN_MODEL_CHEAP") or "sonnet")

    linked = {}
    for change in changes:
        hits = conn.execute(
            "SELECT * FROM agent_runs WHERE repo = ? AND (pr = ? OR (branch <> '' AND branch = ?))",
            (change["repo"], change["pr"], change["branch"])).fetchall()
        if hits:
            linked[(change["repo"], change["pr"])] = hits

    total = len(changes)
    out.append(("Changes merged", str(total) if total else NO_DATA,
                f"{len(linked)} linked to agent runs" if total else ""))

    repos = {change["repo"] for change in changes}
    spend = [run for run in runs if run["repo"] in repos]
    if total and spend:
        dollars = sum(run_cost(run) for run in spend)
        out.append(("Cost per change", f"{dollars / total:.2f} USD",
                    f"{dollars:.2f} USD over {total} changes, list prices"))
        for label, key in (("Cost per change by model", lambda run: leanstats.family(run["model"])),
                           ("Cost per change by role", lambda run: run["role"])):
            parts = {}
            for run in spend:
                parts[key(run)] = parts.get(key(run), 0.0) + run_cost(run)
            ranked = sorted(parts.items(), key=lambda item: (-item[1], item[0]))
            out.append((label, ", ".join(f"{name} {value / total:.2f}" for name, value in ranked), "USD per change"))
    else:
        out.append(("Cost per change", NO_DATA, ""))

    if linked:
        escalated = sum(1 for hits in linked.values() if any(run["role"] == "escalate" for run in hits))
        out.append(("Escalation rate", share(escalated, len(linked)), f"{escalated} of {len(linked)} linked changes"))
    else:
        out.append(("Escalation rate", NO_DATA, ""))

    if reviews:
        summed = {key: sum(review[key] for review in reviews)
                  for key in ("pre_push", "ci", "review", "escaped", "confirmed", "refuted")}
        out.append(("Findings by where caught",
                    f"pre-push {summed['pre_push']}, CI {summed['ci']}, review {summed['review']}, "
                    f"escaped {summed['escaped']}", f"{len(reviews)} reviews"))
        candidates = summed["confirmed"] + summed["refuted"]
        if candidates:
            out.append(("Refuted share", share(summed["refuted"], candidates),
                        f"{summed['refuted']} of {candidates} candidates"))
        else:
            out.append(("Refuted share", NO_DATA, ""))
    else:
        out.append(("Findings by where caught", NO_DATA, ""))
        out.append(("Refuted share", NO_DATA, ""))

    refs = [change["escaped_refs"] for change in changes if change["escaped_refs"] is not None]
    out.append(("Escaped after merge", str(sum(refs)) if refs else NO_DATA,
                f"later issues or pull requests pointing back, over {len(refs)} changes" if refs else ""))

    hunted = [key for key, hits in linked.items()
              if any(run["role"] == "hunt" and leanstats.family(run["model"]) == cheap for run in hits)]
    if hunted:
        review_of = {(review["repo"], review["pr"]): review for review in conn.execute("SELECT * FROM reviews")}
        refs_of = {(change["repo"], change["pr"]): change["escaped_refs"] for change in changes}
        checked = [key for key in hunted if key in review_of or refs_of.get(key) is not None]
        missed = 0
        for key in checked:
            review = review_of.get(key)
            later = review["ci"] + review["review"] + review["escaped"] if review else 0
            if later or refs_of.get(key):
                missed += 1
        unchecked = len(hunted) - len(checked)
        if checked:
            basis = f"of {len(checked)} changes hunted on {cheap}, with a finding caught in CI, in review or after merge"
            if unchecked:
                basis += f"; {unchecked} more had no review and no signals"
            out.append(("Critic misses", str(missed), basis))
        else:
            out.append(("Critic misses", NO_DATA,
                        f"{len(hunted)} changes hunted on {cheap}, none with a review logged or signals collected"))
    else:
        out.append(("Critic misses", NO_DATA, ""))

    rounds = [change["fix_rounds"] for change in changes if change["fix_rounds"] is not None]
    if rounds:
        out.append(("Fix rounds per change", f"{sum(rounds) / len(rounds):.1f}",
                    f"max {max(rounds)}, over {len(rounds)} changes"))
    else:
        out.append(("Fix rounds per change", NO_DATA, ""))

    fires = conn.execute("SELECT hook, outcome, COUNT(*) AS n FROM hook_fires WHERE ts >= ? "
                         "GROUP BY hook, outcome ORDER BY hook, outcome", (since,)).fetchall()
    if fires:
        per_hook = {}
        for fire in fires:
            per_hook.setdefault(fire["hook"], []).append(f"{fire['outcome']} {fire['n']}")
        out.append(("Hook fires", "; ".join(f"{hook} {', '.join(parts)}" for hook, parts in sorted(per_hook.items())),
                    f"{sum(fire['n'] for fire in fires)} fires"))
        registered = registered_hooks()
        quiet = [hook for hook in registered if hook not in per_hook]
        out.append(("Hooks with no fire", ", ".join(quiet) if quiet else "none", f"of {len(registered)} registered"))
    else:
        out.append(("Hook fires", NO_DATA, ""))
        out.append(("Hooks with no fire", NO_DATA, ""))

    tokens = sum(run_tokens(run) for run in runs)
    if tokens:
        other = sum(run_tokens(run) for run in runs if run["role"] == "other")
        no_repo = sum(run_tokens(run) for run in runs if not run["repo"])
        out.append(("Unattributed", f"role other {share(other, tokens)}, no repo {share(no_repo, tokens)}",
                    f"of tokens in {len(runs)} runs"))
    else:
        out.append(("Unattributed", NO_DATA, ""))
    return out + avoidable_rows(runs)


def render(rows, since, markdown, today):
    window = f"{since} to {today}" if since else "all time"
    if markdown:
        lines = [f"Window: {window}. Changes: {rows[0][1]}.", "", "| Measure | Value | Basis |", "| --- | --- | --- |"]
        lines += [f"| {label} | {value} | {basis} |" for label, value, basis in rows]
    else:
        lines = [f"lean-stats report, {window}"]
        lines += [f"{label}: {value}" + (f" ({basis})" if basis else "") for label, value, basis in rows]
    return "\n".join(lines)


def cmd_report(conn, args):
    """Print the numbers for the window, as text or as one Markdown table."""
    since, markdown, rest = options(args)
    if rest:
        raise ValueError(f"report takes --since and --markdown, not {rest[0]}")
    print(render(measures(conn, since), since, markdown, time.strftime("%Y-%m-%d", time.gmtime())))
    return 0


