def test_azure_changes(check, conn):
    az_list = json.dumps([
        {"pullRequestId": 11, "sourceRefName": "refs/heads/$(id)", "creationDate": "2026-10-01T01:00:00.5+00:00",
         "closedDate": "2026-10-02T01:00:00.5+00:00", "lastMergeSourceCommit": {"commitId": "abc"}}])
    calls = []

    def fake(cmd, timeout=600):
        calls.append(cmd)
        if cmd[0] == "az":
            return None if "broken" in cmd else az_list
        return None

    def only(*tools):
        return lambda tool: "/usr/bin/" + tool if tool in tools else None

    repo = "baryodev/My Proj/r"
    check("repo name from every Azure remote form", [repo_from_remote(u) for u in (
        "https://baryodev@dev.azure.com/baryodev/My%20Proj/_git/r", "git@ssh.dev.azure.com:v3/baryodev/My%20Proj/r",
        "https://baryodev.visualstudio.com/My%20Proj/_git/r\n")], [repo] * 3)
    check("a GitHub remote is unchanged", repo_from_remote("https://github.com/o/r.git"), "o/r")
    check("a label can name an Azure repository", parse_label("lean:draft org/proj/repo#5"), ("draft", "org/proj/repo", 5, ""))
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        check("azure change stored", collect_changes(conn, [repo], "2026-10-01", fake, only("az")), 1)
        check("no retro-signals or gh for Azure", [c[0] for c in calls], ["az"])
        check("a failing az stores nothing", collect_changes(conn, ["o/broken/broken"], "2026-10-01", fake, only("az")), 0)
        check("no az skips Azure and keeps GitHub's tools out of it",
              collect_changes(conn, [repo], "2026-10-01", fake, only("gh", "jq")), 0)
        check("no az does not stop GitHub", collect_changes(conn, ["o/r"], "2026-10-01", fake, only("gh", "jq")), 0)
    check("branch text is stored as text", conn.execute("SELECT branch, merged_at, fix_rounds FROM changes WHERE repo = ?",
          (repo,)).fetchone()[:], ("$(id)", "2026-10-02T01:00:00Z", None))
