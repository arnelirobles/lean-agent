    for i, repo in enumerate(("_git/one", "_git/dup", "_git/gone", "o/r", "baryodev/P/one")):
        conn.execute("INSERT INTO agent_runs (run_id, session_id, kind, role, model, repo, started_at, ended_at, "
                     "source_path) VALUES (?, 's', 'main', 'other', 'm', ?, '2026-10-01', '2026-10-01', 'p')",
                     (f"r{i}", repo))
    calls = []
    projects = {"P": ["One", "Dup"], "Q": ["dup"]}

    def fake(cmd, timeout=600):
        calls.append(cmd)
        if cmd[:3] == ["az", "devops", "configure"]:
            return "[defaults]\norganization = https://dev.azure.com/baryodev\n"
        if cmd[:4] == ["az", "devops", "project", "list"]:
            return json.dumps(list(projects))
        return json.dumps(projects[cmd[cmd.index("--project") + 1]])

    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        check("unique match rewritten, others left", fix_legacy_azure(conn, fake, lambda t: "/bin/az"),
              {"baryodev/P/One": 1})
        rows = [tuple(r) for r in conn.execute("SELECT run_id, repo FROM agent_runs ORDER BY run_id")]
        check("rows after the first run", rows, [("r0", "baryodev/P/One"), ("r1", "_git/dup"), ("r2", "_git/gone"),
              ("r3", "o/r"), ("r4", "baryodev/P/one")])
        asked = len(calls)
        check("a second run changes nothing", fix_legacy_azure(conn, fake, lambda t: "/bin/az"), {})
        check("a second run does not call az", len(calls), asked)
        check("rows after the second run", [tuple(r) for r in conn.execute(
            "SELECT run_id, repo FROM agent_runs ORDER BY run_id")], rows)
        conn.execute("INSERT INTO agent_runs (run_id, session_id, kind, role, model, repo, started_at, ended_at, "
                     "source_path) VALUES ('r9', 's', 'main', 'other', 'm', '_git/new', '2026-10-01', '2026-10-01', 'p')")
        projects["Q"].append("New")
        check("a new legacy name is looked at", fix_legacy_azure(conn, fake, lambda t: "/bin/az"),
              {"baryodev/Q/New": 1})
        conn.execute("INSERT INTO agent_runs (run_id, session_id, kind, role, model, repo, started_at, ended_at, "
                     "source_path) VALUES ('r10', 's', 'main', 'other', 'm', '_git/late', '2026-10-01', '2026-10-01', 'p')")
        check("no az leaves the rows and says so", fix_legacy_azure(conn, fake, lambda t: None), {})
        check("a failing az leaves the rows", fix_legacy_azure(conn, lambda c, timeout=600: None, lambda t: "/bin/az"), {})
    text = out.getvalue()
    check("one line per ambiguous name per run that looked", text.count("_git/dup is in 2 projects, left alone"), 2)
    check("one line for no az", text.count("legacy Azure names: skipped, az not found"), 1)
    check("one line for a failing az", text.count("skipped, the az call failed"), 1)
