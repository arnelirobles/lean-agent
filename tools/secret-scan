#!/usr/bin/env python3
"""Find keys and tokens in the lines a commit adds, and keep them out of git.

The scanner runs in the git pre-commit and pre-push hooks it installs. Git
hands those hooks the exact index and the exact refs, so every commit and push
is checked the same way, from Claude or a terminal. The Claude hook
(hooks/secret-scan.py) makes sure the hooks are installed and not skipped, and
scans text Claude writes into files.

  secret-scan scan [--repo DIR] --staged        added lines of the staged diff
  secret-scan scan [--repo DIR] --range A..B    added lines of a commit range
  secret-scan scan --push-stdin REMOTE          a pre-push hook's stdin
  secret-scan scan --file PATH [--stdin]        one file, or text on stdin as PATH
  secret-scan install [--force-shared] [REPO]   pre-commit and pre-push hooks in one repo
  secret-scan install [--force-shared] --all DIR  the same in every git repo under DIR
  secret-scan uninstall [REPO] | --all DIR      take them out, restore what was chained

Exit 0 clean, 1 on a finding, 2 when the scan could not run (a git error, a
bad range, a timeout). The git hooks block on both 1 and 2. Output is one line
per finding, "path:line  pattern", and never the value.

A line containing `allow-secret` is skipped, that line only.
gitleaks: when `gitleaks` is on PATH its rules run too, once per scan, on top
of the built in patterns. If it fails or runs out of time that is printed and
the built in result stands.
Files are read as text whatever .gitattributes says, up to their first NUL;
what follows a NUL is taken as binary and skipped.
A push scans the commits the target remote does not have. Commits on another
remote are scanned too, unless that remote is public (an anonymous ls-remote
over https works), since a public commit cannot leak. A shallow clone's
boundary counts as known. Merges are scanned for what they add over every
parent. A pushed tag that points at a blob or a tree is scanned whole.
gitleaks is skipped when a scan is over 8 MB, and says so.
  LEAN_SKIP_SECRET_SCAN=1       turn the scan off (git hooks and Claude hook)
  LEAN_SECRET_SCAN_TIMEOUT      seconds gitleaks may take in one scan (default 20)
  LEAN_SECRET_SCAN_HOME         where install keeps its copy of this script
                                (default ~/.local/share/lean/secret-scan)
  secret-scan --self-test
"""
import bisect
import hashlib
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time

MARKER = "allow-secret"
CHUNK = 1 << 20
MAX_LINE = 16 << 20
GITLEAKS_MAX_BYTES = 8 << 20
GIT_TIMEOUT = 120


class ScanError(Exception):
    """The scan could not run. Never treated as a clean scan."""


# patterns ---------------------------------------------------------------

AZURE_RUN = re.compile(r"(?<![A-Za-z0-9])[a-z2-7]{52}(?![A-Za-z0-9])")
AZURE_CONTEXT = re.compile(
    r"(?i)(?:pat|token|devops|azure|ado|accesstoken|password)[\w.-]{0,40}[\"']?\s*[:=]\s*[\"']?$")


def azure_pat(line):
    """52 base32 characters next to a name that says token. The run is found first, then the
    120 characters before it are checked, so the cost stays linear in the line."""
    for m in AZURE_RUN.finditer(line):
        if AZURE_CONTEXT.search(line[max(0, m.start() - 120):m.start()]):
            return True
    return False


PATTERNS = [
    ("google-api-key (AIza)", re.compile(r"AIza[0-9A-Za-z_-]{35}")),
    ("github-token (ghp_/gho_/ghu_/ghs_/ghr_)", re.compile(r"gh[pousr]_[A-Za-z0-9]{36,}")),
    ("github-fine-grained-token (github_pat_)", re.compile(r"github_pat_[A-Za-z0-9_]{22,}")),
    ("aws-access-key-id (AKIA)", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("slack-token (xox)", re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("stripe-live-key (sk_live_/rk_live_)", re.compile(r"[sr]k_live_[0-9A-Za-z]{20,}")),
    ("npm-token (npm_)", re.compile(r"npm_[A-Za-z0-9]{36}")),
    ("private-key-block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("azure-devops-pat", azure_pat),
]


def scan_line(line):
    """Names of the patterns a line matches, [] when it carries allow-secret."""
    if MARKER in line:
        return []
    return [name for name, rx in PATTERNS
            if (rx(line) if callable(rx) else rx.search(line))]


# collector: patterns per line, one gitleaks run per scan ------------------

WARNINGS = []


def warn(text):
    WARNINGS.append(text)
    print("secret-scan: warning: " + text, file=sys.stderr)


def gitleaks_path():
    return shutil.which("gitleaks")


def timeout_seconds():
    try:
        return max(1.0, float(os.environ.get("LEAN_SECRET_SCAN_TIMEOUT") or 20))
    except ValueError:
        return 20.0


def run_limited(argv, limit, cwd):
    """Run a command in its own process group; kill the group at the limit. Returns (rc, stderr)
    or raises subprocess.TimeoutExpired."""
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, errors="replace", cwd=cwd, start_new_session=True)
    try:
        _out, err = proc.communicate(timeout=limit)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()
        raise
    return proc.returncode, err


def locate(content, starts, item, count):
    """0-based index of the scanned line a gitleaks finding sits on. The secret is found by byte
    offset in its own file, nearest to the line gitleaks gave; StartLine is the fallback."""
    line = item.get("StartLine")
    want = line - 1 if isinstance(line, int) else 0
    secret = item.get("Secret") or item.get("Match") or ""
    best = None
    if secret:
        pos = content.find(secret)
        while pos >= 0:
            idx = bisect.bisect_right(starts, pos) - 1
            if best is None or abs(idx - want) < abs(best - want):
                best = idx
            pos = content.find(secret, pos + 1)
    if best is None:
        best = want
    return min(max(best, 0), count - 1)


class Collector:
    """Gathers findings from every line fed to it. Lines also go to gitleaks, once, in finish(),
    unless the scan is bigger than the cap, which skips gitleaks for the whole scan."""

    def __init__(self):
        self.found = set()
        self.files = {}  # path -> [(number, text)] for gitleaks
        self.bytes = 0
        self.skipped_big = False
        self.exe = gitleaks_path()

    def feed(self, path, num, line):
        for name in scan_line(line):
            self.found.add((path, num, name))
        if self.exe and not self.skipped_big and MARKER not in line:
            self.bytes += len(line) + 1
            if self.bytes > GITLEAKS_MAX_BYTES:
                self.skipped_big = True
                self.files = {}
            else:
                self.files.setdefault(path, []).append((num, line))

    def feed_text(self, path, text):
        for n, line in enumerate(text.splitlines(), 1):
            self.feed(path, n, line)

    def finish(self):
        if self.skipped_big:
            warn(f"gitleaks skipped: this scan is over {GITLEAKS_MAX_BYTES >> 20} MB. "
                 "The built in patterns covered all of it.")
        elif self.exe and self.files:
            self.run_gitleaks()
        return sorted(self.found, key=lambda f: (f[0], f[1], f[2]))

    def run_gitleaks(self):
        with tempfile.TemporaryDirectory() as tmp:
            src = os.path.join(tmp, "in")
            os.mkdir(src)
            names = {}
            for i, (path, rows) in enumerate(self.files.items()):
                ext = re.sub(r"[^A-Za-z0-9.]", "", os.path.splitext(path)[1])[:16]
                fname = f"f{i:06d}{ext}"
                content = "\n".join(t.replace("\r", "") for _n, t in rows) + "\n"
                with open(os.path.join(src, fname), "w", encoding="utf-8", errors="replace") as f:
                    f.write(content)
                names[fname] = (path, rows, content)
            report = os.path.join(tmp, "r.json")
            tail = ["--report-format", "json", "--report-path", report, "--no-banner", "--exit-code", "0"]
            reason = "no report"
            deadline = time.monotonic() + timeout_seconds()
            for argv in ([self.exe, "dir", src] + tail, [self.exe, "detect", "--no-git", "--source", src] + tail):
                left = deadline - time.monotonic()
                if left <= 0:
                    warn("gitleaks ran out of time. Only the built in patterns were used.")
                    return
                try:
                    rc, err = run_limited(argv, left, tmp)
                except subprocess.TimeoutExpired:
                    warn(f"gitleaks timed out after {timeout_seconds():g}s. Only the built in patterns were used "
                         "(LEAN_SECRET_SCAN_TIMEOUT sets the limit).")
                    return
                except OSError as exc:
                    reason = str(exc)
                    break
                if os.path.exists(report):
                    try:
                        with open(report, encoding="utf-8") as f:
                            data = json.load(f) or []
                    except ValueError:
                        reason = "unreadable report"
                        continue
                    for item in data:
                        fname = os.path.basename(str(item.get("File") or ""))
                        if fname not in names:
                            continue
                        path, rows, content = names[fname]
                        starts = [0] + [m.end() for m in re.finditer("\n", content)]
                        num = rows[locate(content, starts, item, len(rows))][0]
                        if not any(f[0] == path and f[1] == num for f in self.found):
                            self.found.add((path, num, "gitleaks:" + str(item.get("RuleID") or "rule")))
                    return
                reason = (err.strip().splitlines() or [f"exit {rc}"])[-1][:200]
            warn(f"gitleaks failed ({reason}). Only the built in patterns were used.")


def finishing(col, fn):
    """Run fn(collector); with no collector given, make one and return its findings."""
    own = col is None
    col = col or Collector()
    fn(col)
    return col.finish() if own else None


# git ----------------------------------------------------------------------

# Config that would run a command, hide lines or change paths during a scan. Each git call the
# scanner makes (diff, log, cat-file, rev-list, rev-parse, config, remote, ls-files, check-ignore,
# hash-object) runs with these. Filters are replaced per repo in filter_overrides.
SAFE_C = ["-c", "core.fsmonitor=false", "-c", "core.pager=cat", "-c", "diff.external=",
          "-c", "color.ui=false", "-c", "log.showSignature=false", "-c", "log.showRoot=true",
          "-c", "diff.relative=false", "-c", "diff.noprefix=false", "-c", "core.quotePath=false"]
DIFF_ARGS = ["-U0", "--text", "--no-color", "--no-ext-diff", "--no-textconv", "--no-renames",
             "--ignore-submodules=all", "--src-prefix=a/", "--dst-prefix=b/"]


class Repo:
    """Where git runs: a directory, and optionally --git-dir and --work-tree."""

    def __init__(self, cwd, git_dir=None, work_tree=None):
        self.cwd, self.git_dir, self.work_tree = cwd, git_dir, work_tree
        self._filters = None


def as_repo(repo):
    return repo if isinstance(repo, Repo) else Repo(repo)


def raw_git(repo, extra, args, check=True, input=None):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", GIT_PAGER="cat")
    env.pop("GIT_EXTERNAL_DIFF", None)
    argv = ["git"]
    if repo.git_dir:
        argv += ["--git-dir", repo.git_dir]
    if repo.work_tree:
        argv += ["--work-tree", repo.work_tree]
    argv += SAFE_C + extra + list(args)
    if not os.path.isdir(repo.cwd or "."):
        raise ScanError(f"{repo.cwd} is not a directory")
    try:
        p = subprocess.run(argv, cwd=repo.cwd or ".", capture_output=True, input=input, env=env,
                           timeout=GIT_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as exc:
        raise ScanError(f"git did not run: {exc}")
    out = p.stdout.decode("utf-8", "replace")
    if p.returncode != 0:
        if not check:
            return None
        err = p.stderr.decode("utf-8", "replace").strip().splitlines()
        raise ScanError("git " + " ".join(list(args)[:3]) + " failed: " + (err[-1] if err else f"exit {p.returncode}"))
    return out


def filter_overrides(repo):
    """A repo's own filter.NAME.clean/smudge/process commands run when git diff compares a work tree
    file. Replace each configured filter with a harmless one."""
    if repo._filters is None:
        out = raw_git(repo, [], ["config", "--get-regexp", r"^filter\..+\.(clean|smudge|process)$"],
                      check=False) or ""
        names = set()
        for row in out.splitlines():
            key = row.split(None, 1)[0]
            m = re.fullmatch(r"filter\.(.+)\.(?:clean|smudge|process)", key, re.I)
            if m:
                names.add(m.group(1))
        args = []
        for name in sorted(names):
            args += ["-c", f"filter.{name}.clean=cat", "-c", f"filter.{name}.smudge=cat",
                     "-c", f"filter.{name}.process=", "-c", f"filter.{name}.required=false"]
        repo._filters = args
    return repo._filters


def git(repo, *args, check=True, input=None):
    """stdout of a git command. With check, a failure raises ScanError; without, it returns None."""
    repo = as_repo(repo)
    return raw_git(repo, filter_overrides(repo), args, check=check, input=input)


def is_repo(repo):
    return git(repo, "rev-parse", "--git-dir", check=False) is not None


def toplevel(repo):
    repo = as_repo(repo)
    top = git(repo, "rev-parse", "--show-toplevel", check=False)
    return (top or "").strip() or (repo.work_tree or repo.cwd)


def git_path(repo, name):
    """Absolute path of `git rev-parse --git-path NAME`, or None outside a repository."""
    repo = as_repo(repo)
    out = git(repo, "rev-parse", "--git-path", name, check=False)
    if out is None:
        return None
    out = out.strip()
    return out if os.path.isabs(out) else os.path.normpath(os.path.join(repo.cwd or ".", out))


HUNK = re.compile(r"(@{2,}) (.*?) @{2,}")


def parse_diff(text):
    """Added lines of a -U0 diff, or log -p --cc output, as (path, line number, text).

    Hunk counts say which lines are content, so an added line that starts with '++ ' is not read as
    a file header. In a combined diff (a merge) a line counts only when it is new against every
    parent, which is what a conflict resolution adds. A NUL ends the text of that file: the part
    before it is scanned and the rest of the file is skipped as binary."""
    path, new, n, width, cut = None, 0, 0, 1, False
    for raw in text.split("\n"):
        if new > 0:
            cols = raw[:width]
            if len(cols) == width and not cols.strip("+- "):
                if "-" not in cols:
                    new -= 1
                    if path and not cut and cols == "+" * width:
                        line = raw[width:]
                        if "\0" in line:
                            line, cut = line.split("\0", 1)[0], True
                        yield path, n, line
                    n += 1
                continue
            if raw.startswith("\\"):
                continue
            new = 0
        if raw.startswith("diff --git ") or raw.startswith("diff --cc ") or raw.startswith("diff --combined "):
            path, cut = None, False
        elif raw.startswith("+++ "):
            target = raw[4:].rstrip("\t").strip()
            if target == "/dev/null":
                path = None
            else:
                target = target.strip('"')
                path = target[2:] if target[:2] == "b/" else target
        elif raw.startswith("@@"):
            m = HUNK.match(raw)
            if m:
                width = len(m.group(1)) - 1
                last = m.group(2).split()[-1]
                start, _, count = last.lstrip("+").partition(",")
                n = int(start)
                new = int(count) if count else 1


def feed_diff(col, text):
    for path, num, line in parse_diff(text):
        col.feed(path, num, line)


def empty_tree(repo):
    return git(repo, "hash-object", "-t", "tree", "--stdin", input=b"").strip()


def scan_staged(repo, col=None):
    return finishing(col, lambda c: feed_diff(c, git(repo, "diff", "--cached", *DIFF_ARGS)))


def log_args(*revs):
    """log -p for commits, and --cc for what a merge adds on top of its parents."""
    return ["log", "-p", "--cc", "--no-show-signature", "--no-notes", "--format=", *DIFF_ARGS, *revs]


def scan_range(repo, rng, col=None):
    return finishing(col, lambda c: feed_diff(c, git(repo, *log_args(rng))))


def feed_file(col, path, label=None):
    """Scan a regular file in chunks, up to its first NUL. Symlinks and devices are skipped. The
    file is opened without following a link."""
    label = label or path
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        return
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            return
        buf, n, done = b"", 0, False
        while not done:
            chunk = f.read(CHUNK)
            if not chunk:
                break
            if b"\0" in chunk:
                chunk, done = chunk.split(b"\0", 1)[0], True
            parts = (buf + chunk).split(b"\n")
            buf = parts.pop()
            if len(buf) > MAX_LINE:
                parts.append(buf)
                buf = b""
            for part in parts:
                n += 1
                col.feed(label, n, part.decode("utf-8", "replace"))
        if buf:
            col.feed(label, n + 1, buf.decode("utf-8", "replace"))


def scan_file(path, label=None, col=None):
    return finishing(col, lambda c: feed_file(c, path, label))


def scan_text(text, path, col=None):
    return finishing(col, lambda c: c.feed_text(path, text.split("\0", 1)[0]))


# push scope ---------------------------------------------------------------

ZERO = re.compile(r"0+")
_PUBLIC = {}


def resolve_remote(repo, name):
    """(configured remote name, known). A URL or path that matches a configured remote gives that
    remote; any other value is not known."""
    remotes = (git(repo, "remote", check=False) or "").split()
    if name in remotes:
        return name, True
    for r in remotes:
        urls = (git(repo, "remote", "get-url", "--all", r, check=False) or "").split()
        if name in urls:
            return r, True
    return name, False


def https_url(url):
    """The anonymous https form of a remote URL, or None for a local path."""
    m = re.match(r"https?://(?:[^@/]+@)?([^/]+)/(.+)$", url)
    if not m:
        m = re.match(r"(?:ssh|git)://(?:[^@/]+@)?([^/:]+)(?::\d+)?/(.+)$", url)
    if not m:
        m = re.match(r"(?:[^@/:]+@)?([^/:]+\.[^/:]+):(?!/)(.+)$", url)
    if not m:
        return None
    return f"https://{m.group(1)}/{m.group(2).strip('/')}"


def public_url(url):
    """True when anyone can read the repository at url: an anonymous ls-remote over https works,
    with no credentials, no config and no prompt. A local path is never public."""
    https = https_url(url)
    if not https:
        return False
    if https not in _PUBLIC:
        env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_") and k not in ("SSH_ASKPASS",)}
        env.update(GIT_TERMINAL_PROMPT="0", GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull,
                   GIT_ASKPASS="true")
        try:
            p = subprocess.run(["git", "-c", "credential.helper=", "ls-remote", "--heads", https],
                               cwd=tempfile.gettempdir(), capture_output=True, env=env, timeout=20)
            _PUBLIC[https] = p.returncode == 0
        except (OSError, subprocess.SubprocessError):
            _PUBLIC[https] = False
    return _PUBLIC[https]


def remote_is_public(repo, name):
    urls = (git(repo, "remote", "get-url", "--all", name, check=False) or "").split()
    return bool(urls) and all(public_url(u) for u in urls)


def shallow_roots(repo):
    """The commits at a shallow clone's boundary. They count as known: their parents are not here,
    so a diff of them would show the whole tree as new."""
    path = git_path(repo, "shallow")
    try:
        with open(path, encoding="utf-8") as f:
            return [s for s in f.read().split() if re.fullmatch(r"[0-9a-f]{40,64}", s)]
    except (OSError, TypeError):
        return []


def object_type(repo, sha):
    return (git(repo, "cat-file", "-t", sha + "^{}", check=False) or "").strip()


def scan_object(repo, sha, label, col):
    """A pushed ref that points at a blob or a tree: scan the whole object."""
    kind = object_type(repo, sha)
    if kind == "blob":
        col.feed_text(label, git(repo, "cat-file", "blob", sha + "^{}").split("\0", 1)[0])
    elif kind == "tree":
        feed_diff(col, git(repo, "diff", empty_tree(repo), sha + "^{}", *DIFF_ARGS))


def push_excludes(repo, local, nots, target):
    """What a push to target can leave out: commits the target remote has (nots), and commits on
    another remote that anyone can read already. A commit only on a private remote stays in."""
    def count(extra):
        return int(git(repo, "rev-list", "--count", local, "--not", *nots, *extra).strip() or 0)

    left = count([])
    if left == 0:
        return nots
    for r in (git(repo, "remote", check=False) or "").split():
        if r == target or not git(repo, "for-each-ref", "--count=1", "--format=x", f"refs/remotes/{r}/", check=False):
            continue
        if count([f"--remotes={r}"]) < left and remote_is_public(repo, r):
            nots = nots + [f"--remotes={r}"]
    return nots


def scan_push_stdin(repo, stdin_text, remote_arg, col=None):
    """A pre-push hook's stdin: 'local_ref local_sha remote_ref remote_sha' per ref."""
    def run(c):
        name, known = resolve_remote(repo, remote_arg or "")
        base = shallow_roots(repo) + ([f"--remotes={name}"] if known else [])
        for row in stdin_text.splitlines():
            parts = row.split()
            if len(parts) < 4 or ZERO.fullmatch(parts[1]):
                continue
            local, remote = parts[1], parts[3]
            kind = object_type(repo, local)
            if kind in ("blob", "tree"):
                scan_object(repo, local, parts[2], c)
                continue
            nots = list(base)
            if not ZERO.fullmatch(remote) and git(repo, "cat-file", "-e", remote + "^{commit}", check=False) is not None:
                nots.append(remote)
            nots = push_excludes(repo, local, nots, name if known else None)
            feed_diff(c, git(repo, *log_args(local, "--not", *nots)))
    return finishing(col, run)


# output -------------------------------------------------------------------

def render(found):
    """One line per finding. The value never appears."""
    return "\n".join(f"{p}:{n}  {name}" for p, n, name in sorted(set(found), key=lambda f: (f[0], f[1], f[2])))


def message(found, what):
    return (f"Blocked by lean-agent: {what} contains what looks like a key or token. "
            "Put it in a gitignored .env.local or a pipeline secret, never in git. "
            "Add allow-secret to a line that is a test fixture. Found:\n" + render(found))


# git hook installer -------------------------------------------------------

OURS = "# lean-agent secret-scan"
HASH = "# secret-scan-hash: "
COPY = "# secret-scan-copy: "
HOOKS = ("pre-commit", "pre-push")


def home():
    return os.environ.get("LEAN_SECRET_SCAN_HOME") or os.path.expanduser("~/.local/share/lean/secret-scan")


def shq(text):
    """Quote for sh: single quotes, so $, backticks and double quotes in a path stay text."""
    return "'" + text.replace("'", "'\\''") + "'"


def hooks_location(repo):
    """(hooks dir, reason it is shared or None). A hooks path from global or system config is shared
    by every repository. A repo path inside the work tree is usually committed."""
    repo = as_repo(repo)
    top = git(repo, "rev-parse", "--show-toplevel", check=False)
    if top is None:
        return None, None
    top = top.strip()
    out = (git(repo, "config", "--show-scope", "--get", "core.hooksPath", check=False) or "").strip()
    if out:
        scope, _, value = out.partition("\t")
        value = os.path.expanduser(value)
        path = value if os.path.isabs(value) else os.path.join(top, value)
        if scope in ("global", "system", "command"):
            where = "the command line or GIT_CONFIG_* variables" if scope == "command" else f"{scope} git config"
            return path, f"core.hooksPath comes from {where}, so {path} is shared by every repository"
        inside = os.path.realpath(path).startswith(os.path.realpath(top) + os.sep)
        if inside:
            return path, f"core.hooksPath points inside the work tree ({path}), where the hook, with an absolute path to your home, would be committed"
        return path, None
    gp = git(repo, "rev-parse", "--git-path", "hooks").strip()
    return (gp if os.path.isabs(gp) else os.path.join(top, gp)), None


def interpreter():
    """The python that runs install, so the hooks do not depend on PATH; python3 if that path is gone."""
    exe = sys.executable
    return exe if exe and os.path.isfile(exe) and os.access(exe, os.X_OK) else "python3"


def hook_text(name, copy, chained, py="python3"):
    q = shq(copy)
    pq = shq(py)
    old = '"$0.pre-secret-scan"'
    lines = ["#!/bin/sh",
             f"{OURS}: checks {'staged' if name == 'pre-commit' else 'pushed'} lines for keys and tokens. "
             "Remove with: secret-scan uninstall",
             "@@HASH@@",
             COPY + copy.replace("\n", " "),
             f"LEAN_SS_PY={pq}",
             '[ -x "$LEAN_SS_PY" ] || LEAN_SS_PY=python3',
             "unset LEAN_SS_SKIP",
             '[ "$LEAN_SKIP_SECRET_SCAN" = 1 ] && LEAN_SS_SKIP=1',
             f"if [ -z \"$LEAN_SS_SKIP\" ] && [ ! -f {q} ]; then "
             f"printf 'secret-scan: %s is missing, so nothing was scanned and git stops here. "
             "Run secret-scan install again, or set LEAN_SKIP_SECRET_SCAN=1 to skip once.\\n' "
             f"{q} >&2; exit 1; fi"]
    if name == "pre-push":
        lines.append("input=$(cat)")
        run_old = f'[ -x {old} ] && {{ printf \'%s\\n\' "$input" | {old} "$@"; exit $?; }}'
        lines += ['if [ -n "$LEAN_SS_SKIP" ]; then'] + ([f"  {run_old}"] if chained else []) + ["  exit 0", "fi",
                  f"printf '%s\\n' \"$input\" | \"$LEAN_SS_PY\" {q} scan --push-stdin \"$1\" || exit 1"]
        if chained:
            lines.append(run_old)
    else:
        run_old = f'[ -x {old} ] && exec {old} "$@"'
        lines += ['if [ -n "$LEAN_SS_SKIP" ]; then'] + ([f"  {run_old}"] if chained else []) + ["  exit 0", "fi",
                  f"\"$LEAN_SS_PY\" {q} scan --staged || exit 1"]
        if chained:
            lines.append(run_old)
    lines.append("exit 0")
    return lines


def digest(lines):
    return hashlib.sha256("\n".join(l for l in lines if not l.startswith(HASH)).encode()).hexdigest()


def render_hook(name, copy, chained, py="python3"):
    lines = hook_text(name, copy, chained, py)
    lines[lines.index("@@HASH@@")] = HASH + digest([l for l in lines if l != "@@HASH@@"])
    return "\n".join(lines) + "\n"


def hook_state(path):
    """'absent', 'foreign' (not ours), 'ours' (as we wrote it) or 'edited' (ours, since changed)."""
    if not os.path.lexists(path):
        return "absent"
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().split("\n")
    except OSError:
        return "foreign"
    if lines and lines[-1] == "":
        lines.pop()
    if not any(l.startswith(OURS) for l in lines):
        return "foreign"
    stored = [l[len(HASH):] for l in lines if l.startswith(HASH)]
    body = [l for l in lines if not l.startswith(HASH)]
    return "ours" if stored and stored[0] == digest(body) else "edited"


def install_one(repo, out, force=False):
    """True when both hooks are in place; False (with the reason printed) otherwise."""
    d, shared = hooks_location(repo)
    if d is None:
        out(f"skip {repo}: not a git repository")
        return False
    if shared and not force:
        out(f"refused {repo}: {shared}. Use --force-shared to install there anyway.")
        return False
    os.makedirs(home(), exist_ok=True)
    copy = os.path.join(home(), "secret-scan")
    shutil.copyfile(os.path.realpath(__file__), copy)
    os.chmod(copy, 0o755)
    os.makedirs(d, exist_ok=True)
    py = interpreter()
    ok = True
    for name in HOOKS:
        path = os.path.join(d, name)
        old = path + ".pre-secret-scan"
        state = hook_state(path)
        if state == "edited":
            out(f"kept {path}: it was edited after install, so it was not rewritten (delete it and install again)")
            ok = False
            continue
        if state == "foreign":
            if os.path.lexists(old):
                backup, n = old + ".bak", 1
                while os.path.lexists(backup):
                    n += 1
                    backup = f"{old}.bak{n}"
                os.rename(old, backup)
                os.rename(path, old)
                out(f"chained {path}: the hook that replaced ours still runs after the scan; "
                    f"the one chained before is kept as {backup} and no longer runs")
            else:
                os.rename(path, old)
                out(f"chained {path}: the existing hook still runs after the scan")
        with open(path, "w", encoding="utf-8") as f:
            f.write(render_hook(name, copy, os.path.lexists(old), py))
        os.chmod(path, 0o755)
    out(f"{'installed' if ok else 'partly installed'} {d}")
    return ok


def uninstall_one(repo, out, force=False):
    d, shared = hooks_location(repo)
    if d is None:
        out(f"skip {repo}: not a git repository")
        return False
    if shared and not force:
        out(f"refused {repo}: {shared}. Use --force-shared to remove them there anyway.")
        return False
    ok, seen = True, False
    for name in HOOKS:
        path = os.path.join(d, name)
        old = path + ".pre-secret-scan"
        state = hook_state(path)
        seen = seen or state != "absent" or os.path.lexists(old)
        if state == "ours":
            os.remove(path)
            if os.path.lexists(old):
                os.rename(old, path)
        elif state == "edited":
            out(f"kept {path}: it was edited after install (remove it by hand)")
            ok = False
        elif state == "foreign":
            out(f"left {path}: not installed by secret-scan")
        if state in ("absent", "foreign") and os.path.lexists(old):
            out(f"orphan {old}: no secret-scan hook sits in front of it, left alone")
            ok = False
    if not seen:
        out(f"nothing to remove: no secret-scan hooks in {d}")
        return True
    out(f"{'removed from' if ok else 'partly removed from'} {d}")
    return ok


def hooks_installed(repo):
    """(True, None) when this repo's pre-commit and pre-push hooks are ours, can run, and their
    scanner copy is there; else (False, the reason). git's own lookup finds the hooks folder, so a
    core.hooksPath from any config is followed."""
    d = git_path(repo, "hooks")
    if d is None:
        return False, "it is not a git repository"
    for name in HOOKS:
        path = os.path.join(d, name)
        state = hook_state(path)
        if state == "edited":
            return False, (f"its secret-scan {name} hook in {d} was changed after install. "
                           f"Delete {path} and install again")
        if state != "ours":
            return False, f"it has no secret-scan {name} hook in {d}"
        if not os.access(path, os.X_OK):
            return False, f"{path} is not executable, so git skips it"
        with open(path, encoding="utf-8", errors="replace") as f:
            copies = [l[len(COPY):].strip() for l in f.read().split("\n") if l.startswith(COPY)]
        if not copies or not os.path.isfile(copies[0]):
            return False, f"the scanner copy its {name} hook runs is missing"
    return True, None


def install_command(repo):
    """The command that installs the hooks here; it carries --force-shared when install would refuse without it."""
    _d, shared = hooks_location(repo)
    flag = " --force-shared" if shared else ""
    return f"python3 {shq(os.path.realpath(__file__))} install{flag} {shq(toplevel(repo))}"


def install_note(repo):
    """Why --force-shared is in the install command, or an empty string."""
    _d, shared = hooks_location(repo)
    if not shared:
        return ""
    return (f"{shared[0].upper()}{shared[1:]}. --force-shared writes the scan hooks into that folder anyway "
            "(a hook already there is chained); in a tracked folder they show up as changes to commit.")


def find_repos(root):
    repos = []
    for dirpath, dirnames, filenames in os.walk(root):
        if ".git" in dirnames or ".git" in filenames:
            repos.append(dirpath)
            dirnames[:] = []
            continue
        dirnames[:] = [x for x in dirnames if x not in ("node_modules", ".git", ".venv", "venv", "target")
                       and not x.startswith(".Trash")]
    return sorted(repos)


