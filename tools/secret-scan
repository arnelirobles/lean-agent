def cmd_scan(args):
    repo, mode, value, use_stdin = os.getcwd(), None, None, False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--repo" and i + 1 < len(args):
            repo, i = args[i + 1], i + 1
        elif a == "--staged":
            mode = a
        elif a in ("--range", "--push-stdin", "--file") and i + 1 < len(args):
            mode, value, i = a, args[i + 1], i + 1
        elif a == "--stdin":
            use_stdin = True
        else:
            print(f"secret-scan: unknown argument {a}", file=sys.stderr)
            return 2
        i += 1
    if os.environ.get("LEAN_SKIP_SECRET_SCAN") == "1":
        return 0
    if mode is None:
        print("secret-scan scan: choose --staged, --range, --push-stdin or --file", file=sys.stderr)
        return 2
    try:
        if mode == "--staged":
            found = scan_staged(repo)
        elif mode == "--range":
            found = scan_range(repo, value)
        elif mode == "--push-stdin":
            found = scan_push_stdin(repo, sys.stdin.read(), value)
        else:
            found = scan_text(sys.stdin.read(), value) if use_stdin else scan_file(value)
    except ScanError as exc:
        print(f"secret-scan: the scan could not run, so nothing was checked: {exc}", file=sys.stderr)
        return 2
    if found:
        what = {"--staged": "the staged changes",
                "--file": value}.get(mode, "the commits being pushed")
        print(message(found, what), file=sys.stderr)
        return 1
    return 0


def cmd_install(args, remove=False):
    fn = uninstall_one if remove else install_one
    force = "--force-shared" in args
    args = [a for a in args if a != "--force-shared"]
    say = lambda s: print(s)  # noqa: E731
    if args[:1] == ["--all"]:
        if len(args) < 2:
            print("secret-scan: --all needs a folder", file=sys.stderr)
            return 2
        repos = find_repos(os.path.expanduser(args[1]))
        done = sum(1 for r in repos if fn(r, say, force))
        print(f"{'removed from' if remove else 'installed in'} {done} of {len(repos)} repositories")
        return 0 if done == len(repos) else 1
    try:
        return 0 if fn(os.path.expanduser(args[0]) if args else os.getcwd(), say, force) else 1
    except ScanError as exc:
        print(f"secret-scan: {exc}", file=sys.stderr)
        return 2


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    if argv[0] == "scan":
        return cmd_scan(argv[1:])
    if argv[0] in ("install", "uninstall"):
        return cmd_install(argv[1:], remove=argv[0] == "uninstall")
    print(f"secret-scan: unknown command {argv[0]}", file=sys.stderr)
    return 2




def fake_keys():
    """Fake keys built from pieces, so this file never holds a literal key-shaped string."""
    a, b = "A" * 12, "b" * 36
    return {
        "google-api-key (AIza)": "AI" + "za" + "Sy" + "0" * 33,
        "github-token (ghp_/gho_/ghu_/ghs_/ghr_)": "gh" + "p_" + b,
        "github-fine-grained-token (github_pat_)": "github" + "_pat_" + "X" * 30,
        "aws-access-key-id (AKIA)": "AK" + "IA" + "Z" * 16,
        "slack-token (xox)": "xo" + "xb-" + "1234567890-abcdefgh",
        "stripe-live-key (sk_live_/rk_live_)": "sk" + "_live_" + "a1" * 12,
        "npm-token (npm_)": "np" + "m_" + b,
        "private-key-block": "-----BEGIN " + "RSA PRIVATE" + " KEY-----",
