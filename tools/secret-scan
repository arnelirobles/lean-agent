#!/usr/bin/env python3
"""Find keys and tokens in the lines a commit adds, and keep them out of git.

One scanner for the Claude hook (hooks/secret-scan.py) and for the git
pre-commit and pre-push hooks it installs, so a commit from a terminal is
checked the same way as one an agent makes.

  secret-scan scan [--repo DIR] --staged        added lines of the staged diff
  secret-scan scan [--repo DIR] --all           staged and unstaged (git commit -a)
  secret-scan scan [--repo DIR] --range A..B    added lines of a commit range
  secret-scan scan [--repo DIR] --unpushed      commits on no remote yet
  secret-scan scan --push-stdin REMOTE          a pre-push hook's stdin
  secret-scan scan --file PATH [--stdin]        one file, or text on stdin as PATH
  secret-scan install [--force-shared] [REPO]   pre-commit and pre-push hooks in one repo
  secret-scan install [--force-shared] --all DIR  the same in every git repo under DIR
  secret-scan uninstall [REPO] | --all DIR      take them out, restore what was chained

Exit 0 clean, 1 on a finding, 2 when the scan could not run (a git error, a
bad range, a timeout). The git hooks block on both 1 and 2. Output is one line
per finding, "path:line  pattern", and never the value.

A line containing `allow-secret` is skipped, that line only.
gitleaks: when `gitleaks` is on PATH its rules run too, once per scan, on top
of the built in patterns. If it fails or runs out of time that is printed and
the built in result stands.
Binary files are out of scope (a NUL in the first 4 KB, or a binary diff).
  LEAN_SKIP_SECRET_SCAN=1       turn the scan off (git hooks and Claude hook)
  LEAN_SECRET_SCAN_TIMEOUT      seconds gitleaks may take in one scan (default 20)
  LEAN_SECRET_SCAN_HOME         where install keeps its copy of this script
                                (default ~/.local/share/lean/secret-scan)
  secret-scan --self-test
"""
import hashlib
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time

MARKER = "allow-secret"
CHUNK = 1 << 20
MAX_LINE = 16 << 20
GITLEAKS_MAX_BYTES = 20 << 20
GIT_TIMEOUT = 120


class ScanError(Exception):
    """The scan could not run. Never treated as a clean scan."""


# patterns ---------------------------------------------------------------

AZURE_RUN = re.compile(r"(?<![A-Za-z0-9])[a-z2-7]{52}(?![A-Za-z0-9])")
AZURE_CONTEXT = re.compile(
    r"(?i)(?:pat|token|devops|azure|ado|accesstoken|password)[\w.-]{0,40}[\"']?\s*[:=]\s*[\"']?$")


def azure_pat(line):
    """52 base32 characters next to a name that says token. The run is found first, then the
    120 characters before it are checked, so the cost stays linear in the line."""
    for m in AZURE_RUN.finditer(line):
        if AZURE_CONTEXT.search(line[max(0, m.start() - 120):m.start()]):
            return True
    return False


PATTERNS = [
    ("google-api-key (AIza)", re.compile(r"AIza[0-9A-Za-z_-]{35}")),
    ("github-token (ghp_/gho_/ghu_/ghs_/ghr_)", re.compile(r"gh[pousr]_[A-Za-z0-9]{36,}")),
    ("github-fine-grained-token (github_pat_)", re.compile(r"github_pat_[A-Za-z0-9_]{22,}")),
    ("aws-access-key-id (AKIA)", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("slack-token (xox)", re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("stripe-live-key (sk_live_/rk_live_)", re.compile(r"[sr]k_live_[0-9A-Za-z]{20,}")),
    ("npm-token (npm_)", re.compile(r"npm_[A-Za-z0-9]{36}")),
    ("private-key-block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("azure-devops-pat", azure_pat),
]


def scan_line(line):
    """Names of the patterns a line matches, [] when it carries allow-secret."""
    if MARKER in line:
        return []
    return [name for name, rx in PATTERNS
            if (rx(line) if callable(rx) else rx.search(line))]


# collector: patterns per line, one gitleaks run per scan ------------------

WARNINGS = []


def warn(text):
    WARNINGS.append(text)
    print("secret-scan: " + text, file=sys.stderr)


def gitleaks_path():
    return shutil.which("gitleaks")


def timeout_seconds():
    try:
        return max(1.0, float(os.environ.get("LEAN_SECRET_SCAN_TIMEOUT") or 20))
    except ValueError:
        return 20.0


def run_limited(argv, text, limit, cwd):
    """Run a command in its own process group; kill the group at the limit. Returns (rc, stderr)
    or raises subprocess.TimeoutExpired."""
    proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, errors="replace", cwd=cwd, start_new_session=True)
    try:
        _out, err = proc.communicate(text, timeout=limit)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()
        raise
    return proc.returncode, err


class Collector:
    """Gathers findings from every line fed to it. Lines also go to gitleaks, once, in finish()."""

    def __init__(self):
        self.found = set()
        self.lines = []  # (path, number, text) for gitleaks
        self.bytes = 0
        self.skipped_big = False
        self.exe = gitleaks_path()
        self.deadline = time.monotonic() + timeout_seconds()

    def feed(self, path, num, line):
        for name in scan_line(line):
            self.found.add((path, num, name))
        if self.exe and MARKER not in line:
            if self.bytes + len(line) > GITLEAKS_MAX_BYTES:
                self.skipped_big = True
            else:
                self.bytes += len(line) + 1
                self.lines.append((path, num, line))

    def feed_text(self, path, text):
        for n, line in enumerate(text.splitlines(), 1):
            self.feed(path, n, line)

    def finish(self):
        if self.exe and self.lines:
            self.run_gitleaks()
        if self.skipped_big:
            warn("gitleaks skipped part of a very large scan; the built in patterns covered all of it")
        return sorted(self.found, key=lambda f: (f[0], f[1], f[2]))

    def run_gitleaks(self):
        body = "\n".join(t.replace("\r", "") for _p, _n, t in self.lines) + "\n"
        with tempfile.TemporaryDirectory() as tmp:
            report = os.path.join(tmp, "r.json")
            tail = ["--report-format", "json", "--report-path", report, "--redact", "--no-banner",
                    "--exit-code", "0"]
            reason = "no report"
            for argv in ([self.exe, "stdin"] + tail, [self.exe, "detect", "--no-git", "--pipe"] + tail):
                left = self.deadline - time.monotonic()
                if left <= 0:
                    warn("gitleaks ran out of time, built in patterns only")
                    return
                try:
                    rc, err = run_limited(argv, body, left, tmp)
                except subprocess.TimeoutExpired:
                    warn(f"gitleaks timed out after {timeout_seconds():g}s, built in patterns only "
                         "(LEAN_SECRET_SCAN_TIMEOUT sets the limit)")
                    return
                except OSError as exc:
                    reason = str(exc)
                    break
                if os.path.exists(report):
                    try:
                        with open(report, encoding="utf-8") as f:
                            data = json.load(f) or []
                    except ValueError:
                        reason = "unreadable report"
                        continue
                    for item in data:
                        start = item.get("StartLine")
                        if isinstance(start, int) and 1 <= start <= len(self.lines):
                            path, num, _t = self.lines[start - 1]
                            if not any(f[0] == path and f[1] == num for f in self.found):
                                self.found.add((path, num, "gitleaks:" + str(item.get("RuleID") or "rule")))
                    return
                reason = (err.strip().splitlines() or [f"exit {rc}"])[-1][:200]
            warn(f"gitleaks failed ({reason}), built in patterns only")


def finishing(col, fn):
    """Run fn(collector); with no collector given, make one and return its findings."""
    own = col is None
    col = col or Collector()
    fn(col)
    return col.finish() if own else None


# git ----------------------------------------------------------------------

SAFE_C = ["-c", "core.fsmonitor=false", "-c", "core.pager=cat", "-c", "diff.external=",
          "-c", "color.ui=false"]
DIFF_ARGS = ["-U0", "--no-color", "--no-ext-diff", "--no-textconv", "--no-renames",
             "--ignore-submodules=all", "--src-prefix=a/", "--dst-prefix=b/"]


class Repo:
    """Where git runs: a directory, and optionally --git-dir and --work-tree."""

    def __init__(self, cwd, git_dir=None, work_tree=None):
        self.cwd, self.git_dir, self.work_tree = cwd, git_dir, work_tree
        self._filters = None


def as_repo(repo):
    return repo if isinstance(repo, Repo) else Repo(repo)


def raw_git(repo, extra, args, check=True, input=None):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", GIT_PAGER="cat")
    env.pop("GIT_EXTERNAL_DIFF", None)
    argv = ["git"]
    if repo.git_dir:
        argv += ["--git-dir", repo.git_dir]
    if repo.work_tree:
        argv += ["--work-tree", repo.work_tree]
    argv += SAFE_C + extra + list(args)
    if not os.path.isdir(repo.cwd or "."):
        raise ScanError(f"{repo.cwd} is not a directory")
    try:
        p = subprocess.run(argv, cwd=repo.cwd or ".", capture_output=True, input=input, env=env,
                           timeout=GIT_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as exc:
        raise ScanError(f"git did not run: {exc}")
    out = p.stdout.decode("utf-8", "replace")
    if p.returncode != 0:
        if not check:
            return None
        err = p.stderr.decode("utf-8", "replace").strip().splitlines()
        raise ScanError("git " + " ".join(list(args)[:3]) + " failed: " + (err[-1] if err else f"exit {p.returncode}"))
    return out


def filter_overrides(repo):
    """A repo's own filter.NAME.clean/smudge/process commands run when git diff compares a work tree
    file. Replace each configured filter with a harmless one."""
    if repo._filters is None:
        out = raw_git(repo, [], ["config", "--get-regexp", r"^filter\..+\.(clean|smudge|process)$"],
                      check=False) or ""
        names = set()
        for row in out.splitlines():
            key = row.split(None, 1)[0]
            m = re.fullmatch(r"filter\.(.+)\.(?:clean|smudge|process)", key, re.I)
            if m:
                names.add(m.group(1))
        args = []
        for name in sorted(names):
            args += ["-c", f"filter.{name}.clean=cat", "-c", f"filter.{name}.smudge=cat",
                     "-c", f"filter.{name}.process=", "-c", f"filter.{name}.required=false"]
        repo._filters = args
    return repo._filters


def git(repo, *args, check=True, input=None):
    """stdout of a git command. With check, a failure raises ScanError; without, it returns None."""
    repo = as_repo(repo)
    p = raw_git(repo, filter_overrides(repo), args, check=check, input=input)
    return p


def is_repo(repo):
    return git(repo, "rev-parse", "--git-dir", check=False) is not None


def toplevel(repo):
    repo = as_repo(repo)
    top = git(repo, "rev-parse", "--show-toplevel", check=False)
    return (top or "").strip() or (repo.work_tree or repo.cwd)


def parse_diff(text):
    """Added lines of a -U0 diff or log -p output as (path, line number, text). Hunk line counts say
    which lines are content, so an added line that starts with '++ ' is not read as a file header."""
    path, new, old, n = None, 0, 0, 0
    for raw in text.split("\n"):
        if new > 0 or old > 0:
            if raw.startswith("+"):
                new -= 1
                if path:
                    yield path, n, raw[1:]
                n += 1
                continue
            if raw.startswith("-"):
                old -= 1
                continue
            if raw.startswith("\\"):
                continue
            new = old = 0
        if raw.startswith("diff --git ") or raw.startswith("diff --cc ") or raw.startswith("diff --combined "):
            path = None
        elif raw.startswith("+++ "):
            target = raw[4:].rstrip("\t").strip()
            if target == "/dev/null":
                path = None
            else:
                target = target.strip('"')
                path = target[2:] if target[:2] == "b/" else target
        elif raw.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", raw)
            if m:
                old = int(m.group(1)) if m.group(1) is not None else 1
                n = int(m.group(2))
                new = int(m.group(3)) if m.group(3) is not None else 1


def feed_diff(col, text):
    for path, num, line in parse_diff(text):
        col.feed(path, num, line)


def head_or_empty(repo):
    if git(repo, "rev-parse", "--verify", "-q", "HEAD", check=False) is not None:
        return "HEAD"
    return git(repo, "hash-object", "-t", "tree", "/dev/null").strip()


def scan_staged(repo, col=None):
    return finishing(col, lambda c: feed_diff(c, git(repo, "diff", "--cached", *DIFF_ARGS)))


def scan_worktree(repo, paths=None, untracked=False, staged=False, col=None):
    """Added lines against HEAD: the work tree, which holds the index too. paths limits it
    (git commit a.txt). staged adds the index alone (git commit -i a.txt)."""
    def run(c):
        extra = ["--", *paths] if paths else []
        feed_diff(c, git(repo, "diff", head_or_empty(repo), *DIFF_ARGS, *extra))
        if staged:
            feed_diff(c, git(repo, "diff", "--cached", *DIFF_ARGS))
        if untracked:
            top = toplevel(repo)
            names = git(repo, "ls-files", "-o", "--exclude-standard", "--full-name", "-z", *extra)
            for rel in filter(None, names.split("\0")):
                feed_file(c, os.path.join(top, rel), rel)
    return finishing(col, run)


def log_args(*revs):
    return ["log", "-p", "--format=", *DIFF_ARGS, *revs]


def scan_revs(repo, revs, remote=None, unknown=False, col=None):
    """Added lines of the commits reachable from revs that the target remote does not have. remote is
    a configured remote name; unknown means the target is not a configured remote, so the whole
    history of revs is scanned."""
    def run(c):
        if not revs:
            return
        extra = []
        if not unknown:
            extra = ["--not", f"--remotes={remote}" if remote else "--remotes"]
        feed_diff(c, git(repo, *log_args(*revs, *extra)))
    return finishing(col, run)


def scan_range(repo, rng, col=None):
    return finishing(col, lambda c: feed_diff(c, git(repo, *log_args(rng))))


def scan_unpushed(repo, col=None):
    return scan_revs(repo, ["HEAD"], None, col=col)


def feed_file(col, path, label=None):
    """Scan a regular file in chunks. Symlinks, devices and binary files (a NUL in the first 4 KB)
    are skipped. The file is opened without following a link."""
    label = label or path
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        return
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            return
        if b"\0" in f.read(4096):
            return
        f.seek(0)
        buf, n = b"", 0
        while True:
            chunk = f.read(CHUNK)
            if not chunk:
                break
            parts = (buf + chunk).split(b"\n")
            buf = parts.pop()
            if len(buf) > MAX_LINE:
                parts.append(buf)
                buf = b""
            for part in parts:
                n += 1
                col.feed(label, n, part.decode("utf-8", "replace"))
        if buf:
            col.feed(label, n + 1, buf.decode("utf-8", "replace"))


def scan_file(path, label=None, col=None):
    return finishing(col, lambda c: feed_file(c, path, label))


def scan_text(text, path, col=None):
    return finishing(col, lambda c: c.feed_text(path, text))


# push planning ----------------------------------------------------------

PUSH_VALUE_OPTS = {"--repo", "--receive-pack", "--exec", "-o", "--push-option"}


def current_branch(repo):
    return (git(repo, "symbolic-ref", "-q", "--short", "HEAD", check=False) or "").strip()


def resolve_remote(repo, name):
    """(configured remote name, known). A URL or path that matches a configured remote gives that
    remote; any other value is not known."""
    remotes = (git(repo, "remote", check=False) or "").split()
    if name in remotes:
        return name, True
    for r in remotes:
        urls = (git(repo, "remote", "get-url", "--all", r, check=False) or "").split()
        if name in urls:
            return r, True
    return name, False


def default_push_remote(repo):
    branch = current_branch(repo)
    for key in ((f"branch.{branch}.pushRemote",) if branch else ()) + ("remote.pushDefault",) + (
            (f"branch.{branch}.remote",) if branch else ()):
        value = (git(repo, "config", "--get", key, check=False) or "").strip()
        if value:
            return value
    return "origin"


def plan_push(repo, args):
    """What `git push ARGS` would send: (revs, remote name, known) or None for nothing to scan.
    Raises ScanError when it cannot work out what is pushed."""
    flags, pos, i = set(), [], 0
    remote_opt = None
    while i < len(args):
        a = args[i]
        if a == "--":
            pos += args[i + 1:]
            break
        if a in PUSH_VALUE_OPTS:
            if a == "--repo" and i + 1 < len(args):
                remote_opt = args[i + 1]
            i += 2
            continue
        if a.startswith("--repo="):
            remote_opt = a.split("=", 1)[1]
        elif a.startswith("-") and a != "-":
            if a.startswith("--"):
                flags.add(a.split("=", 1)[0])
            else:
                flags.update("-" + ch for ch in a[1:])
        else:
            pos.append(a)
        i += 1
    if flags & {"--dry-run", "-n", "--delete", "-d"}:
        return None
    target = remote_opt or (pos.pop(0) if pos else default_push_remote(repo))
    if remote_opt and pos and pos[0] == remote_opt:
        pos.pop(0)
    name, known = resolve_remote(repo, target)
    revs = []
    if "--mirror" in flags:
        revs.append("--all")
    if "--all" in flags or "--branches" in flags:
        revs.append("--branches")
    if "--tags" in flags:
        revs.append("--tags")
    refspecs = list(pos)
    if not refspecs and known:
        refspecs = (git(repo, "config", "--get-all", f"remote.{name}.push", check=False) or "").split()
    sources, j = [], 0
    while j < len(refspecs):
        spec = refspecs[j]
        if spec == "tag" and j + 1 < len(refspecs):
            sources.append("refs/tags/" + refspecs[j + 1])
            j += 2
            continue
        spec = spec.lstrip("+")
        src = spec.split(":", 1)[0]
        j += 1
        if not src:
            continue  # a delete
        if "*" in src:
            names = (git(repo, "for-each-ref", "--format=%(refname)", src, check=False) or "").split()
            if not names:
                raise ScanError(f"cannot work out what the refspec {spec} pushes")
            sources += names
            continue
        sources.append(src)
    for src in sources:
        if git(repo, "rev-parse", "--verify", "-q", src + "^{commit}", check=False) is None:
            raise ScanError(f"cannot work out what {src} pushes, so it was not scanned")
    revs += sources
    if not revs and not refspecs:
        if (git(repo, "config", "--get", "push.default", check=False) or "").strip() == "matching":
            revs.append("--branches")
        else:
            revs.append("HEAD")
    return list(dict.fromkeys(revs)), name, known


def scan_push(repo, args, col=None):
    plan = plan_push(repo, args)
    if plan is None:
        return finishing(col, lambda c: None)
    revs, name, known = plan
    return scan_revs(repo, revs, name, unknown=not known, col=col)


def scan_push_stdin(repo, stdin_text, remote_arg, col=None):
    """A pre-push hook's stdin: 'local_ref local_sha remote_ref remote_sha' per ref."""
    def run(c):
        name, known = resolve_remote(repo, remote_arg or "")
        for row in stdin_text.splitlines():
            parts = row.split()
            if len(parts) < 4 or set(parts[1]) == {"0"}:
                continue
            local, remote = parts[1], parts[3]
            have = set(remote) != {"0"} and git(repo, "cat-file", "-e", remote + "^{commit}", check=False) is not None
            if have:
                scan_range(repo, f"{remote}..{local}", col=c)
            else:
                scan_revs(repo, [local], name, unknown=not known, col=c)
    return finishing(col, run)


# output -------------------------------------------------------------------

def render(found):
    """One line per finding. The value never appears."""
    return "\n".join(f"{p}:{n}  {name}" for p, n, name in sorted(set(found), key=lambda f: (f[0], f[1], f[2])))


def message(found, what):
    return (f"Blocked by lean-agent: {what} contains what looks like a key or token. "
            "Put it in a gitignored .env.local or a pipeline secret, never in git. "
            "Add allow-secret to a line that is a test fixture. Found:\n" + render(found))


# git hook installer -------------------------------------------------------

OURS = "# lean-agent secret-scan"
HASH = "# secret-scan-hash: "
HOOKS = ("pre-commit", "pre-push")


def home():
    return os.environ.get("LEAN_SECRET_SCAN_HOME") or os.path.expanduser("~/.local/share/lean/secret-scan")


def shq(text):
    """Quote for sh: single quotes, so $, backticks and double quotes in a path stay text."""
    return "'" + text.replace("'", "'\\''") + "'"


def hooks_location(repo):
    """(hooks dir, reason it is shared or None). A hooks path from global or system config is shared
    by every repository. A repo path inside the work tree is usually committed."""
    repo = as_repo(repo)
    top = git(repo, "rev-parse", "--show-toplevel", check=False)
    if top is None:
        return None, None
    top = top.strip()
    out = (git(repo, "config", "--show-scope", "--get", "core.hooksPath", check=False) or "").strip()
    if out:
        scope, _, value = out.partition("\t")
        value = os.path.expanduser(value)
        path = value if os.path.isabs(value) else os.path.join(top, value)
        if scope in ("global", "system"):
            return path, f"core.hooksPath comes from {scope} git config, so {path} is shared by every repository"
        inside = os.path.realpath(path).startswith(os.path.realpath(top) + os.sep)
        if inside:
            return path, f"core.hooksPath points inside the work tree ({path}), where the hook, with an absolute path to your home, would be committed"
        return path, None
    gp = git(repo, "rev-parse", "--git-path", "hooks").strip()
    return (gp if os.path.isabs(gp) else os.path.join(top, gp)), None


def hook_text(name, copy, chained):
    q = shq(copy)
    old = '"$0.pre-secret-scan"'
    lines = ["#!/bin/sh",
             f"{OURS}: checks {'staged' if name == 'pre-commit' else 'pushed'} lines for keys and tokens. "
             "Remove with: secret-scan uninstall",
             "@@HASH@@",
             "unset LEAN_SS_SKIP",
             '[ "$LEAN_SKIP_SECRET_SCAN" = 1 ] && LEAN_SS_SKIP=1',
             f"if [ -z \"$LEAN_SS_SKIP\" ] && [ ! -f {q} ]; then "
             f"printf 'secret-scan: %s is missing, not scanning\\n' {q} >&2; LEAN_SS_SKIP=1; fi"]
    if name == "pre-push":
        lines.append("input=$(cat)")
        run_old = f'[ -x {old} ] && {{ printf \'%s\\n\' "$input" | {old} "$@"; exit $?; }}'
        lines += ['if [ -n "$LEAN_SS_SKIP" ]; then'] + ([f"  {run_old}"] if chained else []) + ["  exit 0", "fi",
                  f"printf '%s\\n' \"$input\" | python3 {q} scan --push-stdin \"$1\" || exit 1"]
        if chained:
            lines.append(run_old)
    else:
        run_old = f'[ -x {old} ] && exec {old} "$@"'
        lines += ['if [ -n "$LEAN_SS_SKIP" ]; then'] + ([f"  {run_old}"] if chained else []) + ["  exit 0", "fi",
                  f"python3 {q} scan --staged || exit 1"]
        if chained:
            lines.append(run_old)
    lines.append("exit 0")
    return lines


def digest(lines):
    return hashlib.sha256("\n".join(l for l in lines if not l.startswith(HASH)).encode()).hexdigest()


def render_hook(name, copy, chained):
    lines = hook_text(name, copy, chained)
    lines[lines.index("@@HASH@@")] = HASH + digest([l for l in lines if l != "@@HASH@@"])
    return "\n".join(lines) + "\n"


def hook_state(path):
    """'absent', 'foreign' (not ours), 'ours' (as we wrote it) or 'edited' (ours, since changed)."""
    if not os.path.lexists(path):
        return "absent"
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().split("\n")
    except OSError:
        return "foreign"
    if lines and lines[-1] == "":
        lines.pop()
    if not any(l.startswith(OURS) for l in lines):
        return "foreign"
    stored = [l[len(HASH):] for l in lines if l.startswith(HASH)]
    body = [l for l in lines if not l.startswith(HASH)]
    return "ours" if stored and stored[0] == digest(body) else "edited"


def install_one(repo, out, force=False):
    """True when both hooks are in place; False (with the reason printed) otherwise."""
    d, shared = hooks_location(repo)
    if d is None:
        out(f"skip {repo}: not a git repository")
        return False
    if shared and not force:
        out(f"refused {repo}: {shared}. Use --force-shared to install there anyway.")
        return False
    os.makedirs(home(), exist_ok=True)
    copy = os.path.join(home(), "secret-scan")
    shutil.copyfile(os.path.realpath(__file__), copy)
    os.chmod(copy, 0o755)
    os.makedirs(d, exist_ok=True)
    ok = True
    for name in HOOKS:
        path = os.path.join(d, name)
        old = path + ".pre-secret-scan"
        state = hook_state(path)
        if state == "edited":
            out(f"kept {path}: it was edited after install, so it was not rewritten (delete it and install again)")
            ok = False
            continue
        if state == "foreign":
            if os.path.lexists(old):
                out(f"skip {path}: a hook is there and {old} already holds another one")
                ok = False
                continue
            os.rename(path, old)
            out(f"chained {path}: the existing hook still runs after the scan")
        with open(path, "w", encoding="utf-8") as f:
            f.write(render_hook(name, copy, os.path.lexists(old)))
        os.chmod(path, 0o755)
    out(f"{'installed' if ok else 'partly installed'} {d}")
    return ok


def uninstall_one(repo, out, force=False):
    d, shared = hooks_location(repo)
    if d is None:
        out(f"skip {repo}: not a git repository")
        return False
    if shared and not force:
        out(f"refused {repo}: {shared}. Use --force-shared to remove them there anyway.")
        return False
    ok = True
    for name in HOOKS:
        path = os.path.join(d, name)
        old = path + ".pre-secret-scan"
        state = hook_state(path)
        if state == "ours":
            os.remove(path)
            if os.path.lexists(old):
                os.rename(old, path)
        elif state == "edited":
            out(f"kept {path}: it was edited after install (remove it by hand)")
            ok = False
        elif state == "foreign":
            out(f"left {path}: not installed by secret-scan")
        if state in ("absent", "foreign") and os.path.lexists(old):
            out(f"orphan {old}: no secret-scan hook sits in front of it, left alone")
            ok = False
    out(f"{'removed from' if ok else 'partly removed from'} {d}")
    return ok


def find_repos(root):
    repos = []
    for dirpath, dirnames, filenames in os.walk(root):
        if ".git" in dirnames or ".git" in filenames:
            repos.append(dirpath)
            dirnames[:] = []
            continue
        dirnames[:] = [x for x in dirnames if x not in ("node_modules", ".git", ".venv", "venv", "target")
                       and not x.startswith(".Trash")]
    return sorted(repos)


# cli ----------------------------------------------------------------------

def cmd_scan(args):
    repo, mode, value, use_stdin = os.getcwd(), None, None, False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--repo" and i + 1 < len(args):
            repo, i = args[i + 1], i + 1
        elif a in ("--staged", "--all", "--unpushed"):
            mode = a
        elif a in ("--range", "--push-stdin", "--file") and i + 1 < len(args):
            mode, value, i = a, args[i + 1], i + 1
        elif a == "--stdin":
            use_stdin = True
        else:
            print(f"secret-scan: unknown argument {a}", file=sys.stderr)
            return 2
        i += 1
    if os.environ.get("LEAN_SKIP_SECRET_SCAN") == "1":
        return 0
    if mode is None:
        print("secret-scan scan: choose --staged, --all, --range, --unpushed, --push-stdin or --file", file=sys.stderr)
        return 2
    try:
        if mode == "--staged":
            found = scan_staged(repo)
        elif mode == "--all":
            found = scan_worktree(repo)
        elif mode == "--unpushed":
            found = scan_unpushed(repo)
        elif mode == "--range":
            found = scan_range(repo, value)
        elif mode == "--push-stdin":
            found = scan_push_stdin(repo, sys.stdin.read(), value)
        else:
            found = scan_text(sys.stdin.read(), value) if use_stdin else scan_file(value)
    except ScanError as exc:
        print(f"secret-scan: the scan could not run, so nothing was checked: {exc}", file=sys.stderr)
        return 2
    if found:
        what = {"--staged": "the staged changes", "--all": "the changes",
                "--file": value}.get(mode, "the commits being pushed")
        print(message(found, what), file=sys.stderr)
        return 1
    return 0


def cmd_install(args, remove=False):
    fn = uninstall_one if remove else install_one
    force = "--force-shared" in args
    args = [a for a in args if a != "--force-shared"]
    say = lambda s: print(s)  # noqa: E731
    if args[:1] == ["--all"]:
        if len(args) < 2:
            print("secret-scan: --all needs a folder", file=sys.stderr)
            return 2
        repos = find_repos(os.path.expanduser(args[1]))
        done = sum(1 for r in repos if fn(r, say, force))
        print(f"{'removed from' if remove else 'installed in'} {done} of {len(repos)} repositories")
        return 0 if done == len(repos) else 1
    try:
        return 0 if fn(os.path.expanduser(args[0]) if args else os.getcwd(), say, force) else 1
    except ScanError as exc:
        print(f"secret-scan: {exc}", file=sys.stderr)
        return 2


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    if argv[0] == "scan":
        return cmd_scan(argv[1:])
    if argv[0] in ("install", "uninstall"):
        return cmd_install(argv[1:], remove=argv[0] == "uninstall")
    print(f"secret-scan: unknown command {argv[0]}", file=sys.stderr)
    return 2




