        commit(r7, "c1")
        write(r7, "k.txt", npm + "\n")
        commit(r7, "c2")
        write(r7, "z.txt", "3\n")
        commit(r7, "c3")
        c1, c2, c3 = sha(r7, "HEAD~2"), sha(r7, "HEAD~1"), sha(r7)
        check("existing ref, remote at c1, sees the key in c2",
              len(scan_push_stdin(r7, f"refs/heads/m {c3} refs/heads/m {c1}\n", "origin")) > 0, True)
        check("existing ref, remote at c2, range is c2..c3 and clean",
              scan_push_stdin(r7, f"refs/heads/m {c3} refs/heads/m {c2}\n", "origin"), [])
        check("a missing remote sha falls back to the remote's refs",
              len(scan_push_stdin(r7, f"refs/heads/m {c3} refs/heads/m {'1' * 40}\n", "origin")) > 0, True)
        check("a delete row is skipped", scan_push_stdin(r7, f"(delete) {zero} refs/heads/m {c2}\n", "origin"), [])
        hook = os.path.join(r2, ".git", "hooks", "pre-push")
        p = sh("sh", hook, "pub", pub, inp=f"refs/heads/main {'2' * 40} refs/heads/main {zero}\n", cwd=r2)
        check("pre-push hook blocks when the scan cannot run", p.returncode != 0, True)
        check("and says nothing was checked", "could not run" in p.stderr, True)
        check("push passes when asked to skip",
              sh("git", "-C", r2, "push", "-q", "pub", "HEAD:refs/heads/main", env={"LEAN_SKIP_SECRET_SCAN": "1"}).returncode, 0)

        # chaining and uninstall (17)
        r3 = repo("r3")
        hook = os.path.join(r3, ".git", "hooks", "pre-commit")
        os.makedirs(os.path.dirname(hook), exist_ok=True)
        oldlog = os.path.join(tmp, "oldlog")
        write(r3, ".git/hooks/pre-commit", f"#!/bin/sh\necho ran-old-hook >> '{oldlog}'\nexit 0\n")
        os.chmod(hook, 0o755)
        sh("python3", here, "install", r3)
        write(r3, "a.txt", "a\n")
        sh("git", "-C", r3, "add", ".")
        check("chained commit passes", sh("git", "-C", r3, "commit", "-qm", "x").returncode, 0)
        check("old hook still ran", os.path.exists(oldlog), True)
        p = sh("python3", here, "install", r3)
        check("reinstall keeps the chained hook", os.path.exists(hook + ".pre-secret-scan"), True)
        check("reinstall reports installed", p.returncode == 0 and "partly" not in p.stdout, True)
        write(r3, "k.txt", npm + "\n")
        sh("git", "-C", r3, "add", ".")
        check("chained hook still blocks", sh("git", "-C", r3, "commit", "-qm", "k").returncode != 0, True)
        sh("python3", here, "uninstall", r3)
        with open(hook) as f:
            body = f.read()
        check("uninstall restores the old hook", "ran-old-hook" in body and OURS not in body, True)
        check("uninstall removes pre-push", os.path.exists(os.path.join(r3, ".git", "hooks", "pre-push")), False)
        # a user's edit to our hook is kept
        sh("python3", here, "install", r3)
        with open(hook, "a") as f:
            f.write("echo my-edit\n")
        p = sh("python3", here, "uninstall", r3)
        check("an edited hook is kept", os.path.exists(hook) and "my-edit" in open(hook).read(), True)
        check("and uninstall says so", "kept" in p.stdout and p.returncode == 1, True)
        p = sh("python3", here, "install", r3)
        check("reinstall does not overwrite an edit and reports partly installed", "partly installed" in p.stdout and p.returncode == 1
              and "my-edit" in open(hook).read(), True)
        # skip then installed must not both be printed as success
        r8 = repo("r8")
        for h in ("pre-commit",):
            write(r8, f".git/hooks/{h}", "#!/bin/sh\nexit 0\n")
            write(r8, f".git/hooks/{h}.pre-secret-scan", "#!/bin/sh\nexit 0\n")
            os.chmod(os.path.join(r8, ".git", "hooks", h), 0o755)
        p = sh("python3", here, "install", r8)
        check("a skipped hook is reported as partial", "skip" in p.stdout and "partly installed" in p.stdout and p.returncode == 1, True)
        r9 = repo("r9")
        write(r9, ".git/hooks/pre-commit.pre-secret-scan", "#!/bin/sh\nexit 0\n")
        p = sh("python3", here, "uninstall", r9)
        check("an orphaned .pre-secret-scan is reported", "orphan" in p.stdout, True)

        # 16: shared and tracked hooks paths are refused
        r4 = repo("r4")
        sh("git", "-C", r4, "config", "core.hooksPath", ".githooks")
        p = sh("python3", here, "install", r4)
        check("a hooksPath inside the work tree is refused", p.returncode == 1 and "refused" in p.stdout, True)
        check("nothing written", os.path.exists(os.path.join(r4, ".githooks", "pre-commit")), False)
        p = sh("python3", here, "install", "--force-shared", r4)
        check("--force-shared installs there", os.path.exists(os.path.join(r4, ".githooks", "pre-commit")), True)
        outside_hooks = os.path.join(tmp, "private-hooks")
        r10 = repo("r10")
        sh("git", "-C", r10, "config", "core.hooksPath", outside_hooks)
        sh("python3", here, "install", r10)
        check("a local hooksPath outside the tree is respected", os.path.exists(os.path.join(outside_hooks, "pre-commit")), True)
        sh("git", "config", "--global", "core.hooksPath", os.path.join(tmp, "shared-hooks"))
        r11 = repo("r11g")
        p = sh("python3", here, "install", r11)
        check("a global hooksPath is refused", p.returncode == 1 and "shared by every repository" in p.stdout, True)
        p = sh("python3", here, "uninstall", r11)
        check("uninstall is refused there too", "refused" in p.stdout, True)
        sh("python3", here, "install", "--force-shared", r11)
        check("--force-shared installs into the shared dir", os.path.exists(os.path.join(tmp, "shared-hooks", "pre-commit")), True)
        sh("git", "config", "--global", "--unset", "core.hooksPath")

        # 15: odd characters in the copy path do not break the hook
        odd = os.path.join(tmp, "a\"b$HOME`c'd e")
        r12 = repo("r12")
        write(r12, "a.txt", "a\n")
        commit(r12, "base")
        sh("python3", here, "install", r12, env={"LEAN_SECRET_SCAN_HOME": odd})
        write(r12, "k.txt", npm + "\n")
        sh("git", "-C", r12, "add", ".")
        p = sh("git", "-C", r12, "commit", "-qm", "k", env={"LEAN_SECRET_SCAN_HOME": odd})
        check("a path with quotes, $ and a backtick still blocks cleanly", p.returncode != 0 and "k.txt:1" in p.stderr, True)
        check("and has no shell syntax error", "syntax error" in p.stderr or "not found" in p.stderr, False)

        # --all
        base = os.path.join(tmp, "many")
        for n in ("x", "y/z"):
            os.makedirs(os.path.join(base, n))
            sh("git", "init", "-q", os.path.join(base, n))
        os.makedirs(os.path.join(base, "plain"))
        p = sh("python3", here, "install", "--all", base)
        check("--all installs in every repo", "installed in 2 of 2" in p.stdout, True)
        check("--all hook exists", os.path.exists(os.path.join(base, "y", "z", ".git", "hooks", "pre-push")), True)
        sh("python3", here, "uninstall", "--all", base)
        check("--all uninstalls", os.path.exists(os.path.join(base, "x", ".git", "hooks", "pre-commit")), False)

        # file mode and stdin
        write(tmp, "f.txt", "x " + keys["slack-token (xox)"] + "\n")
        check("--file blocks", sh("python3", here, "scan", "--file", os.path.join(tmp, "f.txt")).returncode, 1)
        check("--stdin blocks", sh("python3", here, "scan", "--file", "n.txt", "--stdin",
                                   inp=keys["slack-token (xox)"]).returncode, 1)

        # 7: gitleaks, once per scan, with a deadline and an honest failure message
        stub = os.path.join(nogl, "gitleaks")
        count = os.path.join(tmp, "gl-count")

        def stub_gitleaks(body):
            with open(stub, "w") as f:
                f.write("#!/bin/sh\n" + body)
            os.chmod(stub, 0o755)

        report = ('while [ $# -gt 0 ]; do [ "$1" = --report-path ] && out=$2; shift; done\n')
        stub_gitleaks(f'cat >/dev/null\necho x >> "{count}"\n' + report
                      + 'printf \'[{"RuleID":"generic-api-key","StartLine":2}]\' > "$out"\n')
        found = scan_text("one\ntwo\nthree\n", "g.txt")
        check("gitleaks findings are added", found, [("g.txt", 2, "gitleaks:generic-api-key")])
        both = scan_text("one\n" + npm + "\n", "g.txt")
        check("same line reported once", [(f[0], f[1]) for f in both], [("g.txt", 2)])
        r13 = repo("r13")
        write(r13, "ok.txt", "x\n")
        commit(r13, "base")
        for i in range(300):
            write(r13, f"d/f{i}.txt", f"file {i}\nline\n")
        if os.path.exists(count):
            os.remove(count)
        scan_worktree(r13, untracked=True)
        check("300 files, one gitleaks run", len(open(count).read().split()), 1)
        os.environ["LEAN_SECRET_SCAN_TIMEOUT"] = "1"
        stub_gitleaks('exec sleep 6\n')
        t0 = time.monotonic()
        del WARNINGS[:]
        found = scan_text("a\n" + npm + "\n", "slow.txt")
        check("a slow gitleaks is cut off and the pattern result stands", [f[1] for f in found], [2])
        check("it did not wait for it", time.monotonic() - t0 < 5, True)
        check("and it says so", any("timed out" in w for w in WARNINGS), True)
        os.environ.pop("LEAN_SECRET_SCAN_TIMEOUT")
        stub_gitleaks('echo "boom: bad flag" >&2\nexit 3\n')
        del WARNINGS[:]
        found = scan_text("a\n" + npm + "\n", "f.txt")
        check("a failing gitleaks keeps the pattern result", [f[1] for f in found], [2])
        check("and says it failed", any("gitleaks failed" in w and "boom" in w for w in WARNINGS), True)
        os.remove(stub)
        if real_gitleaks:
            os.symlink(real_gitleaks, stub)
            import random
            rnd = random.Random(7)
            alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            # a Stripe test key: the built in patterns only cover live keys
            token = "sk" + "_test_" + "".join(rnd.choice(alpha) for _ in range(24))
            del WARNINGS[:]
            found = scan_text("one\ntwo\nx = '" + token + "'\n", "real.txt")
            check("real gitleaks flags a line the patterns miss", [(f[1], f[2].split(":")[0]) for f in found], [(3, "gitleaks")])
            check("real gitleaks ran without a warning", WARNINGS, [])
            check("real gitleaks output hides the value", token in render(found), False)
            os.remove(stub)
        else:
            print("note: gitleaks is not installed, the real-binary check was skipped")
    finally:
        os.environ["PATH"] = saved_path
        shutil.rmtree(tmp, ignore_errors=True)
    print("self-test: ok" if failures == 0 else f"self-test: {failures} failed")
    return 1 if failures else 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    try:
        sys.exit(main(sys.argv[1:]))
    except ScanError as exc:
        print(f"secret-scan: {exc}", file=sys.stderr)
        sys.exit(2)
