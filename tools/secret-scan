        "_gho": "gh" + "o_" + b,
        "_rk": "rk" + "_live_" + "z9" * 12,
        "_a": a,
    }




def self_test():
    global GITLEAKS_MAX_BYTES, public_url
    failures = 0

    def check(name, got, want):
        nonlocal failures
        if got != want:
            print(f"FAIL {name}: got {got!r}, want {want!r}")
            failures += 1

    os.environ.pop("LEAN_SKIP_SECRET_SCAN", None)
    for var in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS"):
        os.environ.pop(var, None)
    keys = fake_keys()
    saved_path = os.environ.get("PATH", "")
    real_public = public_url
    real_gitleaks = shutil.which("gitleaks", path=saved_path) or (
        "/opt/homebrew/bin/gitleaks" if os.path.exists("/opt/homebrew/bin/gitleaks") else None)
    tmp = os.path.realpath(tempfile.mkdtemp(prefix="secret-scan-test-"))
    try:
        # a PATH with no gitleaks, so the pattern tests do not depend on the machine
        nogl = os.path.join(tmp, "nogl")
        os.makedirs(nogl)
        for tool in ("git", "python3", "sh", "bash", "cat", "printf", "touch", "sleep", "cp", "echo"):
            real = shutil.which(tool, path=saved_path)
            if real:
                os.symlink(real, os.path.join(nogl, tool))
        os.environ["PATH"] = nogl
        os.environ["HOME"] = tmp
        os.environ["GIT_CONFIG_NOSYSTEM"] = "1"
        os.environ["LEAN_SECRET_SCAN_HOME"] = os.path.join(tmp, "home")
        here = os.path.realpath(__file__)
        npm = keys["npm-token (npm_)"]
        ghp = keys["github-token (ghp_/gho_/ghu_/ghs_/ghr_)"]
        google = keys["google-api-key (AIza)"]
        zero = "0" * 40

        def sh(*argv, cwd=None, inp=None, env=None):
            e = dict(os.environ)
            e.update(env or {})
            return subprocess.run(argv, cwd=cwd, input=inp, capture_output=True, text=True, env=e)

        def repo(name, branch="main"):
            r = os.path.join(tmp, name)
            sh("git", "init", "-q", "-b", branch, r)
            sh("git", "-C", r, "config", "user.email", "t@example.org")
            sh("git", "-C", r, "config", "user.name", "t")
            return r

        def bare(name):
            r = os.path.join(tmp, name)
            sh("git", "init", "-q", "--bare", "-b", "main", r)
            return r

        def write(r, rel, text):
            os.makedirs(os.path.dirname(os.path.join(r, rel)), exist_ok=True)
            with open(os.path.join(r, rel), "w") as f:
                f.write(text)

        def commit(r, msg="c"):
            sh("git", "-C", r, "add", "-A")
            return sh("git", "-C", r, "commit", "-qm", msg, "--no-verify")

        def sha(r, rev="HEAD"):
            return sh("git", "-C", r, "rev-parse", rev).stdout.strip()

        def row(r, ref="refs/heads/main", remote_sha=zero, rev="HEAD"):
            return f"{ref} {sha(r, rev)} {ref} {remote_sha}\n"

        def paths(found):
            return sorted({f[0] for f in found})

        def install(r, env=None):
            return sh("python3", here, "install", r, env=env)

        # patterns, one test each
        for name, value in keys.items():
            if name.startswith("_"):
                continue
            check(f"pattern {name}", [f[2] for f in scan_text(f"key = {value}\n", "f.txt")], [name])
        check("a gho_ token", len(scan_text(keys["_gho"], "f")), 1)
        check("an rk_live_ key", len(scan_text(keys["_rk"], "f")), 1)
        check("clean text", scan_text("hello AIza short\nno keys here\n", "f"), [])
        check("long lowercase word without a token name", scan_text("word = " + "a" * 52, "f"), [])
        check("azure pat after a longer name", len(scan_text('ado_token: "' + "abcdefg234" * 5 + 'ab"', "f")), 1)
        text = f"one {npm} # allow-secret\ntwo {npm}\n"
        check("allow-secret is per line", [f[1] for f in scan_text(text, "f")], [2])
        out = render(scan_text(f"x {keys['aws-access-key-id (AKIA)']}", "f"))
        check("render hides the value", keys["aws-access-key-id (AKIA)"] in out, False)
        check("render names file, line, pattern", out, "f:1  aws-access-key-id (AKIA)")

        t0 = time.monotonic()
        scan_text("pat" * 20000 + "\n" + "token=" + "a" * 100000 + "\n", "big")
        check("azure pat regex is linear (60 KB line under 3s)", time.monotonic() - t0 < 3, True)

        # an added line that starts with '++ ' is content, not a file header
        r = repo("r11")
        write(r, "ok.txt", "x\n")
        commit(r, "base")
        write(r, "f.txt", "++ /dev/null\n" + google + "\n")
        sh("git", "-C", r, "add", "f.txt")
        check("a '++ ' line does not hide the next key",
              [(f[0], f[1]) for f in scan_staged(r)], [("f.txt", 2)])
        diff = "diff --git a/f b/f\n--- a/f\n+++ b/f\n@@ -0,0 +1,2 @@\n+++ /dev/null\n+" + npm + "\n"
        check("parse_diff on a hand made diff", [(p, n) for p, n, _l in parse_diff(diff) if npm in _l], [("f", 2)])

        # staged
        r = repo("r1")
        write(r, "ok.txt", "fine\n")
        sh("git", "-C", r, "add", ".")
        check("clean staged", sh("python3", here, "scan", "--staged", cwd=r).returncode, 0)
        sh("git", "-C", r, "commit", "-qm", "base")
        write(r, "cfg.js", "line1\nconst k = '" + google + "';\n")
        sh("git", "-C", r, "add", ".")
        p = sh("python3", here, "scan", "--staged", cwd=r)
        check("staged key blocked", p.returncode, 1)
        check("staged output names file and line", "cfg.js:2  google-api-key (AIza)" in p.stderr, True)
        check("staged output hides the value", google in p.stderr + p.stdout, False)
        check("skip variable", sh("python3", here, "scan", "--staged", cwd=r,
                                  env={"LEAN_SKIP_SECRET_SCAN": "1"}).returncode, 0)
        sh("git", "-C", r, "reset", "-q")
        check("unstaged not seen by --staged", sh("python3", here, "scan", "--staged", cwd=r).returncode, 0)

        # a scan that cannot run is exit 2, never a clean pass
        p = sh("python3", here, "scan", "--range", "nosuch..HEAD", cwd=r)
        check("bad range exits 2", p.returncode, 2)
        check("bad range says nothing was checked", "could not run" in p.stderr, True)
        check("bad repo exits 2", sh("python3", here, "scan", "--staged", "--repo", os.path.join(tmp, "nowhere")).returncode, 2)
        check("not a repo exits 2", sh("python3", here, "scan", "--staged", cwd=tmp).returncode, 2)

        def trap(name, marker):
            script = os.path.join(tmp, name + ".sh")
            with open(script, "w") as f:
                f.write(f"#!/bin/sh\ntouch '{marker}'\ncat \"$1\" 2>/dev/null\nexit 0\n")
            os.chmod(script, 0o755)
            return script

        # a repo's own config must not run code when the hook asks git for a diff or a log
        r = repo("r5")
        write(r, "a.txt", "hi\n")
        write(r, "b.dat", "hi\n")
        commit(r, "base")
        mark = os.path.join(tmp, "mark")
        sh("git", "-C", r, "config", "core.fsmonitor", trap("fsm", mark + "_fsm"))
        sh("git", "-C", r, "config", "diff.evil.textconv", trap("txc", mark + "_txc"))
        sh("git", "-C", r, "config", "diff.evil2.command", trap("ext", mark + "_ext"))
        sh("git", "-C", r, "config", "filter.evil.clean", trap("flt", mark + "_flt"))
        write(r, ".gitattributes", "a.txt diff=evil\nb.dat filter=evil\nc.txt diff=evil2\n")
        write(r, "a.txt", "hi\nmore " + google + "\n")
        write(r, "b.dat", "hi\nmore\n")
        write(r, "c.txt", "c\n")
        sh("git", "-C", r, "add", "c.txt")
        sh("git", "-C", r, "commit", "-qm", "c", "--no-verify")
        write(r, "c.txt", "c\nd\n")

        def markers():
            return sorted(n for n in os.listdir(tmp) if n.startswith("mark_"))

        def clear():
            for n in markers():
                os.remove(os.path.join(tmp, n))

        sh("git", "-C", r, "add", "a.txt", "b.dat")
        sh("git", "-C", r, "diff", "--cached")
        sh("git", "-C", r, "diff", "HEAD")
        sh("git", "-C", r, "ls-files", "-o")
        check("traps work against plain git (textconv, fsmonitor, filter, external diff)",
              sorted({"mark_txc", "mark_fsm", "mark_flt", "mark_ext"} - set(markers())), [])
        sh("git", "-C", r, "commit", "-qm", "k", "--no-verify")
        clear()
        found = scan_staged(r) + scan_range(r, "HEAD~1..HEAD") + scan_push_stdin(r, row(r), "origin")
        check("the scan found the key", "a.txt" in paths(found), True)
        check("no repo-configured command ran during the scan", markers(), [])
        sh("python3", here, "scan", "--staged", cwd=r)
        sh("python3", here, "scan", "--range", "HEAD~1..HEAD", cwd=r)
        check("none ran from the command line either", markers(), [])

        # 1: a signed commit must not start the repo's gpg.program when the scan logs it
        r = repo("r1sig")
        write(r, "a.txt", "a\n")
        commit(r, "base")
        gmark = os.path.join(tmp, "gpgran")
        sh("git", "-C", r, "config", "gpg.program", trap("gpg", gmark))
        sh("git", "-C", r, "config", "log.showSignature", "true")
        write(r, "k.txt", npm + "\n")
        sh("git", "-C", r, "add", "k.txt")
        tree = sh("git", "-C", r, "write-tree").stdout.strip()
        body = (f"tree {tree}\nparent {sha(r)}\nauthor t <t@example.org> 1 +0000\n"
                "committer t <t@example.org> 1 +0000\ngpgsig -----BEGIN PGP SIGNATURE-----\n \n"
                " -----END PGP SIGNATURE-----\n\nsigned\n")
        forged = sh("git", "-C", r, "hash-object", "-t", "commit", "-w", "--stdin", inp=body).stdout.strip()
        sh("git", "-C", r, "update-ref", "refs/heads/main", forged)
        sh("git", "-C", r, "log", "-1")
        check("the gpg trap fires on plain git log", os.path.exists(gmark), True)
        if os.path.exists(gmark):
            os.remove(gmark)
        found = scan_range(r, "HEAD~1..HEAD") + scan_push_stdin(r, row(r), "origin")
