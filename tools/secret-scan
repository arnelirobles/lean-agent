def self_test():
    failures = 0

    def check(name, got, want):
        nonlocal failures
        if got != want:
            print(f"FAIL {name}: got {got!r}, want {want!r}")
            failures += 1

    os.environ.pop("LEAN_SKIP_SECRET_SCAN", None)
    keys = fake_keys()
    saved_path = os.environ.get("PATH", "")
    real_gitleaks = shutil.which("gitleaks", path=saved_path) or (
        "/opt/homebrew/bin/gitleaks" if os.path.exists("/opt/homebrew/bin/gitleaks") else None)
    tmp = tempfile.mkdtemp(prefix="secret-scan-test-")
    try:
        # a PATH with no gitleaks, so the pattern tests do not depend on the machine
        nogl = os.path.join(tmp, "nogl")
        os.makedirs(nogl)
        for tool in ("git", "python3", "sh", "cat", "printf", "touch", "sleep"):
            real = shutil.which(tool, path=saved_path)
            if real:
                os.symlink(real, os.path.join(nogl, tool))
        os.environ["PATH"] = nogl
        os.environ["HOME"] = tmp
        os.environ["GIT_CONFIG_NOSYSTEM"] = "1"
        os.environ["LEAN_SECRET_SCAN_HOME"] = os.path.join(tmp, "home")
        here = os.path.realpath(__file__)
        npm = keys["npm-token (npm_)"]
        ghp = keys["github-token (ghp_/gho_/ghu_/ghs_/ghr_)"]
        google = keys["google-api-key (AIza)"]

        def sh(*argv, cwd=None, inp=None, env=None):
            e = dict(os.environ)
            e.update(env or {})
            return subprocess.run(argv, cwd=cwd, input=inp, capture_output=True, text=True, env=e)

        def repo(name):
            r = os.path.join(tmp, name)
            sh("git", "init", "-q", r)
            sh("git", "-C", r, "config", "user.email", "t@example.org")
            sh("git", "-C", r, "config", "user.name", "t")
            return r

        def write(r, rel, text):
            os.makedirs(os.path.dirname(os.path.join(r, rel)), exist_ok=True)
            with open(os.path.join(r, rel), "w") as f:
                f.write(text)

        def commit(r, msg="c"):
            sh("git", "-C", r, "add", "-A")
            return sh("git", "-C", r, "commit", "-qm", msg, "--no-verify")

        def sha(r, rev="HEAD"):
            return sh("git", "-C", r, "rev-parse", rev).stdout.strip()

        # patterns, one test each
        for name, value in keys.items():
            if name.startswith("_"):
                continue
            check(f"pattern {name}", [f[2] for f in scan_text(f"key = {value}\n", "f.txt")], [name])
        check("a gho_ token", len(scan_text(keys["_gho"], "f")), 1)
        check("an rk_live_ key", len(scan_text(keys["_rk"], "f")), 1)
        check("clean text", scan_text("hello AIza short\nno keys here\n", "f"), [])
        check("long lowercase word without a token name", scan_text("word = " + "a" * 52, "f"), [])
        check("azure pat after a longer name", len(scan_text('ado_token: "' + "abcdefg234" * 5 + 'ab"', "f")), 1)
        text = f"one {npm} # allow-secret\ntwo {npm}\n"
        check("allow-secret is per line", [f[1] for f in scan_text(text, "f")], [2])
        out = render(scan_text(f"x {keys['aws-access-key-id (AKIA)']}", "f"))
        check("render hides the value", keys["aws-access-key-id (AKIA)"] in out, False)
        check("render names file, line, pattern", out, "f:1  aws-access-key-id (AKIA)")

        # 8: the azure shape is linear, not quadratic
        t0 = time.monotonic()
        scan_text("pat" * 20000 + "\n" + "token=" + "a" * 100000 + "\n", "big")
        check("azure pat regex is linear (60 KB line under 3s)", time.monotonic() - t0 < 3, True)

        # 11: an added line that starts with '++ ' is content, not a file header
        r = repo("r11")
        write(r, "ok.txt", "x\n")
        commit(r, "base")
        write(r, "f.txt", "++ /dev/null\n" + google + "\n")
        sh("git", "-C", r, "add", "f.txt")
        check("a '++ ' line does not hide the next key",
              [(f[0], f[1]) for f in scan_staged(r)], [("f.txt", 2)])
        diff = "diff --git a/f b/f\n--- a/f\n+++ b/f\n@@ -0,0 +1,2 @@\n+++ /dev/null\n+" + npm + "\n"
        check("parse_diff on a hand made diff", [(p, n) for p, n, _l in parse_diff(diff) if npm in _l], [("f", 2)])

        # staged, unstaged
