        # a hook git would skip is not counted as installed
        r9c = repo("r9c")
        install(r9c)
        os.chmod(os.path.join(r9c, ".git", "hooks", "pre-push"), 0o644)
        check("a hook that is not executable is not installed", "not executable" in (hooks_installed(r9c)[1] or ""), True)
        # 4: an edited hook is not an installed hook
        r9d = repo("r9d")
        install(r9d)
        with open(os.path.join(r9d, ".git", "hooks", "pre-push"), "a") as f:
            f.write("echo edit\n")
        ok, why = hooks_installed(r9d)
        check("4: an edited hook is not installed", ok, False)
        check("4: and the reason says it was changed and what to do", "changed after install" in why and "install again" in why, True)
        # 5: the hooks name the interpreter that ran install
        with open(os.path.join(r9c, ".git", "hooks", "pre-commit")) as f:
            body = f.read()
        check("5: the hook holds the absolute interpreter", "LEAN_SS_PY='/" in body, True)
        check("5: and no bare python3 call", "| python3" in body or "\npython3 " in body, False)
        gone_py = "\n".join(hook_text("pre-commit", "/x/copy", False, "/no/such/python"))
        check("5: a missing interpreter falls back to python3 at run time", '[ -x "$LEAN_SS_PY" ] || LEAN_SS_PY=python3' in gone_py, True)
        # 1: the install command works where install would refuse
        r9e = repo("r9e")
        sh("git", "-C", r9e, "config", "core.hooksPath", ".githooks")
        check("1: a tracked hooks dir gets --force-shared in the command", "--force-shared" in install_command(r9e), True)
        check("1: and a note that says what it does", "--force-shared writes" in install_note(r9e), True)
        check("1: a plain repo gets neither", ("--force-shared" in install_command(r9c), install_note(r9c)), (False, ""))

        # shared and tracked hooks paths are refused
        r4 = repo("r4")
        sh("git", "-C", r4, "config", "core.hooksPath", ".githooks")
        p = install(r4)
        check("a hooksPath inside the work tree is refused", p.returncode == 1 and "refused" in p.stdout, True)
        check("nothing written", os.path.exists(os.path.join(r4, ".githooks", "pre-commit")), False)
        install_force = sh("python3", here, "install", "--force-shared", r4)
        check("--force-shared installs there", install_force.returncode == 0
              and os.path.exists(os.path.join(r4, ".githooks", "pre-commit")), True)
        outside_hooks = os.path.join(tmp, "private-hooks")
        r10 = repo("r10")
        sh("git", "-C", r10, "config", "core.hooksPath", outside_hooks)
        install(r10)
        check("a local hooksPath outside the tree is respected", os.path.exists(os.path.join(outside_hooks, "pre-commit")), True)
        check("and hooks_installed follows it", hooks_installed(r10), (True, None))
        sh("git", "config", "--global", "core.hooksPath", os.path.join(tmp, "shared-hooks"))
        r11 = repo("r11g")
        p = install(r11)
        check("a global hooksPath is refused", p.returncode == 1 and "shared by every repository" in p.stdout, True)
        p = sh("python3", here, "uninstall", r11)
        check("uninstall is refused there too", "refused" in p.stdout, True)
        sh("python3", here, "install", "--force-shared", r11)
        check("--force-shared installs into the shared dir", os.path.exists(os.path.join(tmp, "shared-hooks", "pre-commit")), True)
        sh("git", "config", "--global", "--unset", "core.hooksPath")
        # 8: a hooks path from the command scope is shared too
        r8c = repo("r8cmd")
        cmdhooks = os.path.join(tmp, "cmd-hooks")
        p = install(r8c, env={"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "core.hooksPath", "GIT_CONFIG_VALUE_0": cmdhooks})
        check("8: core.hooksPath from GIT_CONFIG_COUNT is refused", p.returncode == 1 and "refused" in p.stdout, True)
        check("8: nothing written there", os.path.exists(os.path.join(cmdhooks, "pre-commit")), False)
        p = install(r8c, env={"GIT_CONFIG_PARAMETERS": f"'core.hooksPath'='{cmdhooks}'"})
        check("8: core.hooksPath from GIT_CONFIG_PARAMETERS is refused", p.returncode == 1 and "refused" in p.stdout, True)

        # odd characters in the copy path do not break the hook
        odd = os.path.join(tmp, "a\"b$HOME`c'd e")
        r12 = repo("r12")
        write(r12, "a.txt", "a\n")
        commit(r12, "base")
        install(r12, env={"LEAN_SECRET_SCAN_HOME": odd})
        write(r12, "k.txt", npm + "\n")
        sh("git", "-C", r12, "add", ".")
        p = sh("git", "-C", r12, "commit", "-qm", "k", env={"LEAN_SECRET_SCAN_HOME": odd})
        check("a path with quotes, $ and a backtick still blocks cleanly", p.returncode != 0 and "k.txt:1" in p.stderr, True)
        check("and has no shell syntax error", "syntax error" in p.stderr or "not found" in p.stderr, False)
        check("hooks_installed finds the odd copy", hooks_installed(r12), (True, None))

        # --all
        base = os.path.join(tmp, "many")
        for n in ("x", "y/z"):
            os.makedirs(os.path.join(base, n))
            sh("git", "init", "-q", os.path.join(base, n))
        os.makedirs(os.path.join(base, "plain"))
        p = sh("python3", here, "install", "--all", base)
        check("--all installs in every repo", "installed in 2 of 2" in p.stdout, True)
        check("--all hook exists", os.path.exists(os.path.join(base, "y", "z", ".git", "hooks", "pre-push")), True)
        sh("python3", here, "uninstall", "--all", base)
        check("--all uninstalls", os.path.exists(os.path.join(base, "x", ".git", "hooks", "pre-commit")), False)

        # file mode and stdin
        write(tmp, "f.txt", "x " + keys["slack-token (xox)"] + "\n")
        check("--file blocks", sh("python3", here, "scan", "--file", os.path.join(tmp, "f.txt")).returncode, 1)
        check("--stdin blocks", sh("python3", here, "scan", "--file", "n.txt", "--stdin",
                                   inp=keys["slack-token (xox)"]).returncode, 1)

        # 5: gitleaks, once per scan, capped by size, mapped per file, and loud when it fails
        stub = os.path.join(nogl, "gitleaks")
        count = os.path.join(tmp, "gl-count")

        def stub_gitleaks(body):
            with open(stub, "w") as f:
                f.write(body)
            os.chmod(stub, 0o755)

        # finds zz_ followed by ten letters in each file, and reports the line before the real one
        stub_gitleaks("#!/usr/bin/env python3\nimport json, os, re, sys\n"
                      f"open({count!r}, 'a').write('x\\n')\n"
                      "a = sys.argv[1:]\nsrc = a[1] if a[0] == 'dir' else a[a.index('--source') + 1]\n"
                      "out = []\n"
                      "for name in sorted(os.listdir(src)):\n"
                      "    lines = open(os.path.join(src, name)).read().split('\\n')\n"
                      "    for i, l in enumerate(lines):\n"
                      "        m = re.search(r'zz_[a-z]{10}', l)\n"
                      "        if m:\n"
                      "            out.append({'RuleID': 'stub', 'File': os.path.join(src, name), 'StartLine': max(1, i), 'Secret': m.group(0)})\n"
                      "json.dump(out, open(a[a.index('--report-path') + 1], 'w'))\n")
        tok = "zz_" + "abcdefghij"
        found = scan_text("one\ntwo\nx = " + tok + "\n", "g.txt")
        check("gitleaks findings are added, on the line the secret is on", found, [("g.txt", 3, "gitleaks:stub")])
        both = scan_text("one\n" + npm + " " + tok + "\n", "g.txt")
        check("same line reported once", [(f[0], f[1]) for f in both], [("g.txt", 2)])
        r13 = repo("r13")
        write(r13, "a.txt", "1\n2\n3\n4\n5\n")
        write(r13, "b.txt", "1\n")
        commit(r13, "base")
        write(r13, "a.txt", "1\n2\nthree\n4\n5\nsix\n")
        write(r13, "b.txt", "1\nhello\nx = " + tok + "\n")
        for i in range(300):
            write(r13, f"d/f{i}.txt", f"file {i}\nline\n")
        sh("git", "-C", r13, "add", "-A")
        if os.path.exists(count):
            os.remove(count)
        found = scan_staged(r13)
        check("findings map to their own file and line", found, [("b.txt", 3, "gitleaks:stub")])
        check("302 files, one gitleaks run", len(open(count).read().split()), 1)
        os.remove(count)
        saved_cap, GITLEAKS_MAX_BYTES = GITLEAKS_MAX_BYTES, 200
        del WARNINGS[:]
        found = scan_text(("filler\n" * 40) + npm + "\n", "cap.txt")
        GITLEAKS_MAX_BYTES = saved_cap
        check("over the cap, gitleaks does not run", os.path.exists(count), False)
        check("over the cap, the patterns still run", [f[1] for f in found], [41])
        check("and it says so once", [w for w in WARNINGS if "skipped" in w].__len__(), 1)
        os.environ["LEAN_SECRET_SCAN_TIMEOUT"] = "1"
        stub_gitleaks("#!/bin/sh\nexec sleep 6\n")
        t0 = time.monotonic()
        del WARNINGS[:]
        found = scan_text("a\n" + npm + "\n", "slow.txt")
        check("a slow gitleaks is cut off and the pattern result stands", [f[1] for f in found], [2])
        check("it did not wait for it", time.monotonic() - t0 < 5, True)
        check("and it says so", any("timed out" in w for w in WARNINGS), True)
        os.environ.pop("LEAN_SECRET_SCAN_TIMEOUT")
        stub_gitleaks('#!/bin/sh\necho "boom: bad flag" >&2\nexit 3\n')
        del WARNINGS[:]
        found = scan_text("a\n" + npm + "\n", "f.txt")
        check("a failing gitleaks keeps the pattern result", [f[1] for f in found], [2])
        check("and says it failed", any("gitleaks failed" in w and "boom" in w for w in WARNINGS), True)
        r = repo("r5hook")
        write(r, "a.txt", "a\n")
        commit(r, "base")
        install(r)
        write(r, "b.txt", "clean\n")
        sh("git", "-C", r, "add", "b.txt")
        p = sh("git", "-C", r, "commit", "-qm", "x")
        check("in the git hook a failing gitleaks is a visible warning, not a block",
              (p.returncode, "warning: gitleaks failed" in p.stderr), (0, True))
        os.remove(stub)
        if real_gitleaks:
            os.symlink(real_gitleaks, stub)
            import random
            rnd = random.Random(7)
            alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            # a Stripe test key: the built in patterns only cover live keys
            token = "sk" + "_test_" + "".join(rnd.choice(alpha) for _ in range(24))
            del WARNINGS[:]
            found = scan_text("one\ntwo\nx = '" + token + "'\n", "real.txt")
            check("real gitleaks flags a line the patterns miss", [(f[1], f[2].split(":")[0]) for f in found], [(3, "gitleaks")])
            check("real gitleaks ran without a warning", WARNINGS, [])
            check("real gitleaks output hides the value", token in render(found), False)
            r = repo("r5real")
            write(r, "a.txt", "1\n2\n3\n")
            commit(r, "base")
            write(r, "a.txt", "1\n2\n3\nfour\n")
            write(r, "b.txt", "x\ny\nz = '" + token + "'\n")
            sh("git", "-C", r, "add", "-A")
            check("real gitleaks in a two file diff maps to the second file",
                  [(f[0], f[1]) for f in scan_staged(r)], [("b.txt", 3)])
            os.remove(stub)
        else:
