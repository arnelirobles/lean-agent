#!/usr/bin/env python3
"""Find keys and tokens in the lines a commit adds, and keep them out of git.

One scanner for the Claude hook (hooks/secret-scan.py) and for the git
pre-commit and pre-push hooks it installs, so a commit from a terminal is
checked the same way as one an agent makes.

  secret-scan scan [--repo DIR] --staged        added lines of the staged diff
  secret-scan scan [--repo DIR] --all           staged and unstaged (git commit -a)
  secret-scan scan [--repo DIR] --range A..B    added lines of a commit range
  secret-scan scan [--repo DIR] --unpushed      commits on no remote yet
  secret-scan scan --push-stdin REMOTE          a pre-push hook's stdin
  secret-scan scan --file PATH [--stdin]        one file, or text on stdin as PATH
  secret-scan install [REPO]                    pre-commit and pre-push hooks in one repo
  secret-scan install --all DIR                 the same in every git repo under DIR
  secret-scan uninstall [REPO] | --all DIR      take them out, restore what was chained

Exit 0 clean, 1 on a finding, 2 when it cannot run. Output is one line per
finding, "path:line  pattern", and never the value.

A line containing `allow-secret` is skipped, that line only.
gitleaks: when `gitleaks` is on PATH its rules run too, on top of the built in
patterns, and findings from both are reported once per line.
  LEAN_SKIP_SECRET_SCAN=1    turn the scan off (git hooks and Claude hook)
  LEAN_SECRET_SCAN_HOME      where install keeps its copy of this script
                             (default ~/.local/share/lean/secret-scan)
  secret-scan --self-test
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

MARKER = "allow-secret"
MAX_BYTES = 1_000_000

PATTERNS = [
    ("google-api-key (AIza)", re.compile(r"AIza[0-9A-Za-z_-]{35}")),
    ("github-token (ghp_/gho_/ghu_/ghs_/ghr_)", re.compile(r"gh[pousr]_[A-Za-z0-9]{36,}")),
    ("github-fine-grained-token (github_pat_)", re.compile(r"github_pat_[A-Za-z0-9_]{22,}")),
    ("aws-access-key-id (AKIA)", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("slack-token (xox)", re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("stripe-live-key (sk_live_/rk_live_)", re.compile(r"[sr]k_live_[0-9A-Za-z]{20,}")),
    ("npm-token (npm_)", re.compile(r"npm_[A-Za-z0-9]{36}")),
    ("private-key-block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    # An Azure DevOps PAT is 52 base32 characters. Alone that matches any long lowercase word, so
    # it counts only next to a name that says it is a token.
    ("azure-devops-pat", re.compile(
        r"(?i)(?:pat|token|devops|azure|ado|accesstoken|password)[\w.-]*[\"']?\s*[:=]\s*[\"']?[a-z2-7]{52}(?![A-Za-z0-9])")),
]


def scan_line(line):
    """Names of the patterns a line matches, [] when it carries allow-secret."""
    if MARKER in line:
        return []
    return [name for name, rx in PATTERNS if rx.search(line)]


def scan_text(text, path):
    """Findings (path, line number, pattern) for a whole text, plus gitleaks when installed."""
    found = []
    for n, line in enumerate(text.splitlines(), 1):
        for name in scan_line(line):
            found.append((path, n, name))
    return add_gitleaks(found, [(path, text.splitlines(), list(range(1, len(text.splitlines()) + 1)))])


# gitleaks -----------------------------------------------------------------

def gitleaks_path():
    return shutil.which("gitleaks")


def run_gitleaks(lines):
    """Rule ids gitleaks reports, as {index into lines: rule id}. Empty when it cannot run."""
    exe = gitleaks_path()
    if not exe or not lines:
        return {}
    clean = [("" if MARKER in line else line.replace("\r", "")) for line in lines]
    body = "\n".join(clean) + "\n"
    with tempfile.TemporaryDirectory() as tmp:
        report = os.path.join(tmp, "r.json")
        for argv in ([exe, "stdin"], [exe, "detect", "--no-git", "--pipe"]):
            try:
                subprocess.run(argv + ["--report-format", "json", "--report-path", report, "--redact",
                                       "--no-banner", "--exit-code", "0"],
                               input=body, capture_output=True, text=True, timeout=60, cwd=tmp)
            except (OSError, subprocess.SubprocessError):
                continue
            if os.path.exists(report):
                try:
                    with open(report, encoding="utf-8") as f:
                        data = json.load(f) or []
                except ValueError:
                    continue
                out = {}
                for item in data:
                    start = item.get("StartLine")
                    if isinstance(start, int) and 1 <= start <= len(lines):
                        out.setdefault(start - 1, str(item.get("RuleID") or "rule"))
                return out
    return {}


def add_gitleaks(found, files):
    """files: [(path, lines, line numbers)]. Adds gitleaks findings the patterns missed."""
    seen = {(p, n) for p, n, _ in found}
    out = list(found)
    for path, lines, numbers in files:
        for idx, rule in run_gitleaks(lines).items():
            if idx < len(numbers) and (path, numbers[idx]) not in seen:
                seen.add((path, numbers[idx]))
                out.append((path, numbers[idx], "gitleaks:" + rule))
    return out


# git ----------------------------------------------------------------------

def git(repo, *args, check=False):
    p = subprocess.run(["git", "-C", repo] + list(args), capture_output=True, text=True,
                       errors="replace")
    if check and p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or "git failed")
    return p.stdout if p.returncode == 0 else None


def parse_diff(text):
    """Added lines of a -U0 diff or log -p output: [(path, [lines], [line numbers])]."""
    files, path, lines, nums, n = [], None, [], [], 0

    def flush():
        if path and lines:
            files.append((path, list(lines), list(nums)))

    for raw in text.splitlines():
        if raw.startswith("diff --git "):
            flush()
            path, lines, nums, n = None, [], [], 0
        elif raw.startswith("+++ "):
            target = raw[4:].strip()
            path = None if target == "/dev/null" else (target[2:] if target[:2] == "b/" else target)
            path = path.strip('"') if path else path
        elif raw.startswith("@@"):
            m = re.search(r"\+(\d+)", raw)
            n = int(m.group(1)) if m else 0
        elif raw.startswith("+") and path:
            lines.append(raw[1:])
            nums.append(n)
            n += 1
    flush()
    return files


def scan_diff_text(text):
    files = parse_diff(text)
    found = []
    for path, lines, nums in files:
        for line, num in zip(lines, nums):
            for name in scan_line(line):
                found.append((path, num, name))
    return add_gitleaks(found, files)


def scan_staged(repo):
    return scan_diff_text(git(repo, "diff", "--cached", "-U0", "--no-color", "--no-ext-diff") or "")


def scan_worktree(repo, untracked=False):
    """Staged and unstaged added lines; with untracked, every line of files git would add."""
    base = "HEAD" if git(repo, "rev-parse", "--verify", "-q", "HEAD") is not None else None
    args = ["diff", "-U0", "--no-color", "--no-ext-diff"]
    text = git(repo, *(args + ([base] if base else ["--cached"]))) or ""
    if not base:
        text += git(repo, *args) or ""
    found = scan_diff_text(text)
    if untracked:
        names = git(repo, "ls-files", "-o", "--exclude-standard", "-z") or ""
        for rel in filter(None, names.split("\0")):
            found += scan_file(os.path.join(repo, rel), rel)
    return found


def scan_range(repo, *revs):
    text = git(repo, "log", "-p", "-U0", "--no-color", "--no-ext-diff", "--format=", *revs)
    return scan_diff_text(text or "")


def scan_unpushed(repo):
    return scan_range(repo, "HEAD", "--not", "--remotes")


def scan_file(path, label=None):
    try:
        if os.path.getsize(path) > MAX_BYTES:
            return []
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return []
    if b"\0" in data[:4096]:
        return []
    return scan_text(data.decode("utf-8", "replace"), label or path)


def scan_push_stdin(repo, stdin_text):
    """A pre-push hook's stdin: 'local_ref local_sha remote_ref remote_sha' per ref."""
    found, zero = [], "0" * 40
    for row in stdin_text.splitlines():
        parts = row.split()
        if len(parts) < 4 or set(parts[1]) == {"0"}:
            continue
        local, remote = parts[1], parts[3]
        if set(remote) == {"0"} or remote == zero:
            found += scan_range(repo, local, "--not", "--remotes")
        else:
            found += scan_range(repo, f"{remote}..{local}")
    return found


# output -------------------------------------------------------------------

def render(found):
    """One line per finding. The value never appears."""
    return "\n".join(f"{p}:{n}  {name}" for p, n, name in sorted(set(found), key=lambda f: (f[0], f[1], f[2])))


def message(found, what):
    return (f"Blocked by lean-agent: {what} contains what looks like a key or token. "
            "Put it in a gitignored .env.local or a pipeline secret, never in git. "
            "Add allow-secret to a line that is a test fixture. Found:\n" + render(found))


# git hook installer -------------------------------------------------------

OURS = "# lean-agent secret-scan"
HOOKS = ("pre-commit", "pre-push")


def home():
    return os.environ.get("LEAN_SECRET_SCAN_HOME") or os.path.expanduser("~/.local/share/lean/secret-scan")


def hooks_dir(repo):
    top = git(repo, "rev-parse", "--show-toplevel")
    if top is None:
        return None
    top = top.strip()
    path = (git(top, "config", "--get", "core.hooksPath") or "").strip()
    if path:
        path = os.path.expanduser(path)
        return path if os.path.isabs(path) else os.path.join(top, path)
    gitpath = git(top, "rev-parse", "--git-path", "hooks").strip()
    return gitpath if os.path.isabs(gitpath) else os.path.join(top, gitpath)


def hook_text(name, copy, chained):
    run = f'python3 "{copy}" scan'
    if name == "pre-commit":
        body = f'{run} --staged || exit 1\n'
        if chained:
            body += f'[ -x "$0.pre-secret-scan" ] && exec "$0.pre-secret-scan" "$@"\nexit 0\n'
    else:
        body = f'input=$(cat)\nprintf \'%s\\n\' "$input" | {run} --push-stdin "$1" || exit 1\n'
        if chained:
            body += (f'if [ -x "$0.pre-secret-scan" ]; then\n'
                     f'  printf \'%s\\n\' "$input" | "$0.pre-secret-scan" "$@"\n  exit $?\nfi\n')
        body += "exit 0\n"
    return (f"#!/bin/sh\n{OURS}: checks {'staged' if name == 'pre-commit' else 'pushed'} lines for keys "
            f"and tokens. Remove with: secret-scan uninstall\n"
            f'[ "$LEAN_SKIP_SECRET_SCAN" = 1 ] && SKIP=1\n'
            f'if [ -z "$SKIP" ] && [ ! -f "{copy}" ]; then echo "secret-scan: {copy} is missing, not scanning" >&2; SKIP=1; fi\n'
            f'if [ -n "$SKIP" ]; then\n'
            + ("  input=$(cat)\n" if name == "pre-push" else "")
            + (f'  [ -x "$0.pre-secret-scan" ] && '
               + ('{ printf \'%s\\n\' "$input" | "$0.pre-secret-scan" "$@"; exit $?; }\n' if name == "pre-push"
                  else 'exec "$0.pre-secret-scan" "$@"\n') if chained else "")
            + "  exit 0\nfi\n" + body)


def install_one(repo, out):
    d = hooks_dir(repo)
    if d is None:
        out(f"skip {repo}: not a git repository")
        return False
    os.makedirs(home(), exist_ok=True)
    copy = os.path.join(home(), "secret-scan")
    shutil.copyfile(os.path.realpath(__file__), copy)
    os.chmod(copy, 0o755)
    os.makedirs(d, exist_ok=True)
    for name in HOOKS:
        path = os.path.join(d, name)
        old = path + ".pre-secret-scan"
        chained = os.path.exists(old)
        if os.path.lexists(path):
            with open(path, encoding="utf-8", errors="replace") as f:
                current = f.read()
            if OURS not in current:
                if os.path.lexists(old):
                    out(f"skip {path}: {old} already exists")
                    continue
                os.rename(path, old)
                chained = True
        with open(path, "w", encoding="utf-8") as f:
            f.write(hook_text(name, copy, chained))
        os.chmod(path, 0o755)
    out(f"installed {d}" + (" (core.hooksPath)" if git(repo, "config", "--get", "core.hooksPath") else ""))
    return True


def uninstall_one(repo, out):
    d = hooks_dir(repo)
    if d is None:
        out(f"skip {repo}: not a git repository")
        return False
    for name in HOOKS:
        path = os.path.join(d, name)
        old = path + ".pre-secret-scan"
        if os.path.lexists(path):
            with open(path, encoding="utf-8", errors="replace") as f:
                if OURS not in f.read():
                    continue
            os.remove(path)
            if os.path.lexists(old):
                os.rename(old, path)
    out(f"removed {d}")
    return True


def find_repos(root):
    repos = []
    for dirpath, dirnames, filenames in os.walk(root):
        if ".git" in dirnames or ".git" in filenames:
            repos.append(dirpath)
            dirnames[:] = []
            continue
        dirnames[:] = [x for x in dirnames if x not in ("node_modules", ".git", ".venv", "venv", "target")
                       and not x.startswith(".Trash")]
    return sorted(repos)


# cli ----------------------------------------------------------------------

def cmd_scan(args):
    repo, mode, value, use_stdin = os.getcwd(), None, None, False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--repo" and i + 1 < len(args):
            repo, i = args[i + 1], i + 1
        elif a in ("--staged", "--all", "--unpushed"):
            mode = a
        elif a in ("--range", "--push-stdin", "--file") and i + 1 < len(args):
            mode, value, i = a, args[i + 1], i + 1
        elif a == "--stdin":
            use_stdin = True
        else:
            print(f"secret-scan: unknown argument {a}", file=sys.stderr)
            return 2
        i += 1
    if os.environ.get("LEAN_SKIP_SECRET_SCAN") == "1":
        return 0
    if mode is None:
        print("secret-scan scan: choose --staged, --all, --range, --unpushed, --push-stdin or --file", file=sys.stderr)
        return 2
    try:
        if mode == "--staged":
            found = scan_staged(repo)
        elif mode == "--all":
            found = scan_worktree(repo)
        elif mode == "--unpushed":
            found = scan_unpushed(repo)
        elif mode == "--range":
            found = scan_range(repo, value)
        elif mode == "--push-stdin":
            found = scan_push_stdin(repo, sys.stdin.read())
        else:
            found = scan_text(sys.stdin.read(), value) if use_stdin else scan_file(value)
    except RuntimeError as exc:
        print(f"secret-scan: {exc}", file=sys.stderr)
        return 2
    if found:
        what = {"--staged": "the staged changes", "--all": "the changes",
                "--file": value}.get(mode, "the commits being pushed")
        print(message(found, what), file=sys.stderr)
        return 1
    return 0


def cmd_install(args, remove=False):
    fn = uninstall_one if remove else install_one
    say = lambda s: print(s)  # noqa: E731
    if args[:1] == ["--all"]:
        if len(args) < 2:
            print("secret-scan: --all needs a folder", file=sys.stderr)
            return 2
        repos = find_repos(os.path.expanduser(args[1]))
        done = sum(1 for r in repos if fn(r, say))
        print(f"{'removed from' if remove else 'installed in'} {done} of {len(repos)} repositories")
        return 0
    return 0 if fn(os.path.expanduser(args[0]) if args else os.getcwd(), say) else 2


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    if argv[0] == "scan":
        return cmd_scan(argv[1:])
    if argv[0] in ("install", "uninstall"):
        return cmd_install(argv[1:], remove=argv[0] == "uninstall")
    print(f"secret-scan: unknown command {argv[0]}", file=sys.stderr)
    return 2


# self test ----------------------------------------------------------------

def fake_keys():
    """Fake keys built from pieces, so this file never holds a literal key-shaped string."""
    a, b = "A" * 12, "b" * 36
    return {
        "google-api-key (AIza)": "AI" + "za" + "Sy" + "0" * 33,
        "github-token (ghp_/gho_/ghu_/ghs_/ghr_)": "gh" + "p_" + b,
        "github-fine-grained-token (github_pat_)": "github" + "_pat_" + "X" * 30,
        "aws-access-key-id (AKIA)": "AK" + "IA" + "Z" * 16,
        "slack-token (xox)": "xo" + "xb-" + "1234567890-abcdefgh",
        "stripe-live-key (sk_live_/rk_live_)": "sk" + "_live_" + "a1" * 12,
        "npm-token (npm_)": "np" + "m_" + b,
        "private-key-block": "-----BEGIN " + "RSA PRIVATE" + " KEY-----",
        "azure-devops-pat": "AZURE_DEVOPS_PAT=" + "abcdefg234" * 5 + "ab",
        "_gho": "gh" + "o_" + b,
        "_rk": "rk" + "_live_" + "z9" * 12,
        "_a": a,
    }


def self_test():
    failures = 0

    def check(name, got, want):
        nonlocal failures
        if got != want:
            print(f"FAIL {name}: got {got!r}, want {want!r}")
            failures += 1

    os.environ.pop("LEAN_SKIP_SECRET_SCAN", None)
    keys = fake_keys()
    # no gitleaks on PATH for the pattern tests
    saved_path = os.environ.get("PATH", "")
    tmp = tempfile.mkdtemp(prefix="secret-scan-test-")
    try:
        nogl = os.path.join(tmp, "nogl")
        os.makedirs(nogl)
        for tool in ("git", "python3", "sh", "cat", "printf"):
            real = shutil.which(tool, path=saved_path)
            if real:
                os.symlink(real, os.path.join(nogl, tool))
        os.environ["PATH"] = nogl
        os.environ["HOME"] = tmp
        os.environ["GIT_CONFIG_NOSYSTEM"] = "1"
        os.environ["LEAN_SECRET_SCAN_HOME"] = os.path.join(tmp, "home")
        here = os.path.realpath(__file__)

        # one test per pattern
        for name, value in keys.items():
            if name.startswith("_"):
                continue
            check(f"pattern {name}", [f[2] for f in scan_text(f"key = {value}\n", "f.txt")], [name])
        check("a gho_ token", len(scan_text(keys["_gho"], "f")), 1)
        check("an rk_live_ key", len(scan_text(keys["_rk"], "f")), 1)
        check("clean text", scan_text("hello AIza short\nno keys here\n", "f"), [])
        check("long lowercase word without a token name", scan_text("word = " + "a" * 52, "f"), [])
        # allow-secret skips its own line only
        text = f"one {keys['npm-token (npm_)']} # allow-secret\ntwo {keys['npm-token (npm_)']}\n"
        check("allow-secret is per line", [(f[1]) for f in scan_text(text, "f")], [2])
        # the value never appears in output
        out = render(scan_text(f"x {keys['aws-access-key-id (AKIA)']}", "f"))
        check("render hides the value", keys["aws-access-key-id (AKIA)"] in out, False)
        check("render names file, line, pattern", out, "f:1  aws-access-key-id (AKIA)")

        def sh(*argv, cwd=None, inp=None, env=None):
            e = dict(os.environ)
            e.update(env or {})
            return subprocess.run(argv, cwd=cwd, input=inp, capture_output=True, text=True, env=e)

        def repo(name):
            r = os.path.join(tmp, name)
            sh("git", "init", "-q", r)
            sh("git", "-C", r, "config", "user.email", "t@example.org")
            sh("git", "-C", r, "config", "user.name", "t")
            return r

        def write(r, rel, text):
            with open(os.path.join(r, rel), "w") as f:
                f.write(text)

        r = repo("r1")
        write(r, "ok.txt", "fine\n")
        sh("git", "-C", r, "add", ".")
        check("clean staged", sh("python3", here, "scan", "--staged", cwd=r).returncode, 0)
        sh("git", "-C", r, "commit", "-qm", "base")
        write(r, "cfg.js", "line1\nconst k = '" + keys["google-api-key (AIza)"] + "';\n")
        sh("git", "-C", r, "add", ".")
        p = sh("python3", here, "scan", "--staged", cwd=r)
        check("staged key blocked", p.returncode, 1)
        check("staged output names file and line", "cfg.js:2  google-api-key (AIza)" in p.stderr, True)
        check("staged output hides the value", keys["google-api-key (AIza)"] in p.stderr + p.stdout, False)
        check("skip variable", sh("python3", here, "scan", "--staged", cwd=r,
                                  env={"LEAN_SKIP_SECRET_SCAN": "1"}).returncode, 0)
        # unstaged, for commit -a
        sh("git", "-C", r, "reset", "-q")
        check("unstaged not seen by --staged", sh("python3", here, "scan", "--staged", cwd=r).returncode, 0)
        sh("git", "-C", r, "add", "-N", "cfg.js")
        sh("git", "-C", r, "add", "ok.txt")
        write(r, "ok.txt", "fine\nmore " + keys["npm-token (npm_)"] + "\n")
        check("--all sees unstaged", sh("python3", here, "scan", "--all", cwd=r).returncode, 1)
        sh("git", "-C", r, "rm", "-q", "-f", "--cached", "cfg.js")
        os.remove(os.path.join(r, "cfg.js"))
        write(r, "ok.txt", "fine\n")

        # git hooks: install, block a hand commit, pass a clean one
        r2 = repo("r2")
        write(r2, "a.txt", "a\n")
        sh("git", "-C", r2, "add", "."), sh("git", "-C", r2, "commit", "-qm", "base")
        p = sh("python3", here, "install", r2)
        check("install exit", p.returncode, 0)
        write(r2, "b.js", "k = " + keys["github-token (ghp_/gho_/ghu_/ghs_/ghr_)"] + "\n")
        sh("git", "-C", r2, "add", ".")
        p = sh("git", "-C", r2, "commit", "-qm", "key")
        check("hand commit blocked by the git hook", p.returncode != 0, True)
        check("git hook names the file", "b.js:1" in p.stderr, True)
        check("git hook hides the value", keys["github-token (ghp_/gho_/ghu_/ghs_/ghr_)"] in p.stderr, False)
        check("bypass variable lets it through", sh("git", "-C", r2, "commit", "-qm", "key",
                                                    env={"LEAN_SKIP_SECRET_SCAN": "1"}).returncode, 0)
        write(r2, "c.txt", "clean\n")
        sh("git", "-C", r2, "add", "c.txt")
        check("clean commit passes the git hook", sh("git", "-C", r2, "commit", "-qm", "clean").returncode, 0)

        # pre-push: the key is in history now, push to a bare remote
        bare = os.path.join(tmp, "bare.git")
        sh("git", "init", "-q", "--bare", bare)
        sh("git", "-C", r2, "remote", "add", "origin", bare)
        p = sh("git", "-C", r2, "push", "-q", "origin", "HEAD:refs/heads/main")
        check("push of a commit with a key blocked", p.returncode != 0, True)
        check("push output names the file", "b.js:1" in p.stderr, True)
        check("unpushed scan sees it", sh("python3", here, "scan", "--unpushed", cwd=r2).returncode, 1)
        check("range scan sees it", sh("python3", here, "scan", "--range", "HEAD~2..HEAD", cwd=r2).returncode, 1)
        check("range scan of a clean range", sh("python3", here, "scan", "--range", "HEAD~1..HEAD", cwd=r2).returncode, 0)
        check("push passes when asked to skip",
              sh("git", "-C", r2, "push", "-q", "origin", "HEAD:refs/heads/main",
                 env={"LEAN_SKIP_SECRET_SCAN": "1"}).returncode, 0)
        check("nothing unpushed after", sh("python3", here, "scan", "--unpushed", cwd=r2).returncode, 0)

        # chaining and uninstall
        r3 = repo("r3")
        hook = os.path.join(r3, ".git", "hooks", "pre-commit")
        os.makedirs(os.path.dirname(hook), exist_ok=True)
        write(r3, ".git/hooks/pre-commit", "#!/bin/sh\necho ran-old-hook >> \"" + os.path.join(tmp, "oldlog") + "\"\nexit 0\n")
        os.chmod(hook, 0o755)
        sh("python3", here, "install", r3)
        write(r3, "a.txt", "a\n")
        sh("git", "-C", r3, "add", ".")
        check("chained commit passes", sh("git", "-C", r3, "commit", "-qm", "x").returncode, 0)
        check("old hook still ran", os.path.exists(os.path.join(tmp, "oldlog")), True)
        sh("python3", here, "install", r3)
        check("reinstall keeps the chained hook", os.path.exists(hook + ".pre-secret-scan"), True)
        write(r3, "k.txt", keys["npm-token (npm_)"] + "\n")
        sh("git", "-C", r3, "add", ".")
        check("chained hook still blocks", sh("git", "-C", r3, "commit", "-qm", "k").returncode != 0, True)
        sh("python3", here, "uninstall", r3)
        with open(hook) as f:
            check("uninstall restores the old hook", "ran-old-hook" in f.read() and OURS not in open(hook).read(), True)
        check("uninstall removes pre-push", os.path.exists(os.path.join(r3, ".git", "hooks", "pre-push")), False)

        # core.hooksPath
        r4 = repo("r4")
        sh("git", "-C", r4, "config", "core.hooksPath", ".githooks")
        sh("python3", here, "install", r4)
        check("hooksPath respected", os.path.exists(os.path.join(r4, ".githooks", "pre-commit")), True)
        check("default hooks dir untouched", os.path.exists(os.path.join(r4, ".git", "hooks", "pre-commit")), False)

        # --all
        base = os.path.join(tmp, "many")
        for n in ("x", "y/z"):
            os.makedirs(os.path.join(base, n))
            sh("git", "init", "-q", os.path.join(base, n))
        os.makedirs(os.path.join(base, "plain"))
        p = sh("python3", here, "install", "--all", base)
        check("--all installs in every repo", "installed in 2 of 2" in p.stdout, True)
        check("--all hook exists", os.path.exists(os.path.join(base, "y", "z", ".git", "hooks", "pre-push")), True)
        p = sh("python3", here, "uninstall", "--all", base)
        check("--all uninstalls", os.path.exists(os.path.join(base, "x", ".git", "hooks", "pre-commit")), False)

        # file mode and stdin
        write(tmp, "f.txt", "x " + keys["slack-token (xox)"] + "\n")
        check("--file blocks", sh("python3", here, "scan", "--file", os.path.join(tmp, "f.txt")).returncode, 1)
        check("--stdin blocks", sh("python3", here, "scan", "--file", "n.txt", "--stdin",
                                   inp=keys["slack-token (xox)"]).returncode, 1)

        # gitleaks: a stub on PATH reports line 2 of whatever it is fed
        stub = os.path.join(nogl, "gitleaks")
        write(nogl, "gitleaks", '#!/bin/sh\ncat >/dev/null\nwhile [ $# -gt 0 ]; do [ "$1" = --report-path ] && out=$2; shift; done\n'
              'printf \'[{"RuleID":"generic-api-key","StartLine":2}]\' > "$out"\n')
        os.chmod(stub, 0o755)
        found = scan_text("one\ntwo\nthree\n", "g.txt")
        check("gitleaks findings are added", found, [("g.txt", 2, "gitleaks:generic-api-key")])
        both = scan_text("one\n" + keys["npm-token (npm_)"] + "\n", "g.txt")
        check("same line reported once", [(f[0], f[1]) for f in both], [("g.txt", 2)])
    finally:
        os.environ["PATH"] = saved_path
        shutil.rmtree(tmp, ignore_errors=True)
    print("self-test: ok" if failures == 0 else f"self-test: {failures} failed")
    return 1 if failures else 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    sys.exit(main(sys.argv[1:]))
