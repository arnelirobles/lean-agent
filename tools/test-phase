        rc, out, _ = rdrain()
        if runs_of("Apple.csproj")[-1:] != [("full", "")] or runs_of("Plain.csproj") != [("full", "dev")]:
            fails.append(f"apple job local, plain job remote: {runs_of('Apple.csproj')} {runs_of('Plain.csproj')} {out}")
        if any("Apple.csproj" in l and not l.startswith("rrepo ") for l in rlog("where.log").splitlines()):
            fails.append(f"a remote lane ran an apple job: {rlog('where.log')!r}")

        # A vitest job on a host: the copy leaves node_modules behind and the container gets LEAN_PNPM_VERSION.
        for f in ("web/package.json", "web/pnpm-lock.yaml", "web/node_modules/x/i.js"):
            os.makedirs(os.path.dirname(os.path.join(rrepo, f)), exist_ok=True)
            open(os.path.join(rrepo, f), "w").write("{}\n")
        vj = qadd(rrepo, "web/package.json", "--cycle", "r2v")
        subprocess.run([sys.executable, BRAIN, "queue", "route", vj, "--to", "remote"], env=env, capture_output=True)
        rc, out, _ = rdrain(e=dict(renv, LEAN_PNPM_VERSION="9"))
        shutil.rmtree(os.path.join(rrepo, "web"))
        if "./web/package.json" not in rlog("nfiles.log") or "node_modules" in rlog("nfiles.log") \
                or "node_modules" in rlog("rsync.log"):
            fails.append(f"a vitest copy to the host must leave node_modules behind ({rc}): {rlog('nfiles.log')!r} {out}")
        if "-e LEAN_PNPM_VERSION=9" not in rlog("docker.log"):
            fails.append(f"a vitest container must get LEAN_PNPM_VERSION: {rlog('docker.log')!r}")

        # An idle lane keeps polling while another lane works: the local lane finds nothing, then an apple job
        # arrives while the remote lane is still on its job, and the drain still ends.
        slow = qadd(rrepo, "tests/Apple/Apple.csproj", "--platform", "none", "--cycle", "r2b")
        subprocess.run([sys.executable, BRAIN, "queue", "route", slow, "--to", "remote"], env=env, capture_output=True)
        reset()
        proc = subprocess.Popen([sys.executable, os.path.realpath(__file__)], env=dict(renv, TEST_PHASE_POLL="0.3"),
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        time.sleep(1.5)
        late = qadd(rrepo, "tests/TPlain/TPlain.csproj", "--platform", "apple", "--cycle", "r2b")
        try:
            out = proc.communicate(timeout=30)[0]
        except subprocess.TimeoutExpired:
            proc.kill()
            out = proc.communicate()[0] + " (killed, the drain did not end)"
        c = sqlite3.connect(env["LEAN_BRAIN_DB"])
        started = c.execute("SELECT started_at FROM jobs WHERE id=?", (int(late),)).fetchone()[0] or ""
        ended = c.execute("SELECT ended_at FROM jobs WHERE id=?", (int(slow),)).fetchone()[0] or ""
        c.close()
        # The drainer looks at the queue again once a drain ends, so the late job runs either way; with the
        # fix it starts while the remote job still runs. The slow job takes over 3 s, so whole seconds tell.
        if proc.returncode != 0 or f"job #{slow} done" not in qlist("--cycle", "r2b") \
                or f"job #{late} done" not in qlist("--cycle", "r2b") or runs_of("TPlain.csproj") != [("full", "")] \
                or not started or not started < ended:
            fails.append(f"an idle lane must pick up a job queued while another lane works ({proc.returncode}): "
                         f"{started} !< {ended} {qlist('--cycle', 'r2b')} {out}")

        # A lost connection puts the job back in the queue, is not a test failure, and does not hold the drain.
        open(os.path.join(d, "ssh-fail-run"), "w").close()
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r3")
        lost = qadd(rrepo, "tests/T/Lost.csproj", "--cycle", "r3")
        rc, out, secs = rdrain()
        os.remove(os.path.join(d, "ssh-fail-run"))
        if "back to queued" not in out or rc != 0 or secs > 60:
            fails.append(f"a lost connection must requeue the job and end the drain in seconds ({rc}, {secs:.0f}s): {out}")
        if "Lost" in brain_list() or runs_of("Lost.csproj") != [("full", "")] \
                or f"job #{lost} done" not in qlist("--cycle", "r3"):
            fails.append(f"the requeued job runs on the local lane and files no failure: {brain_list()!r} {runs_of('Lost.csproj')}")
        if leftovers() != ([], []):
            fails.append(f"cleanup must run after a lane problem: {leftovers()}")

        # A failing test reruns on the same host; the rerun's row carries the host too; cleanup follows a fail.
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r4")
        qadd(rrepo, "tests/T/Fail.csproj", "--cycle", "r4")
        rc, out, _ = rdrain()
        if rc != 1 or runs_of("Fail.csproj") != [("full", "dev"), ("rerun", "dev")] \
                or "Acme.RemoteTests.Breaks" not in brain_list("--open") or leftovers() != ([], []):
            fails.append(f"remote fail and rerun ({rc}): {runs_of('Fail.csproj')} {leftovers()} {out}")

        # A host whose Docker is down is an environment blocker, not test failures, and its lane rests.
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r4b")
        qadd(rrepo, "tests/T/Docker.csproj", "--cycle", "r4b")
        rc, out, _ = rdrain()
        if rc != 1 or "lane remote-dev rests: environment: docker unavailable" not in out \
                or "environment: docker unavailable: tests/T/Docker.csproj" not in brain_list("--kind", "blocker") \
                or "Acme.DockerTests" in brain_list("--kind", "test-fail") or runs_of("Docker.csproj") != [("full", "dev")]:
            fails.append(f"a remote environmental result must be one blocker and rest the lane ({rc}): {out}")

        # A stall on the host is stopped, noted, and cleaned up after. The window counts the copy and the
        # container setup too, which on a loaded machine can pass 3 s before the test starts.
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r5")
        qadd(rrepo, "tests/T/Stall.csproj", "--cycle", "r5")
        rc, out, _ = rdrain("--stall", "10")
        if rc != 1 or "stalled: tests/T/Stall.csproj" not in brain_list("--kind", "note") or leftovers() != ([], []) \
                or runs_of("Stall.csproj") != [("full", "dev")]:
            fails.append(f"remote stall ({rc}): {runs_of('Stall.csproj')} {leftovers()} {out}")

        # TEST_PHASE_REMOTES=off is today's behavior: one lane, no ssh.
        qadd(rrepo, "tests/T/Off.csproj", "--cycle", "r6")
        rc, out, _ = rdrain(e=dict(renv, TEST_PHASE_REMOTES="off"))
        if rc != 0 or rlog("ssh.log") or runs_of("Off.csproj") != [("full", "")] or "lanes" in out:
            fails.append(f"remotes off must not touch ssh ({rc}): {rlog('ssh.log')!r} {out}")

        # A kept build: two jobs on one commit build once, a new commit or a changed file builds again, and only
        # the newest build_keep folders stay. reuse_build = no above is the off switch, and the tests before this
        # ran on per-job folders.
        urepo, hostwork2, ini2 = (os.path.join(d, x) for x in ("urepo", "hostwork2", "remotes2.ini"))
        os.makedirs(os.path.join(urepo, "tests", "T"))
        open(os.path.join(urepo, "tests", "T", "Reuse.csproj"), "w").write(net)
        open(os.path.join(urepo, "Code.cs"), "w").write("class A {}\n")
        git = lambda *g: subprocess.run(["git", "-C", urepo, "-c", "user.name=t", "-c", "user.email=t@example.com", *g],
                                        check=True, capture_output=True)
        git("init", "-q")
        git("add", "-A")
        git("commit", "-q", "-m", "one")
        open(ini2, "w").write(f"[remote dev]\nhost = devbox\nworkdir = {hostwork2}\ncpus = 2\nmemory = 8g\n"
                              f"min_free_gb = 0\nbuild_keep = 2\n\n[repo urepo]\nenv_file = {d}/rrepo.env\n")
        uenv = dict(renv, TEST_PHASE_REMOTES_FILE=ini2)

        def reuse_drain(cycle, *classes, e=None):
            for c in classes:
                job = qadd(urepo, "tests/T/Reuse.csproj", "--tier", "fast", "--filter", c, "--cycle", cycle)
                subprocess.run([sys.executable, BRAIN, "queue", "route", job, "--to", "remote"], env=env,
                               capture_output=True)
            rc, out, _ = rdrain(e=dict(uenv, **(e or {})))
            where = rlog("where.log").splitlines()
            builds = [l for l in where if l.split()[0].startswith("build-urepo") and l.split()[1] == "build"]
            tests = [l for l in where if l.split()[0].startswith("build-urepo") and l.split()[1] == "test"]
            copies = [l for l in rlog("rsync.log").splitlines() if l.startswith("files:")]
            return rc, out, len(builds), tests, len(copies)

        rc, out, builds, tests, copies = reuse_drain("u1", "ClassA", "ClassB")
        if rc != 0 or builds != 1 or copies != 1 or len(tests) != 2 or not all("--no-build" in t for t in tests):
            fails.append(f"two jobs on one commit must build and copy once, then test with --no-build "
                         f"({rc}): builds={builds} copies={copies} {tests} {out}")
        rc, out, builds, tests, copies = reuse_drain("u2", "ClassC")
        if rc != 0 or builds != 0 or copies != 0 or len(tests) != 1 or "--no-build" not in tests[0]:
            fails.append(f"a later job on the same commit must reuse the build ({rc}): builds={builds} copies={copies} {tests}")
        open(os.path.join(urepo, "Code.cs"), "w").write("class A { int x; }\n")
        git("commit", "-q", "-am", "two")
        rc, out, builds, tests, copies = reuse_drain("u3", "ClassA", "ClassB")
        if rc != 0 or builds != 1 or copies != 1 or len(tests) != 2:
            fails.append(f"a new commit must build again ({rc}): builds={builds} copies={copies} {tests} {out}")
        open(os.path.join(urepo, "Code.cs"), "w").write("class A { int y; }\n")
        rc, out, builds, tests, copies = reuse_drain("u4", "ClassA")
        if rc != 0 or builds != 1 or copies != 1:
            fails.append(f"a dirty change on the same commit must build again ({rc}): builds={builds} copies={copies} {out}")
        rc, out, builds, tests, copies = reuse_drain("u5", "ClassA")
        if rc != 0 or builds != 0 or copies != 0 or len(tests) != 1 or not all("--no-build" in t for t in tests):
            fails.append(f"the same dirty tree again must reuse its build ({rc}): builds={builds} copies={copies} {tests}")
        open(os.path.join(urepo, "Code.cs"), "w").write("class A { int z; }\n")
        rc, out, builds, tests, copies = reuse_drain("u6", "ClassA")
        kept_dirs = sorted(f for f in os.listdir(hostwork2) if f.startswith("build-urepo") and not f.endswith(".lock"))
        if builds != 1 or len(kept_dirs) != 2 or any(f.endswith(".lock") for f in os.listdir(hostwork2)):
            fails.append(f"build_keep = 2 must prune older folders and leave no lock: {os.listdir(hostwork2)} builds={builds}")
        if any(f.startswith("job-") for f in os.listdir(hostwork2)):
            fails.append(f"a reused build must not leave a job folder: {os.listdir(hostwork2)}")
        if any(os.path.exists(os.path.join(hostwork2, f, ".lean.env")) for f in os.listdir(hostwork2)) \
                or any(f.startswith("env-") for f in os.listdir(hostwork2)):
            fails.append(f"the env file must not outlive the job in a kept build folder: {os.listdir(hostwork2)}")
        # An argument for the test run only (--logger) cannot go to dotnet build: that job takes a fresh folder.
        # A build-safe one (-c) goes to the build as well.
        before = set(os.listdir(hostwork2))
        rc, out, builds, tests, copies = reuse_drain("u6a", "ClassA", e={"TEST_PHASE_DOTNET_ARGS": "--logger trx"})
        where = rlog("where.log")
        if rc != 0 or builds != 0 or " build " in where or not re.search(r"^job-\d+ test .*--logger trx", where, re.M) \
                or set(os.listdir(hostwork2)) != before:
            fails.append(f"a test-only argument must run in a fresh job folder with no build ({rc}): {where!r} {out}")
        rc, out, builds, tests, copies = reuse_drain("u6b", "ClassA", e={"TEST_PHASE_DOTNET_ARGS": "-c Release"})
        if rc != 0 or builds != 1 or not re.search(r"^build-urepo\S* build \S+ -c Release$", rlog("where.log"), re.M):
            fails.append(f"a build-safe argument goes to dotnet build ({rc}): builds={builds} {rlog('where.log')!r}")
        # A failed build is not recorded: the next job builds again instead of testing a missing build.
        open(os.path.join(d, "dotnet-build-fail"), "w").close()
        open(os.path.join(urepo, "Code.cs"), "w").write("class A { int w; }\n")
        rc, out, builds, tests, copies = reuse_drain("u7", "ClassA")
        os.remove(os.path.join(d, "dotnet-build-fail"))
        rc2, out2, builds2, tests2, _ = reuse_drain("u8", "ClassA")
        if rc == 0 or builds != 1 or builds2 != 1 or any(f.startswith("build-urepo") and f.endswith(".lock")
                                                           for f in os.listdir(hostwork2)):
            fails.append(f"a failed build must not be recorded and must release its lock: {rc} {builds} {builds2} "
                         f"{os.listdir(hostwork2)} {out}")

        # A job left running on a host by a dead drainer: the host's folder and containers go first.
        stale = qadd(rrepo, "tests/T/Stale.csproj", "--cycle", "r7")
        got = subprocess.run([sys.executable, BRAIN, "queue", "next", "--host", "dev"], env=env, capture_output=True,
                             text=True).stdout
        os.makedirs(os.path.join(hostwork, f"job-{stale}"), exist_ok=True)
        os.makedirs(dockdir, exist_ok=True)
        open(os.path.join(dockdir, f"c-lean-{stale}-run"), "w").write(stale)
        rc, out, _ = rdrain()
        if f'"id": {stale}' not in got or f"job #{stale} failed" not in qlist("--cycle", "r7") \
                or leftovers() != ([], []):
            fails.append(f"a stale remote job needs its host cleaned: {got!r} {qlist('--cycle', 'r7')} {leftovers()}")
    needs_checks(fails)
    if fails:
        print("self-test failed:\n  " + "\n  ".join(fails))
        return 1
    print("self-test passed")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    sys.exit(main(sys.argv[1:]))
