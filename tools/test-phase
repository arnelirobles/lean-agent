LaneProblem = lr.LaneProblem if lr else type("LaneProblem", (Exception,), {})
HEAVY = os.path.join(HERE, "heavy.sh")
BRAIN = os.path.join(HERE, "brain")
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
# MTP prints "failed Name (1s 184ms)" at column 0. The VSTest console logger prints "  Failed Name [3 ms]"
# with exactly two spaces; a deeper indent is an assertion dump ("    Failed = 1,") and is not a test.
FAILED = re.compile(r"^(?:failed|  Failed)\s+(\S.*?)\s*$")
DURATION = re.compile(r"\s+\((?:\d+(?:\.\d+)?\s*(?:ms|s|m|h)\s*)+\)$|\s+\[[^\]]*\]$")
TEST_NAME = re.compile(r"[A-Za-z_][\w`<>+]*(?:\.[\w`<>+]+)+(?:\(.*\))?")
# Arguments that already say where results go or what collects them: a hang run adds its own results folder and
# deletes it, so it must not share one with these.
OWN_OUTPUT = {"--results-directory", "-r", "--logger", "-l", "--collect", "--settings", "-s", "--diag", "-d"}
# VSTest's line is real (captured, SDK 10.0.103). The MTP alternative is a guess: HangDump never fired in a capture.
HANG_FIRED = re.compile(r"The specified inactivity time of \d+ seconds has elapsed|(?i:hang ?dump (?:timeout|.*expired))")
TEST_RESULT_LINE = re.compile(r"^(?:failed|passed|skipped)\s", re.I)
# The hang timeout is this many seconds under the stall timeout, so the hang dump is taken before heavy.sh stops
# the run (at least half the stall timeout, one second at the least).
HANG_MARGIN = 60


class Dotnet:
    name = "dotnet"

    @staticmethod
    def mode(repo):
        forced = os.environ.get("TEST_PHASE_RUNNER")
        if forced in ("mtp", "vstest"):
            return forced
        d = os.path.abspath(repo)
        while True:
            g = os.path.join(d, "global.json")
            if os.path.isfile(g):
                try:
                    runner = json.load(open(g)).get("test", {}).get("runner", "")
                except (ValueError, OSError, AttributeError):
                    runner = ""
                return "mtp" if runner == "Microsoft.Testing.Platform" else "vstest"
            if os.path.dirname(d) == d:
                return "vstest"
            d = os.path.dirname(d)

    @staticmethod
    def classes(cls_filter):
        """The class names in a filter: several may be joined by |, with or without FullyQualifiedName~."""
        cls = [c.strip().removeprefix("FullyQualifiedName~") for c in (cls_filter or "").split("|")]
        return [c for c in cls if c]

    @classmethod
    def command(cls, mode, project, cls_filter=None, fast=False, extra=(), probe=False, hang=()):
        # probe lists instead of running: MTP exits 8 when the filter matches no test, whatever else it names.
        names = cls.classes(cls_filter)
        if any(c.startswith("-") for c in names):  # a piece read as a dotnet option instead of a class
            raise ValueError("a filter piece starts with -")
        # The VSTest console logger prints passed lines too, which is what the watchdog reads as progress.
        if mode == "mtp":
            # The hang arguments go before `--`: after it the SDK 10.0.103 rejected --results-directory as a
            # directory argument, and ignored --list-tests.
            cmd = ["dotnet", "test", "--project", project] + list(extra) + list(hang) + ["--"]
            # --filter-class matches the full class name. The fast tier takes a fragment, and so does a
            # name with no namespace in any tier, hence the wildcards. A rerun passes full names.
            # xunit v3 ORs repeated --filter-class, so one run covers every class (checked on 4.0.0:
            # A, B and C of 2, 1 and 3 tests ran 3 for A+B and 6 for all). It also hides a class that
            # matches nothing while another matches, which the probe run per class catches.
            if probe:
                cmd.append("--list-tests")
            for c in names:
                cmd += ["--filter-class", f"*{c}*" if fast or "." not in c else c]
            return cmd + ["--output", "Detailed"]
        cmd = ["dotnet", "test", project] + list(extra) + ["--logger", "console;verbosity=normal"]
        if names:
            cmd += ["--filter", "|".join("FullyQualifiedName~" + c for c in names)]
        return cmd + list(hang)

    @classmethod
    def hang_args(cls, mode, repo, project, stall, outdir, extra=()):
        """(arguments, why not). Arguments that make the test host name its running tests and write a small
        dump under outdir before the stall watchdog stops the run: the hang timeout is HANG_MARGIN seconds
        under the stall timeout, so the extension fires first. Empty arguments come with the reason, which
        goes into the note that replaces the test-fail item."""
        if os.environ.get("TEST_PHASE_HANGDUMP", "on") == "off":
            return [], "hang dumps are off (TEST_PHASE_HANGDUMP=off)"
        if not stall or stall <= 0:
            return [], "the stall timeout is off, so there is no hang timeout to set"
        mine = [x for x in extra if x.split("=", 1)[0] in OWN_OUTPUT or x.startswith(("--blame", "--collect", "--logger"))]
        if mine:
            return [], f"the extra arguments already set {mine[0]}, so the hang results folder would clash with it"
        t = f"{max(stall - HANG_MARGIN, stall // 2, 1)}s"
        if mode == "vstest":
            return ["--blame-hang-timeout", t, "--blame-hang-dump-type", "mini", "--results-directory", outdir], ""
        if not cls.has_hangdump(repo, project):
            return [], "the test project does not reference Microsoft.Testing.Extensions.HangDump, so --hangdump is not available"
        return ["--hangdump", "--hangdump-timeout", t, "--hangdump-type", "Mini", "--results-directory", outdir], ""

    @staticmethod
    def has_hangdump(repo, project):
        """Whether the project, or a Directory.Build.props, .targets or Directory.Packages.props above it, has a
        PackageReference or PackageVersion whose Include or Update names HangDump, or sets a property named for
        it (MSTest.Sdk's EnableMicrosoftTestingExtensionsHangDump). A comment or other text does not count."""
        top = os.path.abspath(repo)
        d = os.path.dirname(os.path.abspath(os.path.join(repo, project)))
        files = [os.path.join(repo, project)]
        while True:
            files += [os.path.join(d, n) for n in ("Directory.Build.props", "Directory.Build.targets", "Directory.Packages.props")]
            if d == top or os.path.dirname(d) == d:
                break
            d = os.path.dirname(d)
        for f in files:
            try:
                root = ET.parse(f).getroot()
            except (OSError, ET.ParseError):
                continue
            for el in root.iter():
                tag = el.tag.rsplit("}", 1)[-1] if isinstance(el.tag, str) else ""
                if tag in ("PackageReference", "PackageVersion") and \
                        "hangdump" in (el.get("Include", "") + el.get("Update", "")).lower():
                    return True
                if "hangdump" in tag.lower() and (el.text or "").strip().lower() == "true":
                    return True
        return False

    @classmethod
    def hang_names(cls, mode, text, outdir):
        """(test names still running when the hang timeout fired, where they came from, files in outdir, whether a
        dump file is among them).
        VSTest writes a Sequence xml: tests marked Completed="False" are running, and without that mark the last
        one listed is. MTP's own output is read for a list that follows a hang dump line; so are small text
        files in outdir. Dump files are never opened."""
        found = []
        for dirpath, _, names in os.walk(outdir):
            found += [os.path.join(dirpath, n) for n in sorted(names)]
        out, source = [], ""
        if mode == "vstest":
            for f in found:
                if "sequence" in os.path.basename(f).lower() and f.lower().endswith(".xml"):
                    out, source = cls.sequence_names(open(f, errors="replace").read()), "blame-hang sequence file"
                    if out:
                        break
        else:
            texts = [("hang dump output", ANSI.sub("", text))]
            for f in found:
                if not f.lower().endswith((".dmp", ".core")) and os.path.getsize(f) < 2_000_000:
                    texts.append(("hang dump report", ANSI.sub("", open(f, errors="replace").read())))
            for label, t in texts:
                out = cls.hang_listing(t)
                if out:
                    source = label
                    break
        return out, source, len(found), any(f.lower().endswith((".dmp", ".core")) for f in found)

    @staticmethod
    def sequence_names(xml):
        try:
            tests = [(t.get("DisplayName") or t.get("Name"), t.get("Completed"))
                     for t in ET.fromstring(xml.strip()).iter("Test") if t.get("DisplayName") or t.get("Name")]
        except ET.ParseError:
            return []
        if any(c is not None for _, c in tests):
            running = [n for n, c in tests if (c or "").lower() == "false"]
        else:
            running = [tests[-1][0]] if tests else []
        return list(dict.fromkeys(running))

    @staticmethod
    def hang_listing(text):
        """Test names listed after a line about the running or pending tests, within 40 lines of a hang dump line."""
        lines = text.splitlines()
        out, armed, i = [], 0, 0
        marker = re.compile(r"(?i)\b(pending|in[- ]progress|still running|were running|was running|running)\b.*\btests?\b"
                            r"|\btests?\b.*\b(pending|in[- ]progress|still running|running|hung)\b")
        while i < len(lines):
            l = lines[i].strip()
            if l.startswith("$ "):  # the command line names --hangdump, which is not a report of one
                i += 1
                continue
            if re.search(r"(?i)hang ?dump", l):
                armed = 40
            elif armed:
                armed -= 1
            if armed and marker.search(l) and not TEST_RESULT_LINE.match(l):
                tail = l.split(":", 1)[1] if ":" in l else ""
                for piece in tail.split(","):
                    piece = DURATION.sub("", piece.strip())
                    if TEST_NAME.fullmatch(piece):
                        out.append(piece)
                j = i + 1
                while j < len(lines):
                    item = DURATION.sub("", re.sub(r"^[\s\-*\u2022]+", "", lines[j]).strip())
                    if not item:
                        if out or j > i + 1:
                            break
                    elif TEST_NAME.fullmatch(item):
                        out.append(item)
                    else:
                        break
                    j += 1
                i = j
                continue
            i += 1
        return list(dict.fromkeys(out))

    @staticmethod
    def failures(text):
        """[(test name, the lines that follow it)] in order, each name once."""
        lines = [ANSI.sub("", l).rstrip() for l in text.splitlines()]
        seen, out = set(), []
        for i, l in enumerate(lines):
            m = FAILED.match(l)
            if not m:
                continue
            name = DURATION.sub("", m.group(1))
            if not TEST_NAME.fullmatch(name) or name in seen:
                continue
            seen.add(name)
            end = i + 1
            while end < min(i + 12, len(lines)) and not FAILED.match(lines[end]):
                end += 1
            out.append((name, "\n".join(lines[i:end])))
        return out

    @staticmethod
    def counts(text):
        """(passed, failed, skipped) from the run summary, zeros when there is none."""
        text = ANSI.sub("", text)
        m = re.search(r"Failed:\s*(\d+),\s*Passed:\s*(\d+),\s*Skipped:\s*(\d+)", text)
        if m:
            return int(m.group(2)), int(m.group(1)), int(m.group(3))
        blk = {k.lower(): int(v) for k, v in re.findall(r"^\s*(Total tests|Passed|Failed|Skipped):\s*(\d+)\s*$", text, re.M)}
        if "total tests" in blk:  # the detailed VSTest logger leaves out the lines that are zero
            failed, skipped = blk.get("failed", 0), blk.get("skipped", 0)
            return blk.get("passed", blk["total tests"] - failed - skipped), failed, skipped
        got = {k.lower(): int(v) for k, v in re.findall(r"^\s*(total|failed|succeeded|skipped):\s*(\d+)", text, re.M)}
        if got:
            return got.get("succeeded", 0), got.get("failed", 0), got.get("skipped", 0)
        return 0, 0, 0

    @staticmethod
    def class_of(test):
        base = re.split(r"[(\[]", test, maxsplit=1)[0]
        return base.rsplit(".", 1)[0] if "." in base else base


VITEST_FAIL = re.compile(r"^\s*[\u00d7\u2717\u2718x]\s+(?:\|[^|]*\|\s*)?(\S.*?)\s*$")
VITEST_FAIL_BLOCK = re.compile(r"^\s*FAIL\s+(?:\|[^|]*\|\s*)?(\S.*?)\s*$")
VITEST_TIME = re.compile(r"\s+\d+(?:\.\d+)?\s*m?s$")
VITEST_RETRY = re.compile(r"\s+\((?:retry|repeat) x\d+\)$")
VITEST_FILE = re.compile(r"(?:(?! > | \[ ).)+?\.[cm]?[jt]sx?(?: > | \[ |$)")
VITEST_SCRIPT = """R=$PWD
cd -- "$1" || exit 2
shift
T=$0
# A pnpm-lock.yaml anywhere from the package folder up to the repo root means pnpm. Otherwise the nearest
# package-lock.json means npm, and the nearest yarn.lock is refused (package-lock.json first in one folder).
L=; N=; NK=; d=$PWD
while :; do
  [ -f "$d/pnpm-lock.yaml" ] && L=$d && break
  if [ -z "$NK" ]; then
    for f in package-lock.json yarn.lock; do
      if [ -f "$d/$f" ]; then N=$d; NK=$f; break; fi
    done
  fi
  [ "$d" = "$R" ] || [ "$d" = / ] && break
  d=$(dirname "$d")
done
# A package.json with a "test" script runs that script: it may set --root, the time zone or other flags that a bare
# vitest run from this folder would miss. Extra arguments (the reporter, file filters) go after it.
S=
if [ "$T" = vitest ] && [ -n "$(node -p "(require('./package.json').scripts||{}).test?1:''" 2>/dev/null)" ]; then S=1; fi
case "$T" in
  vitest) if [ -n "$S" ]; then set -- --reporter=verbose "$@"; else set -- vitest run --reporter=verbose "$@"; fi ;;
  playwright) set -- playwright test --reporter=list "$@" ;;
esac
if [ -z "$L" ] && [ "$NK" = yarn.lock ]; then
  echo "run-failed: found yarn.lock; test-phase runs package.json and Playwright jobs with pnpm or npm only" >&2
  exit 2
fi
if [ -z "$L" ] && [ "$NK" = package-lock.json ]; then
  W=$PWD
  # npm ci deletes node_modules, so it runs only when they are missing or older than the lockfile.
  M=$N/node_modules/.package-lock.json
  if [ ! -f "$M" ] || [ -n "$(find "$N/package-lock.json" -newer "$M")" ]; then
    cd -- "$N" && npm ci || exit $?
    cd -- "$W" || exit 2
  fi
  [ -n "$S" ] && exec npm test -- "$@"
  exec npx --no-install "$@"
fi
# Without a packageManager field corepack takes the newest pnpm, which can refuse a lockfile an older one wrote.
if command -v pnpm >/dev/null 2>&1; then P=pnpm
elif grep -q '"packageManager"' package.json 2>/dev/null; then P="corepack pnpm"
else P="corepack pnpm@${LEAN_PNPM_VERSION:-10}"; fi
if [ -n "$L" ]; then $P install --frozen-lockfile || exit $?; else $P install || exit $?; fi
[ -n "$S" ] && exec $P run test "$@"
exec $P exec "$@"
"""


def node_files(cls_filter):
    """The filter pieces (split on |) as file filters; a piece that starts with - would be read as an option."""
    files = [c.strip() for c in (cls_filter or "").split("|")]
    files = [c for c in files if c]
    if any(c.startswith("-") for c in files):
        raise ValueError("a filter piece starts with -")
    return files


class Vitest:
    name = "vitest"
    # heavy.sh counts "passed"/"failed" lines as progress; vitest's verbose lines start with a mark instead.
    progress = r"^\s*[\u2713\u00d7\u2717\u2718\u2193]\s.*|^Progress: .*|^Packages: .*"

    @staticmethod
    def mode(repo):
        return "vitest"

    @staticmethod
    def command(mode, project, cls_filter=None, fast=False, extra=(), probe=False):
        """A shell that goes to the project folder, installs with the lockfile (pnpm or npm) and runs vitest. Each filter
        piece (split on |) is a file filter; with none, everything runs."""
        files = node_files(cls_filter)
        return ["sh", "-c", VITEST_SCRIPT, "vitest", os.path.dirname(project) or "."] + list(extra) + files

    @staticmethod
    def failures(text):
        """[(test name, the lines that follow it)] in order, each name once. A name is file > suite > test.
        The FAIL block after the run has the stack, so its lines win over the one-line reason."""
        lines = [ANSI.sub("", l).rstrip() for l in text.splitlines()]
        first, blocks = {}, {}
        for i, l in enumerate(lines):
            for rx, into in ((VITEST_FAIL, first), (VITEST_FAIL_BLOCK, blocks)):
                m = rx.match(l)
                if m:
                    name = m.group(1)
                    if into is first:  # only the one-line result carries a duration and a retry count
                        name = VITEST_TIME.sub("", VITEST_RETRY.sub("", name))
                    if VITEST_FILE.match(name):
                        end = i + 1
                        while end < min(i + 12, len(lines)) and not VITEST_FAIL.match(lines[end]) \
                                and not VITEST_FAIL_BLOCK.match(lines[end]):
                            end += 1
                        into.setdefault(name, "\n".join(lines[i:end]))
        return [(n, blocks.get(n) or first.get(n, "")) for n in list(first) + [b for b in blocks if b not in first]]

    @staticmethod
    def counts(text):
        """(passed, failed, skipped) from the "Tests  N failed | M passed | K skipped (T)" line, else zeros."""
        found = re.findall(r"^\s*Tests\s+(\d.*)$", ANSI.sub("", text), re.M)
        if not found:
            return 0, 0, 0
        n = {k: int(v) for v, k in re.findall(r"(\d+) (failed|passed|skipped|todo)", found[-1])}
        return n.get("passed", 0), n.get("failed", 0), n.get("skipped", 0) + n.get("todo", 0)

    @staticmethod
    def class_of(test):
        return re.split(r" > | \[ ", test, maxsplit=1)[0]


PW_FAIL = re.compile(r"^\s*[\u2718\u00d7x]\s+\d+\s+(\S.*?)\s*$")
PW_PASS = re.compile(r"^\s*(?:\u2713|ok)\s+\d+\s+(\S.*?)\s*$")
PW_BLOCK = re.compile(r"^\s*\d+\)\s+(\S.*?)(?:\s+\u2500+)?\s*$")
PW_SUMMARY = re.compile(r"^\s*\d+\s+(?:failed|flaky|passed|skipped|did not run|interrupted)\b")
PW_TIME = re.compile(r"\s+\(\d+(?:\.\d+)?(?:ms|s|m|h)(?:\s+\d+(?:\.\d+)?(?:ms|s|m|h))*\)$")
PW_RETRY = re.compile(r"\s+\((?:retry|repeat) #\d+\)$")
PW_PROJECT = re.compile(r"^\[[^\]]*\]\s+\u203a\s+")
PW_WHERE = re.compile(r"^(.+?\.[cm]?[jt]sx?):\d+:\d+(?=$| \u203a )")


class Playwright:
    """Playwright's list reporter. A test is named file \u203a title, without the project, the line and column,
    the retry suffix or the time, so the file is the class and a rerun is per spec file."""
    name = "playwright"
    progress = r"^\s*(?:[\u2713\u2718\u00d7x-]|ok)\s+\d+\s.*|^Progress: .*|^Packages: .*"

    @staticmethod
    def mode(repo):
        return "playwright"

    @staticmethod
    def command(mode, project, cls_filter=None, fast=False, extra=(), probe=False):
        """A shell that goes to the config folder, installs with the lockfile (pnpm or npm) and runs
        playwright test with the list reporter. Each filter piece (split on |) is a file filter."""
        # Playwright reads each file argument as a regular expression, so a path is escaped to match itself.
        files = [re.sub(r"[.*+?^${}()|\[\]\\]", r"\\\g<0>", f) for f in node_files(cls_filter)]
        return ["sh", "-c", VITEST_SCRIPT, "playwright", os.path.dirname(project) or "."] + list(extra) + files

    @staticmethod
    def parse_name(raw, timed=True):
        """(project, file \u203a title) from what follows the mark and the number, or None when it is not a test line."""
        name = PW_RETRY.sub("", PW_TIME.sub("", raw)) if timed else raw
        name = name.strip()
        pm = PW_PROJECT.match(name)
        project = pm.group(0) if pm else ""
        m = PW_WHERE.match(name[len(project):])
        return (project, m.group(1) + name[len(project) + m.end():]) if m else None

    @staticmethod
    def test_name(raw, timed=True):
        """file \u203a title without the project, or None when it is not a test line."""
        got = Playwright.parse_name(raw, timed)
        return got[1] if got else None

    @staticmethod
    def failures(text):
        """[(test name, the lines that follow it)] in order, each name once. A test that failed and then passed on
        a retry in the same project is flaky, not a failure. The numbered block after the run has the error, so it
        wins. The project is part of the flaky check and not of the name."""
        lines = [ANSI.sub("", l).rstrip() for l in text.splitlines()]
        first, blocks, last_fail, last_pass = {}, {}, {}, {}
        for i, l in enumerate(lines):
            for rx, into, timed in ((PW_FAIL, first, True), (PW_BLOCK, blocks, False)):
                m = rx.match(l)
                got = Playwright.parse_name(m.group(1), timed) if m else None
                if got:
                    end = i + 1
                    while end < min(i + 12, len(lines)) and not PW_FAIL.match(lines[end]) \
                            and not PW_BLOCK.match(lines[end]) and not PW_SUMMARY.match(lines[end]):
                        end += 1
                    into.setdefault(got, "\n".join(lines[i:end]))
                    if into is first:
                        last_fail[got] = i
            m = PW_PASS.match(l)
            got = Playwright.parse_name(m.group(1)) if m else None
            if got:
                last_pass[got] = i
        out = {}
        for key in list(first) + [b for b in blocks if b not in first]:
            if last_pass.get(key, -1) > last_fail.get(key, 1 << 30):
                continue
            out.setdefault(key[1], blocks.get(key) or first.get(key, ""))
        return list(out.items())

    @staticmethod
    def counts(text):
        """(passed, failed, skipped) from the summary lines "N failed", "N flaky", "N skipped", "N passed (T)".
        A flaky test passed in the end, so it counts as passed."""
        n = {}
        for v, k in re.findall(r"^\s*(\d+)\s+(failed|flaky|passed|skipped|did not run|interrupted)\b", ANSI.sub("", text), re.M):
            n[k] = int(v)
        return n.get("passed", 0) + n.get("flaky", 0), n.get("failed", 0) + n.get("interrupted", 0), \
            n.get("skipped", 0) + n.get("did not run", 0)

    @staticmethod
    def class_of(test):
        return test.split(" \u203a ", 1)[0]


RUNNERS = [Dotnet, Vitest, Playwright]


def skips_node_modules(runner):
    """Whether a copy to a remote host leaves node_modules behind."""
    return runner in (Vitest, Playwright)


PLAYWRIGHT_CONFIG = re.compile(r"^playwright\.config\.(?:ts|js|mjs|cjs)$")


def tp_name(path):
    """How a test project is named in runs and tags: its file name, and for a package.json or a Playwright
    config its folder too."""
    base = os.path.basename(path)
    return os.path.join(os.path.basename(os.path.dirname(path)), base) if (base == "package.json"
        or PLAYWRIGHT_CONFIG.match(base)) and os.path.dirname(path) else base


def runner_for(test_project):
    """Vitest for a package.json, Playwright for a playwright.config file, Dotnet for everything else."""
    base = os.path.basename(test_project)
    if PLAYWRIGHT_CONFIG.match(base):
        return Playwright
    return Vitest if base == "package.json" else Dotnet


class Lane:
    """One place jobs run: the local machine, or one SSH host."""

    def __init__(self, name, where, remote=None, repos=None):
        self.name, self.where, self.remote = name, where, remote
        self.repos = {k.lower(): v for k, v in (repos or {}).items()}


LOCAL = Lane("local", "local")


class Hold:
    """A job's claim on its heavy.sh lane: taken at its first command and kept to its last, so the alone
    reruns are not queued behind another session's run."""

    def __init__(self, lane):
        self.lane, self.fd, self.path, self.claim, self.error = lane, None, None, "", ""
        self.ok = bool(hl) and bool(re.fullmatch(r"[A-Za-z0-9._-]+", lane))

    def take(self, wait):
        """Seconds spent waiting (0 once held), or None when the lane stayed busy for wait seconds."""
        if self.fd is not None:
            return 0.0
        d = os.environ.get("HEAVY_LOCK_DIR") or "/tmp/heavy-locks"
        os.makedirs(d, exist_ok=True)
        t0 = time.monotonic()
        self.path = os.path.join(d, self.lane + ".lock")
        self.fd = hl.acquire(self.path, wait)
        if self.fd is None:
            return None
        try:
            self.claim = hl.claim(self.path)
        except OSError as e:  # no claim file (a symlink or a stranger's file there): give the lane back and let
            self.release()    # heavy.sh take it command by command, as without a hold
            self.ok, self.error = False, str(e)
            return 0.0
        return time.monotonic() - t0

    def release(self):
        if self.fd is not None:
            hl.unclaim(self.path)
            os.close(self.fd)
            self.fd, self.claim = None, ""


def heavy(lane, cmd, cwd, log, stall, header=None, hold=None, fail_stall=0, progress=None):
    """Run cmd in the lane. Returns (exit code, output, started, ended, seconds spent waiting for the lane)."""
    env = dict(os.environ)
    env.setdefault("HEAVY_WAIT", "3600")
    if stall:
        env["HEAVY_STALL"] = str(stall)
    else:
        env.pop("HEAVY_STALL", None)
    if fail_stall:
        env["HEAVY_FAIL_STALL"] = str(fail_stall)
    else:
        env.pop("HEAVY_FAIL_STALL", None)
    env.pop("HEAVY_HELD", None)
    if progress:
        env["HEAVY_PROGRESS"] = progress
    timing = log + ".wait"
    env["HEAVY_TIMING_FILE"] = timing
    started = int(time.time())
    held = hold if hold and hold.ok and env["HEAVY_WAIT"].isdigit() else None
    waited = None
    if held:
        waited = held.take(int(env["HEAVY_WAIT"]))
        if waited is None:  # what heavy.sh itself says when the lane stays busy, so a busy job reads the same
            text = (header if header is not None else "$ " + " ".join(shlex.quote(c) for c in cmd) + "\n") \
                + f"heavy.sh: timed out after {env['HEAVY_WAIT']}s waiting for lane '{lane}'. Nothing ran.\n"
            open(log, "w").write(text)
            return 75, text, started, int(time.time()), float(env["HEAVY_WAIT"])
        if held.claim:
            env["HEAVY_HELD"] = held.claim
        else:
            sys.stderr.write(f"test-phase: no lane hold for '{lane}' (claim failed: {held.error}); "
                             "locking command by command\n")
    with open(log, "w") as fh:
        # The header is always one line, so what follows it is the command's own output.
        fh.write(header if header is not None else "$ " + " ".join(shlex.quote(c) for c in cmd) + "\n")
        fh.flush()
        rc = subprocess.run(["bash", HEAVY, lane] + cmd, cwd=cwd, env=env, stdout=fh,
                            stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode
    ended = int(time.time())
    try:
        wait = float(open(timing).read().strip() or 0)
        os.remove(timing)
    except (OSError, ValueError):
        wait = None
    if held:
        wait = waited
    return rc, open(log, errors="replace").read(), started, ended, wait


def load1():
    try:
        return os.getloadavg()[0]
    except OSError:
        return None


SECRETS = [
    (re.compile(r"(?i)\b(password|pwd)(\s*=\s*)(?:\"[^\"]*\"|'[^']*'|[^;\s\"']+)"), r"\1\2***"),
    (re.compile(r"(?i)\b(api[-_ ]?key)(\s*[=:]\s*)(?:\"[^\"]*\"|'[^']*'|[^;\s\"',]+)"), r"\1\2***"),
    (re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]+"), "Bearer ***"),
    (re.compile(r"\beyJ[A-Za-z0-9_=-]*(?:\.[A-Za-z0-9_=-]*)*"), "***"),
]


def mask(text):
    """Test output can carry connection strings and tokens; none of it goes into brain."""
    for pattern, repl in SECRETS:
        text = pattern.sub(repl, text)
    return text


def brain(args, stdin=None):
    r = subprocess.run([sys.executable, BRAIN] + args, capture_output=True, text=True, input=stdin)
    if r.returncode != 0:
        sys.stderr.write("test-phase: brain failed: " + r.stderr.strip() + "\n")
        return None
    return r.stdout.strip()


def requeue_job(job_id, problem, say):
    """Put a running job back in the queue. One retry; a loud line when it still fails. True when requeued."""
    for _ in range(2):
        if brain(["queue", "requeue", str(job_id), "--reason", problem[:200]]) is not None:
            return True
    say(f"test-phase: job #{job_id} is STUCK running: brain would not requeue it ({problem[:120]})")
    return False


def add_item(row, kind, ref, severity, body, run_id, ctx, tags=()):
    ref = mask(ref)
    args = ["add", "--project", row["project"], "--repo", ctx["repo"], "--kind", kind, "--ref", ref,
            "--title", ref, "--body-file", "-", "--severity", severity, "--phase", "test", "--source", "test-phase",
            "--cycle", ctx["cycle"]]
    if row.get("session"):
        args += ["--session", row["session"], "--session-cwd", row.get("session_cwd", "")]
    if ctx["branch"]:
        args += ["--branch", ctx["branch"]]
    if run_id:
        args += ["--run-id", str(run_id)]
    for t in tags:
        args += ["--tag", t]
    brain(args, stdin=mask(body))  # the body goes by stdin, not argv, where any user's ps could read it


def record_run(row, ctx, tier, mode, rc, text, started, ended, wait, load_start, project, lane=LOCAL, stalled=False):
    passed, failed, skipped = ctx["runner"].counts(text)
    load_end = lr.remote_load(lane.remote) if lane.remote else load1()
    out = brain(["run-add", "--cycle", ctx["cycle"], "--project", row["project"], "--repo", ctx["repo"],
                 "--test-project", tp_name(project), "--runner", mode, "--tier", tier,
                 "--started", str(started), "--ended", str(ended), "--passed", str(passed),
                 "--failed", str(failed), "--skipped", str(skipped), "--stalled", "1" if rc in (76, 78) or stalled else "0",
                 "--exit-code", str(rc)]
                + (["--host", lane.remote.name] if lane.remote else [])
                + (["--lane-wait", str(wait)] if wait is not None else [])
                + (["--load-start", "%.2f" % load_start] if load_start is not None else [])
                + (["--load-end", "%.2f" % load_end] if load_end is not None else []))
    return int(out) if out and out.isdigit() else None


def current_branch(repo):
    r = subprocess.run(["git", "-C", repo, "branch", "--show-current"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def parse_plan(path):
    entries = []
    for n, raw in enumerate(open(path), 1):
        raw = raw.strip()
        if not raw or raw.startswith("#"):
            continue
        parts = shlex.split(raw)
        extra = [x[len("args="):] for x in parts[2:] if x.startswith("args=")]
        again = [x[len("again="):] for x in parts[2:] if x.startswith("again=")]
        parts = parts[:2] + [x for x in parts[2:] if not x.startswith(("args=", "again="))]
        if len(parts) not in (2, 3) or len(extra) > 1 or len(again) > 1:
            sys.exit(f"test-phase: {path} line {n}: want <repo-dir> <test project path> [fast-filter] [args=EXTRA] [again=REASON]")
        entries.append(parts + [None] * (3 - len(parts)) + [extra[0] if extra else "", again[0] if again else ""])
    if not entries:
        sys.exit(f"test-phase: {path} lists no projects, so nothing would run")
    return entries


def safe(s):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", s).strip("_")[:60]


def tier_note(rc, hung=False):
    return "stalled" if hung else {0: "pass", 75: "busy", 76: "stalled", 78: "stalled-failing"}.get(rc, "fail")


def signal_of(rc):
    """The signal that ended a command, or 0. heavy.sh reports a kill as 128 + n; a negative code is a bash that
    was itself killed."""
    if rc < 0:
        return -rc
    return rc - 128 if 129 <= rc <= 159 else 0


STALL_FACTS = re.compile(r"^heavy\.sh: stalled(?:-failing)?: .*\(passed (\d+), failed (\d+), last test: (.*)\)\s*$", re.M)


def stall_facts(text):
    """(passed, failed, last test) from heavy.sh's stall message, or None."""
    found = STALL_FACTS.findall(text)
    return (int(found[-1][0]), int(found[-1][1]), found[-1][2]) if found else None


def close_blockers(row, ctx, project):
    """Close this project's open environment and test-needs blockers on this branch. A full run passed, so both are over."""
    where = row["project"] + ("@" + ctx["branch"] if ctx["branch"] else "")
    text = brain(["list", "--open", "--kind", "blocker", "--project", row["project"]]) or ""
    closed = 0
    for m in re.finditer(r"^#(\d+) open \S+ (\S+) (.+?) (?:minor|important|info) occ=", text, re.M):
        ref = m.group(3)
        if m.group(2) == where and (ref == f"test-needs: {project}"
                                    or (ref.startswith("environment: ") and ref.endswith(f": {project}"))):
            if brain(["close", m.group(1), "--resolution", "fixed", "--note", "a full run of the test project passed"]) is not None:
                closed += 1
    return closed


def earlier_items(row, ctx):
    """Item ids by test name: this branch's open flaky items, and its open order-dependent test-fails."""
    where = row["project"] + ("@" + ctx["branch"] if ctx["branch"] else "")
    mine = "tp:" + tp_name(row["test"])  # a name can repeat in another test project: that is no history
    out = {"flaky": {}, "order": {}, "shared": set()}
    for kind, key, extra in (("flaky", "flaky", []), ("test-fail", "order", ["--tag", "order-dependent"])):
        text = brain(["list", "--open", "--kind", kind, "--project", row["project"]] + extra) or ""
        for m in re.finditer(r"^#(\d+) open \S+ (\S+) (.+?) (?:minor|important) occ=\d+ last=\S+(?: tags=(\S+))?$",
                             text, re.M):
            tags = (m.group(4) or "").split(",")
            if m.group(2) == where and mine in tags:
                out[key][m.group(3)] = int(m.group(1))
                if any(t.startswith("tp:") and t != mine for t in tags):
                    out["shared"].add(int(m.group(1)))  # another test project saw this name too
    return out


def hang_seen(runner, text):
    """The counts a hung run printed. A hung run prints no summary, so these are often zero: say so."""
    p, f, _ = runner.counts(text)
    return f"{p} passed, {f} failed before the hang" if p or f else "no counts, the run did not finish"


def hang_fired(text, dumped):
    """Whether the hang timer fired: a dump file was written, or the output says so. A Sequence file alone is not
    evidence, because the blame collector writes one on a crash too."""
    body = "\n".join(l for l in ANSI.sub("", text).splitlines() if not l.startswith("$ "))
    return bool(dumped or HANG_FIRED.search(body))


def is_hang(hang, rc):
    """A run the hang timeout ended: names, the timer fired, and not a pass, a busy lane or heavy.sh's own
    failing-only stop. A signal exit is still a hang when the timer fired; one without it is a crash."""
    return bool(hang.get("names")) and bool(hang.get("fired")) and rc not in (0, 75, 78)


def no_name_reason(hang, text):
    """Why a stalled run has no test name, for the note that stays."""
    if hang.get("why"):
        return hang["why"]
    if "names" not in hang:
        return "this run was not started with a hang timeout (remote lane or not a .NET run)"
    if hang.get("files") or "createdump" in text:
        return "the hang dump was written and deleted, but no test name could be read from it or from the run's output"
    return "no hang dump was written before the stall timeout, so the run printed no test names"


def file_hang(row, hang, a, run_id, ctx, stem, seen):
    """One test-fail item per test the hang dump named as still running. A test already open as a hang on this
    branch hung on an earlier run too, so it is tagged hang-repeat: not load."""
    where = row["project"] + ("@" + ctx["branch"] if ctx["branch"] else "")
    before = set()
    text = brain(["list", "--open", "--kind", "test-fail", "--project", row["project"], "--tag", "hang"]) or ""
    for m in re.finditer(r"^#(\d+) open \S+ (\S+) (.+?) (?:minor|important) occ=\d+ last=\S+(?: tags=(\S+))?$", text, re.M):
        if m.group(2) == where:
            before.add(m.group(3))
    names = hang["names"]
    row["notes"].append(f"hung: {', '.join(names[:3])}" + (f" and {len(names) - 3} more" if len(names) > 3 else ""))
    for n in names:
        again = n in before
        body = (f"hung again: this test was running when the hang timeout fired on an earlier run too, so this is a hang, "
                f"not load. " if again else
                f"hung: this test was still running after {a.stall} s without test progress. ") \
            + f"Named by the {hang['source']}. {seen}. Log: {stem}.log"
        add_item(row, "test-fail", n, "important", body, run_id, ctx,
                 tags=("hang", "hang-repeat") if again else ("hang",))
    row["real"] += len(names)


def file_results(row, labelled, a, run_id, ctx, stem):
    """File what the reruns showed. Many tests that failed together and passed alone are one isolation item."""
    project = row["test"]
    flaky = [n for n, label, _ in labelled if label == "flaky"]
    isolated = len(flaky) > a.isolation_over
    if isolated:
        row["notes"].append(f"isolation: {len(flaky)} tests failed together and passed alone")
        add_item(row, "isolation", f"isolation: {project}", "important",
                 f"{len(flaky)} tests failed in one run and every one passed alone, more than {a.isolation_over}. "
                 f"That is a leak between tests, not {len(flaky)} flaky tests. Log: {stem}.log\n" + "\n".join(flaky),
                 run_id, ctx)
    earlier = earlier_items(row, ctx) if flaky and not isolated and row["tier"] == "full" and not row["filtered"] else {"flaky": {}, "order": {}, "shared": set()}
    tp = "tp:" + tp_name(project)
    for name, label, body in labelled:
        if label != "flaky":
            row["real"] += 1
            add_item(row, "test-fail", name, "important", body, run_id, ctx, tags=[tp])
        elif isolated:
            row["flaky"] += 1
        elif mask(name) in earlier["flaky"] or mask(name) in earlier["order"]:
            row["real"] += 1  # failed in a full run and passed alone, again: it depends on what ran before it
            add_item(row, "test-fail", name, "important", "order-dependent; " + body, run_id, ctx,
                     tags=["order-dependent", tp])
            old = earlier["flaky"].get(mask(name))
            if old and old not in earlier["shared"]:  # a flaky item another test project shares stays open
                if brain(["close", str(old), "--resolution", "duplicate", "--note",
                          "failed in a full run and passed alone again; filed as an order-dependent test-fail"]) is None:
                    row["notes"].append(f"flaky #{old} could not be closed")
        else:
            row["flaky"] += 1
            add_item(row, "flaky", name, "minor", body, run_id, ctx, tags=[tp])


BUILD_FLAG_VALUE = {"-c", "--configuration", "-f", "--framework", "-r", "--runtime", "-v", "--verbosity", "--arch",
                    "--os"}
BUILD_FLAG = {"--no-restore"}
BUILD_PREFIX = ("-p:", "--property:", "-property:")


def build_args(extra):
    """The arguments `dotnet build` accepts out of the extra ones, or None when any is for the test run only
    (--settings, --logger, -e, --results-directory, ...): that job cannot share a build and takes a fresh folder."""
    out, i = [], 0
    while i < len(extra):
        a = extra[i]
        if a in BUILD_FLAG or a.startswith(BUILD_PREFIX):
            out.append(a)
        elif a in BUILD_FLAG_VALUE and i + 1 < len(extra):
            out += [a, extra[i + 1]]
            i += 1
        else:
            return None
        i += 1
    return out


def matched_none(rc, text):
    """A filtered run that ran no test: MTP exit 8, VSTest's no-match line, vitest's no-files line, or a summary of zero tests."""
    if rc == 8:
        return True
    if "No test files found" in ANSI.sub("", text):  # vitest, which exits 0 under passWithNoTests
        return True
    if re.search(r"^Error: No tests found", ANSI.sub("", text), re.M):  # playwright, which exits 1
        return True
    if rc != 0:
        return False
    text = ANSI.sub("", text)
    if sum(Dotnet.counts(text)):  # a multi-target run can miss on one framework and run tests on another
        return False
    return "No test matches the given testcase filter" in text \
        or bool(re.search(r"Failed:\s*\d+,\s*Passed:\s*\d+,\s*Skipped:\s*\d+", text))


def lane_problem(rc, text):
    """Why a remote command never really ran, or "". No marker line means the test command never started."""
    if not re.search("^" + re.escape(lr.MARKER) + r"\s*$", text, re.M):
        lines = [l for l in text.splitlines()[1:] if l.strip()]  # line one is the one-line header
        if not lines:
            return f"nothing ran on the host: no output (exit {rc})"
        return f"nothing ran on the host (exit {rc}): " + mask(lines[-1].strip())[:160]
    if rc == 255:
        return "connection to the host lost (ssh exit 255)"
    return ""


def clean_remote(remote, job_id):
    """Remove a job's folder, containers and network on the host. Best effort: the next claim sweeps too."""
    try:
        subprocess.run(lr.ssh_argv(remote, "sh", "-c", lr.cleanup_script(remote, job_id)), capture_output=True,
                       timeout=180, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def run_job(job, a, run_dir, runner, lane=LOCAL):
    hold = Hold(f"remote-{lane.remote.name}" if lane.remote else a.lane)
    try:
        return _run_job(job, a, run_dir, runner, lane, hold)
    finally:
        hold.release()
        if lane.remote:
            clean_remote(lane.remote, job["id"])


def _run_job(job, a, run_dir, runner, lane, hold):
    repo, project = job["repo_dir"], job["test_project"]
    remote = lane.remote
    cfg = lane.repos.get(job["project"].lower()) if remote else None
    row = {"job": job["id"], "project": job["project"], "test": project, "tier": job["tier"],
           "filtered": bool(job["filter"]), "result": "", "failing": 0, "real": 0, "flaky": 0, "notes": [], "run_id": None, "rc": 1,
           "host": remote.name if remote else "", "session": job.get("session_id", ""),
           "session_cwd": job.get("session_cwd", "")}
    if not os.path.isdir(repo):
        row["result"] = "error"
        row["notes"].append("no such directory")
        return row
    mode = runner.mode(repo)
    row["runner"] = f"{runner.name}/{mode}"
    ctx = {"repo": repo, "cycle": job["cycle"], "runner": runner,
           "branch": a.branch if a.branch is not None else current_branch(repo)}
    stem = os.path.join(run_dir, f"job{job['id']:03d}-{safe(tp_name(project))}-{job['tier']}")
    failing = {}  # test name to its detail

    try:
        extra = (shlex.split(os.environ.get("TEST_PHASE_DOTNET_ARGS", "")) if runner is Dotnet else []) \
            + shlex.split(job.get("args") or "")
    except ValueError as e:
        row["result"] = "error"
        row["notes"].append(f"bad extra arguments: {e}")
        return row
    try:
        runner.command(runner.mode(repo), project, job["filter"] or None, job["tier"] == "fast", extra)
    except ValueError as e:
        row["result"] = "error"
        row["notes"].append(f"bad filter: {e}")
        return row

    if tn and not remote:
        try:
            missing = tn.preflight(repo)
        except Exception as e:  # noqa: BLE001  a bad file must not crash the lane
            missing = [f"MISSING {tn.NEEDS}: cannot check ({type(e).__name__}: {e})"]
        if missing:
            row["result"] = "blocked"
            row["notes"].append(f"{len(missing)} test prerequisite(s) missing, nothing ran")
            add_item(row, "blocker", f"test-needs: {project}", "important",
                     f"The tests of {project} did not run. Missing before the run:\n" + "\n".join(missing)
                     + f"\nCheck again with `test-phase --doctor {repo}`.", None, ctx)
            return row

    synced = []
    kept = {}  # a reused build folder: its path, and the mark and project while its build still has to run

    def host(script, timeout):
        try:
            p = subprocess.run(lr.ssh_argv(remote, "sh", "-c", script), capture_output=True, text=True,
                               timeout=timeout, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError) as e:
            raise LaneProblem(f"{remote.name}: ssh failed ({type(e).__name__})")
        if p.returncode != 0:
            raise LaneProblem(f"{remote.name}: ssh failed (exit {p.returncode}) {mask(p.stderr.strip()[-120:])}".strip())
        return p.stdout

    def prepare():  # the copy and the env file go once per job, however many commands follow
        if synced:
            return
        files = lr.file_list(repo, remote.extra_paths, remote.exclude, skip_node_modules=skips_node_modules(runner))
        dest = None
        if remote.reuse_build and runner is Dotnet and build_args(extra) is not None:
            # One build folder per repository, commit, tree state, image and build arguments. A match skips the
            # copy and the build; a miss copies and builds, and the host lock keeps a second job off the folder
            # until the build is done.
            prefix, name = lr.build_name(remote, repo, files, extra)
            dest = lr.build_dir(remote, name)
            got = re.findall(r"^lean-claim: (\w+)$", host(lr.claim_script(remote, job["id"], prefix, name, project), 1900),
                             re.M)
            if got[-1:] == ["busy"]:
                raise LaneProblem(f"{remote.name}: another job held the build folder for 30 minutes")
            if got[-1:] == ["miss"]:
                kept.update(mark=lr.project_mark(project))
            elif got[-1:] != ["hit"]:
                raise LaneProblem(f"{remote.name}: the build folder check gave no answer")
            kept["dest"] = dest
        if not kept.get("dest") or kept.get("mark"):
            data = b"".join(f.encode("utf-8", "surrogateescape") + b"\0" for f in files)
            try:
                p = subprocess.run(lr.sync_argv(remote, repo, job["id"], dest), input=data, capture_output=True)
            except OSError as e:
                raise LaneProblem(f"{remote.name}: rsync did not start ({e.strerror})")
            if p.returncode != 0:
                tail = p.stderr.decode("utf-8", "replace").strip().splitlines()[-1:] or [""]
                raise LaneProblem(f"{remote.name}: copy failed (rsync exit {p.returncode}) {mask(tail[0])[:120]}".strip())
        if cfg and cfg.env_file:
            lr.send_env(remote, job["id"], cfg.env_file, dest=dest)
        synced.append(1)

    hang_info = {}  # the last tier's hang dump: names, source, why not

    def tier(name, cls_filter, log, probe=False):
        if remote:
            prepare()
        hang_info.clear()
        hargs, outdir = [], (log[:-4] if log.endswith(".log") else log) + "-hang"
        if runner is Dotnet and not remote and not probe:
            hargs, why = Dotnet.hang_args(mode, repo, project, a.stall, outdir, extra)
            if hargs and build_args(extra) is None:  # the build step below cannot take these arguments
                hargs, why = [], "the extra arguments are test-only, so the build cannot run first"
            hang_info["why"] = why
        build = mark = None
        if kept.get("dest"):  # the folder holds a build, or this command makes it
            build = ["dotnet", "build", project] + build_args(extra) if kept.get("mark") else None
            mark = kept.pop("mark", None)
        # A probe follows a run that built, so it never builds again.
        cmd = runner.command(mode, project, cls_filter, name == "fast",
                             extra + ["--no-build"] if kept.get("dest") or probe or hargs else extra, probe,
                             **({"hang": hargs} if hargs else {}))
        if remote:
            before = lr.remote_load(remote)
            ssh = lr.ssh_argv(remote, "sh", "-c", lr.run_script(remote, cfg, job["id"], cmd, kept.get("dest"), build, mark,
                                                                kind=runner.name))
            rc, text, started, ended, wait = heavy(f"remote-{remote.name}", ssh, repo, log, a.stall,
                                                   header=f"$ ssh {remote.name} <script for job {job['id']}>\n",
                                                   hold=hold, fail_stall=a.fail_stall, progress=getattr(runner, "progress", None))
            problem = lane_problem(rc, text)
            if problem:
                raise LaneProblem(problem)
        else:
            before = load1()
            brc = 0
            if hargs:
                # Build first: heavy.sh's stall clock starts with the command, the host's hang timer with the
                # tests, so a long build inside `dotnet test` would let heavy.sh stop the run before the hang
                # timer fires.
                brc, text, started, ended, wait = heavy(a.lane, ["dotnet", "build", project] + build_args(extra), repo,
                                                        (log[:-4] if log.endswith(".log") else log) + "-build.log",
                                                        a.stall, hold=hold)
            if brc == 0:
                rc, text, t0, ended, wait2 = heavy(a.lane, cmd, repo, log, a.stall, hold=hold, fail_stall=a.fail_stall,
                                                   progress=getattr(runner, "progress", None))
                if hargs:
                    wait = (wait or 0) + (wait2 or 0)
                else:
                    started, wait = t0, wait2
            else:
                rc, hargs = brc, []
        if hargs:  # read the names, then delete the dump: a Full one is hundreds of megabytes
            try:
                names, source, files, dumped = Dotnet.hang_names(mode, text, outdir)
                hang_info.update(names=names, source=source, files=files, fired=hang_fired(text, dumped))
                hang_info["hung"] = is_hang(hang_info, rc)
            finally:
                shutil.rmtree(outdir, ignore_errors=True)
        if probe:
            return rc, text, None
        return rc, text, record_run(row, ctx, "fast" if name == "full" and cls_filter else name, mode, rc, text, started,
                                    ended, wait, before, project, lane, stalled=bool(hang_info.get("hung")))

    try:
        rc, text, run_id = tier(job["tier"], job["filter"] or None, stem + ".log")
    except LaneProblem as e:
        row["result"], row["lane_problem"] = "requeued", str(e)
        return row
    row["rc"], row["run_id"] = rc, run_id
    hang = dict(hang_info)  # read now: the reruns below overwrite it
    hung = bool(hang.get("hung"))  # the hang timeout may end the run before heavy.sh does
    row["result"] = tier_note(rc, hung)
    if signal_of(rc) and not hung:  # killed from outside: what it printed before that says nothing about the tests
        row["result"] = "killed"
        row["notes"].append(f"killed by signal {signal_of(rc)}, nothing filed")
        p_, f_, _ = runner.counts(text)
        row["kill"] = (f"killed by signal {signal_of(rc)} in the {job['tier']} run; what it printed first: "
                       f"{p_} passed, {f_} failed. Log: {stem}.log", ctx)
        return row
    for name, detail in runner.failures(text):
        failing.setdefault(name, detail)
    cause = tn.environmental(failing) if tn else None
    if cause:  # the machine failed, not the tests: one blocker, and none of these is rerun or counted as flaky
        label, hint, names, counts = cause
        total = len(failing)
        for n in names:
            del failing[n]
        row["env"], row["env_label"] = len(names), label
        row["notes"].append(f"environment: {label}, {len(names)} of {total} failures")
        add_item(row, "blocker", f"environment: {label}: {project}", "important",
                 f"{len(names)} of {total} failures in {project} come from the machine, not the code: "
                 + ", ".join(f"{k} {v}" for k, v in counts.items())
                 + f". {hint}. They are not test failures and were not rerun. Log: {stem}.log\n"
                 + "\n".join(names[:5]), run_id, ctx)
        if remote:  # the host is the problem, so this lane should not take the next job at once
            row["lane_rest"] = f"environment: {label}"
    facts = stall_facts(text) if rc in (76, 78) else None
    seen = f"passed {facts[0]}, failed {facts[1]}, last test: {facts[2]}" if facts else "no counts in the log"
    if hung:
        seen = hang_seen(runner, text)
    if hung:
        file_hang(row, hang, a, run_id, ctx, stem, seen)
    elif rc == 76:
        why = no_name_reason(hang, text)
        row["notes"].append("stalled, likely load" + (f" ({facts[0]} passed, {facts[1]} failed)" if facts else "")
                            + f"; no test name: {why}")
        add_item(row, "note", f"stalled: {project}", "info",
                 f"no test progress for {a.stall} s, stopped by heavy.sh. {seen}. No test name found: {why}. "
                 f"Log: {stem}.log", run_id, ctx)
    elif rc == 78:
        row["notes"].append(f"stalled-failing: only failures for {a.fail_stall} s"
                            + (f" ({facts[0]} passed, {facts[1]} failed)" if facts else ""))
        add_item(row, "note", f"stalled-failing: {project}", "important",
                 f"only failures, no test passed, for {a.fail_stall} s, stopped by heavy.sh. {seen}. "
                 f"Log: {stem}.log", run_id, ctx)
    elif rc == 75:
        row["notes"].append("lane busy, nothing ran")
    elif job["filter"] and not failing and not row.get("env") and matched_none(rc, text):
        row["result"] = "fail"
        row["notes"].append("filter matched no test")
        add_item(row, "test-fail", f"filter-matched-no-test: {project}", "important",
                 f"filter {job['filter']!r} matched no test (exit {rc}). Log: {stem}.log", run_id, ctx)
    elif rc != 0 and not failing and not row.get("env") and tn and tn.log_cause(text):
        label, hint = tn.log_cause(text)  # the install or build never reached a test: say why, not "build error?"
        row["env"], row["env_label"] = 1, label
        row["notes"].append(f"exit {rc}, environment: {label}")
        add_item(row, "blocker", f"environment: {label}: {project}", "important",
                 f"exit {rc} before any test ran, and the log shows {label}. {hint}. Log: {stem}.log\n"
                 + "\n".join(text.splitlines()[-15:]), run_id, ctx)
        if remote:
            row["lane_rest"] = f"environment: {label}"
    elif rc != 0 and not failing and not row.get("env"):
        tail = "\n".join(text.splitlines()[-15:])
        add_item(row, "test-fail", f"run-failed: {project}", "important",
                 f"exit {rc} with no failing test named. Log: {stem}.log\n{tail}", run_id, ctx)
        row["notes"].append(f"exit {rc}, no test named (build error?)")
    names = runner.classes(job["filter"]) if mode == "mtp" else []
    if len(names) > 1 and rc in (0, 2):
        # The run above ORs the classes, so one that matches nothing hides behind the others. List each alone.
        for n in names:
            try:
                prc, _, _ = tier(job["tier"], n, f"{stem}-probe-{safe(n)}.log", probe=True)
            except LaneProblem as e:  # the run is recorded already: say what was not checked, do not requeue
                row["notes"].append(f"class check skipped, lane problem: {e}")
                break
            if prc == 8:
                row["result"] = "fail"
                row["notes"].append(f"class {n} matched no test")
                add_item(row, "test-fail", f"filter-matched-no-test: {n}", "important",
                         f"class {n} in filter {job['filter']!r} matched no test, though the others ran. "
                         f"Log: {stem}.log", run_id, ctx)
    by_class = {}
    for name in failing:
        by_class.setdefault(runner.class_of(name), []).append(name)
    row["failing"] = len(failing)
    if rc == 0 and job["tier"] == "full" and not job["filter"] and not failing:
        cleared = (brain(["flaky-clear", "--project", row["project"], "--test-project", tp_name(project)])
                   or "").splitlines()
        if cleared:
            row["notes"].append(f"{len(cleared)} flaky closed after 5 passing runs")
        closed = close_blockers(row, ctx, project)
        if closed:
            row["notes"].append(f"{closed} blocker(s) closed, the full run passed")
    lost = None
    labelled = []  # (name, label, body), filed once every rerun is in, so a job killed on the way files none
    for cls, names in by_class.items():
        log = f"{stem}-class-{safe(cls)}.log"
        rrc, rtext, rhang = 75, "", {}  # a rerun that could not run proves nothing: unverified
        if not lost and not row.get("env"):  # an environmental run proves nothing by rerunning
            try:
                rrc, rtext, _ = tier("rerun", cls, log)
                rhang = dict(hang_info)  # each rerun has its own hang dump
            except LaneProblem as e:
                lost = row["lane_rest"] = str(e)
                row["notes"].append(f"rerun not run: {lost}")
            except ValueError as e:  # a file name vitest would read as an option
                row["notes"].append(f"rerun of {cls} not run: {e}")
        rhung = bool(rhang.get("hung"))
        if rhung:  # the class hung alone: the test names it, and the failure is not proven flaky
            row["result"] = "stalled"
            file_hang(row, rhang, a, run_id, ctx, log[:-4], hang_seen(runner, rtext))
        if signal_of(rrc) and not rhung:
            row["result"] = "killed"
            row["notes"].append(f"killed by signal {signal_of(rrc)} in a rerun, nothing filed")
            p_, f_, _ = runner.counts(rtext)
            row["kill"] = (f"killed by signal {signal_of(rrc)} in the rerun of {cls}; what it printed first: "
                           f"{p_} passed, {f_} failed. Log: {log}", ctx)
            return row
        again = {n for n, _ in runner.failures(rtext)}
        rpassed = runner.counts(rtext)[0]
        for name in names:
            # A rerun that named no failure is not proof: a crash or build error names none either.
            if rhung or rrc in (75, 76, 78):
                label = "unverified"
            elif rrc == 0 or (rpassed > 0 and name not in again):
                label = "flaky"
            elif name not in again:
                label = "unverified"
            else:
                label = "real"
            how = (f"not rerun, environment down ({row['env_label']})" if row.get("env")
                   else f"alone: {tier_note(rrc, rhung)}" + (f", hung: {', '.join(rhang['names'][:3])}" if rhung else ""))
            labelled.append((name, label, f"{label}; {how}. Log: {log}\n{failing[name]}"))
    file_results(row, labelled, a, run_id, ctx, stem)
    return row


def enqueue(entries, a, cycle):
    queued = []
    for repo, project, fast, extra, again in entries:
        base = ["queue", "add", repo, project, "--cycle", cycle, "--by", "test-phase"]
        if extra:
            base.append("--args=" + extra)
        if a.project:
            base += ["--project", a.project]
        fast_id = ""
        for tier_args in ((["--tier", "fast", "--filter", fast] if fast else []), ["--tier", "full"]):
            if not tier_args:
                continue
            # A refused add stops the plan: going on would run the fast slice and silently drop the full run.
            if tier_args[1] == "full" and again:
                tier_args = tier_args + ["--again=" + again]
            r = subprocess.run([sys.executable, BRAIN] + base + tier_args, capture_output=True, text=True)
            if tier_args[1] == "fast" and r.returncode == 0 and "joined" not in r.stderr:
                fast_id = r.stdout.strip()
                queued.append(fast_id)
            elif r.returncode == 0 and r.stdout.strip().isdigit():
                queued.append(r.stdout.strip())
            if r.returncode != 0:
                if fast_id.isdigit():
                    brain(["queue", "cancel", fast_id])
                    queued.remove(fast_id)
                kept = f"jobs from earlier plan lines stay queued: {', '.join('#' + i for i in queued)}. " if queued else ""
                sys.exit(f"test-phase: could not queue {project} ({tier_args[1]}): {r.stderr.strip()}\n"
                         f"test-phase: the rest of the plan was not queued; {kept}Fix that, or add again=REASON to the plan line to run it anyway.")


def cancelled_ids():
    return set(re.findall(r"^job #(\d+) cancelled", brain(["queue", "list", "--status", "cancelled"]) or "", re.M))


def only_flaky(row):
    """The job failed, every failing test passed alone, and nothing else went wrong."""
    return row["result"] == "fail" and row["failing"] > 0 and row["real"] == 0 and row["flaky"] == row["failing"]


def rest_seconds():
    try:
        return float(os.environ.get("TEST_PHASE_REST", "600"))
    except ValueError:
        return 600.0


def poll_seconds():
    try:
        return float(os.environ.get("TEST_PHASE_POLL", "3"))
    except ValueError:
        return 3.0


def running_ids():
    return [int(x) for x in re.findall(r"^job #(\d+) running", brain(["queue", "list", "--status", "running"]) or "", re.M)]


def sweep_remote(remote):
    """Remove what belongs to no running job on the host. Best effort."""
    try:
        subprocess.run(lr.ssh_argv(remote, "sh", "-c", lr.sweep_script(remote, running_ids())),
                       capture_output=True, timeout=180, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def error_row(job_id, why):
    return {"job": job_id, "project": "-", "test": "-", "tier": "-", "result": "error", "failing": 0, "real": 0,
            "flaky": 0, "notes": [why], "run_id": None, "rc": 1, "host": ""}


def drain(a, run_dir, lanes=None):
    """(rows, how many jobs were cancelled while draining). One thread per lane."""
    lanes = lanes or [LOCAL]
    before = cancelled_ids()
    remotes = {l.remote.name: l.remote for l in lanes if l.remote}
    # Jobs left running by a drainer that died cannot finish; fail them so their dependents are cancelled.
    for line in (brain(["queue", "list", "--status", "running"]) or "").splitlines():
        m = re.match(r"job #(\d+) ", line)
        if m:
            on = re.search(r" on=(\S+)$", line)
            if on and on.group(1) in remotes:
                clean_remote(remotes[on.group(1)], m.group(1))
            brain(["queue", "finish", m.group(1), "--status", "failed", "--reason", "drainer died"])
    rows = []
    lock = threading.Lock()  # guards printing, rows and state
    wake = threading.Condition(lock)  # an idle lane waits on it, a finished job wakes it
    stop = threading.Event()  # set when no lane is working, so a resting lane wakes and ends
    state = {l.name: "work" for l in lanes}
    retried = set()  # jobs put back once after a kill
    seen = {}  # idle lane: the finish count its last empty poll saw
    done = [0]  # jobs finished or put back; an idle lane polls again when it moved

    def say(msg):
        with lock:
            print(msg, flush=True)

    def settle(lane, st):
        with lock:
            state[lane.name] = st
            if quiet():
                stop.set()
            wake.notify_all()

    def quiet():  # call with the lock held: nobody works and no idle lane missed a finished job
        return all(v != "work" for v in state.values()) \
            and all(seen[n] == done[0] for n, v in state.items() if v == "idle")

    def idle(lane, count):
        """No job for this lane. Wait while another lane works; False when the drain ended."""
        with lock:
            state[lane.name], seen[lane.name] = "idle", count
            if quiet():  # wake the others only to end; waking them on every poll makes idle lanes spin
                stop.set()
                wake.notify_all()
            if not stop.is_set():
                wake.wait(poll_seconds())
            ended = stop.is_set() and count == done[0]
            if not ended:
                state[lane.name] = "work"
            return not ended

    def finished():
        with lock:
            done[0] += 1
            wake.notify_all()

    def rest(lane):
        """Rest after a lane problem. False when the drain ended meanwhile."""
        settle(lane, "rest")
        if stop.is_set() or stop.wait(rest_seconds()):
            return False
        with lock:
            state[lane.name] = "work"
        return True

    def lane_loop(lane):
        last_why, job = None, None
        try:
            while True:
                if lane.remote:
                    sweep_remote(lane.remote)
                    ok, why = lr.preflight(lane.remote)
                    if not ok:
                        if why != last_why:
                            say(f"test-phase: lane {lane.name} rests: {why}")
                        last_why = why
                        if not rest(lane):
                            return
                        continue
                    last_why = None
                count = done[0]
                out = brain(["queue", "next", "--where", lane.where]
                            + (["--host", lane.remote.name] if lane.remote else []))
                if not out:
                    if idle(lane, count):
                        continue
                    return
                job = json.loads(out)
                say(f"test-phase: job #{job['id']} {job['project']} {job['test_project']} ({job['tier']})"
                    + (f" on {lane.remote.name}" if lane.remote else ""))
                row = run_job(job, a, run_dir, runner_for(job["test_project"]), lane)
                problem = row.get("lane_problem")
                if problem:
                    if requeue_job(job["id"], problem, say):
                        say(f"test-phase: job #{job['id']} back to queued, lane {lane.name} rests: {problem}")
                    job = None
                    finished()
                    if not rest(lane):
                        return
                    continue
                if row["result"] == "killed":
                    if job["id"] not in retried:
                        retried.add(job["id"])
                        if requeue_job(job["id"], "; ".join(row["notes"]) + "; retried once", say):
                            say(f"test-phase: job #{job['id']} was killed by a signal, back to queued once")
                        job = None
                        finished()
                        continue
                    row["notes"].append("killed again, not retried")
                    if row.get("kill"):  # the job fails, so brain must say why
                        add_item(row, "note", f"killed twice: {row['test']}", "important",
                                 row["kill"][0] + "\nThe job was run again once and was killed again.",
                                 row["run_id"], row["kill"][1])
                with lock:
                    rows.append(row)
                reason = "; ".join(row["notes"])
                brain(["queue", "finish", str(job["id"]), "--status",
                       "done" if row["rc"] == 0 or only_flaky(row) else "failed"]
                      + (["--run-id", str(row["run_id"])] if row["run_id"] else [])
                      + (["--reason", reason] if reason else []))
                job = None
                finished()
                if row.get("lane_rest"):
                    say(f"test-phase: lane {lane.name} rests: {row['lane_rest']}")
                    if not rest(lane):
                        return
        except Exception as e:  # noqa: BLE001  a crashed lane must not hang the others
            say(f"test-phase: lane {lane.name} crashed: {e!r}")
            if job:
                brain(["queue", "finish", str(job["id"]), "--status", "failed", "--reason", f"lane crashed: {e!r}"[:200]])
            with lock:
                rows.append(error_row(job["id"] if job else 0, f"lane {lane.name} crashed: {e!r}"))
        finally:
            settle(lane, "ended")

    threads = [threading.Thread(target=lane_loop, args=(l,)) for l in lanes]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return rows, len(cancelled_ids() - before)


def table(rows, show_host=False):
    heads = ["job", "project:test", "runner", "tier", "result", "failing", "real", "flaky"]
    data = [["#" + str(r["job"]), r["project"] + ":" + os.path.basename(r["test"]), r.get("runner", "-"), r["tier"],
             r["result"], str(r["failing"]), str(r["real"]), str(r["flaky"])] for r in rows]
    if show_host:  # the column appears only when a remote lane exists, so a local-only table is unchanged
        heads.append("host")
        for d, r in zip(data, rows):
            d.append(r.get("host") or "local")
    heads.append("notes")
    for d, r in zip(data, rows):
        d.append("; ".join(r["notes"]))
    widths = [max(len(x[i]) for x in data + [heads]) for i in range(len(heads))]
    out = ["  ".join(h.ljust(w) for h, w in zip(heads, widths)).rstrip()]
    out += ["  ".join(c.ljust(w) for c, w in zip(d, widths)).rstrip() for d in data]
    return "\n".join(out)


def is_bad(r):
    if r["result"] in ("stalled", "stalled-failing", "killed", "busy", "error", "blocked"):
        return True
    if r["real"]:
        return True
    return r["result"] == "fail" and r["failing"] == 0  # failed without naming a test


def main(argv):
    p = argparse.ArgumentParser(prog="test-phase", description="Drain the test queue.")
    p.add_argument("plan", nargs="?")
    p.add_argument("--lane", default="dotnet")
    p.add_argument("--stall", type=int, default=int(os.environ.get("TEST_PHASE_STALL", "600")))
    p.add_argument("--fail-stall", type=int, default=int(os.environ.get("TEST_PHASE_FAIL_STALL", "1200")))
    p.add_argument("--isolation-over", type=int, default=10)
    p.add_argument("--run-dir")
    p.add_argument("--project")
    p.add_argument("--branch")
    p.add_argument("--cycle")
    p.add_argument("--doctor", nargs="?", const="", metavar="DIR")
    a = p.parse_args(argv)
    if a.doctor is not None:
        if not tn:
            print("test-phase: lib/test_needs.py is missing", file=sys.stderr)
            return 2
        target = a.doctor or tn.repo_root()
        if not os.path.isdir(target):
            print(f"test-phase: {target} is not a directory", file=sys.stderr)
            return 2
        return tn.doctor(os.path.abspath(target))
    stamp = time.strftime("%Y%m%d-%H%M%S")
    cycle = a.cycle or stamp
    if a.plan:
        enqueue(parse_plan(a.plan), a, cycle)
    base = os.environ.get("LEAN_TEST_PHASE_DIR") or os.path.expanduser("~/.local/share/lean/test-phase")
    os.makedirs(base, exist_ok=True)
    lock = open(os.path.join(base, "drainer.lock"), "w")
    lanes = [LOCAL]
    if lr:
        try:
            remotes, repos = lr.load()
        except ValueError as e:  # a bad config must not stop the local lane
            print(f"test-phase: remote lanes off, bad config: {e}", file=sys.stderr)
            remotes, repos = [], {}
        lanes += [Lane(f"remote-{r.name}", "remote", r, repos) for r in remotes]
    rows = []
    cancelled = 0
    runs = 0
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            if runs == 0:
                print("test-phase: a drainer is running; it will take what is queued")
            break
        runs += 1
        run_dir = a.run_dir or os.path.join(base, stamp)
        os.makedirs(run_dir, exist_ok=True)
        if runs == 1:
            print(f"test-phase: logs in {run_dir}", flush=True)
            if len(lanes) > 1:
                print("test-phase: lanes " + ", ".join(l.name for l in lanes), flush=True)
        got, dropped = drain(a, run_dir, lanes)
        rows += got
        cancelled += dropped
        fcntl.flock(lock, fcntl.LOCK_UN)
        # A job enqueued just as the drain ended would wait for the next drainer; look once more.
        if not (brain(["queue", "next", "--peek"]) or "").strip():
            break
    if not rows:
        if runs:
            print("test-phase: nothing queued")
        say_waiting_remote()
        return 1 if cancelled else 0
    print()
    print(table(rows, len(lanes) > 1))
    print(f"\ntest-phase: {len(rows)} jobs, {sum(r['real'] for r in rows)} real, "
          f"{sum(r['flaky'] for r in rows)} flaky, {cancelled} cancelled. `brain list --open` has the entries.")
    say_waiting_remote()
    return 1 if cancelled or any(is_bad(r) for r in rows) else 0


def say_waiting_remote():
    """Name the queued jobs only a remote lane may claim, so one left behind is not a silent wait."""
    ids = re.findall(r"^job #(\d+) queued .*platform=remote", brain(["queue", "list", "--status", "queued"]) or "",
                     re.M)
    if ids:
        print(f"test-phase: {len(ids)} job{'s wait' if len(ids) > 1 else ' waits'} for a remote lane ("
              + " ".join(f"#{i}" for i in ids) + "); `brain queue route ID --to any` lets this machine take one")


def vitest_checks(fails, fixture):
    """Vitest: counts, failures with the test file as class, runner by path, the node image on a remote.
    Looked up by name, so a build without the runner reports failed checks instead of crashing."""
    V = globals().get("Vitest")
    if V is None:
        fails.append("no Vitest runner class")
        return
    got = V.counts(fixture("vitest-failed.log"))
    if got != (3, 2, 1):
        fails.append(f"vitest summary must give (passed, failed, skipped) = (3, 2, 1): {got}")
    if V.counts("\x1b[2m     Tests \x1b[22m \x1b[1m\x1b[32m5 passed\x1b[39m\x1b[22m\x1b[90m (5)\x1b[39m\n") != (5, 0, 0):
        fails.append("a colored vitest summary must parse")
    if V.counts(fixture("vitest-passed.log")) != (2, 0, 0) or V.counts("no summary\n") != (0, 0, 0):
        fails.append("a passing vitest run counts its tests; no summary gives zeros")
    fl = V.failures(fixture("vitest-failed.log"))
    names = [n for n, _ in fl]
    if names != ["src/cart/cart.test.tsx > Cart > adds an item", "src/cart/cart.test.tsx > Cart > removes an item"]:
        fails.append(f"vitest failures must be each failed test once, as file > suite > name: {names}")
    elif "AssertionError: expected 1 to be 2" not in fl[0][1] or "expected 0 to be 1" in fl[0][1]:
        fails.append(f"a vitest failure must carry the lines after it: {fl[0][1]!r}")
    nx = " \u00d7 src/app/[handle]/(app)/members/page.test.tsx > live > a test 64ms\n"
    if [n for n, _ in V.failures(nx)] != ["src/app/[handle]/(app)/members/page.test.tsx > live > a test"]:
        fails.append("a vitest failure under a Next.js [segment] or (group) folder must be found")
    def named(label, text, want):
        try:
            got = [n for n, _ in V.failures(text)]
        except Exception as e:
            got = f"{type(e).__name__}: {e}"
        if got != want:
            fails.append(f"vitest failures, {label}: want {want}, got {got}")

    named("a suite that fails in beforeAll and a file that fails to load", fixture("vitest-load-failed.log"),
          ["src/a.test.ts > B", "src/b.test.ts [ src/b.test.ts ]"])
    named("a retried test is one name", fixture("vitest-retry.log"), ["src/d.test.ts > retry"])
    named("a title ending in a duration, a space or a $ in the path", fixture("vitest-odd-names.log"),
          ["src/sp ace.test.ts > sp", "src/users.$id.test.ts > dollar", "src/a.test.ts > waits 5ms"])
    named("a colored failure line", "\x1b[31m \u00d7 src/a.test.ts > t 1ms\x1b[39m\n", ["src/a.test.ts > t"])
    twice = " \u00d7 src/a.test.ts > t 1ms\n   \u2192 first\n \u00d7 src/a.test.ts > t 2ms\n   \u2192 second\n"
    got = V.failures(twice)
    if len(got) != 1 or "first" not in got[0][1] or "second" in got[0][1]:
        fails.append(f"a name seen twice keeps its first detail: {got}")
    longblock = " \u00d7 src/a.test.ts > t 1ms\n" + "".join(f"line {i}\n" for i in range(30))
    got = V.failures(longblock)
    if len(got) != 1 or len(got[0][1].splitlines()) != 12:
        fails.append(f"a failure carries 12 lines at most: {[len(d.splitlines()) for _, d in got]}")
    if V.counts("     Tests  1 failed (1)\n     Tests  2 passed | 1 todo | 1 skipped (4)\n") != (2, 0, 2):
        fails.append("the last vitest Tests line counts, and todo counts as skipped")
    if hl:
        w = hl.Watch(re.compile("x"))
        w.count(" \u2713 src/a.test.ts > t 1ms")
        w.count(" \u00d7 src/a.test.ts > u 1ms")
        if (w.passed, w.failed) != (1, 1):
            fails.append(f"heavy_lock must count vitest result marks for --fail-stall: {w.passed} {w.failed}")
    if matched_none(0, "No test files found, exiting with code 0\n") is not True \
            or matched_none(1, "No test files found, exiting with code 1\n") is not True:
        fails.append("vitest's no-files line is a filter that matched nothing, at any exit code")
    tp = globals().get("tp_name")
    if not tp or tp("web/package.json") == tp("mobile/package.json") or tp("tests/T/T.csproj") != "T.csproj":
        fails.append("two package.json test projects must not share one name")
    sent = []
    real_brain = globals()["brain"]
    globals()["brain"] = lambda args, stdin=None: sent.append(args) or ""
    try:
        record_run({"project": "p"}, {"cycle": "c", "repo": "r", "runner": V}, "full", "vitest", 0, "", 1, 2, None,
                   None, "web/package.json")
    finally:
        globals()["brain"] = real_brain
    mine = sent[0][sent[0].index("--test-project") + 1] if sent and "--test-project" in sent[0] else ""
    if mine == "package.json" or "web" not in mine:
        fails.append(f"a run row names its package.json by folder: {mine!r}")
    if V.failures(fixture("vitest-passed.log")):
        fails.append("a passing vitest run has no failures")
    if [V.class_of(n) for n in names] != ["src/cart/cart.test.tsx"] * 2 \
            or V.class_of("src/a.test.ts [ src/a.test.ts ]") != "src/a.test.ts":
        fails.append("the class of a vitest test is its file, so the rerun is per file")
    if V.mode("/tmp") != "vitest":
        fails.append("the vitest mode is vitest")
    cmd = V.command("vitest", "web/package.json", "src/a.test.ts|src/b.test.ts", fast=True)
    if cmd[:2] != ["sh", "-c"] or "web" not in cmd or cmd[-2:] != ["src/a.test.ts", "src/b.test.ts"] \
            or "--frozen-lockfile" not in cmd[2] or "vitest run --reporter=verbose" not in cmd[2]:
        fails.append(f"vitest command: install with the lockfile, run verbose, one file filter per piece: {cmd}")
    cmd = V.command("vitest", "package.json")
    if cmd[3:] != ["vitest", "."] or "src/" in " ".join(cmd[3:]):
        fails.append(f"a vitest run with no filter runs everything, in the project folder: {cmd}")
    try:
        V.command("vitest", "web/package.json", "a| --help")
        fails.append("a vitest filter piece starting with - must be refused")
    except ValueError:
        pass
    pick = globals().get("runner_for")
    if not pick or pick("web/package.json") is not V or pick("package.json") is not V \
            or pick("tests/T/T.csproj") is not Dotnet or pick("tests/T") is not Dotnet:
        fails.append("a test path ending in package.json uses Vitest, everything else Dotnet")
    r = lr.Remote(name="dev", host="devbox") if lr else None
    if r is None or getattr(r, "node_image", "") != "node:22-bookworm-slim":
        fails.append("the remote default node image is node:22-bookworm-slim")
        return
    r.node_image = "node:20-slim"
    try:
        sc = lr.run_script(r, None, 5, V.command("vitest", "web/package.json"), kind="vitest")
        dn = lr.run_script(r, None, 5, ["dotnet", "test"])
    except TypeError as e:
        fails.append(f"run_script must take the runner kind: {e}")
        return
    if "node:20-slim sh -c" not in sc or "mcr.microsoft.com/dotnet/sdk" in sc or "/nuget" in sc:
        fails.append("a vitest job runs in the node image and uses no NuGet cache")
    if "node_modules:" in sc or "-e CI=true" not in sc or "store_dir" not in sc:
        fails.append("a vitest job gets a pnpm store volume and CI=true")
    if "mcr.microsoft.com/dotnet/sdk:10.0 sh -c" not in dn or "node:" in dn:
        fails.append("a dotnet job keeps the dotnet image")
    if subprocess.run(["sh", "-n", "-c", sc]).returncode != 0:
        fails.append("the vitest remote script is not valid shell")
    r.cache_max_gb = 5
    if ".node-cache" not in lr.sweep_script(r, []):
        fails.append("the host sweep must also empty an over-size .node-cache")
    was = os.environ.get("LEAN_PNPM_VERSION")
    os.environ["LEAN_PNPM_VERSION"] = "9"
    try:
        sc = lr.run_script(r, None, 5, V.command("vitest", "web/package.json"), kind="vitest")
        dn = lr.run_script(r, None, 5, ["dotnet", "test"])
    finally:
        os.environ.pop("LEAN_PNPM_VERSION")
        if was is not None:
            os.environ["LEAN_PNPM_VERSION"] = was
    if "-e LEAN_PNPM_VERSION=9" not in sc or "LEAN_PNPM_VERSION" in dn:
        fails.append("LEAN_PNPM_VERSION must reach a vitest container and no other")
    with tempfile.TemporaryDirectory() as d:
        os.makedirs(os.path.join(d, "web", "node_modules", "x"))
        for f in ("web/package.json", "web/node_modules/x/i.js", "web/a.test.ts"):
            open(os.path.join(d, f), "w").write("x")
        subprocess.run(["git", "init", "-q", d], check=True)
        got = lr.file_list(d, [], [], skip_node_modules=True)
        if got != ["web/a.test.ts", "web/package.json"]:
            fails.append(f"a vitest copy must leave node_modules behind: {got}")


def node_checks(fails, fixture):
    """npm and pnpm lockfiles for Vitest, the Playwright runner. The shell script runs for real against fake
    npm, npx and pnpm that log what they were asked."""
    V, P = globals().get("Vitest"), globals().get("Playwright")
    if V is None or P is None:
        fails.append("no Playwright runner class")
        return
    pick = globals().get("runner_for")
    for cfg in ("playwright.config.ts", "e2e/playwright.config.js", "x/playwright.config.mjs", "playwright.config.cjs"):
        if not pick or pick(cfg) is not P:
            fails.append(f"a test path ending in {cfg} must use Playwright")
    if pick("web/package.json") is not V or pick("tests/T.csproj") is not Dotnet or pick("playwright.config.json") is not Dotnet:
        fails.append("package.json stays Vitest and an unknown path stays Dotnet")
    tp = globals().get("tp_name")
    if tp("e2e/playwright.config.ts") != "e2e/playwright.config.ts" or tp("a/playwright.config.ts") == tp("b/playwright.config.ts"):
        fails.append("a playwright config is named by folder and file")

    def run_script_in(root, project, tool, *args):
        """Run the command the runner builds, from root, with the fakes first on PATH. [rc, stderr, calls]"""
        with tempfile.TemporaryDirectory() as bins:
            log = os.path.join(bins, "calls.log")
            for tool_name in ("npm", "npx", "pnpm"):
                with open(os.path.join(bins, tool_name), "w") as fh:
                    fh.write(f'#!/bin/sh\necho "{tool_name} $* in $(basename "$PWD")" >> "{log}"\n')
                os.chmod(os.path.join(bins, tool_name), 0o755)
            cmd = (V if tool == "vitest" else P).command(tool, project, *args)
            env = dict(os.environ, PATH=bins + os.pathsep + os.environ["PATH"])
            r = subprocess.run(cmd, cwd=root, env=env, capture_output=True, text=True)
            calls = open(log).read().splitlines() if os.path.exists(log) else []
            return r.returncode, r.stderr, calls

    def tree(d, lock, files):
        os.makedirs(os.path.join(d, "packages", "dopa"))
        os.makedirs(os.path.join(d, "e2e"))
        for f in ("packages/dopa/package.json", "e2e/playwright.config.ts") + ((lock,) if lock else ()):
            open(os.path.join(d, f), "w").write("{}\n")

    with tempfile.TemporaryDirectory() as d:
        tree(d, "package-lock.json", ())
        rc, err, calls = run_script_in(d, "packages/dopa/package.json", "vitest")
        if rc != 0 or calls != ["npm ci in " + os.path.basename(d), "npx --no-install vitest run --reporter=verbose in dopa"]:
            fails.append(f"a package-lock.json in a parent folder must run npm ci there, then npx vitest in the package: {rc} {calls} {err}")
        rc, err, calls = run_script_in(d, "packages/dopa/package.json", "vitest", "test/a.test.ts|test/b.test.ts")
        if calls[1:] != ["npx --no-install vitest run --reporter=verbose test/a.test.ts test/b.test.ts in dopa"]:
            fails.append(f"npm vitest filter pieces must become file arguments: {calls}")
        rc, err, calls = run_script_in(d, "e2e/playwright.config.ts", "playwright", "tests/e2e/online.spec.ts")
        if calls != ["npm ci in " + os.path.basename(d), "npx --no-install playwright test --reporter=list tests/e2e/online\\.spec\\.ts in e2e"]:
            fails.append(f"a playwright config must install with npm ci, then run playwright test with the list reporter: {calls}")
    # A package.json with a "test" script runs through that script (it may set --root and pin TZ), not a bare vitest run.
    with tempfile.TemporaryDirectory() as d:
        tree(d, "package-lock.json", ())
        with open(os.path.join(d, "packages", "dopa", "package.json"), "w") as fh:
            fh.write('{"scripts": {"test": "node scripts/run-tests.js"}}\n')
        rc, err, calls = run_script_in(d, "packages/dopa/package.json", "vitest", "test/a.test.ts|test/b.test.ts")
        if rc != 0 or calls[1:] != ["npm test -- --reporter=verbose test/a.test.ts test/b.test.ts in dopa"]:
            fails.append(f"a package.json with a test script must run npm test with the args after --: {rc} {calls} {err}")
    with tempfile.TemporaryDirectory() as d:
        tree(d, "pnpm-lock.yaml", ())
        with open(os.path.join(d, "packages", "dopa", "package.json"), "w") as fh:
            fh.write('{"scripts": {"test": "node scripts/run-tests.js"}}\n')
        rc, err, calls = run_script_in(d, "packages/dopa/package.json", "vitest")
        if rc != 0 or calls != ["pnpm install --frozen-lockfile in dopa", "pnpm run test --reporter=verbose in dopa"]:
            fails.append(f"a pnpm package with a test script must run pnpm run test: {rc} {calls} {err}")
    with tempfile.TemporaryDirectory() as d:
        tree(d, "pnpm-lock.yaml", ())
        rc, err, calls = run_script_in(d, "packages/dopa/package.json", "vitest")
        if rc != 0 or calls != ["pnpm install --frozen-lockfile in dopa", "pnpm exec vitest run --reporter=verbose in dopa"]:
            fails.append(f"a pnpm-lock.yaml must still pick pnpm: {rc} {calls} {err}")
        rc, err, calls = run_script_in(d, "e2e/playwright.config.ts", "playwright", "a.spec.ts|b.spec.ts")
        if calls != ["pnpm install --frozen-lockfile in e2e", "pnpm exec playwright test --reporter=list a\\.spec\\.ts b\\.spec\\.ts in e2e"]:
            fails.append(f"a playwright config under a pnpm lockfile must use pnpm: {calls}")
    with tempfile.TemporaryDirectory() as d:
        tree(d, "yarn.lock", ())
        for project, tool in (("packages/dopa/package.json", "vitest"), ("e2e/playwright.config.ts", "playwright")):
            rc, err, calls = run_script_in(d, project, tool)
            if rc == 0 or calls or "yarn.lock" not in err or "run-failed" not in err:
                fails.append(f"yarn must be refused by name before anything runs ({tool}): {rc} {calls} {err}")
    with tempfile.TemporaryDirectory() as d:
        tree(d, "package-lock.json", ())
        open(os.path.join(d, "packages", "dopa", "pnpm-lock.yaml"), "w").write("{}\n")
        rc, err, calls = run_script_in(d, "packages/dopa/package.json", "vitest")
        if calls[:1] != ["pnpm install --frozen-lockfile in dopa"]:
            fails.append(f"the nearest lockfile wins over one further up: {calls}")

    # npm ci wipes node_modules, so it runs only when they are missing or older than the lockfile.
    with tempfile.TemporaryDirectory() as d:
        tree(d, "package-lock.json", ())
        nm = os.path.join(d, "node_modules")
        os.makedirs(nm)
        os.utime(os.path.join(d, "package-lock.json"), (1000, 1000))
        marker = os.path.join(nm, ".package-lock.json")
