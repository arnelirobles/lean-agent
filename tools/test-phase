def needs_checks(fails):
    """Test prerequisites and environmental runs, on their own brain database and their own fake dotnet."""
    with tempfile.TemporaryDirectory() as d:
        shims = os.path.join(d, "shims")
        os.mkdir(shims)
        with open(os.path.join(shims, "dotnet"), "w") as fh:  # a build passes; a test prints the file named for the project, with its exit code
            fh.write('#!/bin/sh\necho "$*" >> "$FAKE_LOG"\n[ "$1" = build ] && exit 0\nf="$FAKE_DIR/out-$(basename "$2")"\ncat "$f"\nexit "$(cat "$f.rc")"\n')
        os.chmod(os.path.join(shims, "dotnet"), 0o755)
        env = dict(os.environ, PATH=shims + os.pathsep + os.environ["PATH"], FAKE_DIR=d, HOME=d,
                   FAKE_LOG=os.path.join(d, "calls.log"), LEAN_BRAIN_DB=os.path.join(d, "brain.db"),
                   LEAN_DB=os.path.join(d, "lean.db"), HEAVY_LOCK_DIR=os.path.join(d, "locks"),
                   LEAN_TEST_PHASE_DIR=os.path.join(d, "runs"), HEAVY_WAIT="20", TEST_PHASE_REMOTES="off")
        env.pop("TEST_PHASE_RUNNER", None)
        me = os.path.realpath(__file__)

        def repo(name):
            os.makedirs(os.path.join(d, name, "tests", "T"))
            return os.path.join(d, name)

        def output(project, text, rc):
            open(os.path.join(d, "out-" + project), "w").write(text)
            open(os.path.join(d, "out-" + project + ".rc"), "w").write(str(rc))

        def run(path, project):
            open(os.path.join(d, "plan.txt"), "w").write(f"{path} tests/T/{project}\n")
            open(env["FAKE_LOG"], "w").close()
            r = subprocess.run([sys.executable, me, os.path.join(d, "plan.txt")], env=env, capture_output=True,
                               text=True, timeout=240)
            log = open(env["FAKE_LOG"]).read().splitlines()
            return r.returncode, r.stdout + r.stderr, [c for c in log if not c.startswith("build ")]  # test runs only

        def items(proj, kind, closed=False):
            """[(id, ref)] with the exact ref, so one name never matches part of another."""
            state = ["--status", "closed"] if closed else ["--open"]
            got = subprocess.run([sys.executable, BRAIN, "list", *state, "--kind", kind, "--project", proj], env=env,
                                 capture_output=True, text=True).stdout
            return [(m.group(1), m.group(2)) for m in re.finditer(
                r"^#(\d+) \w+ \S+ \S+ (.+?) (?:minor|important|info) occ=", got, re.M)]

        def show(i):
            return subprocess.run([sys.executable, BRAIN, "show", i], env=env, capture_output=True, text=True).stdout

        docker = "  Error Message:\n   Testcontainers.Builders.DockerUnavailableException : Docker is either not running.\n"
        # 1,800 Docker failures are one blocker for the run, no test-fail, no flaky, and nothing is rerun.
        r_d = repo("envdocker")
        output("Dk.csproj", "".join(f"  Failed Dk.Tests.T{i} [1 ms]\n{docker}" for i in range(1800))
               + "Failed!  - Failed:  1800, Passed:     0, Skipped:     0, Total:  1800\n", 1)
        rc, out, calls = run(r_d, "Dk.csproj")
        ref = "environment: docker unavailable: tests/T/Dk.csproj"
        got = items("envdocker", "blocker")
        if rc != 1 or [r for _, r in got] != [ref]:
            fails.append(f"1800 Docker failures must be exactly one blocker and exit 1 ({rc}): {got} {out}")
        if items("envdocker", "test-fail") or items("envdocker", "flaky"):
            fails.append("an environmental run must file no test-fail or flaky item")
        if len(calls) != 1:
            fails.append(f"an environmental run must not rerun any class: {len(calls)} calls")
        if got and "docker unavailable 1800" not in show(got[0][0]):
            fails.append(f"the blocker must count each cause: {show(got[0][0])!r}")
        # A passing full run of the project closes the blocker.
        output("Dk.csproj", "Passed!  - Failed:     0, Passed:     5, Skipped:     0, Total:     5\n", 0)
        rc, out, calls = run(r_d, "Dk.csproj")
        if rc != 0 or items("envdocker", "blocker") or [r for _, r in items("envdocker", "blocker", True)] != [ref]:
            fails.append(f"a passing full run must close the environment blocker ({rc}): {items('envdocker', 'blocker')} {out}")

        # A real failure followed by Docker failures: the real one is kept, unverified, and worded as not rerun.
        r_r = repo("envreal")
        output("Rl.csproj", "  Failed Rl.Real.Breaks [1 ms]\n   Assert.Equal() Failure\n"
               + "".join(f"  Failed Rl.D.T{i} [1 ms]\n{docker}" for i in range(3))
               + "Failed!  - Failed: 4, Passed: 0, Skipped: 0, Total: 4\n", 1)
        detail = dict(Dotnet.failures(open(os.path.join(d, "out-Rl.csproj")).read()))
        if "Docker" in detail.get("Rl.Real.Breaks", "Docker"):
            fails.append(f"a failure's detail must stop at the next failure: {detail.get('Rl.Real.Breaks')!r}")
        rc, out, calls = run(r_r, "Rl.csproj")
        tf = items("envreal", "test-fail")
        if [r for _, r in tf] != ["Rl.Real.Breaks"] or len(calls) != 1 \
                or [r for _, r in items("envreal", "blocker")] != ["environment: docker unavailable: tests/T/Rl.csproj"]:
            fails.append(f"a real failure before Docker ones must be filed, with no rerun: {tf} {len(calls)} {out}")
        elif "not rerun, environment down" not in show(tf[0][0]) or "busy" in show(tf[0][0]):
            fails.append(f"a failure not rerun must say so: {show(tf[0][0])!r}")

        # Missing prerequisites: one blocker naming each, no test runs, no value printed, no test-fail.
        r_n = repo("needrefuse")
        os.makedirs(os.path.join(r_n, ".lean"))
        env["LEAN_NEEDS_SET"] = "topsecret-value-123"
        env.pop("LEAN_NEEDS_UNSET", None)
        needs_file = os.path.join(r_n, ".lean", "test-needs")
        open(needs_file, "w").write("env LEAN_NEEDS_SET  # present\nenv LEAN_NEEDS_UNSET\npath ../not-here\n")
        output("Nn.csproj", "Passed!  - Failed:     0, Passed:     1, Skipped:     0, Total:     1\n", 0)
        rc, out, calls = run(r_n, "Nn.csproj")
        nb = items("needrefuse", "blocker")
        body = show(nb[0][0]) if nb else ""
        if rc != 1 or [r for _, r in nb] != ["test-needs: tests/T/Nn.csproj"] or calls \
                or "LEAN_NEEDS_UNSET is not set" not in body or "../not-here" not in body \
                or "topsecret-value-123" in body + out:
            fails.append(f"missing prerequisites must be one blocker, no run, no value shown ({rc}): {nb} {calls} {body!r}")
        if items("needrefuse", "test-fail"):
            fails.append("a refusal must not be a test-fail")
        ql = subprocess.run([sys.executable, BRAIN, "queue", "list"], env=env, capture_output=True, text=True).stdout
        if not re.search(r"failed.*test prerequisite\(s\) missing", ql):
            fails.append(f"a refused job must finish failed with the reason: {ql}")
        dr = subprocess.run([sys.executable, me, "--doctor", r_n], env=env, capture_output=True, text=True)
        if dr.returncode != 1 or "MISSING env: LEAN_NEEDS_UNSET is not set" not in dr.stdout \
                or "ok      env LEAN_NEEDS_SET" not in dr.stdout or "topsecret-value-123" in dr.stdout + dr.stderr:
            fails.append(f"--doctor must report the missing piece and exit 1: {dr.returncode} {dr.stdout!r}")
        open(needs_file, "w").write("env LEAN_NEEDS_SET\n")
        dr = subprocess.run([sys.executable, me, "--doctor", r_n], env=env, capture_output=True, text=True)
        if dr.returncode != 0:
            fails.append(f"--doctor must exit 0 when everything is met: {dr.returncode} {dr.stdout!r}")
        rc, out, calls = run(r_n, "Nn.csproj")
        if rc != 0 or items("needrefuse", "blocker") or len(calls) != 1:
            fails.append(f"met prerequisites must run the tests and close the blocker ({rc}): {items('needrefuse', 'blocker')}")

        # The runtime check joins in, and an unreadable file is a blocker, not a crash.
        r_t = repo("needruntime")
        os.makedirs(os.path.join(r_t, ".lean"))
        open(os.path.join(r_t, ".lean", "test-needs"), "w").write("env LEAN_NEEDS_SET\n")
        open(os.path.join(r_t, "package.json"), "w").write('{"engines":{"node":">=999.0.0"}}')
        output("Rt.csproj", "Passed!  - Failed:     0, Passed:     1, Skipped:     0, Total:     1\n", 0)
        rc, out, calls = run(r_t, "Rt.csproj")
        nb = items("needruntime", "blocker")
        if rc != 1 or calls or len(nb) != 1 or "runtime:" not in show(nb[0][0]):
            fails.append(f"check-runtime must be part of the check ({rc}): {nb} {calls}")
        if hasattr(os, "geteuid") and os.geteuid() != 0:
            r_p = repo("needunreadable")
            os.makedirs(os.path.join(r_p, ".lean"))
            pf = os.path.join(r_p, ".lean", "test-needs")
            open(pf, "w").write("env LEAN_NEEDS_SET\n")
            os.chmod(pf, 0)
            rc, out, calls = run(r_p, "Rt.csproj")
            nb = items("needunreadable", "blocker")
            if rc != 1 or "Traceback" in out or calls or len(nb) != 1 or "cannot check" not in show(nb[0][0]):
                fails.append(f"an unreadable test-needs file must be a blocker, not a crash ({rc}): {nb} {out}")


