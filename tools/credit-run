with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps({"argv": sys.argv[1:], "env": sorted(os.environ), "key_set": bool(key),
                        "cwd": os.getcwd(), "stdin": stdin}) + "\n")


