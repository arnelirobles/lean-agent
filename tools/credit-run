elif mode == "badcost":
    print(payload("success", "abc", "sess-bad"))
elif mode == "nojson":
    print("plain output " + key)
elif mode == "kill":
    sys.stdout.write("partial " + key)
    sys.stdout.flush()
    os.kill(os.getpid(), signal.SIGKILL)
elif mode == "sleep":
    time.sleep(30)
elif mode == "hang":
    sys.stdout.write('{"result": "' + key)
    sys.stdout.flush()
    open(os.environ["FAKE_READY"], "w").close()
    time.sleep(60)
'''
FAKE_SECURITY = '#!/bin/sh\nif [ "$FAKE_NOKEY" = 1 ]; then exit 44; fi\necho "$FAKE_KEY"\n'

BAD_ALLOW = [
    "Bash(git push:*)", "Bash(git push origin main)", "Bash", "Bash(git:*)",
    "Bash(git -C x push:*)", "Bash(git -c k=v push:*)", "Bash(git --no-pager push:*)",
    "Bash(git pu*)", "Bash(git\tpush:*)", "Bash(git pu\u200bsh:*)", "Read,Bash(git:*)",
    "Bash(g*)", "Bash(sh:*)", "Bash(python3:*)", "Bash(python3.12:*)", "Bash(gh:*)",
    "Bash(curl:*)", "bash(env:*)", "Bash(env:*)", "Bash(npm test)", "Bash(make:*)",
    "Bash(/usr/bin/git status --short:*)", "Bash(git diff --output=x:*)", "Bash(FOO=1 ls:*)",
    "Bash(ls  -l)", "Bash(ls:*:*)", "Bash()", "Bash(ls $(id))", "Bash(ls;id)", "Read(x)", "*", "",
]
GOOD_ALLOW = ["Bash(ls:*)", "Bash(wc -l:*)", "Bash(cat README.md)", "WebFetch", "Bash(git status:*)"]


def self_test():
    import shutil
    fails = []
    me = os.path.realpath(__file__)
    secret = "sk-ant-SELFTEST-0123456789+/abcdefghij"
    b64 = base64.b64encode(secret.encode()).decode()
    with tempfile.TemporaryDirectory() as tmp:
        tmp = os.path.realpath(tmp)
        bindir = os.path.join(tmp, "bin")
        tmpdir = os.path.join(tmp, "tmpdir")
        os.makedirs(bindir)
        os.makedirs(tmpdir)
        for name, body in (("claude", "#!" + sys.executable + "\n" + FAKE_CLAUDE),
                           ("security", FAKE_SECURITY), ("secret-tool", FAKE_SECURITY)):
            path = os.path.join(bindir, name)
            with open(path, "w") as f:
                f.write(body)
            os.chmod(path, 0o755)
        fake_home = os.path.join(tmp, "home")
        os.makedirs(fake_home)
        ledger_file = os.path.join(fake_home, ".lean", "credit-runs.jsonl")
        credit_out = os.path.join(fake_home, ".lean", "credit-out")
        log = os.path.join(tmp, "claude.log")
        main_repo = os.path.join(tmp, "main")
        wt = os.path.join(tmp, "wt")
        g = lambda *x: subprocess.run(["git", "-C", main_repo, *x], capture_output=True, check=True)
        os.makedirs(main_repo)
        g("init", "-q", "-b", "main")
        g("-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "--allow-empty", "-m", "i")
        g("worktree", "add", "-q", "-b", "feat/x", wt)
        brief = os.path.join(tmp, "brief.md")
        with open(brief, "w") as f:
            f.write("fix the ticket")
        base_env = {k: v for k, v in os.environ.items() if not k.startswith(("GIT_", "ANTHROPIC_", "LEAN_CREDIT"))}
        base_env.update(PATH=bindir + os.pathsep + os.environ["PATH"], HOME=fake_home, TMPDIR=tmpdir,
                        FAKE_KEY=secret, FAKE_LOG=log)

        def cr(*args, **env):
            r = subprocess.run([sys.executable, me, *args], capture_output=True, text=True,
                               env=dict(base_env, **env))
            if "Traceback" in r.stderr:
                fails.append(f"traceback for {args[:3]}: {r.stderr[-200:]!r}")
            return r

        def started():
            return os.path.exists(log)

        def fresh():
            if started():
                os.remove(log)

        def records():
            return [json.loads(x) for x in open(log)] if started() else []

        def rows():
            return [json.loads(x) for x in open(ledger_file)] if os.path.exists(ledger_file) else []

        def leaks(text):
            squashed = re.sub(r"\\[nrt]|\s", "", text)
            hits = []
            for name, needle in (("key", secret), ("base64", b64), ("urlencoded", urllib.parse.quote(secret, safe=""))):
                if needle in text or needle in squashed:
                    hits.append(name)
            return hits

        def case(label, mode, want_rc, *extra, **env):
            """One run with the fake claude in `mode`; the key must be in none of the channels."""
            fresh()
            o = os.path.join(tmp, f"out-{label}.json")
            r = cr("--brief", brief, "--worktree", wt, "--budget", "2", "--out", o, *extra,
                   FAKE_MODE=mode, **env)
            if r.returncode != want_rc:
                fails.append(f"{label}: rc={r.returncode}, want {want_rc}, err={r.stderr[-200:]!r}")
            outtext = open(o).read() if os.path.exists(o) else ""
            for chan, text in (("stdout", r.stdout), ("stderr", r.stderr), ("output file", outtext),
                               ("ledger", open(ledger_file).read())):
                if leaks(text):
                    fails.append(f"{label}: key leaked into {chan} as {leaks(text)}")
            if "FAKE-STDERR-MARKER" not in r.stderr:
                fails.append(f"{label}: child stderr was not passed on")
            return r, outtext

        # ---- a good run: argv, environment, redaction in every channel
        r, outtext = case("ok", "ok", 0)
        rec = records()[-1]
        argv = rec["argv"]
        if "done" not in r.stdout or "0.2500" not in r.stdout:
            fails.append(f"stdout lacks result or cost: {r.stdout!r}")
        if REDACTED not in outtext or "[redacted]" not in r.stderr:
            fails.append("redaction left no marker")
        if not rec["key_set"] or "ANTHROPIC_API_KEY" not in rec["env"]:
            fails.append("key did not reach the child environment")
        if secret in json.dumps(argv):
            fails.append("key in argv")
        if argv[argv.index("--max-budget-usd") + 1] != "2.0":
            fails.append("budget flag wrong")
        if argv[argv.index("--allowedTools") + 1].split(",") != DEFAULT_ALLOW:
            fails.append("allowed tools are not the defaults")
        if argv[argv.index("--disallowedTools") + 1].split(",") != DENY:
            fails.append("deny list not in argv")
        if rec["cwd"] != wt or rec["stdin"] != "fix the ticket":
            fails.append("job did not run in the worktree with the brief on stdin")
        row = rows()[-1]
        if (row["branch"], row["model"], row["budget"], row["cost"], row["cost_known"], row["turns"],
                row["state"], row["session"]) != ("feat/x", "sonnet", 2.0, 0.25, True, 3, "ok", "sess-ok"):
            fails.append(f"ledger row wrong: {row}")
        if os.stat(os.path.join(tmp, "out-ok.json")).st_mode & 0o077:
            fails.append("--out is readable by others")

        # ---- the env of the child: stripped names do not reach it
        fresh()
        r = cr(*["--brief", brief, "--worktree", wt, "--budget", "2"],
               ANTHROPIC_AUTH_TOKEN="t", ANTHROPIC_BASE_URL="http://other.invalid",
               CLAUDE_CODE_USE_BEDROCK="1", CLAUDE_CODE_USE_VERTEX="1", CLAUDE_CODE_OAUTH_TOKEN="t",
               GIT_DIR=os.path.join(main_repo, ".git"), GIT_AUTHOR_NAME="a", ANTHROPIC_API_KEY="other")
        names = set(records()[-1]["env"]) if started() else set()
        if r.returncode != 0:
            fails.append(f"GIT_DIR in the caller broke the worktree check: rc={r.returncode} {r.stderr[-120:]!r}")
        for n in sorted(STRIP_ENV | {"GIT_DIR", "GIT_AUTHOR_NAME"}):
            if n in names:
                fails.append(f"{n} reached the child")
        if "ANTHROPIC_API_KEY" not in names:
            fails.append("key missing when ANTHROPIC_API_KEY was already set")

        # ---- cap, error, timeout, interrupted, no output, kill: still no key anywhere
        r, _ = case("cap", "cap", 3)
        if "sess-cap" not in r.stderr or "budget_cap" not in r.stderr or "claude --resume sess-cap" not in r.stderr:
            fails.append(f"cap hit not reported with the session id: {r.stderr[-300:]!r}")
        case("err", "err", 1)
        t0 = time.monotonic()
        r, _ = case("timeout", "sleep", 124, "--minutes", "0.02")
        if time.monotonic() - t0 > 25 or "time limit" not in r.stderr or rows()[-1]["state"] != "timeout":
            fails.append(f"time limit not enforced: {r.stderr[-200:]!r}")
        # unknown cost: written as null, never a traceback, always a line
        for label, mode, rc, want_cost, want_state in (("nojson", "nojson", 1, None, "error"),
                                                       ("kill", "kill", 137, None, "error"),
                                                       ("badcost", "badcost", 0, None, "ok"),
                                                       ("array", "array", 0, 0.5, "ok")):
            n = len(rows())
            case(label, mode, rc)
            new = rows()[n:]
            if len(new) != 1 or new[0]["cost"] != want_cost or new[0]["cost_known"] != (want_cost is not None) \
                    or new[0]["state"] != want_state:
                fails.append(f"{label}: ledger row {new}")
        if rows()[-1]["session"] != "sess-arr":
            fails.append("array result entry not read")

        # ---- SIGTERM: --out holds no raw key, one ledger line, nothing left in the temp dir
        fresh()
        ready = os.path.join(tmp, "ready")
        o = os.path.join(tmp, "out-term.json")
        n = len(rows())
        p = subprocess.Popen([sys.executable, me, "--brief", brief, "--worktree", wt, "--budget", "2", "--out", o],
                             env=dict(base_env, FAKE_MODE="hang", FAKE_READY=ready),
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        end = time.monotonic() + 15
        while time.monotonic() < end and not os.path.exists(ready):
            time.sleep(0.05)
        p.send_signal(signal.SIGTERM)
        try:
            so, se = p.communicate(timeout=60)
        except subprocess.TimeoutExpired:
            p.kill()
            so, se = p.communicate()
            fails.append("SIGTERM: credit-run did not stop")
        new = rows()[n:]
        outtext = open(o).read() if os.path.exists(o) else ""
        if len(new) != 1 or new[0]["state"] != "interrupted":
            fails.append(f"SIGTERM: ledger rows {new}")
        for chan, text in (("stdout", so), ("stderr", se), ("output file", outtext), ("ledger", open(ledger_file).read())):
            if leaks(text):
                fails.append(f"SIGTERM: key leaked into {chan}")
        if not outtext:
            fails.append("SIGTERM: --out was not written")

        # ---- missing keychain item: exit 2, one line, no job
        fresh()
        r = cr("--brief", brief, "--worktree", wt, "--budget", "2", FAKE_NOKEY="1")
        if r.returncode != 2 or len(r.stderr.strip().splitlines()) != 1 or r.stdout or started():
            fails.append(f"missing item: rc={r.returncode} err={r.stderr!r} started={started()}")

        # ---- --allow: each bad spelling is refused with no job, good ones pass through
        for bad in BAD_ALLOW:
            fresh()
            r = cr("--brief", brief, "--worktree", wt, "--budget", "2", "--allow", bad)
            if r.returncode != 2 or started() or len(r.stderr.strip().splitlines()) != 1:
                fails.append(f"--allow {bad!r} not refused: rc={r.returncode} started={started()}")
        for ok in GOOD_ALLOW:
            fresh()
            r = cr("--brief", brief, "--worktree", wt, "--budget", "2", "--allow", ok)
            tools = records()[-1]["argv"] if started() else []
            if r.returncode != 0 or ok not in ",".join(tools[tools.index("--allowedTools") + 1:][:1]).split(",") if tools else True:
                fails.append(f"--allow {ok!r} rejected or missing: rc={r.returncode} {r.stderr[-100:]!r}")

        # ---- budget and minutes
        fresh()
        r = cr("--brief", brief, "--worktree", wt, "--budget", "0.1234567")
        if r.returncode != 0 or records()[-1]["argv"][records()[-1]["argv"].index("--max-budget-usd") + 1] != "0.1234567":
            fails.append("budget was rounded or refused")
        for label, args in (("no budget", []), ("zero budget", ["--budget", "0"]),
                            ("under 0.01", ["--budget", "0.009"]), ("nan budget", ["--budget", "nan"]),
                            ("inf budget", ["--budget", "inf"]), ("negative budget", ["--budget", "-1"]),
                            ("minutes 0", ["--budget", "1", "--minutes", "0"]),
                            ("minutes -1", ["--budget", "1", "--minutes", "-1"]),
                            ("minutes nan", ["--budget", "1", "--minutes", "nan"])):
            fresh()
            r = cr("--brief", brief, "--worktree", wt, *args)
            if r.returncode != 2 or started():
                fails.append(f"{label} not refused: rc={r.returncode}")

        # ---- worktree rules
        fresh()
        r = cr("--brief", brief, "--worktree", main_repo, "--budget", "1")
        if r.returncode != 2 or started() or "not a linked worktree" not in r.stderr:
            fails.append(f"main checkout not refused: rc={r.returncode} {r.stderr!r}")
        with open(os.path.join(wt, "dirty"), "w") as f:
            f.write("x")
        r = cr("--brief", brief, "--worktree", wt, "--budget", "1")
        if r.returncode != 2 or started():
            fails.append(f"dirty worktree not refused: rc={r.returncode}")
        os.remove(os.path.join(wt, "dirty"))

        # ---- bounded missing: no job
        lone = os.path.join(tmp, "lone")
        os.makedirs(lone)
        shutil.copy(me, os.path.join(lone, "credit-run"))
        fresh()
        r = subprocess.run([sys.executable, os.path.join(lone, "credit-run"), "--brief", brief, "--worktree", wt,
                            "--budget", "1"], capture_output=True, text=True, env=base_env)
        if r.returncode != 2 or started() or len(r.stderr.strip().splitlines()) != 1:
            fails.append(f"missing bounded not refused: rc={r.returncode} {r.stderr!r}")

        # ---- --out: an existing file is refused and left alone, same-second runs get their own file
        existing = os.path.join(tmp, "existing.json")
        for victim in (existing, ledger_file):
            if victim == existing:
                with open(victim, "w") as f:
                    f.write("keep me")
            before = open(victim).read()
            fresh()
            r = cr("--brief", brief, "--worktree", wt, "--budget", "1", "--out", victim)
            if r.returncode != 2 or started() or open(victim).read() != before:
                fails.append(f"existing --out {victim} not refused or changed: rc={r.returncode}")
        before = set(os.listdir(credit_out))
        for _ in range(3):
            cr("--brief", brief, "--worktree", wt, "--budget", "1")
        if len(set(os.listdir(credit_out)) - before) != 3:
            fails.append("runs in one second shared an output file")

        if os.listdir(tmpdir):
            fails.append(f"raw output left in the temp dir: {os.listdir(tmpdir)}")

        # ---- --spent: sums, counts unknown and skipped lines, survives bad bytes
        home2 = os.path.join(tmp, "home2")
        os.makedirs(os.path.join(home2, ".lean"))
        with open(os.path.join(home2, ".lean", "credit-runs.jsonl"), "wb") as f:
            f.write(b'{"cost":0.5}\n{"cost":1.25,"branch":"\xff"}\n{"cost":NaN}\n{"cost":-3}\n'
                    b'{"cost":null,"cost_known":false}\n{{\n\xff\xfe\n{"cost":"abc"}\n[1]\n\n')
        r = cr("--spent", HOME=home2)
        if "spent $1.7500 over 3 runs" not in r.stdout or "1 runs with unknown cost" not in r.stdout \
                or "6 unreadable lines skipped" not in r.stderr:
            fails.append(f"--spent wrong: {r.stdout!r} {r.stderr!r}")
        r = cr("--spent", HOME=os.path.join(tmp, "nohome"))
        if "spent $0.0000 over 0 runs" not in r.stdout:
            fails.append(f"--spent with no ledger: {r.stdout!r}")

        # ---- key-help prints a quoted command and no key
        item = "my item; id"
        r = cr("--key-help", LEAN_CREDIT_KEY_ITEM=item)
        if shlex.quote(item) not in r.stdout or leaks(r.stdout + r.stderr):
            fails.append(f"--key-help wrong: {r.stdout!r}")
    for f in fails:
        print("self-test failed:", f)
    if fails:
        return 1
    print("self-test passed")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    sys.exit(main(sys.argv[1:]))
