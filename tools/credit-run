    b = base64.b64encode(key.encode()).decode()
    return [key, key[:10] + "\n" + key[10:], key[:8] + " " + key[8:], b, b[:12] + "\n" + b[12:],
            urllib.parse.quote(key, safe="")]


# env >&2, and the key in other shapes
