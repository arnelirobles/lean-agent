def payload(sub, cost, sid, is_error=False):
    obj = {"type": "result", "subtype": sub, "is_error": is_error, "total_cost_usd": cost,
           "num_turns": 3, "session_id": sid, "result": "done " + " | ".join(forms()),
           "env": dict(os.environ), "esc": key}
    # the first character of the key as a JSON unicode escape
    return json.dumps(obj).replace('"esc": "' + key[0], '"esc": "\\u%04x' % ord(key[0]))


if mode == "ok":
