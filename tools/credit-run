#!/usr/bin/env python3
"""Run one brief as a headless Claude Agent SDK job paid by an API key, with a dollar cap.

  credit-run --brief FILE --worktree DIR --budget USD [--model sonnet] [--minutes N]
             [--allow TOOL ...] [--read-only] [--role NAME] [--out FILE] [--resume SESSION]
             [--advisor opus|off] [--cache-ttl 5m|1h] [--fast]
  credit-run --setup       install the pinned SDKs (agent and batch) under ~/.lean/credit-sdk
  credit-run --key-help    print the command that stores the key, for you to run
  credit-run --spent       spent, reserved and remaining against LEAN_CREDIT_TOTAL_USD
  credit-run --pace        spend per day against LEAN_CREDIT_UNTIL, and the next move; needs no key
  credit-run --self-test

A job starts only when all of these hold:
  LEAN_CREDIT_RUNS=on            master switch, default off
  LEAN_CREDIT_TOTAL_USD=N        total cap, required
  the key is in the keychain     LEAN_CREDIT_KEY_ITEM (default lean-api-credit); read
                                 with `security` on macOS, `secret-tool` on Linux
The key goes into the SDK worker's environment only, never argv, stdin, the ledger or
a file. ANTHROPIC_AUTH_TOKEN and CLAUDE_CODE_OAUTH_TOKEN are removed from that
environment because the auth token outranks the key, and so are ANTHROPIC_BASE_URL and
the Bedrock, Vertex and Foundry switches, so the key only goes to the Claude API.

Cap: the SDK stops a job only after a turn, so a job can overshoot its budget. Each job
reserves budget plus LEAN_CREDIT_TURN_USD (default 0.50) in ~/.lean/credit-runs.jsonl
before it starts, under a file lock. A reservation with no final line (a killed job, a
worker crash) counts at its reserved amount. Refused with exit 2 when spent plus reserved
plus this reservation would pass the total. The figures are a local estimate from
total_cost_usd. A cost figure does not prove which balance paid; the Console workspace
spend limit is the only hard limit.

Tools: Read, Glob, Grep, Edit, Write and git status, diff, log, add, commit. Anything
else is denied (permission mode dontAsk). git push is refused, also through --allow.
--read-only keeps Read, Glob and Grep only: no Bash, no edits. Put any diff in the brief.
It needs no clean worktree. Read(/proc/**) is denied on every job. --role (spec, hunt,
refute, analyze, draft-doc) is recorded on the ledger line. Without --read-only the worktree must be a clean linked git
worktree, not the main checkout. The job runs under `bounded`.

stdout: the result text, then the cost. The full result JSON goes to --out (default
~/.lean/credit-out/RUN.json). Exit 0 done, 3 budget cap hit (the session id is printed so
the job can be resumed with --resume), 1 any other failure, 2 refused or bad input.
Python standard library only. The worker is credit-run-worker.mjs and needs node.
"""
import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(ROOT, "lib"))
from credit_common import (append_line, child_env, die, home, key_command, key_item, ledger_path,  # noqa: E402
                           money, pace_report, read_key, reserve, scrub, sdk_dir, spent_report)

SDK_VERSION = "0.3.316"
SDK_PACKAGE = "@anthropic-ai/claude-agent-sdk"
BATCH_SDK_VERSION = "1.3.0"
BATCH_SDK_PACKAGE = "@anthropic-ai/sdk"
ROLES = ("spec", "hunt", "refute", "analyze", "draft-doc")
READ_TOOLS = ["Read", "Glob", "Grep"]
EDIT_TOOLS = READ_TOOLS + ["Edit", "Write"]
# The allowlist matches "git log", not "git -C DIR log", and models reach for -C.
GIT_NOTE = "\n\nYou are already in the job's directory. Run git as plain `git log`, never `git -C`, one command per Bash call with no && chains.\n"
GIT_EDIT = ["status", "diff", "log", "add", "commit"]
RUNNERS = {"sh", "bash", "zsh", "env", "xargs", "python", "python3", "node", "perl", "ruby", "eval", "exec"}
PUSH_DENY = "Bash(git push:*)"
DENY_ALWAYS = ["Read(/proc/**)"]
DENY_EDIT = [PUSH_DENY, "Bash(git -C:*)", "Bash(git -c:*)", "Bash(git * --out*)"]


def sdk_entry():
    return os.path.join(sdk_dir(), "node_modules", "@anthropic-ai", "claude-agent-sdk", "sdk.mjs")


def key_help():
    item = key_item()
    if sys.platform == "darwin":
        print("Run this yourself. It asks for the key without echoing it:")
        print(f'  security add-generic-password -U -a "$USER" -s {item} -w')
    elif sys.platform.startswith("linux"):
        print("Run this yourself. It asks for the key without echoing it:")
        print(f"  secret-tool store --label={item} service {item}")
    else:
        die("only macOS and Linux are supported")
    print("credit-run never takes the key as an argument.")
    return 0


# checks

def refused_allow(entry):
    e = entry.strip()
    if re.fullmatch(r"Bash(\(\s*(\*|:\*)?\s*\))?", e):
        return True
    if re.fullmatch(r"Bash\(\s*git\s*(:\*|\s\*|\*)?\s*\)", e):
        return True
    if re.search(r"git\b.*\bpush\b", e):
        return True
    m = re.fullmatch(r"Bash\((.*)\)", e, re.S)
    if m:
        words = [w for w in re.split(r"[\s:]+", m.group(1).strip()) if w]
        if not words:
            return True
        if os.path.basename(words[0]) in RUNNERS:
            return True
        if words[0] == "git":
            sub = words[1] if len(words) > 1 else ""
            if not sub or sub.startswith("-") or any(c in sub for c in "*?[]"):
                return True
    return False


def git(worktree, *args):
    try:
        r = subprocess.run(["git", "-C", worktree, *args], capture_output=True, text=True)
    except OSError:
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def check_worktree(worktree):
    if git(worktree, "rev-parse", "--is-inside-work-tree") != "true":
        die(f"{worktree} is not a git worktree")
    gd = git(worktree, "rev-parse", "--git-dir")
    cd = git(worktree, "rev-parse", "--git-common-dir")
    real = lambda p: os.path.realpath(os.path.join(worktree, p))
    if gd is None or cd is None or real(gd) == real(cd):
        die(f"{worktree} is the main checkout; use a linked worktree (git worktree add)")
    if git(worktree, "status", "--porcelain"):
        die(f"{worktree} has uncommitted changes; commit or stash them first")


def write_rules(worktree):
    """Edit and Write only inside the worktree, never in git metadata: a planted hook would run with the key."""
    real = os.path.realpath(worktree)
    common = git(worktree, "rev-parse", "--git-common-dir") or ".git"
    common = os.path.realpath(os.path.join(real, common))
    # A leading // is an absolute path in a permission rule.
    allow = [f"{t}(/{real}/**)" for t in ("Edit", "Write")]
    deny = [f"{t}({p})" for t in ("Edit", "Write")
            for p in (f"/{real}/.git", f"/{real}/.git/**", f"/{common}/**", "**/.git/**")]
    return allow, deny


def build_options(a, worktree, model):
    if a.read_only:
        tools = ["Read", "Glob", "Grep"]
        allowed = ["Read", "Glob", "Grep"]
        denied = list(DENY_ALWAYS)
    else:
        allow = a.allow or []
        names = [re.split(r"\(", x.strip(), 1)[0] for x in allow]
        tools = list(dict.fromkeys(EDIT_TOOLS + ["Bash"] + names))
        write_allow, write_deny = write_rules(worktree)
        allowed = READ_TOOLS + write_allow + [f"Bash(git {g}:*)" for g in GIT_EDIT] + allow
        denied = DENY_EDIT + DENY_ALWAYS + write_deny
    opts = {
        "model": model,
        "maxBudgetUsd": a.budget_value,
        "settingSources": [],
        "tools": tools,
        "allowedTools": allowed,
        "disallowedTools": denied,
        "permissionMode": "dontAsk",
        "plugins": [{"type": "local", "path": ROOT}],
        "cwd": worktree,
    }
    settings = {"attribution": False}  # no agent trailers on commits or pull requests
    if a.advisor_value == "opus":
        settings["advisorModel"] = "opus"
    if a.fast:
        settings["fastMode"] = True
    opts["settings"] = settings
    if a.resume:
        opts["resume"] = a.resume
    return opts


class Parser(argparse.ArgumentParser):
    def error(self, message):
        die(message.splitlines()[0])


def parser():
    p = Parser(prog="credit-run", add_help=True)
    p.add_argument("--brief")
    p.add_argument("--worktree")
    p.add_argument("--budget")
    p.add_argument("--model", default="sonnet")
    p.add_argument("--minutes")
    p.add_argument("--allow", nargs="+", action="extend")
    p.add_argument("--read-only", action="store_true")
    p.add_argument("--role", choices=ROLES)
    p.add_argument("--out")
    p.add_argument("--resume")
    p.add_argument("--advisor")
    p.add_argument("--cache-ttl")
    p.add_argument("--fast", action="store_true")
    p.add_argument("--setup", action="store_true")
    p.add_argument("--key-help", action="store_true")
    p.add_argument("--spent", action="store_true")
    p.add_argument("--pace", action="store_true")
    p.add_argument("--self-test", action="store_true")
    return p


def setup():
    npm = shutil.which("npm")
    if not npm:
        die("npm not found; install node first")
    os.makedirs(sdk_dir(), mode=0o700, exist_ok=True)
    r = subprocess.run([npm, "install", "--prefix", sdk_dir(), f"{SDK_PACKAGE}@{SDK_VERSION}",
                        f"{BATCH_SDK_PACKAGE}@{BATCH_SDK_VERSION}"])
    return r.returncode


def main(argv):
    a = parser().parse_args(argv)
    if a.self_test:
        return self_test()
    if a.key_help:
        return key_help()
    if a.spent:
        return spent_report()
    if a.pace:
        return pace_report()
    if a.setup:
        return setup()

    if os.environ.get("LEAN_CREDIT_RUNS", "").strip().lower() != "on":
        die("credit runs are off; set LEAN_CREDIT_RUNS=on to allow them")
    total_text = os.environ.get("LEAN_CREDIT_TOTAL_USD")
    if not total_text:
        die("LEAN_CREDIT_TOTAL_USD is not set; set the total you allow to spend")
    total = money(total_text, "LEAN_CREDIT_TOTAL_USD")
    turn = money(os.environ.get("LEAN_CREDIT_TURN_USD") or "0.50", "LEAN_CREDIT_TURN_USD")
    if not a.brief or not a.worktree:
        die("--brief and --worktree are required")
    if a.budget is None:
        die("--budget is required")
    a.budget_value = money(a.budget, "--budget")
    a.advisor_value = (a.advisor or os.environ.get("LEAN_CREDIT_ADVISOR") or "off").strip().lower()
    if a.advisor_value not in ("opus", "off"):
        die(f"advisor must be opus or off, got {a.advisor_value!r}")
    ttl = (a.cache_ttl or os.environ.get("LEAN_CREDIT_CACHE_TTL") or "5m").strip()
    if ttl not in ("5m", "1h"):
        die(f"cache ttl must be 5m or 1h, got {ttl!r}")
    if a.fast:
        if os.environ.get("LEAN_CREDIT_FAST", "").strip().lower() != "on":
            die("--fast needs LEAN_CREDIT_FAST=on")
        if "opus" not in a.model.lower():
            die("--fast switches any other model to Opus at double Opus rates; use an Opus model")
    if a.read_only and a.allow:
        die("--allow cannot be used with --read-only")
    for entry in a.allow or []:
        if refused_allow(entry):
            die(f"refused: {entry!r} would allow git push")
    minutes = None
    if a.minutes is not None:
        try:
            minutes = float(a.minutes)
        except ValueError:
            minutes = -1
        if not (minutes >= 0) or minutes == float("inf"):
            die(f"--minutes must be 0 or more, got {a.minutes!r}")
    if key_command() is None:
        die("only macOS and Linux are supported")
    if not os.path.isfile(a.brief):
        die(f"brief file not found: {a.brief}")
    worktree = os.path.realpath(a.worktree)
    if not os.path.isdir(worktree):
        die(f"worktree not found: {a.worktree}")
    if not shutil.which("node"):
        die("node not found; install node, then run credit-run --setup")
    if not os.path.isfile(sdk_entry()):
        die("the Agent SDK is not installed; run credit-run --setup")
    if not a.read_only:
        tool = os.path.realpath(ROOT)
        if os.path.commonpath([tool, worktree]) in (tool, worktree):
            die(f"{worktree} holds this tool; an edit job there could change its own limits")
        check_worktree(worktree)
    key = read_key()
    with open(a.brief) as f:
        prompt = f.read() + ("" if a.read_only else GIT_NOTE)

    run = uuid.uuid4().hex[:12]
    out = os.path.realpath(a.out) if a.out else os.path.join(home(), ".lean", "credit-out", f"{run}.json")
    os.makedirs(os.path.dirname(out), mode=0o700, exist_ok=True)
    meta = {
        "run": run,
        "branch": git(worktree, "rev-parse", "--abbrev-ref", "HEAD") or "",
        "model": a.model,
        "budget": a.budget_value,
        "role": a.role,
        "read_only": a.read_only,
        "advisor": a.advisor_value,
        "speed": "fast" if a.fast else "standard",
        "cache_ttl": ttl,
    }
    reserve(dict(meta, time=time.strftime("%Y-%m-%dT%H:%M:%S%z"), phase="reserve",
                 reserved=round(a.budget_value + turn, 6)), total)

    job = json.dumps({"prompt": prompt, "options": build_options(a, worktree, a.model), "out": out})
    cmd = [sys.executable, os.path.join(HERE, "bounded")]
    if minutes is not None:
        cmd += ["--minutes", str(minutes)]
    cmd += ["--", shutil.which("node"), os.path.join(HERE, "credit-run-worker.mjs"), sdk_dir()]
    r = subprocess.run(cmd, input=job, capture_output=True, text=True, env=child_env(key, ttl))
    err = scrub(r.stderr, key).strip()
    try:
        with open(out) as f:
            text = f.read()
        if key in text:
            with open(out, "w") as f:
                f.write(scrub(text, key))
    except OSError:
        pass

    summary = None
    for line in reversed(scrub(r.stdout, key).splitlines()):
        try:
            summary = json.loads(line)
            break
        except ValueError:
            continue
    if r.returncode == 124:
        err = (err + "\n" if err else "") + "stopped at the time limit"
    if err:
        print(err.splitlines()[-1], file=sys.stderr)
    if not isinstance(summary, dict) or "subtype" not in summary:
        print(f"credit-run: job {run} gave no result; its reservation stays counted", file=sys.stderr)
        return 1

    sub = summary["subtype"]
    state = "cap" if sub == "error_max_budget_usd" else "ok" if sub == "success" and not summary.get("is_error") else sub
    append_line(dict(meta, time=time.strftime("%Y-%m-%dT%H:%M:%S%z"), phase="final", state=state,
                     cost=summary.get("cost"), turns=summary.get("turns"),
                     session_id=summary.get("session_id")))
    print(summary.get("result") or "")
    cost = summary.get("cost")
    print(f"cost ${cost:.4f}" if cost is not None else "cost unknown")
    if state == "cap":
        print(f"credit-run: budget cap hit; resume with --resume {summary.get('session_id')}", file=sys.stderr)
        return 3
    return 0 if state == "ok" else 1


# self-test

KEY = "sk-ant-FAKEKEY1234567890"

FAKE_NODE = r'''#!/usr/bin/env python3
