FAKE_KEY_TOOL = '''#!/bin/sh
case "$FAKE_KEY_MODE" in
  empty) echo "" ;;
  missing) exit 44 ;;
  *) echo "%s" ;;
esac
''' % KEY


def self_test():
    fails = []
    me = os.path.realpath(__file__)

    def check(ok, msg):
        if not ok:
            fails.append(msg)

    tmp = tempfile.mkdtemp(prefix="credit-run-test-")
    try:
        bindir = os.path.join(tmp, "bin")
        nonode = os.path.join(tmp, "nonode")
        os.makedirs(bindir)
        os.makedirs(nonode)
        for name, body in (("node", FAKE_NODE), ("security", FAKE_KEY_TOOL), ("secret-tool", FAKE_KEY_TOOL),
                           ("npm", '#!/bin/sh\nprintf "%s\\n" "$@" > "$FAKE_NPM_REC"\n')):
            p = os.path.join(bindir, name)
            with open(p, "w") as f:
                f.write(body)
            os.chmod(p, 0o755)
        gitpath = shutil.which("git")
        os.symlink(gitpath, os.path.join(nonode, "git"))
        for name in ("security", "secret-tool"):
            os.symlink(os.path.join(bindir, name), os.path.join(nonode, name))
        fake_home = os.path.join(tmp, "home")
        os.makedirs(os.path.join(fake_home, ".lean", "credit-sdk", "node_modules", "@anthropic-ai",
                                 "claude-agent-sdk"))
        open(os.path.join(fake_home, ".lean", "credit-sdk", "node_modules", "@anthropic-ai",
                          "claude-agent-sdk", "sdk.mjs"), "w").close()
        ledger = os.path.join(fake_home, ".lean", "credit-runs.jsonl")
        rec = os.path.join(tmp, "rec.json")

        # a repo, a clean linked worktree, and a dirty one
        main_repo = os.path.join(tmp, "main")
        os.makedirs(main_repo)
        g = ["git", "-C", main_repo, "-c", "user.name=t", "-c", "user.email=t@t"]
        subprocess.run(g + ["init", "-q", "-b", "main"], check=True)
        subprocess.run(g + ["commit", "-q", "--allow-empty", "-m", "x"], check=True)
        wt = os.path.join(tmp, "wt")
        wt_dirty = os.path.join(tmp, "wt-dirty")
        subprocess.run(g + ["worktree", "add", "-q", "-b", "a", wt], check=True)
        subprocess.run(g + ["worktree", "add", "-q", "-b", "b", wt_dirty], check=True)
        open(os.path.join(wt_dirty, "junk"), "w").write("x")
        brief = os.path.join(tmp, "brief.md")
        open(brief, "w").write("do the thing")

        base = {"PATH": bindir + os.pathsep + os.environ.get("PATH", ""), "HOME": fake_home,
                "FAKE_REC": rec, "FAKE_NPM_REC": os.path.join(tmp, "npm.txt")}

        def env(**kw):
            e = dict(base)
            e.update(kw)
            return e

        on = {"LEAN_CREDIT_RUNS": "on", "LEAN_CREDIT_TOTAL_USD": "2.0"}

        def run(args, e, **kw):
            for f in (rec,):
                if os.path.exists(f):
                    os.remove(f)
            return subprocess.run([sys.executable, me] + args, capture_output=True, text=True, env=e, **kw)

        def job_args(*extra, wtree=wt, budget="0.5"):
            return ["--brief", brief, "--worktree", wtree, "--budget", budget] + list(extra)

        def rec_json():
            return json.load(open(rec)) if os.path.exists(rec) else None

        def one_line(r):
            return r.returncode == 2 and len(r.stderr.strip().splitlines()) == 1 and "Traceback" not in r.stderr

        def reset_ledger():
            if os.path.exists(ledger):
                os.remove(ledger)

        # switch off
        r = run(job_args(), env(LEAN_CREDIT_TOTAL_USD="2.0"))
        check(one_line(r) and rec_json() is None and not os.path.exists(ledger), f"switch off did not stop the job: {r.returncode} {r.stderr!r}")
        r = run(job_args(), env(LEAN_CREDIT_RUNS="off", LEAN_CREDIT_TOTAL_USD="2.0"))
        check(one_line(r) and rec_json() is None, "switch off (explicit) started a job")
        # an edit job never runs on the tool's own folder, above it or below it
        for place in (ROOT, os.path.dirname(ROOT), os.path.join(ROOT, "tools")):
            r = run(job_args(wtree=place), env(LEAN_CREDIT_RUNS="on", LEAN_CREDIT_TOTAL_USD="2.0"))
            check(one_line(r) and "holds this tool" in r.stderr and rec_json() is None, f"edit job passes at {place}: {r.stderr!r}")
        # --spent and --key-help work with the switch off
        r = run(["--spent"], env())
        check(r.returncode == 0 and "local estimate" in r.stdout and "Console" in r.stdout, f"--spent: {r.stdout!r}")
        r = run(["--key-help"], env())
        check(r.returncode == 0 and ("security add-generic-password" in r.stdout or "secret-tool store" in r.stdout)
              and KEY not in r.stdout, "--key-help")

        # missing total
        r = run(job_args(), env(LEAN_CREDIT_RUNS="on"))
        check(one_line(r) and rec_json() is None, f"missing total started a job: {r.returncode} {r.stderr!r}")

        # a reservation over the total refuses: 0.6 + 0.5 turn reserve is 1.1 over 1.0
        r = run(job_args(budget="0.6"), env(LEAN_CREDIT_RUNS="on", LEAN_CREDIT_TOTAL_USD="1.0"))
        check(one_line(r) and rec_json() is None and not open(ledger).read().strip(), f"over-total job started: {r.returncode} {r.stderr!r}")

        # a good run: env, options, ledger, key absence
        reset_ledger()
        e = env(**on, LEAN_CREDIT_ADVISOR="opus", LEAN_CREDIT_CACHE_TTL="1h",
                ANTHROPIC_AUTH_TOKEN="tok-a", CLAUDE_CODE_OAUTH_TOKEN="tok-b", FAKE_MODE="leak",
                ANTHROPIC_BASE_URL="http://x", CLAUDE_CODE_USE_BEDROCK="1",
                CLAUDE_CODE_USE_VERTEX="1", CLAUDE_CODE_USE_FOUNDRY="1")
        out_file = os.path.join(tmp, "out.json")
        r = run(job_args("--role", "hunt", "--out", out_file), e)
        c = rec_json()
        check(r.returncode == 0 and c is not None, f"good run failed: {r.returncode} {r.stderr!r} {r.stdout!r}")
        if c:
            names = c["env_names"]
            check("ANTHROPIC_AUTH_TOKEN" not in names, "ANTHROPIC_AUTH_TOKEN reached the child")
            check("CLAUDE_CODE_OAUTH_TOKEN" not in names, "CLAUDE_CODE_OAUTH_TOKEN reached the child")
            for gone in ("ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX",
                         "CLAUDE_CODE_USE_FOUNDRY"):
                check(gone not in names, f"{gone} reached the child")
            check(c["key_ok"] is True, "the key did not reach the child env")
            check(c["cache_ttl"] == "1h", f"cache ttl not passed: {c['cache_ttl']!r}")
            check(c["scrub"] == "1", f"key not scrubbed from Bash and hooks: {c['scrub']!r}")
            job = json.loads(c["stdin"])
            opts = job["options"]
            check(job["prompt"].startswith("do the thing") and "never `git -C`" in job["prompt"], "git note not in the prompt")
            check(opts.get("settings", {}).get("advisorModel") == "opus", "advisor not passed")
            check("fastMode" not in opts.get("settings", {}), "fastMode set without --fast")
            check(opts.get("settings", {}).get("attribution") is False, "attribution not turned off")
            check(not {"Edit", "Write"} & set(opts["allowedTools"]), "Edit or Write passes outside the worktree")
            check(any(x.startswith("Write(//") and x.endswith("/**)") for x in opts["allowedTools"]), "Write not scoped to the worktree")
            check("Write(**/.git/**)" in opts["disallowedTools"] and "Edit(**/.git/**)" in opts["disallowedTools"], "git metadata not denied")
            check("Bash(git * --out*)" in opts["disallowedTools"], "git --output not denied")
            check(opts["settingSources"] == [] and opts["permissionMode"] == "dontAsk", "scope or permission mode")
            check(opts["plugins"] == [{"type": "local", "path": ROOT}], "plugin path")
            for d in ("Bash(git push:*)", "Bash(git -C:*)", "Bash(git -c:*)", "Read(/proc/**)"):
                check(d in opts["disallowedTools"], f"{d} not denied on an edit job")
            check(json.loads(c["stdin"])["prompt"].startswith("do the thing") and "never `git -C`" in json.loads(c["stdin"])["prompt"], "git note missing on an edit job")
            check(opts["maxBudgetUsd"] == 0.5 and opts["model"] == "sonnet", "budget or model")
            leak_places = {
                "argv": json.dumps(c["argv"]), "stdin": c["stdin"], "stdout": r.stdout, "stderr": r.stderr,
                "ledger": open(ledger).read(), "output file": open(out_file).read(),
            }
            for place, text in leak_places.items():
                check(KEY not in text, f"the key is in the {place}")
            check("[redacted]" in r.stdout + r.stderr, "the fake leaked the key but nothing was redacted")
        check(scrub("a " + KEY, KEY) == "a [redacted]", "scrub does not remove the key")
        lines = [json.loads(x) for x in open(ledger)]
        check([x["phase"] for x in lines] == ["reserve", "final"] and lines[0]["run"] == lines[1]["run"], f"ledger shape: {lines}")
        if len(lines) == 2:
            check(lines[1]["role"] == "hunt" and lines[1]["advisor"] == "opus" and lines[1]["speed"] == "standard"
                  and lines[1]["state"] == "ok" and lines[0]["reserved"] == 1.0, f"ledger fields: {lines}")
        check("leaked [redacted]" in r.stdout and "cost $0.0100" in r.stdout, f"stdout: {r.stdout!r}")

        # key problems: empty and missing exit 2 with one line and no job
        for mode in ("empty", "missing"):
            reset_ledger()
            r = run(job_args(), env(**on, FAKE_KEY_MODE=mode))
            check(one_line(r) and rec_json() is None and not os.path.exists(ledger), f"{mode} key: {r.returncode} {r.stderr!r}")
            check(KEY not in r.stderr, "key text in error")

        # --fast
        reset_ledger()
        r = run(job_args("--fast", "--model", "sonnet"), env(**on, LEAN_CREDIT_FAST="on"))
        check(one_line(r) and rec_json() is None, "--fast with sonnet started")
        r = run(job_args("--fast", "--model", "opus"), env(**on))
        check(one_line(r) and rec_json() is None, "--fast without the switch started")
        r = run(job_args("--fast", "--model", "claude-opus-4-1"), env(**on, LEAN_CREDIT_FAST="on"))
        c = rec_json()
        check(r.returncode == 0 and c and json.loads(c["stdin"])["options"]["settings"].get("fastMode") is True, f"--fast opus: {r.stderr!r}")
        check(open(ledger).read().count('"speed": "fast"') == 2, "speed not in the ledger")

        # push refused
        for bad in ("Bash(git push:*)", "Bash", "Bash(git:*)", "Bash(git -C x push origin)",
                    "Bash(git -C:*)", "Bash(git -c:*)", "Bash(git -c x=y status)", "Bash(git pu*)",
                    "Bash(git p?sh:*)", "Bash(sh -c:*)", "Bash(bash:*)", "Bash(zsh -c:*)", "Bash(env:*)",
                    "Bash(xargs:*)", "Bash(python:*)", "Bash(python3 -c:*)", "Bash(node -e:*)",
                    "Bash(perl:*)", "Bash(ruby:*)", "Bash(eval:*)", "Bash(exec:*)", "Bash(/bin/sh -c:*)"):
            r = run(job_args("--allow", bad), env(**on))
            check(one_line(r) and rec_json() is None, f"--allow {bad!r} was not refused")
        r = run(job_args("--allow", "Bash(npm run build:*)"), env(**on))
        c = rec_json()
        check(r.returncode == 0 and c and "Bash(npm run build:*)" in json.loads(c["stdin"])["options"]["allowedTools"], "a fine --allow was refused")

        # worktree checks
        for label, path in (("main checkout", main_repo), ("dirty worktree", wt_dirty)):
            r = run(job_args(wtree=path), env(**on))
            check(one_line(r) and rec_json() is None, f"{label} started a job")
        r = run(job_args("--read-only", wtree=wt_dirty), env(**on))
        c = rec_json()
        check(r.returncode == 0 and c is not None, f"read-only on a dirty tree: {r.stderr!r}")
        if c:
            o = json.loads(c["stdin"])["options"]
            for field in ("tools", "allowedTools"):
                check(not any(x.startswith(("Edit", "Write")) for x in o[field]), f"read-only {field} has an edit tool: {o[field]}")
            check(o["tools"] == ["Read", "Glob", "Grep"], f"read-only tools: {o['tools']}")
            check(o["allowedTools"] == ["Read", "Glob", "Grep"], f"read-only allowedTools: {o['allowedTools']}")
            check("Read(/proc/**)" in o["disallowedTools"], "read-only does not deny /proc")
            check("git" not in json.loads(c["stdin"])["prompt"], "git note on a read-only job")
        r = run(job_args("--read-only", "--allow", "Bash(git push:*)"), env(**on))
        check(one_line(r) and rec_json() is None, "read-only with --allow push started")
        r = run(job_args("--role", "nonsense"), env(**on))
        check(one_line(r) and rec_json() is None, "bad role accepted")

        # cap hit: cost counted, session id shown, exit 3
        reset_ledger()
        r = run(job_args(), env(**on, FAKE_MODE="cap"))
        check(r.returncode == 3 and "sess-1" in r.stderr, f"cap hit: {r.returncode} {r.stderr!r}")
        check(json.loads(open(ledger).readlines()[-1])["state"] == "cap", "cap state not in the ledger")
        r = run(["--spent"], env(**on))
        check("spent    $0.0900" in r.stdout and "reserved $0.0000" in r.stdout, f"cap spent: {r.stdout!r}")

        # the timeout path: bounded stops the worker, exit 1, the reservation stays
        reset_ledger()
        r = run(job_args("--minutes", "0.02"), env(**on, FAKE_MODE="sleep"))
        check(r.returncode == 1 and "time limit" in r.stderr and open(ledger).read().count("\n") == 1,
              f"timeout: {r.returncode} {r.stderr!r}")
        pid = (rec_json() or {}).get("pid")
        if pid:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass

        # parallel reservations: 4 jobs reserve 1.0 each against a total of 2.0, so 2 pass
        reset_ledger()
        procs = []
        for i in range(4):
            procs.append(subprocess.Popen(
                [sys.executable, me] + job_args("--minutes", "0.05"),
                env=env(**on, FAKE_MODE="sleep", FAKE_REC=os.path.join(tmp, f"par{i}.json")),
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True))
        codes = sorted(p.wait(timeout=60) for p in procs)
        for p in procs:
            p.stdout.close()
            p.stderr.close()
        reserved_lines = sum(1 for x in open(ledger) if '"phase": "reserve"' in x)
        check(codes == [1, 1, 2, 2] and reserved_lines == 2, f"parallel reserve: codes={codes} reserved={reserved_lines}")
        for i in range(4):
            try:
                os.kill(json.load(open(os.path.join(tmp, f"par{i}.json")))["pid"], signal.SIGKILL)
            except (OSError, ValueError):
                pass

        # a cut-off ledger line does not swallow the next record
        reset_ledger()
        with open(ledger, "w") as f:
            f.write('{"run": "cut", "phase": "rese')
        r = run(job_args(), env(**on))
        parsed = []
        for x in open(ledger).read().split("\n"):
            try:
                parsed.append(json.loads(x))
            except ValueError:
                pass
        check(r.returncode == 0 and [x["phase"] for x in parsed] == ["reserve", "final"], f"cut-off line: {parsed}")

        # a worker crash leaves its reservation counting
        reset_ledger()
        r = run(job_args(), env(**on, FAKE_MODE="crash"))
        check(r.returncode == 1 and open(ledger).read().count("\n") == 1, f"crash: {r.returncode} {open(ledger).read()!r}")
        r = run(["--spent"], env(**on))
        check("reserved $1.0000" in r.stdout, f"crash reservation: {r.stdout!r}")

        # a killed job's reservation counts, and blocks the next job
        reset_ledger()
        p = subprocess.Popen([sys.executable, me] + job_args(), env=env(**on, FAKE_MODE="sleep"),
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        end = time.monotonic() + 15
        while time.monotonic() < end and not (os.path.exists(ledger) and os.path.exists(rec)):
            time.sleep(0.1)
        child_pid = (rec_json() or {}).get("pid")
        p.send_signal(signal.SIGKILL)
        p.wait()
        r = run(["--spent"], env(**on))
        check("reserved $1.0000" in r.stdout, f"killed job not counted: {r.stdout!r}")
        r = run(job_args(budget="0.6"), env(**on))
        check(one_line(r) and rec_json() is None, f"a job passed over a killed job's reservation: {r.returncode} {r.stderr!r}")
        if child_pid:
            try:
                os.kill(child_pid, signal.SIGKILL)
            except OSError:
                pass

        # older single-line rows (no phase) count against the total
        reset_ledger()
        with open(ledger, "w") as f:
            f.write(json.dumps({"time": "t", "branch": "x", "model": "m", "budget": 1.0, "cost": 0.75,
                                "cost_known": True, "turns": 1, "state": "ok", "session": "old-1"}) + "\n")
            f.write(json.dumps({"time": "t", "budget": 0.4, "cost": None, "cost_known": False}) + "\n")
            f.write(json.dumps({"time": "t", "budget": 0.4, "cost": "lots"}) + "\n")
            f.write("not json\n")
        r = run(["--spent"], env(**on))
        check("spent    $1.1500" in r.stdout and "unknown  1" in r.stdout and "skipped  2" in r.stdout,
              f"older rows: {r.stdout!r}")
        # 1.15 spent plus a 1.0 reservation is over 2.0
        r = run(job_args(), env(**on))
        check(one_line(r) and rec_json() is None, f"a job passed over older rows: {r.returncode} {r.stderr!r}")
        r = run(job_args(budget="0.3"), env(**on))
        check(r.returncode == 0, f"a job that fits was refused: {r.stderr!r}")

        # --pace: no key, no worker, no switch
        import contextlib
        import datetime as dt
        import io
        import credit_common as cc
        day_rows = lambda *rs: open(ledger, "w").write("".join(json.dumps(x) + "\n" for x in rs))  # noqa: E731

        def pace_in_process(now, **vals):
            saved = dict(os.environ)
            os.environ.update({"HOME": fake_home, "LEAN_CREDIT_TOTAL_USD": "100"})
            for k in ("LEAN_CREDIT_UNTIL", "LEAN_CREDIT_CODE"):
                os.environ.pop(k, None)
            os.environ.update(vals)
            buf = io.StringIO()
            try:
                with contextlib.redirect_stdout(buf):
                    cc.pace_report(now)
            finally:
                os.environ.clear()
                os.environ.update(saved)
            return buf.getvalue()

        utc = dt.timezone.utc
        noon = dt.datetime(2026, 11, 10, 12, 0, tzinfo=utc)
        fin = lambda t, c: {"run": "x" + t, "phase": "final", "cost": c, "time": t}  # noqa: E731
        # 10 days left (10 to 19 Nov, last day counts), 100 total, 0 spent: 10 per day
        reset_ledger()
        out = pace_in_process(noon, LEAN_CREDIT_UNTIL="2026-11-19")
        check("days left 10" in out and "per day   $10.0000" in out and "state     behind" in out
              and "Next: move docs and tickets to credits. LEAN_CREDIT_CODE=on would add coding." in out,
              f"pace behind: {out!r}")
        out = pace_in_process(noon, LEAN_CREDIT_UNTIL="2026-11-19", LEAN_CREDIT_CODE="on")
        check("Next: move coding jobs to credits too." in out and "state     behind" in out, f"pace behind, code on: {out!r}")
        # 12 spent today against 88 over 10 days (8.8 per day): ahead
        day_rows(fin("2026-11-10T09:00:00+0000", 12.0))
        out = pace_in_process(noon, LEAN_CREDIT_UNTIL="2026-11-19", LEAN_CREDIT_CODE="on")
        check("state     ahead" in out and "today     $12.0000 spent" in out
              and out.strip().splitlines()[-1] == "Next: keep credits to review work.", f"pace ahead: {out!r}")
        # reserved money counts as used for remaining
        day_rows({"run": "r", "phase": "reserve", "reserved": 20.0, "time": "2026-11-10T09:00:00+0000"})
        out = pace_in_process(noon, LEAN_CREDIT_UNTIL="2026-11-19")
        check("reserved  $20.0000" in out and "remaining $80.0000" in out and "per day   $8.0000" in out
              and "today     $0.0000 spent" in out, f"pace reserved: {out!r}")
        # the last day: days left 1
        reset_ledger()
        out = pace_in_process(noon, LEAN_CREDIT_UNTIL="2026-11-10")
        check("days left 1" in out and "per day   $100.0000" in out, f"pace last day: {out!r}")
        # 23:30 on the 9th at UTC-8 and 00:30 on the 11th at UTC+8 are both the 10th in UTC; 09:30 on the 11th at UTC+8 is the 11th
        day_rows(fin("2026-11-09T23:30:00-0800", 3.0), fin("2026-11-11T00:30:00+0800", 4.0),
                 fin("2026-11-11T09:30:00+0800", 50.0))
        out = pace_in_process(noon, LEAN_CREDIT_UNTIL="2026-11-19")
        check("today     $7.0000 spent" in out, f"pace offsets: {out!r}")
        # the same instant is a different day at another now
        out = pace_in_process(dt.datetime(2026, 11, 10, 20, 5, tzinfo=dt.timezone(dt.timedelta(hours=-8))),
                              LEAN_CREDIT_UNTIL="2026-11-19")
        check("days left 9" in out and "today     $50.0000 spent" in out, f"pace now with an offset: {out!r}")
        # legacy rows count in the total
        day_rows({"time": "2026-11-10T01:00:00+0000", "budget": 1.0, "cost": 30.0, "cost_known": True})
        out = pace_in_process(noon, LEAN_CREDIT_UNTIL="2026-11-19")
        check("spent     $30.0000" in out and "today     $30.0000 spent" in out, f"pace legacy row: {out!r}")
        # exits: bad input, with the switch off, no key read and no worker started
        for label, extra in (("past date", {"LEAN_CREDIT_UNTIL": "2000-01-01"}),
                             ("bad date", {"LEAN_CREDIT_UNTIL": "2026-13-45"}),
                             ("short date", {"LEAN_CREDIT_UNTIL": "2026-1-5"}),
                             ("no date", {}),
                             ("no total", {"LEAN_CREDIT_UNTIL": "2999-01-01", "LEAN_CREDIT_TOTAL_USD": ""})):
            r = run(["--pace"], env(**dict({"LEAN_CREDIT_TOTAL_USD": "100"}, **extra)))
            check(one_line(r) and rec_json() is None, f"--pace {label}: {r.returncode} {r.stderr!r}")
        key_rec = os.path.join(tmp, "key-read")
        bad_key = os.path.join(bindir, "security")
        saved_tool = open(bad_key).read()
        for name in ("security", "secret-tool"):
            with open(os.path.join(bindir, name), "w") as f:
                f.write(f'#!/bin/sh\ntouch "{key_rec}"\necho x\n')
        r = run(["--pace"], env(LEAN_CREDIT_TOTAL_USD="100", LEAN_CREDIT_UNTIL="2999-01-01"))
        check(r.returncode == 0 and "Next:" in r.stdout and rec_json() is None and not os.path.exists(key_rec),
              f"--pace read the key or started a worker: {r.returncode} {r.stderr!r}")
        for name in ("security", "secret-tool"):
            with open(os.path.join(bindir, name), "w") as f:
                f.write(saved_tool)

        # the real worker under real node, against a fake SDK
        real_node = shutil.which("node", path=os.environ.get("PATH", ""))
        if not real_node:
            print("self-test note: node not found, worker tests skipped")
        else:
            sdk = os.path.join(tmp, "fakesdk")
            sdk_mod = os.path.join(sdk, "node_modules", "@anthropic-ai", "claude-agent-sdk")
            os.makedirs(sdk_mod)
            with open(os.path.join(sdk_mod, "sdk.mjs"), "w") as f:
                f.write("""export async function* query() {
  yield { type: 'system', subtype: 'init' }
  if (process.env.FAKE_SDK_MODE === 'cap') {
    yield { type: 'result', subtype: 'error_max_budget_usd', is_error: true, total_cost_usd: 0.09,
            num_turns: 2, session_id: 's1', result: 'partial ' + process.env.ANTHROPIC_API_KEY }
    throw new Error('Reached maximum budget')
  }
  throw new Error('boom')
}
""")
            worker = os.path.join(HERE, "credit-run-worker.mjs")
            wenv = {"PATH": os.environ.get("PATH", ""), "HOME": fake_home, "ANTHROPIC_API_KEY": KEY}
            for mode in ("cap", "throw"):
                wout = os.path.join(tmp, f"w-{mode}.json")
                w = subprocess.run([real_node, worker, sdk], capture_output=True, text=True,
                                   input=json.dumps({"prompt": "p", "options": {}, "out": wout}),
                                   env=dict(wenv, FAKE_SDK_MODE=mode))
                if mode == "cap":
                    check(w.returncode == 0 and os.path.exists(wout), f"worker cap: rc={w.returncode} {w.stderr!r}")
                    summary = json.loads(w.stdout.strip().splitlines()[-1]) if w.stdout.strip() else {}
                    check(summary.get("subtype") == "error_max_budget_usd" and summary.get("session_id") == "s1"
                          and summary.get("cost") == 0.09, f"worker cap summary: {summary}")
                    written = open(wout).read() if os.path.exists(wout) else ""
                    check(KEY not in w.stdout + w.stderr + written and "[redacted]" in written,
                          "the worker did not scrub the key itself")
                else:
                    check(w.returncode == 1 and not os.path.exists(wout) and not w.stdout.strip(),
                          f"worker throw: rc={w.returncode} out={os.path.exists(wout)} {w.stdout!r}")
                    check(KEY not in w.stderr, "key in worker stderr")

        # setup and missing pieces
        npm_rec = base["FAKE_NPM_REC"]
        r = run(["--setup"], env())
        args = open(npm_rec).read().split() if os.path.exists(npm_rec) else []
        check(r.returncode == 0 and "--prefix" in args and f"{SDK_PACKAGE}@{SDK_VERSION}" in args
              and f"{BATCH_SDK_PACKAGE}@{BATCH_SDK_VERSION}" in args, f"--setup argv: {args}")
        shutil.rmtree(os.path.join(fake_home, ".lean", "credit-sdk"))
        r = run(job_args(), env(**on))
        check(one_line(r) and "--setup" in r.stderr and rec_json() is None, f"no SDK: {r.stderr!r}")
        r = run(job_args(), env(**on, PATH=nonode))
        check(one_line(r) and "node" in r.stderr and rec_json() is None, f"no node: {r.stderr!r}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    for f in fails:
        print("self-test failed:", f)
    if fails:
        return 1
    print("self-test passed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
