mode = os.environ.get("FAKE_MODE", "ok")
raw = sys.stdin.read()
job = json.loads(raw)
key = "%s"
rec = {"argv": sys.argv, "stdin": raw, "pid": os.getpid(),
       "env_names": sorted(os.environ),
       "cache_ttl": os.environ.get("CLAUDE_CODE_PROMPT_CACHE_TTL"),
       "scrub": os.environ.get("CLAUDE_CODE_SUBPROCESS_ENV_SCRUB"),
