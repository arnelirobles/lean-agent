#!/usr/bin/env python3
"""A local list of what went wrong and is not fixed yet, shared by every session on the machine.

  brain add --project P --kind K --ref R [--repo R] [--branch B] [--title T] [--body B | --body-file F]
            [--severity S] [--phase P] [--source S] [--model M] [--cycle C] [--commit H] [--link L]
            [--run-id N] [--tag T ...] [--session ID] [--session-cwd DIR]
  brain list [--open] [--status S] [--project P] [--kind K] [--tag T] [--cycle C]
  brain show ID
  brain close ID [--wontfix] [--resolution R] [--note N] [--commit H] [--tag T ...]
  brain reopen ID
  brain run-add --cycle C --project P --test-project T --tier fast|full|rerun [--repo R] [--runner mtp|vstest]
            [--started E] [--ended E] [--lane-wait N] [--load-start X] [--load-end X] [--passed N]
            [--failed N] [--skipped N] [--stalled 0|1] [--exit-code N] [--host NAME]      prints the run id
  brain queue add <repo-dir> <test-project> [--filter F] [--tier fast|full] [--after ID] [--cycle C]
            [--by NAME] [--project P] [--platform apple|auto|none] [--args=EXTRA]      prints the job id and returns at once; EXTRA is
            extra dotnet arguments for this job, written --args=-p:X=1 so a leading dash is not read as an option.
            --platform auto (the default) marks the job apple when the test project targets -maccatalyst, -ios
            or -macos; a remote lane never claims an apple job
  brain queue list [--cycle C] [--status S]
  brain queue cancel ID                    a queued job; jobs waiting on it are cancelled too
  brain queue route ID --to remote|local|any   remote: only a remote lane claims it; local: only this
            machine (platform=apple); any: whichever lane is free
  brain queue next [--peek] [--where local|remote] [--host NAME]   (what test-phase uses to drain)
  brain queue finish ID --status done|failed | requeue ID --reason R   (requeue puts a running job back)
  brain resume [--project P] [--max N]
  brain stats [--json]
  brain export [--format md|json] [--project P] [--status S]
  brain session start|end|status ID [--cwd DIR]
  brain answers --session ID
  brain --self-test

The file is ${LEAN_BRAIN_DB:-~/.local/share/lean/brain.db}, one sqlite database with a schema version
(table meta) that is migrated forward on open. Nothing leaves the machine. Output is plain text, one
line per item. --body-file - reads the body from stdin.

Kinds in use: test-fail, flaky, minor, question, ticket, security, and three for surviving a context
compaction: pending (the next step), blocker (waiting on the user, or a denied action that must not be
worked around) and agent (a running subagent: id, task and worktree in the title or body; closed when it
reports back). Others are allowed. Never store secrets, tokens or passwords.
resume prints the open items of one project as a short digest: blockers, agents, queued and running
jobs, pending, questions, then the rest, newest first, titles only, at most --max lines (default 40). The project defaults to the
git toplevel's name in the current directory. It prints nothing and exits 0 when there is no database
or nothing open. Queued and running jobs are listed after the blockers and agents. The SessionStart hook runs it on startup and after a compaction.
Status: open, closed, wontfix. Resolution: fixed, flaky, not-a-bug, duplicate, answered, filed.
Severity: critical, important, minor, info. Phase: code, test, fix, review.
Source: test-phase, agent, review, user. Model: haiku, sonnet, opus, or empty.
add stores the Claude session that filed the item and its folder (--session, --session-cwd, defaulting
to $LEAN_SESSION_ID and $LEAN_SESSION_CWD, which the session-env hook sets), so an answer can resume it.
session records whether a session is open or ended (the session-env hook calls it), so an answer
never starts a second copy of a live session. answers prints the answered questions a session filed that
it has not had yet and marks them delivered; close --delivered marks one delivered at once.

Adding an open item with the same project, kind and ref does not make a new row: it raises
occurrences and moves last_seen, so a failure seen in ten runs is one line.

The queue replaces wait loops. Never write a sleep or pgrep loop to wait for the test lane: enqueue and
end the turn. bin/test-phase drains the queue, one drainer at a time, oldest ready job first. A job
whose --after job failed or was cancelled is cancelled with the reason. States: queued, running, done,
failed, cancelled.

What goes where. Brain holds anything with a status that changes: test failures, flaky classes,
deferred minors, open questions for the user, unfiled or filed tickets, security findings. Markdown
ledgers keep rulings (decisions, with the cost if wrong), task complete lines and user decisions.
Memory files keep standing preferences. Run logs are scratch and can expire once their failures are in
brain. A ledger points to open items with a line like "open items: brain list --project X --status open".
"""
import argparse
import calendar
import json
import os
import re
import sqlite3
import statistics
import subprocess
import sys
import tempfile
import time

STATUS = ("open", "closed", "wontfix")
RESOLUTION = ("fixed", "flaky", "not-a-bug", "duplicate", "answered", "filed")
SEVERITY = ("critical", "important", "minor", "info")
PHASE = ("code", "test", "fix", "review")
SOURCE = ("test-phase", "agent", "review", "user")
MODEL = ("haiku", "sonnet", "opus", "")
TIERS = ("fast", "full", "rerun")
RUNNERS = ("mtp", "vstest", "")

ITEM_COLS = ("id project repo branch kind ref title body status resolution severity phase source model "
             "cycle commit_hash link run_id occurrences first_seen last_seen closed_at").split()


def db_path():
    return os.environ.get("LEAN_BRAIN_DB") or os.path.expanduser("~/.local/share/lean/brain.db")


def migrate_1(con):  # the first layout: one flat table
    con.execute("""CREATE TABLE entries (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        project TEXT NOT NULL, branch TEXT NOT NULL DEFAULT '', kind TEXT NOT NULL, ref TEXT NOT NULL,
        detail TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'open',
        seen INTEGER NOT NULL DEFAULT 1, first_seen TEXT NOT NULL, last_seen TEXT NOT NULL,
        closed_at TEXT, note TEXT NOT NULL DEFAULT '')""")


def migrate_2(con):  # items, tags and runs; carries over rows from the flat table
    con.execute("""CREATE TABLE runs (
        id INTEGER PRIMARY KEY AUTOINCREMENT, cycle TEXT NOT NULL DEFAULT '', project TEXT NOT NULL,
        repo TEXT NOT NULL DEFAULT '', test_project TEXT NOT NULL DEFAULT '', runner TEXT NOT NULL DEFAULT '',
        tier TEXT NOT NULL DEFAULT 'full', started INTEGER, ended INTEGER, duration_s REAL,
        lane_wait_s REAL, load_start REAL, load_end REAL, passed INTEGER NOT NULL DEFAULT 0,
        failed INTEGER NOT NULL DEFAULT 0, skipped INTEGER NOT NULL DEFAULT 0,
        stalled INTEGER NOT NULL DEFAULT 0, exit_code INTEGER)""")
    con.execute("""CREATE TABLE items (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        project TEXT NOT NULL, repo TEXT NOT NULL DEFAULT '', branch TEXT NOT NULL DEFAULT '',
        kind TEXT NOT NULL, ref TEXT NOT NULL, title TEXT NOT NULL DEFAULT '', body TEXT NOT NULL DEFAULT '',
        status TEXT NOT NULL DEFAULT 'open', resolution TEXT NOT NULL DEFAULT '',
        severity TEXT NOT NULL DEFAULT '', phase TEXT NOT NULL DEFAULT '', source TEXT NOT NULL DEFAULT '',
        model TEXT NOT NULL DEFAULT '', cycle TEXT NOT NULL DEFAULT '', commit_hash TEXT NOT NULL DEFAULT '',
        link TEXT NOT NULL DEFAULT '', run_id INTEGER REFERENCES runs(id), occurrences INTEGER NOT NULL DEFAULT 1,
        first_seen TEXT NOT NULL, last_seen TEXT NOT NULL, closed_at TEXT)""")
    con.execute("CREATE TABLE tags (item_id INTEGER NOT NULL REFERENCES items(id), tag TEXT NOT NULL, "
                "PRIMARY KEY (item_id, tag))")
    con.execute("CREATE INDEX items_key ON items (project, kind, ref, status)")
    con.execute("CREATE INDEX runs_test ON runs (test_project)")
    if con.execute("SELECT name FROM sqlite_master WHERE name='entries'").fetchone():
        for r in con.execute("SELECT * FROM entries ORDER BY id").fetchall():
            kind = "test-fail" if r["kind"] == "test-failure" else r["kind"]
            body = r["detail"] + (("\n\nclosed: " + r["note"]) if r["note"] else "")
            con.execute("INSERT INTO items (id, project, branch, kind, ref, title, body, status, occurrences,"
                        " first_seen, last_seen, closed_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
                        (r["id"], r["project"], r["branch"], kind, r["ref"], r["ref"], body, r["status"],
                         r["seen"], r["first_seen"], r["last_seen"], r["closed_at"]))
        con.execute("DROP TABLE entries")


def migrate_3(con):  # the queue test-phase drains
    con.execute("""CREATE TABLE jobs (
        id INTEGER PRIMARY KEY AUTOINCREMENT, cycle TEXT NOT NULL DEFAULT '', project TEXT NOT NULL,
        repo_dir TEXT NOT NULL, test_project TEXT NOT NULL, filter TEXT NOT NULL DEFAULT '',
        tier TEXT NOT NULL DEFAULT 'full', after_id INTEGER REFERENCES jobs(id),
        status TEXT NOT NULL DEFAULT 'queued', reason TEXT NOT NULL DEFAULT '',
        enqueued_by TEXT NOT NULL DEFAULT '', enqueued_at TEXT NOT NULL, started_at TEXT, ended_at TEXT,
        run_id INTEGER REFERENCES runs(id))""")
    con.execute("CREATE INDEX jobs_status ON jobs (status, id)")


def migrate_4(con):  # extra arguments for the test command, per job
    con.execute("ALTER TABLE jobs ADD COLUMN args TEXT NOT NULL DEFAULT ''")


def migrate_5(con):  # the session that filed an item and its folder, so an answer can resume it
    con.execute("ALTER TABLE items ADD COLUMN session_id TEXT NOT NULL DEFAULT ''")
    con.execute("ALTER TABLE items ADD COLUMN session_cwd TEXT NOT NULL DEFAULT ''")
    con.execute("ALTER TABLE items ADD COLUMN answer_delivered_at TEXT NOT NULL DEFAULT ''")
    con.execute("""CREATE TABLE sessions (id TEXT PRIMARY KEY, cwd TEXT NOT NULL DEFAULT '',
        started_at TEXT NOT NULL, ended_at TEXT NOT NULL DEFAULT '')""")


def migrate_6(con):  # a bumped job runs before the rest of the queue
    con.execute("ALTER TABLE jobs ADD COLUMN priority INTEGER NOT NULL DEFAULT 0")


def migrate_7(con):  # which platform a job needs, and which host ran a job or a run
    con.execute("ALTER TABLE jobs ADD COLUMN platform TEXT NOT NULL DEFAULT ''")
    con.execute("ALTER TABLE jobs ADD COLUMN host TEXT NOT NULL DEFAULT ''")
    con.execute("ALTER TABLE runs ADD COLUMN host TEXT NOT NULL DEFAULT ''")
    # Platform was not detected before this step; unknown means local only.
    con.execute("UPDATE jobs SET platform='apple' WHERE status IN ('queued','running')")


MIGRATIONS = [migrate_1, migrate_2, migrate_3, migrate_4, migrate_5, migrate_6, migrate_7]


def connect():
    path = db_path()
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    con = sqlite3.connect(path, timeout=30, isolation_level=None)
    con.row_factory = sqlite3.Row
    con.execute("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)")

    def current():
        row = con.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
        version = int(row["value"]) if row else 0
        if not row and con.execute("SELECT name FROM sqlite_master WHERE name='entries'").fetchone():
            version = 1  # the flat layout was written before the version table existed
        if version > len(MIGRATIONS):
            sys.exit(f"brain: {path} has schema version {version}, newer than this brain knows")
        return version

    if current() < len(MIGRATIONS):
        # One writer migrates; a second opener waits for the lock, then sees the new version and does nothing.
        # SQLite DDL is transactional, so a migration that fails leaves the old version and no half-built tables.
        con.execute("BEGIN IMMEDIATE")
        try:
            for n in range(current(), len(MIGRATIONS)):
                MIGRATIONS[n](con)
                con.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('schema_version', ?)", (str(n + 1),))
            con.execute("COMMIT")
        except BaseException:
            con.execute("ROLLBACK")
            raise
    con.isolation_level = ""  # the rest of brain relies on `with con:` opening and committing a transaction
    return con


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def epoch(ts):
    return calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ"))


def tags_of(con, item_id):
    return [r["tag"] for r in con.execute("SELECT tag FROM tags WHERE item_id=? ORDER BY tag", (item_id,))]


def line(con, r):
    where = r["project"] + ("@" + r["branch"] if r["branch"] else "")
    s = f"#{r['id']} {r['status']} {r['kind']} {where} {r['ref']}"
    if r["severity"]:
        s += f" {r['severity']}"
    s += f" occ={r['occurrences']} last={r['last_seen']}"
    t = tags_of(con, r["id"])
    return s + (" tags=" + ",".join(t) if t else "")


def add_tags(con, item_id, tags):
    for t in tags or []:
        con.execute("INSERT OR IGNORE INTO tags (item_id, tag) VALUES (?,?)", (item_id, t))


def get(con, ident):
    r = con.execute("SELECT * FROM items WHERE id=?", (ident,)).fetchone()
    if not r:
        sys.exit(f"brain: no item #{ident}")
    return r


def body_of(a):
    if a.body_file:
        return sys.stdin.read() if a.body_file == "-" else open(a.body_file).read()
    return a.body or ""


def session_ok(ident):
    return bool(re.fullmatch(r"[A-Za-z0-9-]{1,100}", ident))


def cmd_add(a):
    if a.session and not session_ok(a.session):
        sys.exit("brain: --session takes letters, digits and dashes only")
    con = connect()
    body = body_of(a)
    t = now()
    with con:
        row = con.execute("SELECT * FROM items WHERE status='open' AND project=? AND kind=? AND ref=?",
                          (a.project, a.kind, a.ref)).fetchone()
        if row:
            sets = {"last_seen": t}
            for col, val in (("branch", a.branch), ("body", body), ("repo", a.repo), ("cycle", a.cycle),
                             ("severity", a.severity), ("link", a.link), ("run_id", a.run_id),
                             ("session_id", a.session), ("session_cwd", a.session_cwd if a.session else "")):
                if val not in ("", None):
                    sets[col] = val
            con.execute("UPDATE items SET occurrences=occurrences+1, " + ", ".join(f"{k}=?" for k in sets)
                        + " WHERE id=?", list(sets.values()) + [row["id"]])
            item_id, verb = row["id"], "seen again"
        else:
            cur = con.execute(
                "INSERT INTO items (project, repo, branch, kind, ref, title, body, severity, phase, source, model,"
                " cycle, commit_hash, link, run_id, first_seen, last_seen, session_id, session_cwd)"
                " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (a.project, a.repo, a.branch, a.kind, a.ref, a.title or a.ref, body, a.severity, a.phase,
                 a.source, a.model, a.cycle, a.commit, a.link, a.run_id, t, t, a.session,
                 a.session_cwd if a.session else ""))
            item_id, verb = cur.lastrowid, "added"
        add_tags(con, item_id, a.tag)
        print(f"{verb}: " + line(con, get(con, item_id)))
    return 0


def cmd_list(a):
    q, args = "SELECT DISTINCT items.* FROM items", []
    if a.tag:
        q += " JOIN tags ON tags.item_id = items.id AND tags.tag = ?"
        args.append(a.tag)
    q += " WHERE 1=1"
    status = "open" if a.open else a.status
    for col, val in (("status", status), ("project", a.project), ("kind", a.kind), ("cycle", a.cycle)):
        if val:
            q += f" AND items.{col}=?"
            args.append(val)
    con = connect()
    for r in con.execute(q + " ORDER BY items.id", args).fetchall():
        print(line(con, r))
    return 0


def cmd_show(a):
    con = connect()
    r = get(con, a.id)
    print(line(con, r))
    print(f"title: {r['title']}")
    print(f"first seen: {r['first_seen']}")
    for col in ("repo", "resolution", "phase", "source", "model", "cycle", "commit_hash", "link", "run_id", "closed_at",
                "session_id", "session_cwd"):
        if r[col] not in ("", None):
            label = "session" if col == "session_id" else col.replace("_hash", "").replace("_", " ")
            print(f"{label}: {r[col]}")
    if r["body"]:
        print("body: " + r["body"])
    return 0


def cmd_close(a):
    con = connect()
    with con:
        r = get(con, a.id)
        if r["status"] != "open":
            sys.exit(f"brain: #{a.id} is already {r['status']}")
        body = r["body"] + (("\n\nclosed: " + a.note) if a.note else "")
        t = now()
        con.execute("UPDATE items SET status=?, resolution=?, closed_at=?, body=?, answer_delivered_at=?,"
                    " commit_hash=COALESCE(NULLIF(?, ''), commit_hash) WHERE id=?",
                    ("wontfix" if a.wontfix else "closed", a.resolution, t, body, t if a.delivered else "",
                     a.commit, a.id))
        add_tags(con, a.id, a.tag)
        print("closed: " + line(con, get(con, a.id)))
    return 0


def cmd_session(a):
    if not session_ok(a.id):
        sys.exit("brain: a session id takes letters, digits and dashes only")
    con = connect()
    with con:
        if a.action == "start":
            con.execute("INSERT INTO sessions (id, cwd, started_at) VALUES (?,?,?) ON CONFLICT(id) DO UPDATE"
                        " SET cwd=excluded.cwd, started_at=excluded.started_at, ended_at=''", (a.id, a.cwd, now()))
        elif a.action == "end":
            con.execute("UPDATE sessions SET ended_at=? WHERE id=?", (now(), a.id))
        else:
            r = con.execute("SELECT * FROM sessions WHERE id=?", (a.id,)).fetchone()
            print("unknown" if not r else f"{'ended' if r['ended_at'] else 'open'} {r['cwd']}")
    return 0


def cmd_answers(a):
    """Print the answers to this session's questions that it has not had yet, and mark them delivered."""
    con = connect()
    with con:
        rows = con.execute("SELECT * FROM items WHERE session_id=? AND kind='question' AND resolution='answered'"
                           " AND answer_delivered_at='' ORDER BY id", (a.session,)).fetchall()
        for r in rows:
            answer = r["body"].rsplit("\n\nclosed: ", 1)[1] if "\n\nclosed: " in r["body"] else ""
            print(f"#{r['id']} {r['title']}: {answer}")
            con.execute("UPDATE items SET answer_delivered_at=? WHERE id=?", (now(), r["id"]))
    return 0


def cmd_reopen(a):
    con = connect()
    with con:
        r = get(con, a.id)
        if r["status"] == "open":
            sys.exit(f"brain: #{a.id} is already open")
        dupe = con.execute("SELECT id FROM items WHERE status='open' AND project=? AND kind=? AND ref=?",
                           (r["project"], r["kind"], r["ref"])).fetchone()
        if dupe:
            sys.exit(f"brain: #{dupe['id']} is the same item and still open")
        con.execute("UPDATE items SET status='open', resolution='', closed_at=NULL WHERE id=?", (a.id,))
        print("reopened: " + line(con, get(con, a.id)))
    return 0


def cmd_run_add(a):
    con = connect()
    started = a.started if a.started is not None else int(time.time())
    ended = a.ended if a.ended is not None else started
    with con:
        cur = con.execute(
            "INSERT INTO runs (cycle, project, repo, test_project, runner, tier, started, ended, duration_s,"
            " lane_wait_s, load_start, load_end, passed, failed, skipped, stalled, exit_code, host)"
            " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (a.cycle, a.project, a.repo, a.test_project, a.runner, a.tier, started, ended, ended - started,
             a.lane_wait, a.load_start, a.load_end, a.passed, a.failed, a.skipped, a.stalled, a.exit_code, a.host))
    print(cur.lastrowid)
    return 0


JOB_STATUS = ("queued", "running", "done", "failed", "cancelled")
JOB_TIERS = ("fast", "full")


def project_of(path):
    """The main repository's name, so a worktree and its repository are one project."""
    path = os.path.abspath(path)
    r = subprocess.run(["git", "-C", path if os.path.isdir(path) else os.path.dirname(path), "rev-parse",
                        "--git-common-dir"], capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip():
        common = os.path.abspath(os.path.join(path, r.stdout.strip()))
        name = os.path.basename(common)
        return os.path.basename(os.path.dirname(common)) if name == ".git" else re.sub(r"\.git$", "", name)
    return os.path.basename(path.rstrip("/"))


def cancel_dependents(con, job_id, reason):
    for r in con.execute("SELECT id FROM jobs WHERE status='queued' AND after_id=?", (job_id,)).fetchall():
        con.execute("UPDATE jobs SET status='cancelled', reason=?, ended_at=? WHERE id=?", (reason, now(), r["id"]))
        cancel_dependents(con, r["id"], reason)


def job_line(r):
    s = f"job #{r['id']} {r['status']} {r['tier']} {r['project']} {r['test_project']}"
    if r["filter"]:
        s += f" filter={r['filter']}"
    if r["args"]:
        s += f" args={r['args']}"
    if r["cycle"]:
        s += f" cycle={r['cycle']}"
    if r["after_id"]:
        s += f" after=#{r['after_id']}"
    if r["priority"] and r["status"] == "queued":
        s += " bumped"
    if r["reason"]:
        s += f" ({r['reason']})"
    if r["run_id"]:
        s += f" run={r['run_id']}"
    if r["platform"]:
        s += f" platform={r['platform']}"
    if r["host"] and r["status"] == "running":
        s += f" on={r['host']}"
    return s


APPLE_TFM = re.compile(r"-(maccatalyst|ios|macos)", re.I)
TFM_ELEMENT = re.compile(r"<TargetFrameworks?(?:\s[^>]*)?>(.*?)</TargetFrameworks?\s*>", re.S | re.I)
USE_MAUI = re.compile(r"<UseMaui(?:\s[^>]*)?>\s*true\s*</UseMaui\s*>", re.I)
PROJECT_REF = re.compile(r"<ProjectReference\s[^>]*?Include\s*=\s*[\"']([^\"']+)[\"']", re.I)


def _apple_text(text):
    return any(APPLE_TFM.search(m.group(1)) for m in TFM_ELEMENT.finditer(text)) or bool(USE_MAUI.search(text))


def detect_platform(repo, test_project):
    """'apple' when the job may need an Apple platform, else ''.

    Conservative: the project file, Directory.Build.props from its folder up to the repo root, and every
    project it references (transitively) are checked. A project that cannot be found or read, or a folder
    with more than one csproj, gives 'apple' too: unknown means local only."""
    path = os.path.join(repo, test_project)
    try:
        if os.path.isdir(path):
            found = [f for f in os.listdir(path) if f.endswith(".csproj")]
            if len(found) != 1:
                return "apple"
            path = os.path.join(path, found[0])
        path = os.path.abspath(path)
        seen = set()
        todo = [path]
        props_done = set()
        root = os.path.abspath(repo)
        while todo:
            cur = todo.pop()
            if cur in seen:
                continue
            seen.add(cur)
            text = open(cur, encoding="utf-8", errors="replace").read()
            if _apple_text(text):
                return "apple"
            folder = os.path.dirname(cur)
            while True:
                props = os.path.join(folder, "Directory.Build.props")
                if props not in props_done:
                    props_done.add(props)
                    if os.path.isfile(props):
                        if _apple_text(open(props, encoding="utf-8", errors="replace").read()):
                            return "apple"
                if folder == root or os.path.dirname(folder) == folder:
                    break
                if not (folder + os.sep).startswith(root + os.sep):
                    break
                folder = os.path.dirname(folder)
            for ref in PROJECT_REF.findall(text):
                todo.append(os.path.abspath(os.path.join(os.path.dirname(cur), ref.replace("\\", "/"))))
    except (OSError, ValueError):
        return "apple"
    return ""


def cmd_queue(a):
    con = connect()
    if a.qcmd == "add":
        if a.tier == "fast" and not a.filter:
            sys.exit("brain: a fast job needs --filter")
        dep = con.execute("SELECT status FROM jobs WHERE id=?", (a.after,)).fetchone() if a.after else None
        if a.after and not dep:
            sys.exit(f"brain: no job #{a.after} to run after")
        repo = os.path.abspath(a.repo_dir)
        # A job behind one that already failed or was cancelled can never run; record that at once.
        dead = dep and dep["status"] in ("failed", "cancelled")
        if not dead:
            # The same run already waiting: join it, so one build serves every agent that asked.
            same = con.execute(
                "SELECT id FROM jobs WHERE status='queued' AND repo_dir=? AND test_project=? AND filter IS ?"
                " AND tier=? AND after_id IS ? AND args IS ? ORDER BY id LIMIT 1",
                (repo, a.test_project, a.filter, a.tier, a.after, a.args)).fetchone()
            if same:
                print(f"brain: the same job is already queued as #{same['id']}; joined it", file=sys.stderr)
                print(same["id"])
                return 0
        with con:
            cur = con.execute(
                "INSERT INTO jobs (cycle, project, repo_dir, test_project, filter, tier, after_id, enqueued_by,"
                " enqueued_at, status, reason, ended_at, args, platform) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (a.cycle, a.project or project_of(repo), repo, a.test_project, a.filter, a.tier, a.after,
                 a.by, now(), "cancelled" if dead else "queued",
                 f"dependency #{a.after} {dep['status']}" if dead else "", now() if dead else None, a.args,
                 detect_platform(repo, a.test_project) if a.platform == "auto" else
                 ("apple" if a.platform == "apple" else "")))
        print(cur.lastrowid)
        return 0
    if a.qcmd == "list":
        q, args = "SELECT * FROM jobs WHERE 1=1", []
        for col, val in (("cycle", a.cycle), ("status", a.status)):
            if val:
                q += f" AND {col}=?"
                args.append(val)
        for r in con.execute(q + " ORDER BY id", args).fetchall():
            print(job_line(r))
        return 0
    if a.qcmd == "cancel":
        with con:
            r = con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()
            if not r:
                sys.exit(f"brain: no job #{a.id}")
            if r["status"] != "queued":
                sys.exit(f"brain: job #{a.id} is {r['status']}, only a queued job can be cancelled")
            con.execute("UPDATE jobs SET status='cancelled', reason='cancelled', ended_at=? WHERE id=?", (now(), a.id))
            cancel_dependents(con, a.id, f"dependency #{a.id} cancelled")
        print(f"cancelled job #{a.id}")
        return 0
    if a.qcmd == "bump":  # moves a queued job, and the queued jobs chained after it, to the front
        with con:
            r = con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()
            if not r:
                sys.exit(f"brain: no job #{a.id}")
            if r["status"] != "queued":
                sys.exit(f"brain: job #{a.id} is {r['status']}, only a queued job can be bumped")
            todo, bumped = [a.id], []
            while todo:
                job = todo.pop()
                con.execute("UPDATE jobs SET priority=1 WHERE id=?", (job,))
                bumped.append(job)
                todo += [d["id"] for d in con.execute(
                    "SELECT id FROM jobs WHERE status='queued' AND after_id=?", (job,)).fetchall()]
        print("bumped " + " ".join(f"#{j}" for j in sorted(bumped)))
        return 0
    if a.qcmd == "next":  # claims the oldest ready job; prints it as one line of JSON, or nothing
        con.isolation_level = None
        con.execute("BEGIN IMMEDIATE")
        skip = " AND j.platform != 'apple'" if a.where == "remote" else " AND j.platform != 'remote'"
        r = con.execute(
            "SELECT j.* FROM jobs j WHERE j.status='queued' AND (j.after_id IS NULL OR "
            "(SELECT status FROM jobs d WHERE d.id=j.after_id)='done')" + skip
            + " ORDER BY j.priority DESC, j.id LIMIT 1").fetchone()
        if r and not a.peek:
            con.execute("UPDATE jobs SET status='running', started_at=?, host=?, reason='' WHERE id=?",
                        (now(), a.host, r["id"]))
        con.execute("COMMIT")
        if r:
            row = dict(r)
            if not a.peek:
                row["host"] = a.host
            print(json.dumps(row))
        return 0
    if a.qcmd == "route":  # which lanes may claim a queued job
        with con:
            r = con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()
            if not r:
                sys.exit(f"brain: no job #{a.id}")
            if r["status"] != "queued":
                sys.exit(f"brain: job #{a.id} is {r['status']}, only a queued job can be routed")
            con.execute("UPDATE jobs SET platform=? WHERE id=?",
                        ({"remote": "remote", "local": "apple", "any": ""}[a.to], a.id))
        if a.to == "remote" and detect_platform(r["repo_dir"], r["test_project"]) == "apple":
            print(f"brain: job #{a.id} may need an Apple platform; it can fail to build on a remote host",
                  file=sys.stderr)
        print(job_line(con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()))
        return 0
    if a.qcmd == "requeue":  # a running job goes back to the queue, for a lane problem
        with con:
            r = con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()
            if not r:
                sys.exit(f"brain: no job #{a.id}")
            if r["status"] != "running":
                sys.exit(f"brain: job #{a.id} is {r['status']}, only a running job can be requeued")
            con.execute("UPDATE jobs SET status='queued', host='', started_at=NULL, reason=? WHERE id=?",
                        (a.reason, a.id))
        print(job_line(con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()))
        return 0
    if a.qcmd == "finish":
        with con:
            r = con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()
            if not r:
                sys.exit(f"brain: no job #{a.id}")
            con.execute("UPDATE jobs SET status=?, reason=?, run_id=COALESCE(?, run_id), ended_at=? WHERE id=?",
                        (a.status, a.reason, a.run_id, now(), a.id))
            if a.status != "done":
                cancel_dependents(con, a.id, f"dependency #{a.id} {a.status}")
        print(job_line(con.execute("SELECT * FROM jobs WHERE id=?", (a.id,)).fetchone()))
        return 0
    return 2


RESUME_ORDER = ("blocker", "agent", "pending", "question")


def default_project():
    return project_of(os.getcwd())


def cmd_resume(a):
    if not os.path.exists(db_path()):
        return 0
    project = a.project or default_project()
    con = connect()
    rows = con.execute("SELECT id, kind, title, ref FROM items WHERE status='open' AND project=?"
                       " ORDER BY id DESC", (project,)).fetchall()
    jobs = con.execute("SELECT * FROM jobs WHERE status IN ('queued', 'running') AND project=? ORDER BY id",
                       (project,)).fetchall()
    if not rows and not jobs:
        return 0

    def rank(r):
        return RESUME_ORDER.index(r["kind"]) if r["kind"] in RESUME_ORDER else len(RESUME_ORDER)

    rows = sorted(rows, key=rank)  # stable, so newest stays first within a kind
    lines = []
    for r in rows:
        title = " ".join((r["title"] or r["ref"]).split())
        lines.append((rank(r), f"#{r['id']} {r['kind']} {title[:100]}"))
    at = sum(1 for k, _ in lines if k <= RESUME_ORDER.index("agent"))  # jobs follow blockers and agents
    lines[at:at] = [(1, job_line(j)[:100]) for j in jobs]
    total = len(lines)
    room = max(a.max, 2) - 2  # the header and the line for what was cut
    shown = lines if total <= room + 1 else lines[:room]
    print(f"brain: {len(rows)} open and {len(jobs)} queued or running for {project}")
    for _, text in shown:
        print(text)
    if len(shown) < total:
        print(f"... {total - len(shown)} more: brain list --project {project} --status open")
    return 0


def stats(con):
    out = {}
    out["by_kind_status"] = [dict(r) for r in con.execute(
        "SELECT kind, status, COUNT(*) AS n FROM items GROUP BY kind, status ORDER BY kind, status")]
    out["open_by_project"] = [dict(r) for r in con.execute(
        "SELECT project, COUNT(*) AS n FROM items WHERE status='open' GROUP BY project ORDER BY n DESC, project")]
    spans = {}
    for r in con.execute("SELECT kind, first_seen, closed_at FROM items WHERE closed_at IS NOT NULL"):
        spans.setdefault(r["kind"], []).append(epoch(r["closed_at"]) - epoch(r["first_seen"]))
    out["median_close_s"] = {k: statistics.median(v) for k, v in sorted(spans.items())}
    out["suites"] = [dict(r) for r in con.execute(
        "SELECT r.project, r.test_project, COUNT(*) AS runs, ROUND(AVG(r.lane_wait_s), 1) AS mean_lane_wait_s,"
        " ROUND(AVG(r.duration_s), 1) AS mean_duration_s,"
        " (SELECT COUNT(*) FROM items i JOIN runs rr ON rr.id = i.run_id WHERE i.kind='flaky'"
        "  AND rr.project = r.project AND rr.test_project = r.test_project) AS flaky_items"
        " FROM runs r WHERE r.tier != 'rerun' GROUP BY r.project, r.test_project ORDER BY r.project, r.test_project")]
    for s in out["suites"]:
        s["flaky_rate"] = round(s["flaky_items"] / s["runs"], 3) if s["runs"] else 0
    out["slowest"] = [dict(r) for r in con.execute(
        "SELECT id, project, test_project, tier, duration_s FROM runs WHERE duration_s IS NOT NULL"
        " ORDER BY duration_s DESC, id LIMIT 5")]
    return out


def grid(heads, rows):
    rows = [[("" if c is None else str(c)) for c in r] for r in rows]
    w = [max(len(x[i]) for x in rows + [heads]) for i in range(len(heads))]
    return "\n".join("  ".join(c.ljust(n) for c, n in zip(r, w)).rstrip() for r in [heads] + rows)


def cmd_stats(a):
    s = stats(connect())
    if a.json:
        print(json.dumps(s, indent=2, sort_keys=True))
        return 0
    print("items by kind and status")
    print(grid(["kind", "status", "count"], [[r["kind"], r["status"], r["n"]] for r in s["by_kind_status"]]))
    print("\nopen by project")
    print(grid(["project", "open"], [[r["project"], r["n"]] for r in s["open_by_project"]]))
    print("\nmedian time to close")
    print(grid(["kind", "hours"], [[k, round(v / 3600, 2)] for k, v in s["median_close_s"].items()]))
    print("\nsuites (fast and full runs)")
    print(grid(["project", "test project", "runs", "flaky items", "flaky rate", "mean lane wait s", "mean duration s"],
               [[r["project"], r["test_project"], r["runs"], r["flaky_items"], r["flaky_rate"],
                 r["mean_lane_wait_s"], r["mean_duration_s"]] for r in s["suites"]]))
    print("\nslowest runs")
    print(grid(["run", "project", "test project", "tier", "duration s"],
               [[r["id"], r["project"], r["test_project"], r["tier"], r["duration_s"]] for r in s["slowest"]]))
    return 0


def cmd_export(a):
    con = connect()
    q, args = "SELECT * FROM items WHERE 1=1", []
    for col, val in (("project", a.project), ("status", a.status)):
        if val:
            q += f" AND {col}=?"
            args.append(val)
    rows = con.execute(q + " ORDER BY project, id", args).fetchall()
    if a.format == "json":
        items = []
        for r in rows:
            d = dict(r)
            d["tags"] = tags_of(con, r["id"])
            items.append(d)
        print(json.dumps(items, indent=2, sort_keys=True))
        return 0
    print("# Brain")
    project = None
    for r in rows:
        if r["project"] != project:
            project = r["project"]
            print(f"\n## {project}\n")
        t = tags_of(con, r["id"])
        print(f"- #{r['id']} {r['status']} {r['kind']} {r['title']}"
              + (f" ({r['severity']})" if r["severity"] else "") + f", seen {r['occurrences']}x, last {r['last_seen']}"
              + (f", tags {', '.join(t)}" if t else ""))
        if r["body"]:
            first = r["body"].strip().splitlines()[0] if r["body"].strip() else ""
            if first:
                print(f"  {first}")
    return 0


def parser():
