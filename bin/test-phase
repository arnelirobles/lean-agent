#!/usr/bin/env python3
"""Drain the test queue: every queued test run once, in the heavy lane, failures sorted into brain.

usage: test-phase [PLAN] [--cycle C] [--lane L] [--stall S] [--run-dir D] [--project NAME] [--branch B]
       test-phase --self-test

The cycle this serves: code everything with builds only, queue the test runs, drain the queue once,
read `brain list --open`, fix, run again. Nobody waits in a loop: `brain queue add` returns at once,
and one drainer (start it as a background task) takes the oldest ready job, runs it, and repeats until
nothing is ready. A second test-phase while one is draining says so and exits 0; the running drainer
picks up whatever was enqueued. A job whose --after job failed or was cancelled is cancelled with the
reason. Every command goes through bin/heavy.sh in one lane, so sessions on one machine queue instead
of loading the database together; ask whether the lane is free with `heavy.sh status dotnet`.

PLAN is optional. When given, its lines are enqueued first. One project per line, blank lines and lines
starting with # are skipped:

    <repo-dir> <test project path> [fast-filter] [args=EXTRA] [again=REASON]

The project path is relative to repo-dir. Quote a field that holds spaces. A fast filter is a class
name or a fragment of one (for MTP the fast tier passes *fragment* to --filter-class, and a rerun passes
the exact class); with it the line becomes two jobs, the fast slice and then the whole project.

Extra dotnet arguments, such as MSBuild properties, go on every command of a job: set TEST_PHASE_DOTNET_ARGS
(split like a shell line) for all jobs, and "args=EXTRA" on a plan line or `brain queue add --args=EXTRA` for
one job. They come after the project and before the logger, or before `--` in MTP mode. Example for the
Mac Catalyst desktop tests, which need Xcode checks off:

    TEST_PHASE_DOTNET_ARGS="-p:ValidateXcodeVersion=false" test-phase plan.txt
    ~/app tests/Desktop.Tests/Desktop.Tests.csproj "args=-p:ValidateXcodeVersion=false"

For each job: run it, list the failing tests, run each failing class alone, and label the test flaky if
it passes alone (exit 0, or passed tests and the name absent) or real if it fails again. It is unverified
when the rerun was cut off or failed without naming the test or passing anything. Real and unverified
go to brain as test-fail, flaky as flaky. A job that fails without naming a failing test (a build error)
goes in as test-fail too. A stall is only a note, because the watchdog says it is likely load, not code.
Logs are under the run directory: ${LEAN_TEST_PHASE_DIR:-~/.local/share/lean/test-phase}/<timestamp>.

  --cycle      cycle label for a plan's jobs, runs and items (default: the run directory's name)
  --lane       heavy.sh lane (default dotnet)
  --stall      seconds without test progress before a command is stopped (default 600, 0 is off);
               it starts when the command starts, so keep it above the build time
  --project    brain project name for a plan's jobs (default: the main repository's name, so worktrees share it)
  --branch     brain branch (default: the repo's current branch)

Every command is also recorded as a row in brain's runs table (tier fast, full or rerun, duration, time
spent waiting for the lane, load average at start and end, passed, failed, skipped, stalled, exit code),
and each item points at the run that showed it. `brain stats` reads them.

Remote lanes. When ~/.config/lean/remotes.ini names SSH hosts, the one drainer runs one lane per host next
to the local lane, each claiming the next ready job with `brain queue next`. A remote lane copies the job's
worktree to the host, runs the same test command in a capped container there, and streams the output back
into the same log, so parsing and brain stay local. A job that targets an Apple platform runs only on the
local lane. If the host, the connection or the copy fails, the job goes back to queued and the lane rests
(TEST_PHASE_REST seconds, default 600) while the other lanes go on. TEST_PHASE_REMOTES=off turns every
remote lane off. See docs/remote-lane.md.

TEST_PHASE_RUNNER=mtp or vstest overrides detection. The wait for a busy lane is HEAVY_WAIT, here
defaulting to 3600 seconds. Exit 0 when nothing real failed and no job was cancelled during the drain, 1 otherwise. A job whose
failures were all flaky finishes done, so the jobs after it still run.

Runner support is a class with mode, command, failures, counts and class_of. Dotnet is the one that
exists; another runner is another class in RUNNERS.
"""
import argparse
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
try:
    import lean_remote as lr
except ImportError:  # a copy of test-phase without its module still drains the local lane
    lr = None
LaneProblem = lr.LaneProblem if lr else type("LaneProblem", (Exception,), {})
HEAVY = os.path.join(HERE, "heavy.sh")
BRAIN = os.path.join(HERE, "brain")
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
# MTP prints "failed Name (1s 184ms)" at column 0. The VSTest console logger prints "  Failed Name [3 ms]"
# with exactly two spaces; a deeper indent is an assertion dump ("    Failed = 1,") and is not a test.
FAILED = re.compile(r"^(?:failed|  Failed)\s+(\S.*?)\s*$")
DURATION = re.compile(r"\s+\((?:\d+(?:\.\d+)?\s*(?:ms|s|m|h)\s*)+\)$|\s+\[[^\]]*\]$")
TEST_NAME = re.compile(r"[A-Za-z_][\w`<>+]*(?:\.[\w`<>+]+)+(?:\(.*\))?")


class Dotnet:
    name = "dotnet"

    @staticmethod
    def mode(repo):
        forced = os.environ.get("TEST_PHASE_RUNNER")
        if forced in ("mtp", "vstest"):
            return forced
        d = os.path.abspath(repo)
        while True:
            g = os.path.join(d, "global.json")
            if os.path.isfile(g):
                try:
                    runner = json.load(open(g)).get("test", {}).get("runner", "")
                except (ValueError, OSError, AttributeError):
                    runner = ""
                return "mtp" if runner == "Microsoft.Testing.Platform" else "vstest"
            if os.path.dirname(d) == d:
                return "vstest"
            d = os.path.dirname(d)

    @classmethod
    def command(cls, mode, project, cls_filter=None, fast=False, extra=()):
        # A filter may name several classes joined by |, with or without the FullyQualifiedName~ prefix.
        cls = [c.strip().removeprefix("FullyQualifiedName~") for c in (cls_filter or "").split("|")]
        cls = [c for c in cls if c]
        if any(c.startswith("-") for c in cls):  # a piece read as a dotnet option instead of a class
            raise ValueError("a filter piece starts with -")
        # The VSTest console logger prints passed lines too, which is what the watchdog reads as progress.
        if mode == "mtp":
            cmd = ["dotnet", "test", "--project", project] + list(extra) + ["--"]
            # --filter-class matches the full class name. The fast tier takes a fragment, and so does a
            # name with no namespace in any tier, hence the wildcards. A rerun passes full names.
            for c in cls:
                cmd += ["--filter-class", f"*{c}*" if fast or "." not in c else c]
            return cmd + ["--output", "Detailed"]
        cmd = ["dotnet", "test", project] + list(extra) + ["--logger", "console;verbosity=normal"]
        if cls:
            cmd += ["--filter", "|".join("FullyQualifiedName~" + c for c in cls)]
        return cmd

    @staticmethod
    def failures(text):
        """[(test name, the lines that follow it)] in order, each name once."""
        lines = [ANSI.sub("", l).rstrip() for l in text.splitlines()]
        seen, out = set(), []
        for i, l in enumerate(lines):
            m = FAILED.match(l)
            if not m:
                continue
            name = DURATION.sub("", m.group(1))
            if not TEST_NAME.fullmatch(name) or name in seen:
                continue
            seen.add(name)
            out.append((name, "\n".join(lines[i:i + 12])))
        return out

    @staticmethod
    def counts(text):
        """(passed, failed, skipped) from the run summary, zeros when there is none."""
        text = ANSI.sub("", text)
        m = re.search(r"Failed:\s*(\d+),\s*Passed:\s*(\d+),\s*Skipped:\s*(\d+)", text)
        if m:
            return int(m.group(2)), int(m.group(1)), int(m.group(3))
        blk = {k.lower(): int(v) for k, v in re.findall(r"^\s*(Total tests|Passed|Failed|Skipped):\s*(\d+)\s*$", text, re.M)}
        if "total tests" in blk:  # the detailed VSTest logger leaves out the lines that are zero
            failed, skipped = blk.get("failed", 0), blk.get("skipped", 0)
            return blk.get("passed", blk["total tests"] - failed - skipped), failed, skipped
        got = {k.lower(): int(v) for k, v in re.findall(r"^\s*(total|failed|succeeded|skipped):\s*(\d+)", text, re.M)}
        if got:
            return got.get("succeeded", 0), got.get("failed", 0), got.get("skipped", 0)
        return 0, 0, 0

    @staticmethod
    def class_of(test):
        base = re.split(r"[(\[]", test, maxsplit=1)[0]
        return base.rsplit(".", 1)[0] if "." in base else base


RUNNERS = [Dotnet]


class Lane:
    """One place jobs run: the local machine, or one SSH host."""

    def __init__(self, name, where, remote=None, repos=None):
        self.name, self.where, self.remote = name, where, remote
        self.repos = {k.lower(): v for k, v in (repos or {}).items()}


LOCAL = Lane("local", "local")


def heavy(lane, cmd, cwd, log, stall, header=None):
    """Run cmd in the lane. Returns (exit code, output, started, ended, seconds spent waiting for the lane)."""
    env = dict(os.environ)
    env.setdefault("HEAVY_WAIT", "3600")
    if stall:
        env["HEAVY_STALL"] = str(stall)
    else:
        env.pop("HEAVY_STALL", None)
    timing = log + ".wait"
    env["HEAVY_TIMING_FILE"] = timing
    started = int(time.time())
    with open(log, "w") as fh:
        # The header is always one line, so what follows it is the command's own output.
        fh.write(header if header is not None else "$ " + " ".join(shlex.quote(c) for c in cmd) + "\n")
        fh.flush()
        rc = subprocess.run(["bash", HEAVY, lane] + cmd, cwd=cwd, env=env, stdout=fh,
                            stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode
    ended = int(time.time())
    try:
        wait = float(open(timing).read().strip() or 0)
        os.remove(timing)
    except (OSError, ValueError):
        wait = None
    return rc, open(log, errors="replace").read(), started, ended, wait


def load1():
    try:
        return os.getloadavg()[0]
    except OSError:
        return None


SECRETS = [
    (re.compile(r"(?i)\b(password|pwd)(\s*=\s*)(?:\"[^\"]*\"|'[^']*'|[^;\s\"']+)"), r"\1\2***"),
    (re.compile(r"(?i)\b(api[-_ ]?key)(\s*[=:]\s*)(?:\"[^\"]*\"|'[^']*'|[^;\s\"',]+)"), r"\1\2***"),
    (re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]+"), "Bearer ***"),
    (re.compile(r"\beyJ[A-Za-z0-9_=-]*(?:\.[A-Za-z0-9_=-]*)*"), "***"),
]


def mask(text):
    """Test output can carry connection strings and tokens; none of it goes into brain."""
    for pattern, repl in SECRETS:
        text = pattern.sub(repl, text)
    return text


def brain(args, stdin=None):
    r = subprocess.run([sys.executable, BRAIN] + args, capture_output=True, text=True, input=stdin)
    if r.returncode != 0:
        sys.stderr.write("test-phase: brain failed: " + r.stderr.strip() + "\n")
        return None
    return r.stdout.strip()


def requeue_job(job_id, problem, say):
    """Put a running job back in the queue. One retry; a loud line when it still fails. True when requeued."""
    for _ in range(2):
        if brain(["queue", "requeue", str(job_id), "--reason", problem[:200]]) is not None:
            return True
    say(f"test-phase: job #{job_id} is STUCK running: brain would not requeue it ({problem[:120]})")
    return False


def add_item(row, kind, ref, severity, body, run_id, ctx):
    ref = mask(ref)
    args = ["add", "--project", row["project"], "--repo", ctx["repo"], "--kind", kind, "--ref", ref,
            "--title", ref, "--body-file", "-", "--severity", severity, "--phase", "test", "--source", "test-phase",
            "--cycle", ctx["cycle"]]
    if row.get("session"):
        args += ["--session", row["session"], "--session-cwd", row.get("session_cwd", "")]
    if ctx["branch"]:
        args += ["--branch", ctx["branch"]]
    if run_id:
        args += ["--run-id", str(run_id)]
    brain(args, stdin=mask(body))  # the body goes by stdin, not argv, where any user's ps could read it


def record_run(row, ctx, tier, mode, rc, text, started, ended, wait, load_start, project, lane=LOCAL):
    passed, failed, skipped = ctx["runner"].counts(text)
    load_end = lr.remote_load(lane.remote) if lane.remote else load1()
    out = brain(["run-add", "--cycle", ctx["cycle"], "--project", row["project"], "--repo", ctx["repo"],
                 "--test-project", os.path.basename(project), "--runner", mode, "--tier", tier,
                 "--started", str(started), "--ended", str(ended), "--passed", str(passed),
                 "--failed", str(failed), "--skipped", str(skipped), "--stalled", "1" if rc == 76 else "0",
                 "--exit-code", str(rc)]
                + (["--host", lane.remote.name] if lane.remote else [])
                + (["--lane-wait", str(wait)] if wait is not None else [])
                + (["--load-start", "%.2f" % load_start] if load_start is not None else [])
                + (["--load-end", "%.2f" % load_end] if load_end is not None else []))
    return int(out) if out and out.isdigit() else None


def current_branch(repo):
    r = subprocess.run(["git", "-C", repo, "branch", "--show-current"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def parse_plan(path):
    entries = []
    for n, raw in enumerate(open(path), 1):
        raw = raw.strip()
        if not raw or raw.startswith("#"):
            continue
        parts = shlex.split(raw)
        extra = [x[len("args="):] for x in parts[2:] if x.startswith("args=")]
        again = [x[len("again="):] for x in parts[2:] if x.startswith("again=")]
        parts = parts[:2] + [x for x in parts[2:] if not x.startswith(("args=", "again="))]
        if len(parts) not in (2, 3) or len(extra) > 1 or len(again) > 1:
            sys.exit(f"test-phase: {path} line {n}: want <repo-dir> <test project path> [fast-filter] [args=EXTRA] [again=REASON]")
        entries.append(parts + [None] * (3 - len(parts)) + [extra[0] if extra else "", again[0] if again else ""])
    if not entries:
        sys.exit(f"test-phase: {path} lists no projects, so nothing would run")
    return entries


def safe(s):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", s).strip("_")[:60]


def tier_note(rc):
    return {0: "pass", 75: "busy", 76: "stalled"}.get(rc, "fail")


def matched_none(rc, text):
    """A filtered run that ran no test: MTP exit 8, VSTest's no-match line, or a summary of zero tests."""
    if rc == 8:
        return True
    if rc != 0:
        return False
    text = ANSI.sub("", text)
    if sum(Dotnet.counts(text)):  # a multi-target run can miss on one framework and run tests on another
        return False
    return "No test matches the given testcase filter" in text \
        or bool(re.search(r"Failed:\s*\d+,\s*Passed:\s*\d+,\s*Skipped:\s*\d+", text))


def lane_problem(rc, text):
    """Why a remote command never really ran, or "". No marker line means the test command never started."""
    if not re.search("^" + re.escape(lr.MARKER) + r"\s*$", text, re.M):
        lines = [l for l in text.splitlines()[1:] if l.strip()]  # line one is the one-line header
        if not lines:
            return f"nothing ran on the host: no output (exit {rc})"
        return f"nothing ran on the host (exit {rc}): " + mask(lines[-1].strip())[:160]
    if rc == 255:
        return "connection to the host lost (ssh exit 255)"
    return ""


def clean_remote(remote, job_id):
    """Remove a job's folder, containers and network on the host. Best effort: the next claim sweeps too."""
    try:
        subprocess.run(lr.ssh_argv(remote, "sh", "-c", lr.cleanup_script(remote, job_id)), capture_output=True,
                       timeout=180, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def run_job(job, a, run_dir, runner, lane=LOCAL):
    try:
        return _run_job(job, a, run_dir, runner, lane)
    finally:
        if lane.remote:
            clean_remote(lane.remote, job["id"])


def _run_job(job, a, run_dir, runner, lane):
    repo, project = job["repo_dir"], job["test_project"]
    remote = lane.remote
    cfg = lane.repos.get(job["project"].lower()) if remote else None
    row = {"job": job["id"], "project": job["project"], "test": project, "tier": job["tier"],
           "result": "", "failing": 0, "real": 0, "flaky": 0, "notes": [], "run_id": None, "rc": 1,
           "host": remote.name if remote else "", "session": job.get("session_id", ""),
           "session_cwd": job.get("session_cwd", "")}
    if not os.path.isdir(repo):
        row["result"] = "error"
        row["notes"].append("no such directory")
        return row
    mode = runner.mode(repo)
    row["runner"] = f"{runner.name}/{mode}"
    ctx = {"repo": repo, "cycle": job["cycle"], "runner": runner,
           "branch": a.branch if a.branch is not None else current_branch(repo)}
    stem = os.path.join(run_dir, f"job{job['id']:03d}-{safe(os.path.basename(project))}-{job['tier']}")
    failing = {}  # test name to its detail

    try:
        extra = shlex.split(os.environ.get("TEST_PHASE_DOTNET_ARGS", "")) + shlex.split(job.get("args") or "")
    except ValueError as e:
        row["result"] = "error"
        row["notes"].append(f"bad extra arguments: {e}")
        return row
    try:
        runner.command(runner.mode(repo), project, job["filter"] or None, job["tier"] == "fast", extra)
    except ValueError as e:
        row["result"] = "error"
        row["notes"].append(f"bad filter: {e}")
        return row

    synced = []

    def prepare():  # the copy and the env file go once per job, however many commands follow
        if synced:
            return
        files = lr.file_list(repo, remote.extra_paths, remote.exclude)
        data = b"".join(f.encode("utf-8", "surrogateescape") + b"\0" for f in files)
        try:
            p = subprocess.run(lr.sync_argv(remote, repo, job["id"]), input=data, capture_output=True)
        except OSError as e:
            raise LaneProblem(f"{remote.name}: rsync did not start ({e.strerror})")
        if p.returncode != 0:
            tail = p.stderr.decode("utf-8", "replace").strip().splitlines()[-1:] or [""]
            raise LaneProblem(f"{remote.name}: copy failed (rsync exit {p.returncode}) {mask(tail[0])[:120]}".strip())
        if cfg and cfg.env_file:
            lr.send_env(remote, job["id"], cfg.env_file)
        synced.append(1)

    def tier(name, cls_filter, log):
        cmd = runner.command(mode, project, cls_filter, name == "fast", extra)
        if remote:
            prepare()
            before = lr.remote_load(remote)
            ssh = lr.ssh_argv(remote, "sh", "-c", lr.run_script(remote, cfg, job["id"], cmd))
            rc, text, started, ended, wait = heavy(f"remote-{remote.name}", ssh, repo, log, a.stall,
                                                   header=f"$ ssh {remote.name} <script for job {job['id']}>\n")
            problem = lane_problem(rc, text)
            if problem:
                raise LaneProblem(problem)
        else:
            before = load1()
            rc, text, started, ended, wait = heavy(a.lane, cmd, repo, log, a.stall)
        return rc, text, record_run(row, ctx, name, mode, rc, text, started, ended, wait, before, project, lane)

    try:
        rc, text, run_id = tier(job["tier"], job["filter"] or None, stem + ".log")
    except LaneProblem as e:
        row["result"], row["lane_problem"] = "requeued", str(e)
        return row
    row["rc"], row["run_id"] = rc, run_id
    row["result"] = tier_note(rc)
    for name, detail in runner.failures(text):
        failing.setdefault(name, detail)
    if rc == 76:
        row["notes"].append("stalled, likely load")
        add_item(row, "note", f"stalled: {project}", "info",
                 f"no test progress for {a.stall} s, stopped by heavy.sh. Log: {stem}.log", run_id, ctx)
    elif rc == 75:
        row["notes"].append("lane busy, nothing ran")
    elif job["filter"] and not failing and matched_none(rc, text):
        row["result"] = "fail"
        row["notes"].append("filter matched no test")
        add_item(row, "test-fail", f"filter-matched-no-test: {project}", "important",
                 f"filter {job['filter']!r} matched no test (exit {rc}). Log: {stem}.log", run_id, ctx)
    elif rc != 0 and not failing:
        tail = "\n".join(text.splitlines()[-15:])
        add_item(row, "test-fail", f"run-failed: {project}", "important",
                 f"exit {rc} with no failing test named. Log: {stem}.log\n{tail}", run_id, ctx)
        row["notes"].append(f"exit {rc}, no test named (build error?)")
    by_class = {}
    for name in failing:
        by_class.setdefault(runner.class_of(name), []).append(name)
    row["failing"] = len(failing)
    lost = None
    for cls, names in by_class.items():
        log = f"{stem}-class-{safe(cls)}.log"
        rrc, rtext = 75, ""  # a rerun that could not run proves nothing: unverified
        if not lost:
            try:
                rrc, rtext, _ = tier("rerun", cls, log)
            except LaneProblem as e:
                lost = row["lane_rest"] = str(e)
                row["notes"].append(f"rerun not run: {lost}")
        again = {n for n, _ in runner.failures(rtext)}
        rpassed = runner.counts(rtext)[0]
        for name in names:
            # A rerun that named no failure is not proof: a crash or build error names none either.
            if rrc in (75, 76):
                label = "unverified"
            elif rrc == 0 or (rpassed > 0 and name not in again):
                label = "flaky"
            elif name not in again:
                label = "unverified"
            else:
                label = "real"
            body = f"{label}; alone: {tier_note(rrc)}. Log: {log}\n{failing[name]}"
            if label == "flaky":
                row["flaky"] += 1
                add_item(row, "flaky", name, "minor", body, run_id, ctx)
            else:
                row["real"] += 1
                add_item(row, "test-fail", name, "important", body, run_id, ctx)
    return row


def enqueue(entries, a, cycle):
    queued = []
    for repo, project, fast, extra, again in entries:
        base = ["queue", "add", repo, project, "--cycle", cycle, "--by", "test-phase"]
        if extra:
            base.append("--args=" + extra)
        if a.project:
            base += ["--project", a.project]
        fast_id = ""
        for tier_args in ((["--tier", "fast", "--filter", fast] if fast else []), ["--tier", "full"]):
            if not tier_args:
                continue
            # A refused add stops the plan: going on would run the fast slice and silently drop the full run.
            if tier_args[1] == "full" and again:
                tier_args = tier_args + ["--again=" + again]
            r = subprocess.run([sys.executable, BRAIN] + base + tier_args, capture_output=True, text=True)
            if tier_args[1] == "fast" and r.returncode == 0 and "joined" not in r.stderr:
                fast_id = r.stdout.strip()
                queued.append(fast_id)
            elif r.returncode == 0 and r.stdout.strip().isdigit():
                queued.append(r.stdout.strip())
            if r.returncode != 0:
                if fast_id.isdigit():
                    brain(["queue", "cancel", fast_id])
                    queued.remove(fast_id)
                kept = f"jobs from earlier plan lines stay queued: {', '.join('#' + i for i in queued)}. " if queued else ""
                sys.exit(f"test-phase: could not queue {project} ({tier_args[1]}): {r.stderr.strip()}\n"
                         f"test-phase: the rest of the plan was not queued; {kept}Fix that, or add again=REASON to the plan line to run it anyway.")


def cancelled_ids():
    return set(re.findall(r"^job #(\d+) cancelled", brain(["queue", "list", "--status", "cancelled"]) or "", re.M))


def only_flaky(row):
    """The job failed, every failing test passed alone, and nothing else went wrong."""
    return row["result"] == "fail" and row["failing"] > 0 and row["real"] == 0 and row["flaky"] == row["failing"]


def rest_seconds():
    try:
        return float(os.environ.get("TEST_PHASE_REST", "600"))
    except ValueError:
        return 600.0


def poll_seconds():
    try:
        return float(os.environ.get("TEST_PHASE_POLL", "3"))
    except ValueError:
        return 3.0


def running_ids():
    return [int(x) for x in re.findall(r"^job #(\d+) running", brain(["queue", "list", "--status", "running"]) or "", re.M)]


def sweep_remote(remote):
    """Remove what belongs to no running job on the host. Best effort."""
    try:
        subprocess.run(lr.ssh_argv(remote, "sh", "-c", lr.sweep_script(remote, running_ids())),
                       capture_output=True, timeout=180, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def error_row(job_id, why):
    return {"job": job_id, "project": "-", "test": "-", "tier": "-", "result": "error", "failing": 0, "real": 0,
            "flaky": 0, "notes": [why], "run_id": None, "rc": 1, "host": ""}


def drain(a, run_dir, runner, lanes=None):
    """(rows, how many jobs were cancelled while draining). One thread per lane."""
    lanes = lanes or [LOCAL]
    before = cancelled_ids()
    remotes = {l.remote.name: l.remote for l in lanes if l.remote}
    # Jobs left running by a drainer that died cannot finish; fail them so their dependents are cancelled.
    for line in (brain(["queue", "list", "--status", "running"]) or "").splitlines():
        m = re.match(r"job #(\d+) ", line)
        if m:
            on = re.search(r" on=(\S+)$", line)
            if on and on.group(1) in remotes:
                clean_remote(remotes[on.group(1)], m.group(1))
            brain(["queue", "finish", m.group(1), "--status", "failed", "--reason", "drainer died"])
    rows = []
    lock = threading.Lock()  # guards printing, rows and state
    wake = threading.Condition(lock)  # an idle lane waits on it, a finished job wakes it
    stop = threading.Event()  # set when no lane is working, so a resting lane wakes and ends
    state = {l.name: "work" for l in lanes}
    seen = {}  # idle lane: the finish count its last empty poll saw
    done = [0]  # jobs finished or put back; an idle lane polls again when it moved

    def say(msg):
        with lock:
            print(msg, flush=True)

    def settle(lane, st):
        with lock:
            state[lane.name] = st
            if quiet():
                stop.set()
            wake.notify_all()

    def quiet():  # call with the lock held: nobody works and no idle lane missed a finished job
        return all(v != "work" for v in state.values()) \
            and all(seen[n] == done[0] for n, v in state.items() if v == "idle")

    def idle(lane, count):
        """No job for this lane. Wait while another lane works; False when the drain ended."""
        with lock:
            state[lane.name], seen[lane.name] = "idle", count
            if quiet():  # wake the others only to end; waking them on every poll makes idle lanes spin
                stop.set()
                wake.notify_all()
            if not stop.is_set():
                wake.wait(poll_seconds())
            ended = stop.is_set() and count == done[0]
            if not ended:
                state[lane.name] = "work"
            return not ended

    def finished():
        with lock:
            done[0] += 1
            wake.notify_all()

    def rest(lane):
        """Rest after a lane problem. False when the drain ended meanwhile."""
        settle(lane, "rest")
        if stop.is_set() or stop.wait(rest_seconds()):
            return False
        with lock:
            state[lane.name] = "work"
        return True

    def lane_loop(lane):
        last_why, job = None, None
        try:
            while True:
                if lane.remote:
                    sweep_remote(lane.remote)
                    ok, why = lr.preflight(lane.remote)
                    if not ok:
                        if why != last_why:
                            say(f"test-phase: lane {lane.name} rests: {why}")
                        last_why = why
                        if not rest(lane):
                            return
                        continue
                    last_why = None
                count = done[0]
                out = brain(["queue", "next", "--where", lane.where]
                            + (["--host", lane.remote.name] if lane.remote else []))
                if not out:
                    if idle(lane, count):
                        continue
                    return
                job = json.loads(out)
                say(f"test-phase: job #{job['id']} {job['project']} {job['test_project']} ({job['tier']})"
                    + (f" on {lane.remote.name}" if lane.remote else ""))
                row = run_job(job, a, run_dir, runner, lane)
                problem = row.get("lane_problem")
                if problem:
                    if requeue_job(job["id"], problem, say):
                        say(f"test-phase: job #{job['id']} back to queued, lane {lane.name} rests: {problem}")
                    job = None
                    finished()
                    if not rest(lane):
                        return
                    continue
                with lock:
                    rows.append(row)
                reason = "; ".join(row["notes"])
                brain(["queue", "finish", str(job["id"]), "--status",
                       "done" if row["rc"] == 0 or only_flaky(row) else "failed"]
                      + (["--run-id", str(row["run_id"])] if row["run_id"] else [])
                      + (["--reason", reason] if reason else []))
                job = None
                finished()
                if row.get("lane_rest"):
                    say(f"test-phase: lane {lane.name} rests: {row['lane_rest']}")
                    if not rest(lane):
                        return
        except Exception as e:  # noqa: BLE001  a crashed lane must not hang the others
            say(f"test-phase: lane {lane.name} crashed: {e!r}")
            if job:
                brain(["queue", "finish", str(job["id"]), "--status", "failed", "--reason", f"lane crashed: {e!r}"[:200]])
            with lock:
                rows.append(error_row(job["id"] if job else 0, f"lane {lane.name} crashed: {e!r}"))
        finally:
            settle(lane, "ended")

    threads = [threading.Thread(target=lane_loop, args=(l,)) for l in lanes]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return rows, len(cancelled_ids() - before)


def table(rows, show_host=False):
    heads = ["job", "project:test", "runner", "tier", "result", "failing", "real", "flaky"]
    data = [["#" + str(r["job"]), r["project"] + ":" + os.path.basename(r["test"]), r.get("runner", "-"), r["tier"],
             r["result"], str(r["failing"]), str(r["real"]), str(r["flaky"])] for r in rows]
    if show_host:  # the column appears only when a remote lane exists, so a local-only table is unchanged
        heads.append("host")
        for d, r in zip(data, rows):
            d.append(r.get("host") or "local")
    heads.append("notes")
    for d, r in zip(data, rows):
        d.append("; ".join(r["notes"]))
    widths = [max(len(x[i]) for x in data + [heads]) for i in range(len(heads))]
    out = ["  ".join(h.ljust(w) for h, w in zip(heads, widths)).rstrip()]
    out += ["  ".join(c.ljust(w) for c, w in zip(d, widths)).rstrip() for d in data]
    return "\n".join(out)


def is_bad(r):
    if r["result"] in ("stalled", "busy", "error"):
        return True
    if r["real"]:
        return True
    return r["result"] == "fail" and r["failing"] == 0  # failed without naming a test


def main(argv):
    p = argparse.ArgumentParser(prog="test-phase", description="Drain the test queue.")
    p.add_argument("plan", nargs="?")
    p.add_argument("--lane", default="dotnet")
    p.add_argument("--stall", type=int, default=int(os.environ.get("TEST_PHASE_STALL", "600")))
    p.add_argument("--run-dir")
    p.add_argument("--project")
    p.add_argument("--branch")
    p.add_argument("--cycle")
    a = p.parse_args(argv)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    cycle = a.cycle or stamp
    if a.plan:
        enqueue(parse_plan(a.plan), a, cycle)
    base = os.environ.get("LEAN_TEST_PHASE_DIR") or os.path.expanduser("~/.local/share/lean/test-phase")
    os.makedirs(base, exist_ok=True)
    lock = open(os.path.join(base, "drainer.lock"), "w")
    lanes = [LOCAL]
    if lr:
        try:
            remotes, repos = lr.load()
        except ValueError as e:  # a bad config must not stop the local lane
            print(f"test-phase: remote lanes off, bad config: {e}", file=sys.stderr)
            remotes, repos = [], {}
        lanes += [Lane(f"remote-{r.name}", "remote", r, repos) for r in remotes]
    rows = []
    cancelled = 0
    runs = 0
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            if runs == 0:
                print("test-phase: a drainer is running; it will take what is queued")
            break
        runs += 1
        run_dir = a.run_dir or os.path.join(base, stamp)
        os.makedirs(run_dir, exist_ok=True)
        if runs == 1:
            print(f"test-phase: logs in {run_dir}", flush=True)
            if len(lanes) > 1:
                print("test-phase: lanes " + ", ".join(l.name for l in lanes), flush=True)
        got, dropped = drain(a, run_dir, RUNNERS[0], lanes)
        rows += got
        cancelled += dropped
        fcntl.flock(lock, fcntl.LOCK_UN)
        # A job enqueued just as the drain ended would wait for the next drainer; look once more.
        if not (brain(["queue", "next", "--peek"]) or "").strip():
            break
    if not rows:
        if runs:
            print("test-phase: nothing queued")
        say_waiting_remote()
        return 1 if cancelled else 0
    print()
    print(table(rows, len(lanes) > 1))
    print(f"\ntest-phase: {len(rows)} jobs, {sum(r['real'] for r in rows)} real, "
          f"{sum(r['flaky'] for r in rows)} flaky, {cancelled} cancelled. `brain list --open` has the entries.")
    say_waiting_remote()
    return 1 if cancelled or any(is_bad(r) for r in rows) else 0


def say_waiting_remote():
    """Name the queued jobs only a remote lane may claim, so one left behind is not a silent wait."""
    ids = re.findall(r"^job #(\d+) queued .*platform=remote", brain(["queue", "list", "--status", "queued"]) or "",
                     re.M)
    if ids:
        print(f"test-phase: {len(ids)} job{'s wait' if len(ids) > 1 else ' waits'} for a remote lane ("
              + " ".join(f"#{i}" for i in ids) + "); `brain queue route ID --to any` lets this machine take one")


def self_test():
    fails = []
    # A fast filter of several classes joined by | runs each of them, on both runners.
    got = Dotnet.command("mtp", "T.csproj", "ATests|FullyQualifiedName~BTests", fast=True)
    if got != ["dotnet", "test", "--project", "T.csproj", "--", "--filter-class", "*ATests*",
               "--filter-class", "*BTests*", "--output", "Detailed"]:
        fails.append(f"mtp must pass one --filter-class per class: {got}")
    # A full tier filter without a namespace still finds the class; a full name is passed as it is.
    got = Dotnet.command("mtp", "T.csproj", "ATests|Acme.BTests")
    if got != ["dotnet", "test", "--project", "T.csproj", "--", "--filter-class", "*ATests*",
               "--filter-class", "Acme.BTests", "--output", "Detailed"]:
        fails.append(f"mtp full tier must wildcard a bare class name: {got}")
    try:
        Dotnet.command("mtp", "T.csproj", "A| --help")
        fails.append("a filter piece starting with - must be refused")
    except ValueError:
        pass
    got = Dotnet.command("vstest", "T.csproj", "ATests|BTests", fast=True)
    if got[-2:] != ["--filter", "FullyQualifiedName~ATests|FullyQualifiedName~BTests"]:
        fails.append(f"vstest must prefix every class: {got}")
    fix = os.path.join(HERE, "..", "tests", "fixtures", "test-phase")

    def fixture(name):
        return open(os.path.join(fix, name), errors="replace").read()

    for name, want in (("vstest-detailed-summary.log", (7, 0, 0)), ("vstest-detailed-failed.log", (6, 3, 1))):
        if Dotnet.counts(fixture(name)) != want:
            fails.append(f"detailed VSTest summary {name}: {Dotnet.counts(fixture(name))}, want {want}")
    if Dotnet.counts("Failed!  - Failed:     2, Passed:     1, Skipped:     0, Total:     3\n") != (1, 2, 0):
        fails.append("the one-line summary must still parse")

    # Secrets in test output are masked, and the body travels by stdin.
    probe = ("Server=db;Password=hunter2;User=x\nPwd=\"p w\" Authorization: Bearer abc.DEF-123/x=\n"
             "token eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.sig_nature apikey=sk-123 api_key: 'k k'\n")
    masked = mask(probe)
    for leak in ("hunter2", "p w", "abc.DEF", "eyJhbGci", "eyJzdWIi", "sig_nature", "sk-123", "k k"):
        if leak in masked:
            fails.append(f"secret {leak!r} survived masking: {masked!r}")
    if "Server=db" not in masked or "User=x" not in masked:
        fails.append(f"masking removed more than the secret: {masked!r}")
    seen = {}
    real_brain = globals()["brain"]
    globals()["brain"] = lambda args, stdin=None: seen.update(args=args, stdin=stdin)
    try:
        add_item({"project": "p"}, "test-fail", "T.a", "important", probe, None,
                 {"repo": "r", "cycle": "c", "branch": ""})
    finally:
        globals()["brain"] = real_brain
    if "hunter2" in " ".join(seen.get("args", [])) or "hunter2" in (seen.get("stdin") or "") \
            or "-" not in seen.get("args", []) or "--body" in seen.get("args", []):
        fails.append(f"item body must be masked and sent by stdin, not argv: {seen}")

    globals()["brain"] = lambda args, stdin=None: seen.update(args=args, stdin=stdin)
    try:
        add_item({"project": "p", "session": "s-1", "session_cwd": "/w"}, "flaky", "T.b", "minor", "x", None,
                 {"repo": "r", "cycle": "c", "branch": ""})
    finally:
        globals()["brain"] = real_brain
    a = seen.get("args", [])
    if "--session" not in a or a[a.index("--session") + 1] != "s-1":
        fails.append(f"an item must carry the session that queued the job: {a}")

    if Lane("r", "remote", None, {"MixedCase": {"dir": "/x"}}).repos.get("mixedcase") != {"dir": "/x"}:
        fails.append("a lane must find a repository config by its project name in any case")

    # A remote job's log opens with a one-line header, so the reason is never script text.
    head = "$ ssh dev <script for job 9>\n"
    why = lane_problem(255, head + "ssh: connect refused\n")
    if "connect refused" not in why or "script" in why:
        fails.append(f"lane_problem must read the output after the header: {why!r}")
    if "no output (exit 255)" not in lane_problem(255, head):
        fails.append(f"an empty output must read as no output: {lane_problem(255, head)!r}")
    if lane_problem(1, head + "marker\n".replace("marker", lr.MARKER) + "x\n") != "":
        fails.append("a log with the marker line is not a lane problem")

    # A requeue that fails once is retried; one that keeps failing is said loudly.
    calls, said = [], []
    globals()["brain"] = lambda args, stdin=None: calls.append(args) or (None if len(calls) == 1 else "")
    try:
        ok = requeue_job(7, "ssh failed", said.append)
    finally:
        globals()["brain"] = real_brain
    if not ok or len(calls) != 2 or said:
        fails.append(f"a failed requeue must be retried once: {ok} {calls} {said}")
    calls.clear()
    globals()["brain"] = lambda args, stdin=None: calls.append(args) or None
    try:
        ok = requeue_job(7, "ssh failed", said.append)
    finally:
        globals()["brain"] = real_brain
    if ok or len(calls) != 2 or not said or "job #7" not in said[0] or "STUCK running" not in said[0]:
        fails.append(f"a requeue that keeps failing must name the stuck job: {ok} {calls} {said}")

    # Names come out stable and only real test lines count.
    got = [n for n, _ in Dotnet.failures(fixture("mtp-failure.log"))]
    if got != ["BarakoCMS.Tests.ModuleCapabilityGrantTests.Every_module_grants_its_own_capabilities_to_admin"]:
        fails.append(f"mtp duration suffix must not be part of the name: {got}")
    for tail in ("(12ms)", "(1.5s)", "(1s 184ms)", "(1m 02s 100ms)", "(2h 1m 3s)"):
        got = [n for n, _ in Dotnet.failures(f"failed A.B.C.D {tail}\n")]
        if got != ["A.B.C.D"]:
            fails.append(f"duration {tail} not stripped: {got}")
    got = [n for n, _ in Dotnet.failures("failed A.B.C.D(x: 1.5) (3ms)\n")]
    if got != ["A.B.C.D(x: 1.5)"]:
        fails.append(f"argument list lost: {got}")
    got = [n for n, _ in Dotnet.failures(fixture("vstest-assertion-dump.log"))]
    if got != ["Shop.Client.ContractTests.Orders.OrderServerTests.ShippingCounts_are_18_23_1"]:
        fails.append(f"an assertion dump must not parse as tests: {got}")
    got = [n for n, _ in Dotnet.failures('  Failed A.B.T(code: "1 2", e: True) [10 s]\n    Failed = 1,\nFailed!  - Failed: 2\n')]
    if got != ['A.B.T(code: "1 2", e: True)']:
        fails.append(f"vstest line with arguments: {got}")
    with tempfile.TemporaryDirectory() as d:
        bin_dir = os.path.join(d, "shims")
        os.mkdir(bin_dir)
        # A fake dotnet. FAKE_FULL and FAKE_CLASS_<name> pick what it prints, FAKE_LOG records every call.
        shim = os.path.join(bin_dir, "dotnet")
        with open(shim, "w") as fh:
            fh.write('''#!/bin/sh
echo "$*" >> "$FAKE_LOG"
case "$*" in
  *Canceller.csproj*) python3 "$FAKE_BRAIN" queue cancel "$FAKE_CANCEL" >/dev/null ;;
esac
case "$*" in
  *"--filter-class "*|*"FullyQualifiedName~"*)
    all="$*"; cls=${all##*--filter-class }; [ "$cls" = "$all" ] && cls=${all##*FullyQualifiedName~}
    cls=${cls%% *}
    f=$FAKE_DIR/class-$cls
    if [ -f "$f" ]; then cat "$f"; [ -f "$f.rc" ] && exit "$(cat "$f.rc")"; exit 0; fi
    echo "passed $cls.Any (1ms)"; exit 0 ;;
esac
if [ -f "$FAKE_DIR/full" ]; then cat "$FAKE_DIR/full"; exit "$(cat "$FAKE_DIR/full.rc")"; fi
echo "Passed!  - Failed: 0"; exit 0
''')
        os.chmod(shim, 0o755)
        env = dict(os.environ, PATH=bin_dir + os.pathsep + os.environ["PATH"], FAKE_DIR=d, FAKE_BRAIN=BRAIN,
                   FAKE_LOG=os.path.join(d, "calls.log"), LEAN_BRAIN_DB=os.path.join(d, "brain.db"),
                   HEAVY_LOCK_DIR=os.path.join(d, "locks"), LEAN_TEST_PHASE_DIR=os.path.join(d, "runs"),
                   HEAVY_WAIT="20", TEST_PHASE_REMOTES="off")
        env.pop("TEST_PHASE_RUNNER", None)
        repo_v = os.path.join(d, "vrepo")
        repo_m = os.path.join(d, "mrepo")
        for r in (repo_v, repo_m):
            os.makedirs(os.path.join(r, "tests", "T"))
        with open(os.path.join(repo_m, "global.json"), "w") as fh:
            fh.write('{"sdk": {"version": "10.0.100"}, "test": {"runner": "Microsoft.Testing.Platform"}}')

        def put(name, text, rc=None):
            with open(os.path.join(d, name), "w") as fh:
                fh.write(text)
            if rc is not None:
                with open(os.path.join(d, name + ".rc"), "w") as fh:
                    fh.write(str(rc))

        def run(plan, *extra):
            pf = os.path.join(d, "plan.txt")
            open(pf, "w").write(plan)
            open(env["FAKE_LOG"], "w").close()
            r = subprocess.run([sys.executable, os.path.realpath(__file__), pf, *extra], env=env,
                               capture_output=True, text=True, timeout=240)
            calls = open(env["FAKE_LOG"]).read().splitlines()
            return r.returncode, r.stdout + r.stderr, calls

        def brain_list(*args):
            return subprocess.run([sys.executable, BRAIN, "list", *args], env=env, capture_output=True,
                                  text=True).stdout

        # VSTest repo: one real failure, one flaky, one that passes.
        put("full", "  Failed Acme.RealTests.Breaks [3 ms]\n  Failed Acme.FlakyTests.Sometimes(x: 1.5) [9 ms]\n"
                    "  Passed Acme.OkTests.Fine [1 ms]\nFailed!  - Failed:     2, Passed:     1, Skipped:     0, Total:     3\n", 1)
        put("class-Acme.RealTests", "  Failed Acme.RealTests.Breaks [3 ms]\nFailed!  - Failed: 1\n", 1)
        put("class-Acme.FlakyTests", "  Passed Acme.FlakyTests.Sometimes(x: 1.5) [9 ms]\nPassed!\n", 0)
        rc, out, calls = run(f"# plan\n{repo_v} tests/T/T.csproj Fast\n")
        if rc != 1:
            fails.append(f"a real failure must exit 1, got {rc}: {out}")
        want = ["test tests/T/T.csproj --logger console;verbosity=normal --filter FullyQualifiedName~Fast",
                "test tests/T/T.csproj --logger console;verbosity=normal"]
        if calls[:2] != want:
            fails.append(f"vstest order or arguments wrong (fast first, then full): {calls}")
        if not any("--filter FullyQualifiedName~Acme.RealTests" in c for c in calls) or \
           not any("--filter FullyQualifiedName~Acme.FlakyTests" in c for c in calls):
            fails.append(f"each failing class must rerun alone: {calls}")
        if any("--project" in c for c in calls):
            fails.append(f"vstest repo used MTP syntax: {calls}")
        lst = brain_list()
        if "test-fail vrepo" not in lst or "Acme.RealTests.Breaks" not in lst:
            fails.append(f"real failure not in brain: {lst!r}")
        if "flaky vrepo" not in lst or "Acme.FlakyTests.Sometimes(x: 1.5)" not in lst:
            fails.append(f"flaky test not in brain as flaky: {lst!r}")
        if "OkTests" in lst:
            fails.append(f"a passing test reached brain: {lst!r}")
        if not re.search(r"vrepo:T\.csproj\s+dotnet/vstest\s+full\s+fail\s+2\s+1\s+1", out):
            fails.append(f"summary row wrong: {out}")
        runs = os.path.join(d, "runs")
        logs = [f for r_, _, fs in os.walk(runs) for f in fs]
        if not any(f.endswith("-fast.log") for f in logs) or not any(f.endswith("-full.log") for f in logs):
            fails.append(f"logs not written to the run dir: {logs}")

        import sqlite3
        con = sqlite3.connect(env["LEAN_BRAIN_DB"])
        runs = con.execute("SELECT tier, passed, failed, exit_code, lane_wait_s, load_end IS NOT NULL, cycle FROM runs"
                           " ORDER BY id").fetchall()
        if [r[0] for r in runs] != ["fast", "full", "rerun", "rerun"] or runs[1][1:4] != (1, 2, 1) \
                or runs[1][4] is None or not runs[1][5] or not runs[1][6]:
            fails.append(f"runs table rows wrong: {runs}")
        linked = con.execute("SELECT COUNT(*) FROM items WHERE run_id IS NOT NULL AND source='test-phase'"
                             " AND phase='test' AND cycle != ''").fetchone()[0]
        if linked != 2:
            fails.append(f"items must link to their run and carry source, phase and cycle: {linked}")
        con.close()
        st = json.loads(subprocess.run([sys.executable, BRAIN, "stats", "--json"], env=env, capture_output=True,
                                       text=True).stdout)
        if st["suites"][0]["runs"] != 2 or st["suites"][0]["flaky_items"] != 1:
            fails.append(f"stats over test-phase runs: {st['suites']}")

        # The same failure again is one brain row with a higher seen count.
        run(f"{repo_v} tests/T/T.csproj\n")
        lst = brain_list("--kind", "test-fail")
        if len(lst.splitlines()) != 1 or "occ=2" not in lst:
            fails.append(f"a repeat run must dedupe in brain: {lst!r}")

        # MTP repo, with ANSI colour and a passing project: exit 0, MTP syntax.
        os.remove(os.path.join(d, "full"))
        os.remove(os.path.join(d, "full.rc"))
        rc, out, calls = run(f"{repo_m} tests/T/T.csproj\n")
        if rc != 0 or calls != ["test --project tests/T/T.csproj -- --output Detailed"]:
            fails.append(f"mtp passing run: {rc} {calls} {out}")
        put("full", "\x1b[31mfailed Acme.MtpTests.Bad (12ms)\x1b[0m\n  Assert failed\nTest run summary: Failed!\n", 2)
        put("class-Acme.MtpTests", "failed Acme.MtpTests.Bad (12ms)\n", 2)
        rc, out, calls = run(f"{repo_m} tests/T/T.csproj\n")
        if not any("--project tests/T/T.csproj -- --filter-class Acme.MtpTests" in c for c in calls):
            fails.append(f"mtp class rerun wrong: {calls}")
        if "Acme.MtpTests.Bad" not in brain_list("--open") or rc != 1:
            fails.append(f"mtp failure not in brain or exit not 1 ({rc})")
        env["TEST_PHASE_DOTNET_ARGS"] = "-p:ValidateXcodeVersion=false"
        rc, out, calls = run(f"{repo_m} tests/T/T.csproj \"args=-p:Job=1 -p:Two='a b'\"\n")
        env.pop("TEST_PHASE_DOTNET_ARGS")
        if calls[0] != "test --project tests/T/T.csproj -p:ValidateXcodeVersion=false -p:Job=1 -p:Two=a b -- --output Detailed":
            fails.append(f"extra args go before -- in mtp mode, env first then the job's: {calls}")
        rc, out, calls = run(f"{repo_v} tests/T/T.csproj args=-p:V=1\n")
        if calls[0] != "test tests/T/T.csproj -p:V=1 --logger console;verbosity=normal":
            fails.append(f"extra args in vstest mode: {calls}")
        rc, out, calls = run(f"{repo_m} tests/T/T.csproj Mtp\n")
        if calls[0] != "test --project tests/T/T.csproj -- --filter-class *Mtp* --output Detailed" or \
           "test --project tests/T/T.csproj -- --filter-class Acme.MtpTests --output Detailed" not in calls:
            fails.append(f"mtp fast tier needs wildcards, reruns the exact class: {calls}")

        # A filter that matches no test is a failure, not a pass: VSTest exits 0 with no summary, MTP exits 8.
        put("full", "Passed!  - Failed: 0, Passed: 1, Skipped: 0, Total: 1\n", 0)
        put("class-Empty", "No test matches the given testcase filter `FullyQualifiedName~Empty` in T.dll\n", 0)
        put("class-Good", "  Passed Acme.GoodTests.A [1 ms]\nPassed!  - Failed: 0, Passed: 3, Skipped: 0, Total: 3\n", 0)
        rc, out, calls = run(f"{repo_v} tests/T/T.csproj Empty\n")
        if rc != 1 or "filter matched no test" not in out or "filter-matched-no-test: tests/T/T.csproj" not in brain_list():
            fails.append(f"vstest exit 0 with a filter that matched nothing must fail with an item ({rc}): {out} {brain_list()!r}")
        os.remove(os.path.join(d, "class-Empty"))
        put("class-*Empty*", "", 8)
        rc, out, calls = run(f"{repo_m} tests/T/T.csproj Empty\n")
        if rc != 1 or "filter matched no test" not in out:
            fails.append(f"mtp exit 8 with a filter must fail as matched no test ({rc}): {out}")
        rc, out, calls = run(f"{repo_v} tests/T/T.csproj Good\n")
        if rc != 0 or "filter matched no test" in out:
            fails.append(f"a filtered run with tests must still pass ({rc}): {out}")

        # A refused full add stops the plan loudly; again=REASON on the plan line goes through as --again.
        def gitrepo(name, dirty=False):
            g = os.path.join(d, name)
            os.makedirs(os.path.join(g, "tests", "T"))
            with open(os.path.join(g, "f.txt"), "w") as fh:
                fh.write("x\n")
            for cmd in (["init", "-q"], ["add", "."], ["-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "-m", "x"]):
                subprocess.run(["git", "-C", g] + cmd, check=True, capture_output=True)
            if dirty:
                with open(os.path.join(g, "f.txt"), "w") as fh:
                    fh.write("changed\n")
            return g
        put("full", "Passed!  - Failed: 0, Passed: 1, Skipped: 0, Total: 1\n", 0)
        gclean, gdirty = gitrepo("gclean"), gitrepo("gdirty", dirty=True)
        rc, out, calls = run(f"{gdirty} tests/T/T.csproj Fast\n")
        if rc == 0 or "uncommitted" not in out or "again=" not in out or calls:
            fails.append(f"a refused full add must fail the plan before any job runs ({rc}): {out} {calls}")
        rc, out, calls = run(f"{gdirty} tests/T/T.csproj \"again=testing the edit\"\n")
        if rc != 0 or not calls:
            fails.append(f"again=REASON must let a dirty tree run ({rc}): {out} {calls}")
        rc, out, calls = run(f"{gclean} tests/T/T.csproj\n")
        rc, out, calls = run(f"{gclean} tests/T/T.csproj Fast\n")
        if rc == 0 or "already exists" not in out:
            fails.append(f"a second full run of one commit must fail the plan ({rc}): {out} {calls}")
        rc, out, calls = run(f"{gclean} tests/T/T.csproj again=redo\n")
        if rc != 0 or not calls:
            fails.append(f"again=REASON must allow a second full run ({rc}): {out} {calls}")
        put("class-Multi", "No test matches the given testcase filter `FullyQualifiedName~Multi` in T.dll (net8.0)\n"
            "Passed!  - Failed: 0, Passed: 2, Skipped: 0, Total: 2 - T.dll (net10.0)\n", 0)
        rc, out, calls = run(f"{repo_v} tests/T/T.csproj Multi\n")
        if rc != 0 or "filter matched no test" in out:
            fails.append(f"a multi-target run with tests on one framework must pass ({rc}): {out}")

        # A build error: nonzero exit, no failing test named. It must not look like a pass.
        os.remove(os.path.join(d, "class-Acme.MtpTests"))
        put("full", "error CS1002: ; expected\n", 1)
        rc, out, calls = run(f"{repo_v} tests/T/T.csproj\n")
        if rc != 1 or "run-failed: tests/T/T.csproj" not in subprocess.run(
                [sys.executable, BRAIN, "show", "4"], env=env, capture_output=True, text=True).stdout + brain_list():
            fails.append(f"build error not reported ({rc}): {out}")

        # A rerun that names no failure proves nothing: only exit 0, or passed tests with the name absent, is flaky.
        put("full", "  Failed Un.UnverTests.A [1 ms]\n  Failed Pa.PartTests.A [1 ms]\nFailed!  - Failed: 2, Passed: 0, Skipped: 0, Total: 2\n", 1)
        put("class-Un.UnverTests", "Unhandled exception. The host crashed\n", 1)
        put("class-Pa.PartTests", "Failed!  - Failed: 1, Passed: 4, Skipped: 0, Total: 5\n  Failed Pa.PartTests.Other [1 ms]\n", 1)
        rc, out, calls = run(f"{repo_v} tests/T/T.csproj\n")
        lst = brain_list()
        if "flaky vrepo Un.UnverTests.A" in lst or "test-fail vrepo Un.UnverTests.A" not in lst:
            fails.append(f"a rerun with no named failure and a nonzero exit must not be flaky: {lst!r}")
        if "flaky vrepo Pa.PartTests.A" not in lst:
            fails.append(f"a rerun with passed tests and the name absent is flaky: {lst!r}")
        un = subprocess.run([sys.executable, BRAIN, "show", re.search(r"#(\d+) \S+ test-fail vrepo Un\.UnverTests\.A", lst).group(1)],
                            env=env, capture_output=True, text=True).stdout if "test-fail vrepo Un.UnverTests.A" in lst else ""
        if "unverified" not in un:
            fails.append(f"an unproven rerun must be labelled unverified: {un!r}")
        put("full", "error CS1002: ; expected\n", 1)

        # The queue. Job A fails to build, B waits on A, C is independent, D waits on B (a chain).
        # Drain order is by id among ready jobs; B and D are cancelled with the reason.
        def qadd(*args):
            return subprocess.run([sys.executable, BRAIN, "queue", "add", *args], env=env, capture_output=True,
                                  text=True).stdout.strip()

        def drain(*extra):
            open(env["FAKE_LOG"], "w").close()
            r = subprocess.run([sys.executable, os.path.realpath(__file__), *extra], env=env, capture_output=True,
                               text=True, timeout=240)
            return r.returncode, r.stdout + r.stderr, open(env["FAKE_LOG"]).read().splitlines()

        def qlist(*args):
            return subprocess.run([sys.executable, BRAIN, "queue", "list", *args], env=env, capture_output=True,
                                  text=True).stdout

        ja = qadd(repo_v, "tests/T/A.csproj", "--cycle", "qa")
        jb = qadd(repo_v, "tests/T/B.csproj", "--after", ja, "--cycle", "qa")
        jc = qadd(repo_v, "tests/T/C.csproj", "--cycle", "qa")
        jd = qadd(repo_v, "tests/T/D.csproj", "--after", jb, "--cycle", "qa")
        rc, out, calls = drain()
        order = [c.split()[1] for c in calls if "FullyQualifiedName" not in c]
        if order != ["tests/T/A.csproj", "tests/T/C.csproj"]:
            fails.append(f"queue ran the wrong jobs or order: {calls}")
        ql = qlist("--cycle", "qa")
        if f"job #{ja} failed" not in ql or f"job #{jc} failed" not in ql \
                or f"job #{jb} cancelled" not in ql or f"job #{jd} cancelled" not in ql \
                or ql.count(f"dependency #{ja} failed") != 2:
            fails.append(f"dependents not cancelled with a reason: {ql}")
        if rc != 1:
            fails.append(f"a failed job must exit 1, got {rc}")

        # A job whose failures are all flaky is done: its dependent runs and the exit is 0.
        put("full", "  Failed Fl.FlakyOnly.A [1 ms]\nFailed!  - Failed: 1, Passed: 2, Skipped: 0, Total: 3\n", 1)
        put("class-Fl.FlakyOnly", "Passed!  - Failed: 0, Passed: 1, Skipped: 0, Total: 1\n", 0)
        jf1 = qadd(repo_v, "tests/T/F1.csproj", "--cycle", "qf")
        jf2 = qadd(repo_v, "tests/T/F2.csproj", "--after", jf1, "--cycle", "qf")
        rc, out, calls = drain()
        ql = qlist("--cycle", "qf")
        if f"job #{jf1} done" not in ql or f"job #{jf2} done" not in ql or rc != 0:
            fails.append(f"an all-flaky job must finish done and run its dependents, exit 0 ({rc}): {ql} {out}")
        put("full", "error CS1002: ; expected\n", 1)

        # A job cancelled while the drain runs makes the exit 1, even though nothing failed.
        os.remove(os.path.join(d, "full"))
        os.remove(os.path.join(d, "full.rc"))
        jx = qadd(repo_v, "tests/T/Canceller.csproj", "--cycle", "qx")
        jy = qadd(repo_v, "tests/T/Victim.csproj", "--cycle", "qx")
        env["FAKE_CANCEL"] = jy
        rc, out, calls = drain()
        env.pop("FAKE_CANCEL")
        if rc != 1 or f"job #{jy} cancelled" not in qlist("--cycle", "qx"):
            fails.append(f"a job cancelled during the drain must exit 1 ({rc}): {out}")
        put("full", "error CS1002: ; expected\n", 1)

        # Nothing ready: a drain says so, exits 0, runs nothing.
        rc, out, calls = drain()
        if rc != 0 or calls or "nothing queued" not in out:
            fails.append(f"an empty queue should be a quiet 0 ({rc}): {out} {calls}")

        # A job routed to a remote lane, with no remote lane: the Mac leaves it queued and says so.
        jr = qadd(repo_v, "tests/T/R.csproj", "--platform", "none", "--cycle", "qr")
        subprocess.run([sys.executable, BRAIN, "queue", "route", jr, "--to", "remote"], env=env, capture_output=True)
        rc, out, calls = drain()
        if rc != 0 or calls or "1 job waits for a remote lane" not in out \
                or f"job #{jr} queued" not in qlist("--cycle", "qr"):
            fails.append(f"a job routed to a remote lane must wait, named in the output ({rc}): {out} {calls}")
        subprocess.run([sys.executable, BRAIN, "queue", "cancel", jr], env=env, capture_output=True)

        # Only one drainer: while one holds the lock, a second exits 0 and leaves the job queued.
        import fcntl
        jl = qadd(repo_v, "tests/T/L.csproj", "--cycle", "ql")
        os.makedirs(os.path.join(d, "runs"), exist_ok=True)
        held = open(os.path.join(d, "runs", "drainer.lock"), "w")
        fcntl.flock(held, fcntl.LOCK_EX)
        rc, out, calls = drain()
        if rc != 0 or "a drainer is running" not in out or calls or f"job #{jl} queued" not in qlist("--cycle", "ql"):
            fails.append(f"second drainer must exit 0 and leave the queue alone ({rc}): {out} {calls}")
        fcntl.flock(held, fcntl.LOCK_UN)
        held.close()
        rc, out, calls = drain()
        if f"job #{jl} failed" not in qlist("--cycle", "ql"):  # the shim still reports a build error
            fails.append(f"the job should run once the lock is free: {qlist('--cycle', 'ql')} {out}")

        # A job left running by a dead drainer is failed, and its dependent cancelled.
        jr = qadd(repo_v, "tests/T/R.csproj", "--platform", "none", "--cycle", "qr")
        jr2 = qadd(repo_v, "tests/T/R2.csproj", "--after", jr, "--cycle", "qr")
        subprocess.run([sys.executable, BRAIN, "queue", "next"], env=env, capture_output=True, text=True)
        # that claimed an older ready job, if any; claim until jr is running
        while f"job #{jr} running" not in qlist("--cycle", "qr"):
            if not subprocess.run([sys.executable, BRAIN, "queue", "next"], env=env, capture_output=True,
                                  text=True).stdout.strip():
                break
        rc, out, calls = drain()
        ql = qlist("--cycle", "qr")
        if f"job #{jr} failed" not in ql or "drainer died" not in ql or f"job #{jr2} cancelled" not in ql:
            fails.append(f"stale running job not failed: {ql}")

        # A stall: a silent hang is stopped and only noted, not logged as a failing test.
        put("full", "", 0)
        with open(shim, "w") as fh:
            fh.write('#!/bin/sh\necho "[+1/x0/?0] t"\nsleep 60\n')
        rc, out, calls = run(f"{repo_m} tests/T/T.csproj\n", "--stall", "2")
        if rc != 1 or "stalled" not in out or "stalled: tests/T/T.csproj" not in brain_list("--kind", "note"):
            fails.append(f"stall not handled ({rc}): {out}")
        # No plan lines means nothing ran, which must not read as success.
        pf = os.path.join(d, "empty.txt")
        open(pf, "w").write("# nothing\n")
        r = subprocess.run([sys.executable, os.path.realpath(__file__), pf], env=env, capture_output=True, text=True)
        if r.returncode == 0:
            fails.append("an empty plan exited 0")

        # Remote lanes: a fake ssh, rsync and docker act on local folders (tests/fixtures/test-phase/remote).
        # The apple job keeps the local lane busy for about three seconds, so a plain job goes to the remote lane.
        rfix = os.path.realpath(os.path.join(fix, "remote"))
        hostwork, dockdir, rrepo = (os.path.join(d, x) for x in ("hostwork", "docker", "rrepo"))
        ini = os.path.join(d, "remotes.ini")
        for sub in ("tests/T", "tests/U", "tests/Apple", "local-packages"):
            os.makedirs(os.path.join(rrepo, sub))
        net = "<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup></Project>"
        apple = "<Project><PropertyGroup><TargetFrameworks>net10.0;net10.0-maccatalyst</TargetFrameworks></PropertyGroup></Project>"
        for name, text in ((".gitignore", "local-packages/\n"), (".env.local", "TOKEN=zzz\n"), ("secrets.json", "{}\n"),
                           ("tests/Apple/Apple.csproj", apple), ("local-packages/p.nupkg", "p"),
                           ("local-packages/x.key", "k")) + tuple(
                (f"tests/{x[0]}/{x[1]}.csproj", net) for x in ("TPlain", "TFail", "TStall", "TLost", "TOff", "TStale")):
            os.makedirs(os.path.dirname(os.path.join(rrepo, name)), exist_ok=True)
            open(os.path.join(rrepo, name), "w").write(text)
        for x in ("T/Hs", "U/Hs", "T/Plain", "T/Fail", "T/Stall", "T/Lost", "T/Off", "T/Stale"):
            open(os.path.join(rrepo, "tests", x + ".csproj"), "w").write(net)
        subprocess.run(["git", "init", "-q", rrepo], check=True)
        open(os.path.join(d, "rrepo.env"), "w").write("POSTGRES_PASSWORD=hunter2\n")
        open(ini, "w").write(f"[remote dev]\nhost = devbox\nworkdir = {hostwork}\ncpus = 2\nmemory = 8g\n"
                             f"min_free_gb = 0\nextra_paths = local-packages\n\n[repo rrepo]\n"
                             f"sidecars = db=postgres:16\nenv_file = {d}/rrepo.env\nready = pg_isready\n")
        renv = dict(env, PATH=rfix + os.pathsep + os.environ["PATH"], TEST_PHASE_REMOTES_FILE=ini,
                    FAKE_SSH_LOG=os.path.join(d, "ssh.log"), FAKE_DOCKER_DIR=dockdir, TEST_PHASE_REST="600",
                    HEAVY_WAIT="60")
        renv.pop("TEST_PHASE_REMOTES")

        def reset():
            for f in os.listdir(d):
                if f.startswith(("where", "files-", "peers", "envmode", "docker.log", "ssh.log", "rsync", "inflight-")):
                    os.remove(os.path.join(d, f))

        def rdrain(*extra, e=None):
            reset()
            t0 = time.time()
            r = subprocess.run([sys.executable, os.path.realpath(__file__), *extra], env=dict(e or renv),
                               capture_output=True, text=True, timeout=240)
            return r.returncode, r.stdout + r.stderr, time.time() - t0

        def rlog(name):
            try:
                return open(os.path.join(d, name)).read()
            except OSError:
                return ""

        def runs_of(test_project):
            c = sqlite3.connect(env["LEAN_BRAIN_DB"])
            got = c.execute("SELECT tier, host FROM runs WHERE test_project=? ORDER BY id", (test_project,)).fetchall()
            c.close()
            return got

        def leftovers():
            jobs = [f for f in os.listdir(hostwork) if f.startswith("job-")] if os.path.isdir(hostwork) else []
            return jobs, os.listdir(dockdir) if os.path.isdir(dockdir) else []

        # Two lanes run two jobs at once; the copy skips excluded files; the env file stays off every command line.
        qadd(rrepo, "tests/T/Hs.csproj", "--cycle", "r1")
        qadd(rrepo, "tests/U/Hs.csproj", "--cycle", "r1")
        rc, out, _ = rdrain()
        if rc != 0 or rlog("peers.log").split() != ["peers=2", "peers=2"]:
            fails.append(f"two jobs must run at the same time on two lanes ({rc}): {rlog('peers.log')!r} {out}")
        starts = sorted(l.split()[0].split("-")[0] for l in rlog("where.log").splitlines())
        if starts != ["job", "rrepo"]:
            fails.append(f"one job on each lane: {rlog('where.log')!r}")
        if sorted(h for _, h in runs_of("Hs.csproj")) != ["", "dev"]:
            fails.append(f"the remote run's row must carry the host: {runs_of('Hs.csproj')}")
        remote_files = "".join(rlog(f) for f in os.listdir(d) if f.startswith("files-job-"))
        if "./local-packages/p.nupkg" not in remote_files or "./tests/T/Plain.csproj" not in remote_files \
                or any(x in remote_files for x in (".env.local", "secrets.json", "x.key")):
            fails.append(f"the host must get the repo and extra paths but no excluded file: {remote_files!r}")
        if "-rw-------" not in rlog("envmode.log") or "./.lean.env" not in remote_files:
            fails.append(f"the env file must sit in the job folder with mode 600: {rlog('envmode.log')!r}")
        everything = rlog("ssh.log") + rlog("docker.log") + rlog("rsync.log")
        if "hunter2" in everything or ".env.local" in rlog("rsync.log"):
            fails.append("a secret or an excluded file reached a command line or the copy list")
        if "--cpus 2" not in rlog("docker.log") or "--memory 8g" not in rlog("docker.log") \
                or "--user" not in rlog("docker.log"):
            fails.append(f"every container is capped and runs as the ssh user: {rlog('docker.log')!r}")
        if leftovers() != ([], []) or not re.search(r"\bhost\b", out) or "dev" not in out:
            fails.append(f"nothing may be left on the host after a pass, and the summary shows the host: {leftovers()} {out}")

        # An apple-platform job runs on the local lane only.
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r2")
        qadd(rrepo, "tests/T/Plain.csproj", "--cycle", "r2")
        rc, out, _ = rdrain()
        if runs_of("Apple.csproj")[-1:] != [("full", "")] or runs_of("Plain.csproj") != [("full", "dev")]:
            fails.append(f"apple job local, plain job remote: {runs_of('Apple.csproj')} {runs_of('Plain.csproj')} {out}")
        if any("Apple.csproj" in l and not l.startswith("rrepo ") for l in rlog("where.log").splitlines()):
            fails.append(f"a remote lane ran an apple job: {rlog('where.log')!r}")

        # An idle lane keeps polling while another lane works: the local lane finds nothing, then an apple job
        # arrives while the remote lane is still on its job, and the drain still ends.
        slow = qadd(rrepo, "tests/Apple/Apple.csproj", "--platform", "none", "--cycle", "r2b")
        subprocess.run([sys.executable, BRAIN, "queue", "route", slow, "--to", "remote"], env=env, capture_output=True)
        reset()
        proc = subprocess.Popen([sys.executable, os.path.realpath(__file__)], env=dict(renv, TEST_PHASE_POLL="0.3"),
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        time.sleep(1.5)
        late = qadd(rrepo, "tests/TPlain/TPlain.csproj", "--platform", "apple", "--cycle", "r2b")
        try:
            out = proc.communicate(timeout=30)[0]
        except subprocess.TimeoutExpired:
            proc.kill()
            out = proc.communicate()[0] + " (killed, the drain did not end)"
        c = sqlite3.connect(env["LEAN_BRAIN_DB"])
        started = c.execute("SELECT started_at FROM jobs WHERE id=?", (int(late),)).fetchone()[0] or ""
        ended = c.execute("SELECT ended_at FROM jobs WHERE id=?", (int(slow),)).fetchone()[0] or ""
        c.close()
        # The drainer looks at the queue again once a drain ends, so the late job runs either way; with the
        # fix it starts while the remote job still runs. The slow job takes over 3 s, so whole seconds tell.
        if proc.returncode != 0 or f"job #{slow} done" not in qlist("--cycle", "r2b") \
                or f"job #{late} done" not in qlist("--cycle", "r2b") or runs_of("TPlain.csproj") != [("full", "")] \
                or not started or not started < ended:
            fails.append(f"an idle lane must pick up a job queued while another lane works ({proc.returncode}): "
                         f"{started} !< {ended} {qlist('--cycle', 'r2b')} {out}")

        # A lost connection puts the job back in the queue, is not a test failure, and does not hold the drain.
        open(os.path.join(d, "ssh-fail-run"), "w").close()
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r3")
        lost = qadd(rrepo, "tests/T/Lost.csproj", "--cycle", "r3")
        rc, out, secs = rdrain()
        os.remove(os.path.join(d, "ssh-fail-run"))
        if "back to queued" not in out or rc != 0 or secs > 60:
            fails.append(f"a lost connection must requeue the job and end the drain in seconds ({rc}, {secs:.0f}s): {out}")
        if "Lost" in brain_list() or runs_of("Lost.csproj") != [("full", "")] \
                or f"job #{lost} done" not in qlist("--cycle", "r3"):
            fails.append(f"the requeued job runs on the local lane and files no failure: {brain_list()!r} {runs_of('Lost.csproj')}")
        if leftovers() != ([], []):
            fails.append(f"cleanup must run after a lane problem: {leftovers()}")

        # A failing test reruns on the same host; the rerun's row carries the host too; cleanup follows a fail.
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r4")
        qadd(rrepo, "tests/T/Fail.csproj", "--cycle", "r4")
        rc, out, _ = rdrain()
        if rc != 1 or runs_of("Fail.csproj") != [("full", "dev"), ("rerun", "dev")] \
                or "Acme.RemoteTests.Breaks" not in brain_list("--open") or leftovers() != ([], []):
            fails.append(f"remote fail and rerun ({rc}): {runs_of('Fail.csproj')} {leftovers()} {out}")

        # A stall on the host is stopped, noted, and cleaned up after. The window counts the copy and the
        # container setup too, which on a loaded machine can pass 3 s before the test starts.
        qadd(rrepo, "tests/Apple/Apple.csproj", "--cycle", "r5")
        qadd(rrepo, "tests/T/Stall.csproj", "--cycle", "r5")
        rc, out, _ = rdrain("--stall", "10")
        if rc != 1 or "stalled: tests/T/Stall.csproj" not in brain_list("--kind", "note") or leftovers() != ([], []) \
                or runs_of("Stall.csproj") != [("full", "dev")]:
            fails.append(f"remote stall ({rc}): {runs_of('Stall.csproj')} {leftovers()} {out}")

        # TEST_PHASE_REMOTES=off is today's behavior: one lane, no ssh.
        qadd(rrepo, "tests/T/Off.csproj", "--cycle", "r6")
        rc, out, _ = rdrain(e=dict(renv, TEST_PHASE_REMOTES="off"))
        if rc != 0 or rlog("ssh.log") or runs_of("Off.csproj") != [("full", "")] or "lanes" in out:
            fails.append(f"remotes off must not touch ssh ({rc}): {rlog('ssh.log')!r} {out}")

        # A job left running on a host by a dead drainer: the host's folder and containers go first.
        stale = qadd(rrepo, "tests/T/Stale.csproj", "--cycle", "r7")
        got = subprocess.run([sys.executable, BRAIN, "queue", "next", "--host", "dev"], env=env, capture_output=True,
                             text=True).stdout
        os.makedirs(os.path.join(hostwork, f"job-{stale}"), exist_ok=True)
        os.makedirs(dockdir, exist_ok=True)
        open(os.path.join(dockdir, f"c-lean-{stale}-run"), "w").write(stale)
        rc, out, _ = rdrain()
        if f'"id": {stale}' not in got or f"job #{stale} failed" not in qlist("--cycle", "r7") \
                or leftovers() != ([], []):
            fails.append(f"a stale remote job needs its host cleaned: {got!r} {qlist('--cycle', 'r7')} {leftovers()}")
    if fails:
        print("self-test failed:\n  " + "\n  ".join(fails))
        return 1
    print("self-test passed")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    sys.exit(main(sys.argv[1:]))
