#!/usr/bin/env python3
"""An MCP server over stdio that lets a Claude session read and write the brain database.

Newline-delimited JSON-RPC 2.0, Python 3 standard library only. Every tool runs the `brain` CLI that sits
next to this script as a subprocess with an argument list (never a shell), so the schema and the rules
stay in one place. A nonzero exit becomes a tool result with isError true and the stderr text.

Tools: brain_list, brain_show, brain_add, brain_close, brain_queue_list, brain_queue_add,
brain_queue_cancel, brain_queue_bump, brain_queue_route, brain_stats, brain_digest. `queue next` and `queue finish` are not exposed:
only the drainer (bin/test-phase) claims and finishes jobs.

brain_list answers small by default: open items, newest first, 50 lines (the limit argument changes that, and
a status or open=false asks for more). brain_queue_list defaults to queued and running jobs. A cut says how
many more exist. brain_digest is the short start-of-session read.

A body goes to brain on stdin (--body-file -), never on the command line.
BRAIN_MCP_ARGV_LOG=FILE appends the argv of every brain call to FILE as one JSON line (used by the
self-test to prove a body never reaches argv). Logs go to stderr only.

  brain-mcp --self-test
"""
import json
import re
import os
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
BRAIN = os.path.join(HERE, "brain")
DEFAULT_PROTOCOL = "2025-06-18"


def log(*a):
    print("brain-mcp:", *a, file=sys.stderr, flush=True)


def S(desc):
    return {"type": "string", "description": desc}


def I(desc):
    return {"type": "integer", "description": desc}


def B(desc):
    return {"type": "boolean", "description": desc}


def schema(props, required=()):
    d = {"type": "object", "properties": props, "additionalProperties": False}
    if required:
        d["required"] = list(required)
    return d


class Bad(Exception):
    pass


def need_int(a, k):
    v = a.get(k)
    if isinstance(v, bool) or not isinstance(v, int):
        raise Bad(f"{k} must be an integer")
    return str(v)


def need_str(a, k):
    v = a.get(k)
    if not isinstance(v, str) or not v:
        raise Bad(f"{k} is required and must be a non-empty string")
    return no_dash(k, v)


def no_dash(k, v):
    # A value that starts with a dash would be read by brain as an option, not as the value.
    if v.startswith("-"):
        raise Bad(f"{k} must not start with -")
    return v


def opt(a, args, key, flag=None, kind=str):
    """Append --flag value when key is present."""
    v = a.get(key)
    if v is None or v == "":
        return
    if kind is int:
        if isinstance(v, bool) or not isinstance(v, int):
            raise Bad(f"{key} must be an integer")
        v = str(v)
    elif not isinstance(v, str):
        raise Bad(f"{key} must be a string")
    # --flag=value keeps a value such as "-1 offset" a value, so a title or note may start with a dash.
    args.append((flag or "--" + key.replace("_", "-")) + "=" + v)


DEFAULT_LIMIT = 50


def limit_of(a):
    v = a.get("limit", DEFAULT_LIMIT)
    if isinstance(v, bool) or not isinstance(v, int) or v < 1:
        raise Bad("limit must be a positive integer")
    return v


def cut(lines, limit, what):
    if len(lines) <= limit:
        return "\n".join(lines)
    return "\n".join(lines[:limit] + [f"... {len(lines) - limit} more {what}; narrow the filters or pass a bigger limit"])


def after_list(a, text):
    # brain lists oldest first; an agent wants the newest.
    return cut(list(reversed(text.splitlines())), limit_of(a), "items")


def after_queue_list(a, text):
    lines = text.splitlines()
    if not a.get("status"):
        lines = [ln for ln in lines if ln.split()[2:3] in (["queued"], ["running"])]
    return cut(list(reversed(lines)), limit_of(a), "jobs") or "no queued or running jobs"


def t_list(a):
    limit_of(a)
    args = ["list"]
    if a.get("open") is True or (a.get("open") is not False and not a.get("status")):
        args.append("--open")
    for k in ("status", "project", "kind", "tag", "cycle"):
        opt(a, args, k)
    return args, None


def t_show(a):
    return ["show", need_int(a, "id")], None


def t_add(a):
    args = ["add", "--project", need_str(a, "project"), "--kind", need_str(a, "kind"), "--ref", need_str(a, "ref")]
    for k in ("title", "severity", "repo", "branch", "cycle"):
        opt(a, args, k)
    body = a.get("body")
    stdin = None
    if body not in (None, ""):
        if not isinstance(body, str):
            raise Bad("body must be a string")
        args.extend(["--body-file", "-"])
        stdin = body
    return args, stdin


def t_close(a):
    args = ["close", need_int(a, "id")]
    opt(a, args, "resolution")
    opt(a, args, "note")
    if a.get("wontfix") is True:
        args.append("--wontfix")
    return args, None


def t_queue_list(a):
    limit_of(a)
    args = ["queue", "list"]
    opt(a, args, "status")
    opt(a, args, "cycle")
    return args, None


CLASS = re.compile(r"[A-Za-z0-9_.*~`+<>]+")


def t_queue_add(a):
    args = ["queue", "add", need_str(a, "repo_dir"), need_str(a, "test_project"), "--by", "mcp"]
    # test-phase splits a filter on | and hands each piece to dotnet, so check each piece, not the whole.
    f = a.get("filter")
    if f not in (None, "") and not (isinstance(f, str) and all(CLASS.fullmatch(p.strip()) for p in f.split("|"))):
        raise Bad("filter must be class names joined by |")
    if a.get("tier") not in (None, "", "fast", "full"):
        raise Bad("tier must be fast or full")
    for k in ("filter", "tier", "cycle"):
        opt(a, args, k)
    opt(a, args, "after", kind=int)
    # No extra dotnet arguments here: they run on the drainer's machine, so they stay a shell-only choice.
    # Only the top of a git work tree: a queued job builds and runs that folder's code, and a remote
    # lane copies its files, so a scratch folder somewhere is not a place to queue from.
    top = subprocess.run(["git", "-C", args[2], "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if not os.path.isdir(args[2]) or top.returncode != 0 or \
            os.path.realpath(top.stdout.strip()) != os.path.realpath(args[2]):
        raise Bad("repo_dir must be the top folder of a git work tree")
    return args, None


def t_queue_cancel(a):
    return ["queue", "cancel", need_int(a, "id")], None


def t_queue_bump(a):
    return ["queue", "bump", need_int(a, "id")], None


def t_queue_route(a):
    to = need_str(a, "to")
    if to not in ("remote", "local", "any"):
        raise Bad("to must be remote, local or any")
    return ["queue", "route", need_int(a, "id"), "--to=" + to], None


def t_digest(a):
    args = ["digest"]
    if a.get("all") is True:
        args.append("--all")
    opt(a, args, "project")
    return args, None


def t_stats(a):
    return ["stats", "--json"], None


TOOLS = [
    ("brain_list", "List brain items, one line each: open items, newest first, 50 at most unless limit says "
     "otherwise. Filters are optional.", t_list, schema({
        "limit": I("most lines to return, default 50"),
        "open": B("only open items (the default); false lists every status"), "status": S("open, closed or wontfix"), "project": S("project name"),
        "kind": S("item kind, such as test-fail or question"), "tag": S("a tag"), "cycle": S("cycle name")})),
    ("brain_show", "Show one brain item in full.", t_show, schema({"id": I("item id")}, ["id"])),
    ("brain_add", "Add an item, or bump the count of an open one with the same project, kind and ref.", t_add, schema({
        "project": S("project name"), "kind": S("test-fail, flaky, minor, question, ticket, security, pending, blocker, agent"),
        "ref": S("short key that identifies the item"), "title": S("one-line title"), "body": S("details"),
        "severity": S("critical, important, minor or info"), "repo": S("repository"), "branch": S("branch"),
        "cycle": S("cycle name")}, ["project", "kind", "ref"])),
    ("brain_close", "Close an item.", t_close, schema({
        "id": I("item id"), "resolution": S("fixed, flaky, not-a-bug, duplicate, answered or filed"),
        "note": S("closing note"), "wontfix": B("close as wontfix")}, ["id"])),
    ("brain_queue_list", "List test queue jobs: queued and running unless status says otherwise, newest first, "
     "50 at most.", t_queue_list, schema({
        "limit": I("most lines to return, default 50"),
        "status": S("queued, running, done, failed or cancelled"), "cycle": S("cycle name")})),
    ("brain_queue_add", "Queue a test job. Returns the job id at once; do not wait for it.", t_queue_add, schema({
        "repo_dir": S("repository folder"), "test_project": S("test project path"), "filter": S("test filter"),
        "tier": S("fast or full"), "after": I("job id this one waits for"), "cycle": S("cycle name")},
        ["repo_dir", "test_project"])),
    ("brain_queue_cancel", "Cancel a queued job and the jobs waiting on it.", t_queue_cancel,
     schema({"id": I("job id")}, ["id"])),
    ("brain_queue_bump", "Move a queued job, and the jobs chained after it, ahead of the rest.", t_queue_bump,
     schema({"id": I("job id")}, ["id"])),
    ("brain_queue_route", "Choose which lanes may run a queued job: remote (only a remote host such as the VM), "
     "local (only this machine) or any.", t_queue_route,
     schema({"id": I("job id"), "to": S("remote, local or any")}, ["id", "to"])),
    ("brain_digest", "Short read for the start of a session, under 2 KB: open counts by project and kind, open "
     "blockers and questions, running jobs, stale agents. The current project unless project or all is given.",
     t_digest, schema({"project": S("project name, matched without regard to case"),
                       "all": B("every project")})),
    ("brain_stats", "Run counts, flaky rate and durations as JSON.", t_stats, schema({})),
]
BY_NAME = {n: f for n, _, f, _ in TOOLS}
AFTER = {"brain_list": after_list, "brain_queue_list": after_queue_list}


def run_brain(args, stdin):
    argv = [sys.executable, BRAIN, *args]
    path = os.environ.get("BRAIN_MCP_ARGV_LOG")
    if path:
        with open(path, "a") as f:
            f.write(json.dumps(argv) + "\n")
    r = subprocess.run(argv, input=stdin, capture_output=True, text=True)
    return r.returncode, r.stdout, r.stderr


def result(text, err=False):
    return {"content": [{"type": "text", "text": text}], "isError": err}


def call_tool(name, a):
    fn = BY_NAME.get(name)
    if fn is None:
        return None
    if not isinstance(a, dict):
        return result("arguments must be an object", True)
    try:
        args, stdin = fn(a)
    except Bad as e:
        return result(str(e), True)
    try:
        rc, out, err = run_brain(args, stdin)
    except OSError as e:
        return result(f"could not run brain: {e}", True)
    if rc != 0:
        return result((err.strip() or out.strip() or f"brain exited {rc}"), True)
    if name in AFTER:
        out = AFTER[name](a, out)
    return result(out.strip() or "ok")


def handle(msg):
    """Return a response dict, or None for a notification."""
    if not isinstance(msg, dict):
        return {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "invalid request"}}
    method = msg.get("method")
    mid = msg.get("id")
    has_id = "id" in msg
    params = msg.get("params") or {}

    def ok(res):
        return {"jsonrpc": "2.0", "id": mid, "result": res}

    def fail(code, text):
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": code, "message": text}}

    if not has_id:  # notification, never answered
        return None
    if method == "initialize":
        return ok({"protocolVersion": params.get("protocolVersion") or DEFAULT_PROTOCOL,
                   "capabilities": {"tools": {}}, "serverInfo": {"name": "brain", "version": "1.0.0"}})
    if method == "ping":
        return ok({})
    if method == "tools/list":
        return ok({"tools": [{"name": n, "description": d, "inputSchema": s} for n, d, _, s in TOOLS]})
    if method == "tools/call":
        res = call_tool(params.get("name"), params.get("arguments") or {})
        if res is None:
            return fail(-32602, f"unknown tool: {params.get('name')}")
        return ok(res)
    return fail(-32601, f"method not found: {method}")


def serve():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            resp = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
        else:
            try:
                resp = handle(msg)
            except Exception as e:  # keep the server alive
                log("internal error:", repr(e))
                resp = {"jsonrpc": "2.0", "id": msg.get("id") if isinstance(msg, dict) else None,
                        "error": {"code": -32603, "message": "internal error"}}
        if resp is not None:
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()


def digest_and_size_tests(fails, call, db):
    import sqlite3
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    con = sqlite3.connect(db)
    rows = [("Big%d" % (i % 30), "test-fail", "t%d" % i, "title " + "x" * 80, "open" if i % 4 else "closed", now, now)
            for i in range(2000)]
    rows.append(("Big1", "blocker", "bb", "waiting on the user", "open", now, now))
    rows.append(("Big1", "agent", "oldagent", "stale one", "open", "2020-01-01T00:00:00Z", "2020-01-01T00:00:00Z"))
    con.executemany("INSERT INTO items (project, kind, ref, title, status, first_seen, last_seen) "
                    "VALUES (?,?,?,?,?,?,?)", rows)
    for i in range(300):
        con.execute("INSERT INTO jobs (project, repo_dir, test_project, status, enqueued_at) "
                    "VALUES ('Big1', '/x', ?, 'done', ?)", ("t/Done%d.csproj" % i, now))
    con.execute("INSERT INTO jobs (project, repo_dir, test_project, status, enqueued_at) "
                "VALUES ('Big1', '/x', 't/Running.csproj', 'running', ?)", (now,))
    con.commit()
    con.close()
    err, text = call("brain_list")
    lines = text.splitlines()
    if err or len(text.encode()) > 8000 or len(lines) != 51 or " closed " in text:
        fails.append(f"brain_list default must be open items, 50 lines and under 8 KB: {err} {len(text.encode())} "
                     f"bytes {len(lines)} lines")
    if "more items" not in lines[-1] or not lines[-1].startswith("... "):
        fails.append(f"a cut brain_list must say how many more: {lines[-1:]!r}")
    err, text = call("brain_list", limit=5)
    if err or len(text.splitlines()) != 6:
        fails.append(f"brain_list limit 5: {err} {text!r}")
    err, text = call("brain_list", limit=0)
    if not err:
        fails.append("a limit under 1 must be refused")
    err, text = call("brain_list", status="closed", limit=1000)
    if err or " open " in text or len(text.splitlines()) != 500:
        fails.append(f"brain_list status closed must list closed items past the default: {err} {len(text.splitlines())}")
    err, text = call("brain_list", project="Big1", kind="blocker")
    if err or "bb" not in text or len(text.splitlines()) != 1:
        fails.append(f"brain_list project and kind filters must still work: {err} {text!r}")
    err, text = call("brain_list", open=False, project="Big1", limit=1000)
    if err or " closed " not in text:
        fails.append(f"brain_list open=false must include closed items: {err}")
    err, text = call("brain_queue_list")
    if err or "Running.csproj" not in text or "Done" in text or "tests/A.csproj" not in text:
        fails.append(f"brain_queue_list default must be queued and running jobs only: {err} {text[:300]!r}")
    err, text = call("brain_queue_list", status="done")
    if err or "Done0.csproj" not in text or len(text.splitlines()) != 51 or "more jobs" not in text.splitlines()[-1]:
        fails.append(f"brain_queue_list status done must list done jobs, cut at 50: {err} {len(text.splitlines())}")
    err, text = call("brain_digest", project="big1")
    if err or len(text.encode()) > 2048 or "waiting on the user" not in text or "stale agent" not in text \
            or "Running.csproj" not in text or "Done" in text:
        fails.append(f"brain_digest for one project: {err} {len(text.encode())} bytes {text!r}")
    err, text = call("brain_digest", all=True)
    if err or len(text.encode()) > 2048 or "big0" not in text:
        fails.append(f"brain_digest all on 2000 items must stay under 2 KB: {err} {len(text.encode())} bytes")


def self_test():
    fails = []
    me = os.path.realpath(__file__)
    secret = "hunter2"
    with tempfile.TemporaryDirectory() as d:
        d_root = d
        argv_log = os.path.join(d, "argv.log")
        env = dict(os.environ, LEAN_BRAIN_DB=os.path.join(d, "brain.db"), BRAIN_MCP_ARGV_LOG=argv_log)
        env.pop("LEAN_SESSION_ID", None)
        env.pop("LEAN_SESSION_CWD", None)
        p = subprocess.Popen([sys.executable, me], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True, env=env)
        n = [0]

        def rpc(method, params=None):
            n[0] += 1
            p.stdin.write(json.dumps({"jsonrpc": "2.0", "id": n[0], "method": method, "params": params or {}}) + "\n")
            p.stdin.flush()
            r = json.loads(p.stdout.readline())
            if r.get("id") != n[0]:
                fails.append(f"{method}: id mismatch {r}")
            return r

        def call(name, **a):
            r = rpc("tools/call", {"name": name, "arguments": a})
            res = r.get("result", {})
            text = "".join(c.get("text", "") for c in res.get("content", []))
            return bool(res.get("isError")), text

        try:
            r = rpc("initialize", {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "t"}})
            res = r.get("result", {})
            if res.get("protocolVersion") != "2025-03-26" or res.get("serverInfo", {}).get("name") != "brain" \
                    or "tools" not in res.get("capabilities", {}):
                fails.append(f"initialize: {r}")
            p.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            p.stdin.flush()
            if rpc("ping").get("result") != {}:
                fails.append("ping must return {}")
            names = {t["name"] for t in rpc("tools/list").get("result", {}).get("tools", [])}
            want = {"brain_list", "brain_show", "brain_add", "brain_close", "brain_queue_list", "brain_queue_add",
                    "brain_queue_cancel", "brain_queue_bump", "brain_queue_route", "brain_stats", "brain_digest"}
            if names != want:
                fails.append(f"tools/list: missing {sorted(want - names)} extra {sorted(names - want)}")
            err, text = call("brain_add", project="demo", kind="question", ref="q1", title="a title",
                             body=f"password is {secret}\nsecond line")
            if err or "added" not in text:
                fails.append(f"brain_add: {err} {text!r}")
            err, text = call("brain_list", open=True, project="demo")
            if err or "q1" not in text:
                fails.append(f"brain_list must show the item: {err} {text!r}")
            err, text = call("brain_show", id=1)
            if err or secret not in text or "second line" not in text:
                fails.append(f"brain_show must return the stdin body: {err} {text!r}")
            err, text = call("brain_add", project="demo", kind="note", ref="q2", title="-1 offset in the parser")
            if err:
                fails.append(f"a title may start with a dash: {text!r}")
            repo = os.path.join(d, "repo")
            os.makedirs(os.path.join(repo, "sub"))
            subprocess.run(["git", "init", "-q", repo], check=True)
            for not_top in (d, os.path.join(repo, "sub")):
                err, text = call("brain_queue_add", repo_dir=not_top, test_project="tests/A.csproj")
                if not err:
                    fails.append(f"brain_queue_add must refuse a folder that is not a git top folder: {not_top}")
            d = repo
            os.makedirs(os.path.join(d, "tests"))
            with open(os.path.join(d, "tests", "A.csproj"), "w") as f:
                f.write("<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup></Project>")
            err, text = call("brain_queue_add", repo_dir=d, test_project="tests/A.csproj", filter="X", tier="fast")
            if err:
                fails.append(f"brain_queue_add: {text!r}")
            for bad in ({"repo_dir": d, "test_project": "--help"}, {"repo_dir": d, "test_project": "t", "filter": "-x"},
                        {"repo_dir": d, "test_project": "t", "filter": "A| --help"},
                        {"repo_dir": d, "test_project": "t", "tier": "slow"},
                        {"repo_dir": os.path.join(d, "nope"), "test_project": "t"},
                        {"repo_dir": d, "test_project": "t", "args": "-p:X=1"}):
                err, text = call("brain_queue_add", **bad)
                if not err and "args" not in bad:
                    fails.append(f"brain_queue_add must refuse {bad}: {text!r}")
            if "--args" in open(argv_log).read():
                fails.append("brain_queue_add must never pass --args")
            err, text = call("brain_queue_route", id=1, to="remote")
            if err or "platform=remote" not in text:
                fails.append(f"brain_queue_route must send a queued job to a remote lane: {err} {text!r}")
            call("brain_queue_add", repo_dir=d, test_project="tests/Mac.csproj")  # unreadable, so queued as apple
            err, text = call("brain_queue_route", id=2, to="remote")
            if not err or "--force" not in text:
                fails.append(f"brain_queue_route must refuse sending an apple job to a remote lane: {err} {text!r}")
            for bad in ({"id": 1, "to": "vm"}, {"id": 1, "to": "--help"}, {"id": 1}):
                err, text = call("brain_queue_route", **bad)
                if not err:
                    fails.append(f"brain_queue_route must refuse {bad}: {text!r}")
            err, text = call("brain_queue_list")
            if err or "tests/A.csproj" not in text:
                fails.append(f"brain_queue_list must show the job: {err} {text!r}")
            digest_and_size_tests(fails, call, os.path.join(d_root, "brain.db"))
            err, text = call("brain_stats")
            if err or not text.lstrip().startswith(("{", "[")):
                fails.append(f"brain_stats must return json: {err} {text!r}")
            err, text = call("brain_show", id=99999)
            if not err or not text:
                fails.append(f"a bad id must be isError with text: {err} {text!r}")
            err, text = call("brain_show", id="one")
            if not err:
                fails.append("a non-integer id must be isError")
            r = rpc("tools/call", {"name": "brain_queue_next", "arguments": {}})
            if "error" not in r:
                fails.append("queue next must not be exposed")
            r = rpc("nope/nothing")
            if r.get("error", {}).get("code") != -32601:
                fails.append(f"unknown method must be -32601: {r}")
        except Exception as e:
            fails.append(f"exception: {e!r}")
        finally:
            try:
                p.stdin.close()
                p.wait(timeout=10)
            except Exception:
                p.kill()
        if os.path.exists(argv_log):
            logged = open(argv_log).read()
            if secret in logged:
                fails.append("the body reached a brain argv")
            if "--body-file" not in logged or '"-"' not in logged:
                fails.append("brain_add must pass --body-file -")
            if '"mcp"' not in logged:
                fails.append("queue add must pass --by mcp")
            for bad in ('"next"', '"finish"'):
                if bad in logged:
                    fails.append(f"argv log has {bad}")
        else:
            fails.append("no argv log written")
    if fails:
        for f in fails:
            print("FAIL:", f)
        return 1
    print("brain-mcp self-test: ok")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    serve()
