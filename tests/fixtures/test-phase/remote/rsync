#!/usr/bin/env python3
"""Fake rsync for the test-phase self-test: copies the --files-from list (NUL separated, on stdin) into a folder."""
import os
import shutil
import sys

args = sys.argv[1:]
with open(os.path.join(os.environ["FAKE_DIR"], "rsync.log"), "a") as fh:
    fh.write(" ".join(args) + "\n")
if os.path.exists(os.path.join(os.environ["FAKE_DIR"], "rsync-fail")):
    sys.stderr.write("rsync: connection unexpectedly closed\n")
    sys.exit(12)
if "--files-from=-" not in args or "--from0" not in args:
    sys.exit("fake rsync: want --files-from=- --from0")
src, dest = args[-2], args[-1]
dest = dest.split(":", 1)[1] if ":" in dest else dest
os.makedirs(dest, exist_ok=True)
names = [n for n in sys.stdin.buffer.read().split(b"\0") if n]
with open(os.path.join(os.environ["FAKE_DIR"], "rsync.log"), "a") as fh:
    fh.write("files: " + " ".join(sorted(n.decode() for n in names)) + "\n")
for n in names:
    rel = n.decode()
    target = os.path.join(dest, rel)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    shutil.copy2(os.path.join(src, rel), target, follow_symlinks=False)
