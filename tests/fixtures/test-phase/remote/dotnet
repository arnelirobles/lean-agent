#!/bin/sh
# Fake dotnet for the remote lane self-test. The project name in the arguments picks the behavior.
echo "$(basename "$PWD") $*" >> "$FAKE_DIR/where.log"
find . -type f | sort >> "$FAKE_DIR/files-$(basename "$PWD").log"
[ -f .lean.env ] && ls -l .lean.env >> "$FAKE_DIR/envmode.log"
case "$*" in
  *Apple.csproj*) for i in 1 2 3 4 5 6; do echo "passed Busy$i"; sleep 0.5; done; exit 0 ;;
  *Stall.csproj*) echo "[+1/x0/?0] t"; sleep 60; exit 0 ;;
  *Hs.csproj*)
    : > "$FAKE_DIR/inflight-$$"; i=0
    while [ "$(ls "$FAKE_DIR" | grep -c '^inflight-')" -lt 2 ] && [ "$i" -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
    echo "peers=$(ls "$FAKE_DIR" | grep -c '^inflight-')" >> "$FAKE_DIR/peers.log"; exit 0 ;;
  *FullyQualifiedName~Acme.RemoteTests*)
    echo "  Failed Acme.RemoteTests.Breaks [3 ms]"
    echo "Failed!  - Failed:     1, Passed:     0, Skipped:     0, Total:     1"; exit 1 ;;
  *Fail.csproj*)
    echo "  Failed Acme.RemoteTests.Breaks [3 ms]"
    echo "Failed!  - Failed:     1, Passed:     2, Skipped:     0, Total:     3"; exit 1 ;;
esac
echo "Passed!  - Failed:     0, Passed:     1, Skipped:     0, Total:     1"
exit 0
